{%- comment -%}
  Editorial media block for sections/product-cards-grid.liquid
  ------------------------------------------------------------------
  Renders one "editorial_media" block as a full-width row inside the
  product grid - it always spans every column (grid-column: 1 / -1), so it
  never counts as a product card for the 4/2/1 column math and never nests
  inside a product-card article. Image-only and video-only both work
  without forcing any text. Reuses the theme's global <internal-video>
  custom element for Shopify-hosted video - no new JS.

  Accepts:
  - block: {Block} an editorial_media block
{%- endcomment -%}

{%- liquid
  assign bs = block.settings
  assign has_video = false
  if bs.video != blank
    assign has_video = true
  endif
  assign has_media = false
  if has_video or bs.desktop_image != blank
    assign has_media = true
  endif
  assign has_text = false
  if bs.heading != blank or bs.text != blank or bs.cta_label != blank
    assign has_text = true
  endif
-%}

{%- if has_media or has_text -%}
  <div
    class="vp-prodgrid-media vp-prodgrid-media--{{ bs.width_mode }}"
    style="
      --vp-pgm-bg: {{ bs.color_background }};
      --vp-pgm-text: {{ bs.color_text }};
      --vp-pgm-radius: {{ bs.border_radius }}px;
      --vp-pgm-spacing-top: {{ bs.spacing_top }}px;
      --vp-pgm-spacing-bottom: {{ bs.spacing_bottom }}px;
      --vp-pgm-ratio-d: {{ bs.desktop_aspect_ratio | default: '21/9' | replace: ':', '/' }};
      --vp-pgm-ratio-m: {{ bs.mobile_aspect_ratio | default: '4/5' | replace: ':', '/' }};
    "
    {{ block.shopify_attributes }}
  >
    {%- if has_media -%}
      <div class="vp-prodgrid-media__media">
        {%- if has_video -%}
          <internal-video class="vp-prodgrid-media__video-wrap"{% if bs.video_autoplay %} data-autoplay="true" data-no-play-btn="true"{% endif %}>
            <video
              class="vp-prodgrid-media__video"
              poster="{% if bs.video_poster != blank %}{{ bs.video_poster | image_url: width: 1600 }}{% else %}{{ bs.video.preview_image | image_url: width: 1600 }}{% endif %}"
              {% if bs.video_loop %}loop{% endif %}
              {% if bs.video_autoplay %}muted{% endif %}
              playsinline
              {% if bs.video_controls %}controls{% endif %}
            >
              {%- for source in bs.video.sources -%}
                <source {% if bs.video_autoplay %}data-{% endif %}src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          </internal-video>
        {%- elsif bs.mobile_image != blank -%}
          {%- comment -%} Distinct mobile image set: swap by breakpoint. {%- endcomment -%}
          {{ bs.desktop_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '100vw', class: 'vp-prodgrid-media__image vp-prodgrid-media__image--desktop-only', alt: bs.heading | default: '' }}
          {{ bs.mobile_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480,640,900', sizes: '100vw', class: 'vp-prodgrid-media__image vp-prodgrid-media__image--mobile-only', alt: bs.heading | default: '' }}
        {%- else -%}
          {%- comment -%} No separate mobile image: one responsive image at every breakpoint. {%- endcomment -%}
          {{ bs.desktop_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480,640,900,1200,1600', sizes: '100vw', class: 'vp-prodgrid-media__image', alt: bs.heading | default: '' }}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if has_text -%}
      <div class="vp-prodgrid-media__content">
        {%- if bs.heading != blank -%}
          <h3 class="vp-prodgrid-media__heading">{{ bs.heading | escape }}</h3>
        {%- endif -%}
        {%- if bs.text != blank -%}
          <p class="vp-prodgrid-media__text">{{ bs.text | escape }}</p>
        {%- endif -%}
        {%- if bs.cta_label != blank -%}
          <a href="{{ bs.cta_link | default: '#' }}" class="vp-prodgrid-media__cta">{{ bs.cta_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{%- style -%}
  .vp-prodgrid-media {
    grid-column: 1 / -1;
    background: var(--vp-pgm-bg, transparent);
    color: var(--vp-pgm-text, #10232B);
    margin-top: var(--vp-pgm-spacing-top, 8px);
    margin-bottom: var(--vp-pgm-spacing-bottom, 8px);
    overflow: hidden;
  }

  .vp-prodgrid-media--contained {
    border-radius: var(--vp-pgm-radius, 16px);
  }

  .vp-prodgrid-media--full_bleed {
    border-radius: 0;
  }

  .vp-prodgrid-media__media {
    position: relative;
    background: rgba(16, 35, 43, 0.03);
    aspect-ratio: var(--vp-pgm-ratio-m, 4/5);
  }

  .vp-prodgrid-media__image,
  .vp-prodgrid-media__video-wrap,
  .vp-prodgrid-media__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vp-prodgrid-media__image--mobile-only { display: block; }
  .vp-prodgrid-media__image--desktop-only { display: none; }

  .vp-prodgrid-media__content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .vp-prodgrid-media__heading {
    margin: 0;
    font-family: var(--font-heading-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    color: inherit;
  }

  .vp-prodgrid-media__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: inherit;
    opacity: 0.9;
  }

  .vp-prodgrid-media__cta {
    align-self: flex-start;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border-radius: 999px;
    background: #47B5E9;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .vp-prodgrid-media__cta:focus-visible { outline: 2px solid #10232B; outline-offset: 2px; }

  @media screen and (min-width: 750px) {
    .vp-prodgrid-media__media { aspect-ratio: var(--vp-pgm-ratio-d, 21/9); }
    .vp-prodgrid-media__image--desktop-only { display: block; }
    .vp-prodgrid-media__image--mobile-only { display: none; }
    .vp-prodgrid-media__content { padding: 28px; }
    .vp-prodgrid-media__heading { font-size: 26px; }
    .vp-prodgrid-media__text { font-size: 16px; }
  }
{%- endstyle -%}
