{%- comment -%}
  Review-only screen switcher.

  Hidden unless the URL carries ?spp_dev=1 (or the section setting is on).
  It exists so the founder and QA can reach every screen, state and currency
  without a live backend. It is never shown to a customer and it performs no
  mutation beyond the mock adapter.

  Scoped to the Phoenix-supported surface: no swap, add-on, address, payment,
  frequency, quantity, pause or resume entries, because those screens and
  sheets no longer exist.
{%- endcomment -%}

<aside class="spp__dev" data-spp-dev hidden aria-label="Portal review switcher">
  <button type="button" class="spp__dev-toggle" data-spp-dev-toggle style="width:auto;min-height:24px;padding:0;">
    Review tools
  </button>

  <div class="spp__dev-body">
    <div class="spp__dev-title" style="margin-top:10px;">Screens</div>

    <div class="spp__dev-group">Sign in</div>
    <button type="button" data-spp-go="login">Magic-link login</button>
    <button type="button" data-spp-go="sent">Link sent</button>

    <div class="spp__dev-group">Portal</div>
    <button type="button" data-spp-go="dashboard">Dashboard</button>
    <button type="button" data-spp-go="subscription">Subscription details</button>
    <button type="button" data-spp-go="deliveries">Deliveries</button>
    <button type="button" data-spp-go="loyalty" data-spp-loyalty hidden>VetPoints</button>
    <button type="button" data-spp-go="rewards">Rewards catalogue</button>
    <button type="button" data-spp-go="account">Help &amp; account</button>

    <div class="spp__dev-group">Cancel &amp; restart</div>
    <button type="button" data-spp-go="cancel-benefits">1 · Benefits</button>
    <button type="button" data-spp-go="cancel-reason">2 · Reason</button>
    <button type="button" data-spp-go="cancel-alt">2 · Alternatives</button>
    <button type="button" data-spp-go="cancel-confirm">3 · Confirm</button>
    <button type="button" data-spp-go="cancel-done">4 · Cancelled</button>
    <button type="button" data-spp-go="reactivate">Reactivate</button>
    <button type="button" data-spp-go="inactive">Inactive list</button>
    <button type="button" data-spp-go="empty">Empty account</button>

    <div class="spp__dev-group">Schedule sheets</div>
    <button type="button" data-spp-sheet="skip">Skip delivery</button>
    <button type="button" data-spp-sheet="delay">Delay / reschedule</button>

    <div class="spp__dev-group">System states</div>
    <button type="button" data-spp-go="loading">Loading</button>
    <button type="button" data-spp-go="expired">Expired link</button>
    <button type="button" data-spp-go="error">API error</button>
    <button type="button" data-spp-go="success">Success</button>
    <button type="button" data-spp-dev-pending>Mutation pending (skip)</button>

    <div class="spp__dev-group">Subscription status</div>
    <button type="button" data-spp-dev-status="active">Active</button>
    <button type="button" data-spp-dev-status="cancelled">Cancelled</button>

    <div class="spp__dev-group">Market currency</div>
    <select data-spp-dev-currency aria-label="Market currency">
      <option value="USD">USD — prototype example</option>
      <option value="GBP">GBP</option>
      <option value="EUR">EUR</option>
      <option value="SEK">SEK</option>
    </select>

    <p class="spp__note" style="margin-top:12px;">
      Mock data. Currency comes from Phoenix order details in production.
    </p>
  </div>
</aside>
