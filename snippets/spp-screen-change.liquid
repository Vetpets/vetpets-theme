{%- comment -%}
  Screens: swap product, add one-time item, delivery address,
  secure payment redirect.

  The payment screen never collects card data. It hands off to a hosted
  page minted server-side; this portal has no card fields at all.
{%- endcomment -%}

{%- comment -%} ---------- Swap a product ---------- {%- endcomment -%}
<section class="spp__screen" data-spp-screen="swap" hidden aria-labelledby="spp-swap-h">
  <button type="button" class="spp__back" data-spp-go="dashboard">
    {% render 'spp-icon', icon: 'chevron-left' %}Overview
  </button>

  <h1 class="spp__h1" id="spp-swap-h">Swap a product</h1>
  <p class="spp__lede">
    Replacing <strong style="color:var(--spp-ink);" data-spp-field="swap.replacing">EyeWipes &mdash; 100 ct</strong>.
    The swap applies from your <span data-spp-field="subscription.nextOrderShort">Sep 8</span> delivery onwards;
    price updates with it.
  </p>

  <div style="display:flex;flex-direction:column;gap:12px;" role="radiogroup" aria-label="Replacement product" data-spp-list="swapOptions">
    <template data-spp-tpl="swapOptions">
      <button type="button" class="spp__pick" role="radio" aria-checked="false" data-spp-pick="swap">
        <span class="spp__thumb spp__thumb--lg" data-spp-thumb><img data-spp-img alt=""></span>
        <span style="flex:1;min-width:0;">
          <span class="spp__media-title" style="display:block;" data-spp-field="name">EarWipes jar</span>
          <span class="spp__media-meta" style="display:block;" data-spp-field="meta">Ear care · packshot photo pending</span>
        </span>
        <span class="spp__media-price" data-spp-field="price">$21.90</span>
      </button>
    </template>
  </div>

  <button type="button" class="spp__btn spp__btn--primary" style="margin-top:18px;" data-spp-act="swap">
    <span data-spp-field="label.swap">Confirm swap for Sep 8</span>
  </button>
</section>

{%- comment -%} ---------- Add a one-time item ---------- {%- endcomment -%}
<section class="spp__screen" data-spp-screen="addon" hidden aria-labelledby="spp-addon-h">
  <button type="button" class="spp__back" data-spp-go="dashboard">
    {% render 'spp-icon', icon: 'chevron-left' %}Overview
  </button>

  <h1 class="spp__h1" id="spp-addon-h">
    Add to your <span data-spp-field="subscription.nextOrderShort">Sep 8</span> delivery
  </h1>
  <p class="spp__lede">
    One-time additions ship with the next order at subscriber pricing. They don&rsquo;t change your recurring items.
  </p>

  <div style="display:flex;flex-direction:column;gap:12px;" data-spp-list="addonOptions">
    <template data-spp-tpl="addonOptions">
      <div class="spp__pick" style="cursor:default;">
        <span class="spp__thumb spp__thumb--lg" data-spp-thumb><img data-spp-img alt=""></span>
        <div style="flex:1;min-width:0;">
          <div class="spp__media-title" data-spp-field="name">GloveWipes pack</div>
          <div class="spp__media-meta">
            <span data-spp-field="meta">One-time · ships with next order</span> ·
            <span data-spp-field="price">$18.90</span>
          </div>
        </div>
        <button type="button" class="spp__btn spp__btn--secondary" style="width:auto;min-height:44px;padding:0 16px;font-size:14px;" data-spp-pick="addon">
          <span data-spp-field="btnLabel">Add</span>
        </button>
      </div>
    </template>
  </div>

  <div class="spp__total-strip" style="margin-top:18px;">
    <span>New delivery total</span>
    <span data-spp-field="addon.total">$62.73</span>
  </div>

  <button type="button" class="spp__btn spp__btn--primary" style="margin-top:12px;" data-spp-act="addon">
    <span data-spp-field="label.addon">Save changes to next delivery</span>
  </button>
</section>

{%- comment -%} ---------- Delivery address ---------- {%- endcomment -%}
<section class="spp__screen" data-spp-screen="address" hidden aria-labelledby="spp-addr-h">
  <button type="button" class="spp__back" data-spp-go="dashboard">
    {% render 'spp-icon', icon: 'chevron-left' %}Overview
  </button>

  <h1 class="spp__h1" id="spp-addr-h">Delivery address</h1>
  <p class="spp__lede">
    Changes apply to the <span data-spp-field="subscription.nextOrderShort">Sep 8</span> delivery and everything after it.
  </p>

  <form class="spp__card spp__form-grid" data-spp-form="address" novalidate>
    <label class="spp__field spp__field--full">
      <span class="spp__field-label">Full name</span>
      <input class="spp__input" name="name" autocomplete="name" value="Margaret Ellis">
    </label>
    <label class="spp__field spp__field--full">
      <span class="spp__field-label">Street address</span>
      <input class="spp__input" name="line1" autocomplete="address-line1" value="214 Wren Street">
    </label>
    <label class="spp__field">
      <span class="spp__field-label">Apartment</span>
      <input class="spp__input" name="line2" autocomplete="address-line2" value="Apt 3B">
    </label>
    <label class="spp__field">
      <span class="spp__field-label">City</span>
      <input class="spp__input" name="city" autocomplete="address-level2" value="Portland">
    </label>
    <label class="spp__field">
      <span class="spp__field-label">State</span>
      <input class="spp__input" name="province" autocomplete="address-level1" value="OR">
    </label>
    <label class="spp__field">
      <span class="spp__field-label">ZIP code</span>
      <input class="spp__input" name="zip" autocomplete="postal-code" inputmode="numeric" value="97209">
    </label>
    <label class="spp__field spp__field--full">
      <span class="spp__field-label">Phone for delivery updates</span>
      <input class="spp__input" name="phone" type="tel" autocomplete="tel" value="(503) 555-0142">
    </label>
  </form>

  <button type="button" class="spp__btn spp__btn--primary" style="margin-top:14px;" data-spp-act="saveAddress">
    <span data-spp-field="label.saveAddress">Save address</span>
  </button>
</section>

{%- comment -%} ---------- Secure payment redirect ---------- {%- endcomment -%}
<section class="spp__screen" data-spp-screen="payment" hidden aria-labelledby="spp-pay-h">
  <div style="padding:18px 0;">
    <button type="button" class="spp__back" data-spp-go="dashboard">
      {% render 'spp-icon', icon: 'chevron-left' %}Overview
    </button>

    <div class="spp__narrow spp__centred spp__card" style="border-radius:22px;padding:26px 22px;box-shadow:0 8px 24px rgba(13,35,64,.08);">
      <div class="spp__disc" style="width:64px;height:64px;margin-bottom:18px;">
        {% render 'spp-icon', icon: 'lock' %}
      </div>

      <h1 class="spp__h1" id="spp-pay-h" style="font-size:23px;line-height:1.25;margin-bottom:10px;">
        Taking you to our secure payment page
      </h1>
      <p class="spp__lede" style="font-weight:400;font-size:15.5px;line-height:1.55;margin-bottom:20px;">
        Card details are handled by our payment provider. VetPets never sees or stores your card number,
        and this portal has no card fields.
      </p>

      <div class="spp__info" style="display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:18px;">
        <span style="width:44px;height:30px;border-radius:6px;background:var(--spp-ink);color:#fff;font:700 10px/30px var(--spp-font);text-align:center;display:block;" data-spp-field="subscription.paymentBrand">VISA</span>
        <span style="font:500 14.5px/1.3 var(--spp-font);color:var(--spp-body);">
          Currently on file: ···· <span data-spp-field="subscription.paymentLast4">4242</span>
        </span>
      </div>

      <div style="display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:18px;font:600 14px/1 var(--spp-font);color:var(--spp-ink);">
        <span class="spp__spinner spp__spinner--accent"></span>
        Opening secure page&hellip;
      </div>

      <button type="button" class="spp__btn spp__btn--primary" data-spp-act="redirect">
        <span data-spp-field="label.redirect">Continue to secure page</span>
      </button>
      <button type="button" class="spp__btn spp__btn--link" style="margin-top:8px;" data-spp-go="dashboard">Not now</button>

      <p class="spp__note" style="margin-top:16px;">
        Your next delivery on <span data-spp-field="subscription.nextOrderShort">Sep 8</span> is unaffected while you update the card.
      </p>
    </div>
  </div>
</section>
