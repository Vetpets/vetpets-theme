{%- comment -%}
  VetPets Subscription Portal — icon set.

  Every icon is inline SVG so it inherits colour from its container. That
  is what keeps icons white on solid blue surfaces without a second asset.

  Usage: {% render 'spp-icon', icon: 'chevron-right', size: 14 %}

  Params:
    icon   required, see the case list below
    size   optional, px (square). Some icons override height for their ratio.
    stroke optional, defaults to currentColor
{%- endcomment -%}

{%- liquid
  assign s = size | default: 20
  assign sc = stroke | default: 'currentColor'
-%}

{%- case icon -%}

  {%- when 'paw' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <ellipse cx="7.2" cy="7.6" rx="2.5" ry="3.1" fill="{{ sc }}"/>
      <ellipse cx="12" cy="5.9" rx="2.5" ry="3.3" fill="{{ sc }}"/>
      <ellipse cx="16.8" cy="7.6" rx="2.5" ry="3.1" fill="{{ sc }}"/>
      <path d="M12 12.1c2.9 0 5.4 2.1 5.4 4.6 0 2-1.6 3.2-3.4 3.2-1 0-1.5-.4-2-.4s-1 .4-2 .4c-1.8 0-3.4-1.2-3.4-3.2 0-2.5 2.5-4.6 5.4-4.6z" fill="{{ sc }}"/>
    </svg>

  {%- when 'sparkle' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M12 2.6l2.1 5.6 5.6 2.1-5.6 2.1-2.1 5.6-2.1-5.6-5.6-2.1 5.6-2.1L12 2.6z" fill="{{ sc }}"/>
      <path d="M18.6 15.4l.9 2.4 2.4.9-2.4.9-.9 2.4-.9-2.4-2.4-.9 2.4-.9.9-2.4z" fill="{{ sc }}" opacity=".65"/>
    </svg>

  {%- when 'eye' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M2.4 12S6 5.6 12 5.6 21.6 12 21.6 12 18 18.4 12 18.4 2.4 12 2.4 12z" stroke="{{ sc }}" stroke-width="1.8" stroke-linejoin="round"/>
      <circle cx="12" cy="12" r="3.1" stroke="{{ sc }}" stroke-width="1.8"/>
    </svg>

  {%- when 'ear' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M7.4 9.6a4.6 4.6 0 119.2 0c0 2.6-2.2 3.6-3.3 5.2-.8 1.2-.3 3-2 3.6-1.4.5-2.6-.5-2.6-1.9 0-1.7 1.6-2.2 1.6-3.6 0-1-.9-1.5-.9-2.6a1.9 1.9 0 013.1-1.5" stroke="{{ sc }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'shield-check' -%}
    {%- comment -%} Final approved guarantee mark: solid accent shield, white tick. {%- endcomment -%}
    <svg width="26" height="30" viewBox="0 0 26 30" fill="none" aria-hidden="true" focusable="false">
      <path d="M13 1.6l10.4 3.5v9.2c0 6.4-4.2 11.6-10.4 14.1C6.8 25.9 2.6 20.7 2.6 14.3V5.1L13 1.6z" fill="#47B5E9"/>
      <path d="M8.1 15.1l3.6 3.6 6.6-7.2" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'check' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 34 34" fill="none" aria-hidden="true" focusable="false">
      <path d="M8 17.5l6 6 12-13" stroke="{{ sc }}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'check-circle' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 19 19" fill="none" aria-hidden="true" focusable="false">
      <circle cx="9.5" cy="9.5" r="8.4" stroke="{{ sc }}" stroke-width="1.6"/>
      <path d="M5.8 9.7l2.6 2.6 5-5.4" stroke="{{ sc }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'toast-check' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false" style="flex:0 0 auto;">
      <circle cx="10" cy="10" r="9" fill="#13B6B5"/>
      <path d="M6 10.3l2.7 2.7L14 7.6" stroke="#0F172A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'clock' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
      <circle cx="10" cy="10" r="8.2" stroke="{{ sc }}" stroke-width="1.7"/>
      <path d="M10 6v4.4l3 1.8" stroke="{{ sc }}" stroke-width="1.7" stroke-linecap="round"/>
    </svg>

  {%- when 'clock-action' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
      <circle cx="10" cy="10.4" r="7.4" stroke="#47B5E9" stroke-width="1.8"/>
      <path d="M10 6.6v4.2l3 1.8" stroke="#47B5E9" stroke-width="1.8" stroke-linecap="round"/>
    </svg>

  {%- when 'skip' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
      <path d="M4 5l7 5-7 5V5z" fill="#47B5E9"/>
      <rect x="13" y="5" width="2.6" height="10" rx="1.1" fill="#47B5E9"/>
    </svg>

  {%- when 'list' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
      <path d="M3.5 6h13M3.5 10h13M3.5 14h8" stroke="#47B5E9" stroke-width="1.8" stroke-linecap="round"/>
    </svg>

  {%- when 'pause' -%}
    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true" focusable="false">
      <rect x="3" y="2.5" width="3.2" height="10" rx="1.2" fill="{{ sc }}"/>
      <rect x="8.8" y="2.5" width="3.2" height="10" rx="1.2" fill="{{ sc }}"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true" focusable="false">
      <path d="M3 8.5h10M9 4.5l4 4-4 4" stroke="{{ sc }}" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'chevron-right' -%}
    <svg width="9" height="14" viewBox="0 0 9 14" fill="none" aria-hidden="true" focusable="false" style="flex:0 0 auto;">
      <path d="M2 2l5 5-5 5" stroke="#47B5E9" stroke-width="1.9" stroke-linecap="round"/>
    </svg>

  {%- when 'chevron-left' -%}
    <svg width="9" height="14" viewBox="0 0 9 14" fill="none" aria-hidden="true" focusable="false" style="flex:0 0 auto;">
      <path d="M7 2L2 7l5 5" stroke="#47B5E9" stroke-width="1.9" stroke-linecap="round"/>
    </svg>

  {%- when 'chevron-down' -%}
    <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true" focusable="false">
      <path d="M2.4 4l3.1 3.1L8.6 4" stroke="#47B5E9" stroke-width="1.7" stroke-linecap="round"/>
    </svg>

  {%- when 'lock' -%}
    <svg width="26" height="30" viewBox="0 0 26 30" fill="none" aria-hidden="true" focusable="false">
      <rect x="3" y="12" width="20" height="15" rx="4" stroke="#47B5E9" stroke-width="2"/>
      <path d="M8 12V8a5 5 0 0110 0v4" stroke="#47B5E9" stroke-width="2" stroke-linecap="round"/>
      <circle cx="13" cy="19.5" r="2" fill="#47B5E9"/>
    </svg>

  {%- when 'tab-home' -%}
    <svg width="21" height="21" viewBox="0 0 21 21" fill="none" aria-hidden="true" focusable="false">
      <path d="M3.5 9L10.5 3.5 17.5 9v8a1.5 1.5 0 01-1.5 1.5H5A1.5 1.5 0 013.5 17V9z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'tab-deliveries' -%}
    <svg width="21" height="21" viewBox="0 0 21 21" fill="none" aria-hidden="true" focusable="false">
      <rect x="3.2" y="4.6" width="14.6" height="13" rx="2.4" stroke="currentColor" stroke-width="1.7"/>
      <path d="M3.2 8.6h14.6M7.6 3.2v3M13.4 3.2v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>

  {%- when 'tab-points' -%}
    <svg width="21" height="21" viewBox="0 0 21 21" fill="none" aria-hidden="true" focusable="false">
      <path d="M10.5 2.8l2.3 4.9 5.4.7-3.9 3.7 1 5.3-4.8-2.6-4.8 2.6 1-5.3L2.8 8.4l5.4-.7 2.3-4.9z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'tab-account' -%}
    <svg width="21" height="21" viewBox="0 0 21 21" fill="none" aria-hidden="true" focusable="false">
      <circle cx="10.5" cy="7.4" r="3.4" stroke="currentColor" stroke-width="1.7"/>
      <path d="M4.4 18c.7-3.2 3.2-5 6.1-5s5.4 1.8 6.1 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>

  {%- when 'cancelled-check' -%}
    <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true" focusable="false">
      <path d="M7 15.5l5.4 5.4L23 10" stroke="#0F172A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'success-check' -%}
    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
      <path d="M7 14.4l5 5 9.5-10.6" stroke="#47B5E9" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'image-pending' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <rect x="3.2" y="5.2" width="17.6" height="13.6" rx="2.6" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="8.6" cy="10" r="1.6" fill="currentColor"/>
      <path d="M3.6 16.4l4.6-4 3.4 3 3.2-2.6 5.4 4.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

{%- endcase -%}
