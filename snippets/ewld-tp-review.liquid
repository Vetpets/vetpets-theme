{%- comment -%}
  EyeWipes lander — one Trustpilot review card (sections/eyewipes-lander.liquid).
  variant: 'featured' (vet section, 2-up grid) or 'card' (carousel item).
{%- endcomment -%}
{%- capture aria -%}{{ title }} — review by {{ name }} on Trustpilot{%- endcapture -%}
{%- if variant == 'featured' -%}
<a href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ aria | escape }}" style="display:flex;flex-direction:column;gap:10px;box-sizing:border-box;background:#FFFFFF;border:1px solid #E5E5DD;border-radius:12px;padding:16px;color:#191919;text-decoration:none;box-shadow:0 6px 18px rgba(13,35,64,.07)">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
    <div style="display:flex;gap:2px" aria-label="Rated 5 out of 5">{{ stars }}</div>
    <span style="font-size:12.5px;color:#6B6B6B">{{ date }}</span>
  </div>
  <div style="font-size:16.5px;font-weight:700;line-height:1.3;color:#191919">{{ title }}</div>
  <p style="margin:0;font-size:15px;line-height:1.5;color:#191919">{{ text }}</p>
  <div style="display:flex;align-items:center;gap:10px;margin-top:auto;padding-top:10px;border-top:1px solid #EFEFEA">
    <span style="width:34px;height:34px;border-radius:50%;background:{{ bg }};color:#191919;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0">{{ initials }}</span>
    <span style="display:flex;flex-direction:column;gap:1px;min-width:0"><span style="font-size:14px;font-weight:700;color:#191919">{{ name }}</span><span style="font-size:12.5px;color:#6B6B6B">{{ country }}</span></span>
  </div>
</a>
{%- else -%}
<a class="tp-card" href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ aria | escape }}" style="display:flex;flex-direction:column;gap:10px;box-sizing:border-box;background:#FFFFFF;border:1px solid #E5E5DD;border-radius:10px;padding:16px;color:#191919;text-decoration:none;box-shadow:0 4px 14px rgba(13,35,64,.05)">
  <div style="display:flex;align-items:center;gap:10px;padding-bottom:12px;border-bottom:1px solid #EFEFEA">
    <span style="width:38px;height:38px;border-radius:50%;background:{{ bg }};color:#191919;font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0">{{ initials }}</span>
    <div style="display:flex;flex-direction:column;gap:1px;min-width:0">
      <span style="font-size:14.5px;font-weight:700;color:#191919">{{ name }}</span>
      <span style="font-size:12.5px;color:#6B6B6B">{{ country }}</span>
    </div>
  </div>
  <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
    <div style="display:flex;gap:2px" aria-label="Rated 5 out of 5">{{ stars }}</div>
    <span style="font-size:12.5px;color:#6B6B6B">{{ date }}</span>
  </div>
  <div style="font-size:16px;font-weight:700;line-height:1.3;color:#191919">{{ title }}</div>
  <p style="margin:0;font-size:14.5px;line-height:1.5;color:#191919">{{ text }}</p>
</a>
{%- endif -%}
