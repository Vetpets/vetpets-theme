{%- comment -%}
  Original-mode evergreen daily countdown strip (all four sales pages).
  Neutral copy only: no campaign name, date, gift or offer wording.
  Counts down to 23:59:59 America/New_York and restarts every New York day.
  The time maths lives in assets/vp-countdown.js (shared with every other
  page); this snippet only renders the markup and mounts it, so every page
  shows the identical value at the same moment. Never rendered in World
  Animal Week mode, which keeps its own fixed-deadline countdown.
{%- endcomment -%}
<!-- vp-dcd:start -->
<style>
  .vp-dcd { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; padding: 7px 12px; background: #EEF7FC; color: #0D2340; border-bottom: 1px solid #D3E8F5; font: 600 13px/1.2 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; text-align: center; }
  .vp-dcd__label { letter-spacing: .01em; }
  .vp-dcd__clock { display: inline-flex; align-items: center; gap: 4px; font-variant-numeric: tabular-nums; }
  .vp-dcd__box { display: inline-flex; flex-direction: column; align-items: center; min-width: 38px; padding: 3px 5px; background: #fff; border: 1px solid #C9E2F2; border-radius: 6px; }
  .vp-dcd__num { font-size: 16px; font-weight: 800; line-height: 1; }
  .vp-dcd__unit { margin-top: 2px; font-size: 8px; font-weight: 700; letter-spacing: .12em; color: #4F5F6B; line-height: 1; }
  .vp-dcd__sep { font-weight: 800; color: #4F5F6B; }
</style>
<div class="vp-dcd" role="timer" aria-label="Today's offer ends in">
  <span class="vp-dcd__label">Today's offer ends in</span>
  <span class="vp-dcd__clock">
    <span class="vp-dcd__box"><span class="vp-dcd__num" data-vp-dcd="h">--</span><span class="vp-dcd__unit">HRS</span></span>
    <span class="vp-dcd__sep" aria-hidden="true">:</span>
    <span class="vp-dcd__box"><span class="vp-dcd__num" data-vp-dcd="m">--</span><span class="vp-dcd__unit">MIN</span></span>
    <span class="vp-dcd__sep" aria-hidden="true">:</span>
    <span class="vp-dcd__box"><span class="vp-dcd__num" data-vp-dcd="s">--</span><span class="vp-dcd__unit">SEC</span></span>
  </span>
</div>
<script src="{{ 'vp-countdown.js' | asset_url }}" defer></script>
<script src="{{ 'vp-daily-countdown.js' | asset_url }}" defer></script>
<!-- vp-dcd:end -->
