{%- comment -%} Screen: deliveries (upcoming + history). {%- endcomment -%}

<section class="spp__screen" data-spp-screen="deliveries" hidden aria-labelledby="spp-del-h">
  <button type="button" class="spp__back" data-spp-go="dashboard">
    {% render 'spp-icon', icon: 'chevron-left' %}Overview
  </button>

  <h1 class="spp__h1" id="spp-del-h" style="margin-bottom:18px;">Deliveries</h1>

  {%- comment -%} Upcoming {%- endcomment -%}
  <div class="spp__card" style="margin-bottom:16px;">
    <span class="spp__badge" style="margin-bottom:12px;">Upcoming</span>
    <div style="font:700 21px/1.2 var(--spp-font);color:var(--spp-ink);" data-spp-field="subscription.nextOrderMedium">Tue, Sep 8</div>
    <div style="font:500 14.5px/1.4 var(--spp-font);color:var(--spp-body);margin-top:5px;">
      <span data-spp-field="subscription.quantitySummary">FreshWipes ×2, EyeWipes ×1</span> ·
      <span data-spp-field="pricing.total">$62.73</span>
    </div>
    <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;">
      <button type="button" class="spp__btn spp__btn--secondary" style="flex:1 1 120px;width:auto;min-height:48px;font-size:14.5px;" data-spp-sheet="skip">Skip</button>
      <button type="button" class="spp__btn" style="flex:1 1 120px;width:auto;min-height:48px;font-size:14.5px;background:var(--spp-surface-soft);border:1px solid rgba(13,35,64,.14);color:var(--spp-ink);" data-spp-sheet="delay">Reschedule</button>
    </div>
  </div>

  {%- comment -%} History {%- endcomment -%}
  <h2 class="spp__eyebrow spp__eyebrow--muted" style="margin:0 0 10px;">Previous deliveries</h2>
  <div class="spp__card spp__card--rows" style="padding:6px 18px;">
    <div data-spp-list="pastOrders">
      <template data-spp-tpl="pastOrders">
        <div class="spp__delivery" style="padding:14px 0;">
          <span class="spp__thumb spp__thumb--xs" data-spp-thumb><img data-spp-img alt=""></span>
          <div style="flex:1;min-width:0;">
            <div style="font:600 15px/1.3 var(--spp-font);color:var(--spp-ink);" data-spp-field="dateLong">10 July 2026</div>
            <div class="spp__delivery-meta">
              <span data-spp-field="items">FreshWipes ×2, EyeWipes ×1</span> ·
              <span data-spp-field="amount">$62.73</span>
            </div>
          </div>
          <span class="spp__delivery-status" data-spp-field="status">Delivered</span>
        </div>
      </template>
    </div>
  </div>
</section>
