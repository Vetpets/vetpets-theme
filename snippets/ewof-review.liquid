{%- comment -%}
  EyeWipes offer page — one customer review card.
  Accepts: name (string), quote (string)
{%- endcomment -%}
<div class="rv">
  <div class="rv-stars" role="img" aria-label="5 out of 5">★★★★★</div>
  <p class="rv-quote">{{ quote }}</p>
  <div class="rv-by">
    <span class="rv-name">{{ name }}</span>
    <span class="rv-ver"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="#47B5E9"></circle><path d="m7.5 12.2 3 3 6-6.4" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>Verified</span>
  </div>
  <div class="rv-prod">Product: EyeWipes Kit</div>
</div>
