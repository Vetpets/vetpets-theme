{{ 'freshwipes-offer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st = section.settings
-%}

<div class="fwo fwo-objection">
  <div class="fwo__inner fwo__section">
    <div class="fwo-objection__inner">
      {%- if st.heading != blank -%}
        <h2 class="fwo__heading">{{ st.heading | escape }}</h2>
      {%- endif -%}

      {%- if st.body != blank -%}
        <p class="fwo__body">{{ st.body | escape }}</p>
      {%- endif -%}

      {%- if st.quote != blank -%}
        <blockquote class="fwo-objection__quote">{{ st.quote | escape }}</blockquote>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FWO objection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Most dogs dental care are designed to fail"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "When was the last time you were ACTUALLY able to brush your dog's teeth properly? Most of dog's dental care overlook the importance of convenience in the act. And dental powders? How can you trust something you don't see working?"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Pull quote",
      "default": "“How can you keep using a solution you don’t even trust?”"
    }
  ],
  "presets": [
    {
      "name": "FWO objection"
    }
  ]
}
{% endschema %}
