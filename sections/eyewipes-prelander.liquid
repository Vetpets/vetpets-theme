    <div class="ewpl-mech__inner">
      <h2 class="ewpl-h2 ewpl-mech__title" id="ewpl-mech-title">Why this <span class="ewpl-accent">works</span> when nothing else did</h2>
      <div class="ewpl-mech__grid">
        <div class="ewpl-mech__card">
          <div class="ewpl-mech__media"><img src="{{ 'ewpl-mech-texture.webp' | asset_url }}" alt="Macro close-up of the textured EyeWipes pad surface" width="700" height="524" loading="lazy" decoding="async"></div>
          <div class="ewpl-mech__head">
            <div class="ewpl-mech__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="#47B5E9" aria-hidden="true"><circle cx="5" cy="5" r="2.1"/><circle cx="12" cy="5" r="2.1"/><circle cx="19" cy="5" r="2.1"/><circle cx="5" cy="12" r="2.1"/><circle cx="12" cy="12" r="2.1"/><circle cx="19" cy="12" r="2.1"/><circle cx="5" cy="19" r="2.1"/><circle cx="12" cy="19" r="2.1"/><circle cx="19" cy="19" r="2.1"/></svg></div>
            <div class="ewpl-mech__name">Textured surface lifts bacteria off</div>
          </div>
          <p class="ewpl-mech__copy">Smooth wipes move the mess around. The textured surface removes it.</p>
        </div>
        <div class="ewpl-mech__card">
