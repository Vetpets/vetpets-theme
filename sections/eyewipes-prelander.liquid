          {% render 'ewpl-review', name: 'John B.', quote: rv6, product: kit_name, pdp_url: pdp_url %}
        </ul>
        <div class="ewpl-reviews__nav">
          <button type="button" class="ewpl-reviews__navbtn" data-ewpl-rail="prev" aria-label="Previous reviews">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 5 8 12l6.5 7" stroke="#47B5E9" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
