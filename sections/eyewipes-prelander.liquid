{%- comment -%}
  EyeWipes pre-lander
  ===================
  Faithful Shopify implementation of the approved Claude Design page
  "EyeWipes Pre-Lander v2" (project: VetPets EyeWipes Pre-Lander).

  Rendered only through templates/page.eyewipes-prelander.json, which uses
  layout/eyewipes-prelander.liquid — a dedicated layout with no header,
  navigation, announcement bar or footer.

  Everything is scoped under #eyewipes-prelander:
    assets/eyewipes-prelander.css   presentation
    assets/eyewipes-prelander.js    countdown, comparison tabs, review rail,
                                    attribution forwarding

  CTA routing: every call to action goes to the canonical EyeWipes PDP. The
  only exception is "Skip to offer", which scrolls to #eyewipes-offer on this
  same page.
{%- endcomment -%}

{%- liquid
  assign pdp_url = section.settings.cta_url | default: 'https://shopvetpets.com/products/eyewipes-prevention-that-keeps-eyes-clear'
  assign offer_anchor = '#eyewipes-offer'

  # server-rendered countdown seed (shop time). eyewipes-prelander.js corrects
  # it to the visitor's own clock within a second.
  assign now_h = 'now' | date: '%H' | times: 1
  assign now_m = 'now' | date: '%M' | times: 1
  assign now_s = 'now' | date: '%S' | times: 1
  assign hour_seconds = now_h | times: 3600
  assign minute_seconds = now_m | times: 60
  assign elapsed = hour_seconds | plus: minute_seconds | plus: now_s
  assign left = 86400 | minus: elapsed
  assign cd_h = left | divided_by: 3600
  assign cd_rem = left | modulo: 3600
  assign cd_m = cd_rem | divided_by: 60
  assign cd_s = cd_rem | modulo: 60
  assign cd_h = cd_h | prepend: '0' | slice: -2, 2
  assign cd_m = cd_m | prepend: '0' | slice: -2, 2
  assign cd_s = cd_s | prepend: '0' | slice: -2, 2

  assign marquee_claims = '45,000+ Happy Dog Owners|100-Day Money-Back Guarantee|Hypoallergenic &amp; Fragrance-Free|Works In 30 Seconds A Day' | split: '|'

  assign cmp_rows = 'Physically removes the buildup~y~n~n~n~y||Textured surface lifts debris off the skin~y~n~n~n~n||Antibacterial — stops it coming back~y~n~d~n~n||Safe for daily use around the eyes~y~n~n~y~d||Works from day one~y~d~d~n~y||No struggle, no stress~y~d~n~y~n||Time per day~t:30 sec~t:1–2 min~t:5–10 min~t:—~t:—' | split: '||'
  assign cmp_rivals = 'Baby Wipes~ewpl-cmp-babywipes.webp~Baby wipes||Coconut Oil &amp; Home Remedies~ewpl-cmp-coconut.webp~Coconut oil and home remedies||Tear-Stain Supplements~ewpl-cmp-supplements.webp~Tear-stain supplements||Grooming Visits~ewpl-cmp-grooming.webp~Grooming visits' | split: '||'

  assign kit_name = 'EyeWipes Kit – Prevention That Keeps Eyes Clear'
-%}

<div id="eyewipes-prelander">

  {%- comment -%} ---------- top offer bar ---------- {%- endcomment -%}
  <div class="ewpl-topbar">
    <div class="ewpl-topbar__inner">
      <div class="ewpl-topbar__text">
        Buy 2, Get 2 Free + Free Gifts
        <span class="ewpl-topbar__sub">· 100-Day Risk-Free Home Trial</span>
      </div>
      <div class="ewpl-countdown">
        <div class="ewpl-countdown__box">
          <div class="ewpl-countdown__num" data-ewpl-cd="h">{{ cd_h }}</div>
          <div class="ewpl-countdown__label">HRS</div>
        </div>
        <div class="ewpl-countdown__sep" aria-hidden="true">:</div>
        <div class="ewpl-countdown__box">
          <div class="ewpl-countdown__num" data-ewpl-cd="m">{{ cd_m }}</div>
          <div class="ewpl-countdown__label">MIN</div>
        </div>
        <div class="ewpl-countdown__sep" aria-hidden="true">:</div>
        <div class="ewpl-countdown__box">
          <div class="ewpl-countdown__num" data-ewpl-cd="s">{{ cd_s }}</div>
          <div class="ewpl-countdown__label">SEC</div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ---------- 1. hero ---------- {%- endcomment -%}
  <section class="ewpl-hero" aria-labelledby="ewpl-hero-title">
    <div class="ewpl-wrap">
      <div class="ewpl-hero__grid">
        <div class="ewpl-hero__copy">
          <h1 class="ewpl-hero__title" id="ewpl-hero-title">How To Stop Crusty Eyes <span class="ewpl-accent">In 30 Seconds A Day</span> — Without Baby Wipes, Grooming, Or Home Remedies</h1>
          <p class="ewpl-hero__sub">A simple daily routine that removes the bacteria causing the problem — so the gunk stops coming back.</p>
          <div class="ewpl-hero__btns">
            <a class="ewpl-cta ewpl-btn-primary" href="{{ pdp_url }}" data-ewpl-pdp>See Why It Works ↓</a>
            <a class="ewpl-cta ewpl-btn-outline" href="{{ offer_anchor }}">Skip to offer ↓</a>
          </div>
          <div class="ewpl-rating"><span class="ewpl-stars" role="img" aria-label="Rated 4.8 out of 5">★★★★★</span>&nbsp; Rated 4.8/5 · 45,000+ Dog Owners</div>
        </div>
        <div class="ewpl-hero__media">
          <div class="ewpl-hero__fade" aria-hidden="true"></div>
          <img
            class="ewpl-hero__img"
            src="{{ 'ewpl-hero-before-after.webp' | asset_url }}"
            alt="A small white dog's eye area before and after the EyeWipes routine — crusty build-up on one side, clean bright fur on the other"
            width="1600"
            height="1197"
            fetchpriority="high"
            decoding="async">
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- marquee ---------- {%- endcomment -%}
  <div class="ewpl-marquee" aria-hidden="true">
    <div class="ewpl-marquee__track">
      {%- for half in (1..2) -%}
        <div class="ewpl-marquee__half">
          {%- for claim in marquee_claims -%}
            <span class="ewpl-marquee__item">
              <span>{{ claim }}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><ellipse cx="7" cy="8" rx="2.1" ry="2.7"/><ellipse cx="12" cy="6.4" rx="2.1" ry="2.7"/><ellipse cx="17" cy="8" rx="2.1" ry="2.7"/><path d="M12 11c3 0 5.2 2.4 5.2 4.7 0 1.9-1.6 2.9-3.3 2.6-.7-.1-1.3-.3-1.9-.3s-1.2.2-1.9.3c-1.7.3-3.3-.7-3.3-2.6C6.8 13.4 9 11 12 11Z"/></svg>
            </span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ---------- 2. mechanism badges ---------- {%- endcomment -%}
  <section class="ewpl-badges" aria-label="Why EyeWipes works">
    <div class="ewpl-badges__grid">
      <div class="ewpl-badge">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="#47B5E9" aria-hidden="true"><circle cx="5" cy="5" r="2.1"/><circle cx="12" cy="5" r="2.1"/><circle cx="19" cy="5" r="2.1"/><circle cx="5" cy="12" r="2.1"/><circle cx="12" cy="12" r="2.1"/><circle cx="19" cy="12" r="2.1"/><circle cx="5" cy="19" r="2.1"/><circle cx="12" cy="19" r="2.1"/><circle cx="19" cy="19" r="2.1"/></svg>
        <span>Textured Surface — Removes, Doesn't Spread</span>
      </div>
      <div class="ewpl-badge">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="#47B5E9" aria-hidden="true"><path d="M12 2.5C8.5 7 5.5 10.3 5.5 14a6.5 6.5 0 0 0 13 0c0-3.7-3-7-6.5-11.5Zm0 16.5a4 4 0 0 1-4-4c0-.4.06-.8.17-1.2A5.5 5.5 0 0 0 12 15.5c1.5 0 2.9-.6 3.9-1.6.07.35.1.72.1 1.1a4 4 0 0 1-4 4Z"/></svg>
        <span>Aloe + Chamomile Antibacterial Formula</span>
      </div>
      <div class="ewpl-badge">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" stroke="#47B5E9" stroke-width="2"/><circle cx="12" cy="12" r="3.2" fill="#47B5E9"/></svg>
        <span>No Stinging — Made For Sensitive Eyes</span>
      </div>
      <div class="ewpl-badge">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.2C9 7.1 6.6 9.9 6.6 13a5.4 5.4 0 0 0 10.8 0c0-3.1-2.4-5.9-5.4-9.8Z" stroke="#47B5E9" stroke-width="2"/><path d="M4 20.5 20 4.2" stroke="#47B5E9" stroke-width="2.4" stroke-linecap="round"/></svg>
        <span>No Rinsing, No Mixing — One Pass And Done</span>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- 3. proof on the wipe ---------- {%- endcomment -%}
  <section class="ewpl-proof" id="why-eye-care" aria-labelledby="ewpl-proof-title">
    <div class="ewpl-proof__inner">
      <div class="ewpl-eyebrow">See it for yourself</div>
      <h2 class="ewpl-h2" id="ewpl-proof-title">The proof is <span class="ewpl-accent">on the wipe</span></h2>
      <p class="ewpl-proof__lead">One pass around the eye area. Look at the wipe.</p>
      <div class="ewpl-proof__grid">
        {%- for i in (1..3) -%}
          {%- assign proof_asset = 'ewpl-proof-pad-' | append: i | append: '.webp' -%}
          <div class="ewpl-proof__tile">
            <img
              src="{{ proof_asset | asset_url }}"
              alt="A used EyeWipes pad, brown with the build-up lifted off a dog's eye area"
              width="700"
              height="700"
              loading="lazy"
              decoding="async">
          </div>
        {%- endfor -%}
      </div>
      <p class="ewpl-proof__body"><strong>That brown? That's what was sitting on your dog's skin.</strong> It's what baby wipes and home remedies just slide over — and what keeps the crust coming back.</p>
      <a class="ewpl-skip ewpl-skip--hero-gap" href="{{ offer_anchor }}">Skip to offer ↓</a>
    </div>
  </section>

  <div class="ewpl-wave" aria-hidden="true"><svg viewBox="0 0 1440 64" preserveAspectRatio="none" focusable="false"><path d="M0 40 C240 8 480 64 720 40 C960 16 1200 56 1440 28 L1440 64 L0 64 Z" fill="#D5F7FF"/></svg></div>

  {%- comment -%} ---------- 4. mechanism cards ---------- {%- endcomment -%}
