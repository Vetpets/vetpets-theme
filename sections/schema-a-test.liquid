{% schema %}
{
  "name": "EyeWipes offer page",
  "tag": "div",
  "class": "eyewipes-offer-page-section",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Add the Kaching Bundles app block to this section. Kaching stays the source of truth for tier, quantity, selling plan and free gifts \u2014 this section only restyles it."
    },
    {
      "type": "paragraph",
      "content": "This section auto-switches to the World Animal Week campaign design from 28 Sep through 4 Oct 2026 (store timezone) and back to the evergreen design outside that window \u2014 no separate page or URL. During the campaign the picker narrows to two tiers; the Multi-Pet Relief Plan deal stays configured in Kaching and reappears automatically once the campaign ends."
    },
    {
      "type": "header",
      "content": "Top bar \u2014 rotating announcement messages (evergreen only)"
    },
    {
      "type": "text",
      "id": "announce_msg1",
      "label": "Message 1",
      "default": "Buy 2, Get 2 Free"
    },
    {
      "type": "text",
      "id": "announce_msg2",
      "label": "Message 2",
      "default": "Free Shipping with RoutineCare"
    },
    {
      "type": "text",
      "id": "announce_msg3",
      "label": "Message 3",
      "default": "Free Gifts Included"
    },
    {
      "type": "header",
      "content": "Hero (evergreen only \u2014 the campaign headline is locked copy)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "End The Crusty Eyes In 30 Seconds A Day"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Textured antibacterial wipes for dogs with gunk, discharge & crusty eyes"
    },
    {
      "type": "text",
      "id": "picker_heading",
      "label": "Plan picker heading",
      "default": "Choose Your Plan"
    },
    {
      "type": "text",
      "id": "rc_note",
      "label": "RoutineCare note",
      "default": "Free shipping on every order"
    }
  ],
  "presets": [
    {
      "name": "EyeWipes offer page"
    }
  ]
}
{% endschema %}
