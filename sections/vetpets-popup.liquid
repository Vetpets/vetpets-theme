          <g transform="translate(7 13) rotate(-10) scale(1.93)"><path d="{{ paw }}"></path></g>
          <g transform="translate(84 34) rotate(-10) scale(1.22)"><path d="{{ paw }}"></path></g>
          <g transform="translate(39 84) rotate(-10) scale(1.56)"><path d="{{ paw }}"></path></g>
        </g>
      </pattern>
      <pattern id="vpp-mark-d-{{ uid }}" width="164" height="164" patternUnits="userSpaceOnUse">
        <g fill="{{ section.settings.color_mark }}" fill-opacity="0.15" fill-rule="evenodd">
          <g transform="translate(8 16) rotate(-10) scale(2.3)"><path d="{{ paw }}"></path></g>
          <g transform="translate(100 40) rotate(-10) scale(1.45)"><path d="{{ paw }}"></path></g>
          <g transform="translate(46 100) rotate(-10) scale(1.85)"><path d="{{ paw }}"></path></g>
        </g>
      </pattern>
    </defs>
