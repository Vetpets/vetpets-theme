                <div class="vpp-waw-countdown-tiles">
                  <div class="vpp-waw-cd-tile"><div class="vpp-waw-cd-num" data-vpp-cd="d">00</div><div class="vpp-waw-cd-lbl">DAYS</div></div>
                  <div class="vpp-waw-cd-tile"><div class="vpp-waw-cd-num" data-vpp-cd="h">00</div><div class="vpp-waw-cd-lbl">HRS</div></div>
                  <div class="vpp-waw-cd-tile"><div class="vpp-waw-cd-num" data-vpp-cd="m">00</div><div class="vpp-waw-cd-lbl">MIN</div></div>
