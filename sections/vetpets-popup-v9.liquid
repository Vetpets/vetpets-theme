      "type": "select",
      "id": "trigger",
      "label": "Trigger type",
      "options": [
        {
          "value": "delay",
          "label": "Time delay"
        },
        {
          "value": "scroll",
          "label": "Scroll depth"
        },
        {
          "value": "exit",
          "label": "Exit intent"
        }
      ],
      "default": "delay"
