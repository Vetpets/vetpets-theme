{%- comment -%}
  VetPets Welcome Popup — self-contained section.
  Ported from Claude Design project "VetPets Welcome Popup", artboards
  "Desktop · interactive" (1440 × 900) and "Mobile · interactive" (390 × 844).
  Rendered once, globally, from layout/theme.liquid immediately before </body>.
  All classes are prefixed .vpp- ; no global selectors.
{%- endcomment -%}

{%- if section.settings.enable -%}
{%- liquid
  assign vpp_blocked = false
  assign path = request.path
  if request.page_type == 'cart' or request.page_type == 'customers/login' or request.page_type == 'customers/register' or request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' or request.page_type == 'customers/reset_password' or request.page_type == 'customers/activate_account'
    assign vpp_blocked = true
  endif
  if path contains '/cart' or path contains '/checkout' or path contains '/account'
    assign vpp_blocked = true
  endif
-%}

{%- unless vpp_blocked -%}
{%- liquid
  assign uid = section.id
  assign paw = "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35zM10.4 6.4h3.2v2.9h2.9v3.2h-2.9v2.9h-3.2v-2.9H7.5V9.3h2.9z"
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">

<style>
  .vetpets-popup-section { margin: 0 !important; padding: 0 !important; }

  #vpp-{{ uid }}.vpp-root {
    --vpp-brand: {{ section.settings.color_brand }};
    --vpp-brand-hover: {{ section.settings.color_brand_hover }};
    --vpp-accent: {{ section.settings.color_accent }};
    --vpp-ink: {{ section.settings.color_ink }};
    --vpp-body: {{ section.settings.color_body }};
    --vpp-muted: {{ section.settings.color_muted }};
    --vpp-error: {{ section.settings.color_error }};
    --vpp-field-bg: {{ section.settings.color_field_bg }};
    --vpp-field-border: {{ section.settings.color_field_border }};
    --vpp-surface: {{ section.settings.color_surface }};
    --vpp-panel: {{ section.settings.color_panel }};
    --vpp-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  /* ---------- overlay: fixed, full-viewport, optically centred ---------- */
  #vpp-{{ uid }}.vpp-root {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: none;
    overflow-x: hidden;
    overflow-y: auto;
    background: linear-gradient(180deg, {{ section.settings.color_gradient_top }} 0%, {{ section.settings.color_gradient_mid }} 46%, {{ section.settings.color_gradient_bottom }} 100%);
    font-family: var(--vpp-font);
    -webkit-font-smoothing: antialiased;
  }
  #vpp-{{ uid }}.vpp-root.vpp-open {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: vpp-fade .28s ease both;
  }

  @keyframes vpp-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes vpp-fade-up { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* ---------- tiled VetPets mark: above the gradient, below all content ---------- */
  #vpp-{{ uid }} .vpp-tile {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    display: block;
  }
  #vpp-{{ uid }} .vpp-tile-desktop { display: none; }

  #vpp-{{ uid }} .vpp-close {
    position: absolute; top: 18px; right: 18px; z-index: 6;
    width: 44px; height: 44px; border-radius: 999px; border: none; padding: 0;
    background: rgba(0,0,0,.06); color: var(--vpp-body);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
  }
  #vpp-{{ uid }} .vpp-close:hover { background: rgba(0,0,0,.11); }

  /* ---------- centred content wrapper; photo cards anchor to THIS ---------- */
  #vpp-{{ uid }} .vpp-wrap {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1400px;
    min-width: 0;
    margin: auto;
    padding: 24px 25px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #vpp-{{ uid }} .vpp-photo { display: none; border-radius: 16px; object-fit: cover; object-position: center; }

  #vpp-{{ uid }} .vpp-col {
    display: flex; flex-direction: column; align-items: center;
    text-align: center; width: 100%; min-width: 0; max-width: 100%;
  }

  #vpp-{{ uid }} .vpp-logo { height: 28px; width: auto; display: block; margin-bottom: 18px; }
  #vpp-{{ uid }} .vpp-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--vpp-brand); margin-bottom: 12px; }
  #vpp-{{ uid }} .vpp-title { margin: 0; font-size: 40px; font-weight: 800; line-height: 1; letter-spacing: -.035em; color: var(--vpp-ink); }
  #vpp-{{ uid }} .vpp-sub { margin: 14px 0 0; font-size: 16px; font-weight: 500; line-height: 1.45; color: var(--vpp-body); max-width: 310px; text-wrap: pretty; }

  #vpp-{{ uid }} .vpp-stack { margin-top: 26px; display: flex; flex-direction: column; align-items: center; gap: 14px; width: 100%; min-width: 0; }

  /* ---------- scratch card: blue panel outside, photo + canvas inside -------- */
  #vpp-{{ uid }} .vpp-panel {
    width: 100%; max-width: 100%; box-sizing: border-box;
    background: var(--vpp-panel);
    border-radius: 24px; padding: 12px;
    box-shadow: 0 22px 44px -16px rgba(0,40,70,.28);
  }
  /* The inner card is 128:85 - the scratch photo's exact ratio - so nothing is
     cropped at any width. The canvas fills it, so scratch coordinates map to
     the photo and to nothing around it. */
  #vpp-{{ uid }} .vpp-card {
    position: relative; display: flex;
    width: 100%; max-width: 100%; aspect-ratio: 128 / 85;
    border-radius: 16px; overflow: hidden;
    background: var(--vpp-surface);
  }
  #vpp-{{ uid }} .vpp-canvas {
    position: absolute; inset: 0; z-index: 2; display: block;
    width: 100%; height: 100%; touch-action: none; cursor: grab;
  }
  #vpp-{{ uid }} .vpp-pill {
    position: absolute; left: 50%; bottom: 20px; transform: translateX(-50%); z-index: 3;
    pointer-events: none; display: flex; align-items: center; gap: 10px;
    height: 40px; padding: 0 18px; border-radius: 100px;
    background: rgba(0,0,0,.28); color: #FFFFFF; font-size: 15px; font-weight: 700;
    white-space: nowrap; transition: opacity .2s ease;
  }

  /* Pre-reveal the steps are taken out of flow so the card keeps the photo's
     aspect ratio exactly; after the reveal the card grows to fit the form. */
  #vpp-{{ uid }} .vpp-step {
    position: absolute; inset: 0;
    flex: 1; min-width: 0; box-sizing: border-box;
    display: flex; flex-direction: column; align-items: center;
    padding: 10px 18px; overflow-y: auto;
    animation: vpp-fade-up .3s ease both;
  }
  #vpp-{{ uid }} .vpp-card.vpp-revealed { aspect-ratio: auto; }
  #vpp-{{ uid }} .vpp-card.vpp-revealed .vpp-step {
    position: relative; inset: auto; overflow-y: visible;
  }
  #vpp-{{ uid }} .vpp-step[data-vpp-step="sms"] { padding: 20px; justify-content: center; }
  #vpp-{{ uid }} .vpp-step[data-vpp-step="done"] { padding: 20px; justify-content: center; }

  #vpp-{{ uid }} .vpp-check { width: 36px; height: 36px; border-radius: 999px; background: var(--vpp-accent); display: flex; align-items: center; justify-content: center; flex: none; }
  #vpp-{{ uid }} .vpp-step[data-vpp-step="done"] .vpp-check { width: 40px; height: 40px; }
  #vpp-{{ uid }} .vpp-kicker { margin-top: 8px; font-size: 13px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--vpp-brand); }
  #vpp-{{ uid }} .vpp-offer { margin-top: 2px; font-size: 32px; font-weight: 800; line-height: 1.05; letter-spacing: -.03em; color: var(--vpp-ink); }
  #vpp-{{ uid }} .vpp-ask { margin-top: 4px; font-size: 15px; font-weight: 500; color: var(--vpp-body); }

  #vpp-{{ uid }} .vpp-input {
    margin-top: 8px; width: 100%; height: 48px; box-sizing: border-box; border-radius: 12px;
    background: var(--vpp-field-bg); border: 1.5px solid var(--vpp-field-border);
    padding: 0 14px; font-size: 15px; font-weight: 500; color: var(--vpp-body);
    outline: none; font-family: var(--vpp-font);
  }
  #vpp-{{ uid }} .vpp-input::placeholder { color: {{ section.settings.color_placeholder }}; }
  #vpp-{{ uid }} .vpp-input:focus { box-shadow: 0 0 0 3px rgba(71,181,233,.14); }
  #vpp-{{ uid }} .vpp-input.vpp-invalid { border-color: var(--vpp-error); }

  #vpp-{{ uid }} .vpp-error { align-self: flex-start; margin-top: 6px; font-size: 13px; font-weight: 600; color: var(--vpp-error); text-align: left; }

  #vpp-{{ uid }} .vpp-submit {
    margin-top: 6px; width: 100%; height: 48px; border-radius: 12px; border: none;
    background: var(--vpp-brand); color: #FFFFFF; font-size: 15px; font-weight: 800;
    letter-spacing: .04em; text-transform: uppercase; cursor: pointer; font-family: var(--vpp-font);
  }
  #vpp-{{ uid }} .vpp-submit:hover { background: var(--vpp-brand-hover); }
  #vpp-{{ uid }} .vpp-submit[disabled] { opacity: .65; cursor: default; }

  #vpp-{{ uid }} .vpp-fine { margin-top: 8px; font-size: 12px; font-weight: 500; line-height: 1.4; color: var(--vpp-muted); text-align: center; }
  #vpp-{{ uid }} .vpp-consent { margin-top: 10px; font-size: 12px; font-weight: 400; line-height: 1.5; color: var(--vpp-muted); text-align: center; text-wrap: pretty; }

  #vpp-{{ uid }} .vpp-sms-title { margin-top: 10px; font-size: 22px; font-weight: 800; line-height: 1.15; letter-spacing: -.02em; color: var(--vpp-ink); text-align: center; }
  #vpp-{{ uid }} .vpp-sms-sub {
    margin-top: 8px; max-width: 300px; font-size: 15px; font-weight: 500;
    line-height: 1.4; color: var(--vpp-muted); text-align: center; text-wrap: pretty;
  }
  #vpp-{{ uid }} .vpp-tel {
    margin-top: 14px; width: 100%; display: flex; align-items: center; height: 48px;
    border-radius: 12px; background: var(--vpp-field-bg); border: 1.5px solid var(--vpp-field-border);
    box-sizing: border-box; overflow: hidden;
  }
  #vpp-{{ uid }} .vpp-tel.vpp-invalid { border-color: var(--vpp-error); }
  #vpp-{{ uid }} .vpp-prefix {
    position: relative; display: flex; align-items: center; height: 100%; flex: none;
    font-size: 15px; font-weight: 700; color: var(--vpp-body);
    background: {{ section.settings.color_prefix_bg }}; border-right: 1.5px solid var(--vpp-field-border);
  }
  #vpp-{{ uid }} .vpp-prefix-select {
    appearance: none; -webkit-appearance: none; -moz-appearance: none;
    height: 100%; box-sizing: border-box; padding: 0 28px 0 14px; margin: 0;
    border: none; border-radius: 0; background: transparent;
    font-family: var(--vpp-font); font-size: 15px; font-weight: 700; line-height: normal;
    color: var(--vpp-body); cursor: pointer; outline: none;
  }
  #vpp-{{ uid }} .vpp-prefix-select:focus-visible { box-shadow: inset 0 0 0 2px var(--vpp-brand); }
  #vpp-{{ uid }} .vpp-prefix-chev {
    position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
    pointer-events: none; color: var(--vpp-muted);
  }
  #vpp-{{ uid }} .vpp-tel input {
    flex: 1; min-width: 0; height: 100%; border: none; background: transparent; padding: 0 12px;
    font-size: 15px; font-weight: 500; color: var(--vpp-body); outline: none; font-family: var(--vpp-font);
  }
  #vpp-{{ uid }} .vpp-tel input::placeholder { color: {{ section.settings.color_placeholder }}; }

  #vpp-{{ uid }} .vpp-skip {
    margin-top: 10px; background: none; border: none; padding: 10px 12px;
    font-size: 16px; font-weight: 600; color: var(--vpp-brand); text-decoration: underline;
    cursor: pointer; font-family: var(--vpp-font);
  }

  #vpp-{{ uid }} .vpp-done-title { margin-top: 12px; font-size: 20px; font-weight: 800; letter-spacing: -.02em; color: var(--vpp-ink); text-align: center; }
  #vpp-{{ uid }} .vpp-done-sub {
    margin-top: 8px; font-size: 15px; font-weight: 500; line-height: 1.4;
    color: var(--vpp-body); text-align: center; text-wrap: pretty;
  }
  #vpp-{{ uid }} .vpp-code {
    margin-top: 12px; width: 100%; height: 48px; border-radius: 12px;
    background: var(--vpp-field-bg); border: 1.5px dashed var(--vpp-brand);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; font-weight: 800; letter-spacing: .14em; color: var(--vpp-ink);
  }
  #vpp-{{ uid }} .vpp-code-note { margin-top: 10px; font-size: 14px; font-weight: 500; color: var(--vpp-body); text-align: center; }

  #vpp-{{ uid }} .vpp-decline {
    background: none; border: none; padding: 8px 12px; font-size: 15px; font-weight: 500;
    color: var(--vpp-muted); text-decoration: underline; cursor: pointer; white-space: nowrap;
    font-family: var(--vpp-font);
  }
  #vpp-{{ uid }} .vpp-decline:hover { color: var(--vpp-body); }

  #vpp-{{ uid }} [hidden] { display: none !important; }

  /* ---------- desktop: 1240px wrapper, photos anchored to the wrapper ---------- */
  @media (min-width: 1280px) {
    #vpp-{{ uid }} .vpp-tile-mobile { display: none; }
    #vpp-{{ uid }} .vpp-tile-desktop { display: block; }

    #vpp-{{ uid }} .vpp-close { top: 26px; right: 26px; }

    #vpp-{{ uid }} .vpp-wrap { display: block; padding: 24px 0; }
    #vpp-{{ uid }} .vpp-col { width: 42%; }

    #vpp-{{ uid }} .vpp-logo { height: 34px; margin-bottom: 22px; }
    #vpp-{{ uid }} .vpp-eyebrow { font-size: 12px; margin-bottom: 14px; }
    #vpp-{{ uid }} .vpp-title { font-size: 54px; }
    #vpp-{{ uid }} .vpp-sub { margin-top: 16px; font-size: 17px; line-height: 1.5; max-width: 400px; }

    #vpp-{{ uid }} .vpp-stack { margin-top: 34px; gap: 18px; }

    #vpp-{{ uid }} .vpp-panel { width: auto; padding: 14px; }
    #vpp-{{ uid }} .vpp-card { width: 560px; max-width: 100%; }
    #vpp-{{ uid }} .vpp-pill { bottom: 22px; }

    #vpp-{{ uid }} .vpp-step { padding: 14px 24px; }
    #vpp-{{ uid }} .vpp-step[data-vpp-step="sms"],
    #vpp-{{ uid }} .vpp-step[data-vpp-step="done"] { padding: 24px; }

    #vpp-{{ uid }} .vpp-check,
    #vpp-{{ uid }} .vpp-step[data-vpp-step="done"] .vpp-check { width: 44px; height: 44px; }
    #vpp-{{ uid }} .vpp-kicker { margin-top: 12px; }
    #vpp-{{ uid }} .vpp-offer { margin-top: 4px; font-size: 46px; line-height: 1; }
    #vpp-{{ uid }} .vpp-ask { margin-top: 8px; }
    #vpp-{{ uid }} .vpp-input { margin-top: 12px; height: 54px; padding: 0 16px; }
    #vpp-{{ uid }} .vpp-submit { margin-top: 10px; height: 54px; }
    #vpp-{{ uid }} .vpp-sms-title { font-size: 24px; }
    #vpp-{{ uid }} .vpp-tel { margin-top: 18px; height: 54px; }
    #vpp-{{ uid }} .vpp-tel input { padding: 0 14px; }
    #vpp-{{ uid }} .vpp-skip { margin-top: 14px; }
    #vpp-{{ uid }} .vpp-done-title { margin-top: 16px; font-size: 24px; }
    #vpp-{{ uid }} .vpp-code { margin-top: 16px; height: 54px; font-size: 20px; }
    #vpp-{{ uid }} .vpp-code-note { font-size: 15px; margin-top: 12px; }

    /* Photo cards keep the artboard's arrangement, offset from the wrapper's
       vertical centre rather than from a fixed 900px frame. */
    /* Percentages of the wrapper, so the composition fills it exactly and stays
       centred at any width from the 1280px breakpoint up to the 1400px cap. */
    #vpp-{{ uid }} .vpp-photo { display: block; position: absolute; height: auto; }
    #vpp-{{ uid }} .vpp-photo--a {
      left: 49.69%; width: 30.14%; aspect-ratio: 422 / 527;
      top: 50%; transform: translateY(-72%);
      box-shadow: 0 28px 54px -22px rgba(0,0,0,.30);
    }
    #vpp-{{ uid }} .vpp-photo--b {
      left: 69.87%; width: 30.14%; aspect-ratio: 422 / 447;
      top: 50%; transform: translateY(-18.5%);
      box-shadow: 0 32px 60px -22px rgba(0,0,0,.32);
    }
  }

  /* Short viewports: drop the floating cards rather than clip them. */
  @media (min-width: 1280px) and (max-height: 779px) {
    #vpp-{{ uid }} .vpp-photo { display: none; }
    #vpp-{{ uid }} .vpp-col { margin: 0 auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    #vpp-{{ uid }}.vpp-root.vpp-open,
    #vpp-{{ uid }} .vpp-step { animation: none; }
    #vpp-{{ uid }} .vpp-pill { transition: none; }
  }
</style>

<div id="vpp-{{ uid }}" class="vpp-root" data-vpp-root role="dialog" aria-modal="true" aria-label="{{ section.settings.text_title | escape }}" aria-hidden="true">

  <svg class="vpp-tile" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="vpp-mark-m-{{ uid }}" width="138" height="138" patternUnits="userSpaceOnUse">
        <g fill="{{ section.settings.color_mark }}" fill-opacity="0.15" fill-rule="evenodd">
          <g transform="translate(7 13) rotate(-10) scale(1.93)"><path d="{{ paw }}"></path></g>
          <g transform="translate(84 34) rotate(-10) scale(1.22)"><path d="{{ paw }}"></path></g>
          <g transform="translate(39 84) rotate(-10) scale(1.56)"><path d="{{ paw }}"></path></g>
        </g>
      </pattern>
      <pattern id="vpp-mark-d-{{ uid }}" width="164" height="164" patternUnits="userSpaceOnUse">
        <g fill="{{ section.settings.color_mark }}" fill-opacity="0.15" fill-rule="evenodd">
          <g transform="translate(8 16) rotate(-10) scale(2.3)"><path d="{{ paw }}"></path></g>
          <g transform="translate(100 40) rotate(-10) scale(1.45)"><path d="{{ paw }}"></path></g>
          <g transform="translate(46 100) rotate(-10) scale(1.85)"><path d="{{ paw }}"></path></g>
        </g>
      </pattern>
    </defs>
    <rect class="vpp-tile-mobile" width="100%" height="100%" fill="url(#vpp-mark-m-{{ uid }})"></rect>
    <rect class="vpp-tile-desktop" width="100%" height="100%" fill="url(#vpp-mark-d-{{ uid }})"></rect>
  </svg>

  <button type="button" class="vpp-close" data-vpp-close aria-label="{{ section.settings.text_close_label | escape }}">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
  </button>

  <div class="vpp-wrap" data-vpp-wrap>
    {%- if section.settings.photo_primary != blank -%}
      {{ section.settings.photo_primary | image_url: width: 800 | image_tag: class: 'vpp-photo vpp-photo--a', widths: '400, 600, 800', sizes: '400px', loading: 'lazy', alt: section.settings.photo_primary_alt }}
    {%- endif -%}
    {%- if section.settings.photo_secondary != blank -%}
      {{ section.settings.photo_secondary | image_url: width: 800 | image_tag: class: 'vpp-photo vpp-photo--b', widths: '400, 600, 800', sizes: '400px', loading: 'lazy', alt: section.settings.photo_secondary_alt }}
    {%- endif -%}

    <div class="vpp-col">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'vpp-logo', widths: '200, 300, 400', sizes: '170px', loading: 'lazy', alt: shop.name }}
      {%- endif -%}

      <div class="vpp-eyebrow">{{ section.settings.text_eyebrow }}</div>
      <h1 class="vpp-title">{{ section.settings.text_title }}</h1>
      <p class="vpp-sub">{{ section.settings.text_subtitle }}</p>

      <div class="vpp-stack">
        <div class="vpp-panel">
        <div class="vpp-card">

          <div class="vpp-step" data-vpp-step="email">
            <div class="vpp-check">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
            </div>
            <div class="vpp-kicker">{{ section.settings.text_unlocked }}</div>
            <div class="vpp-offer">{{ section.settings.text_offer }}</div>
            <div class="vpp-ask">{{ section.settings.text_email_ask }}</div>
            <input class="vpp-input" data-vpp-email type="email" inputmode="email" autocomplete="email" aria-label="{{ section.settings.text_email_ask | escape }}" placeholder="{{ section.settings.text_email_placeholder | escape }}">
            <div class="vpp-error" data-vpp-email-error hidden role="alert"></div>
            <button type="button" class="vpp-submit" data-vpp-email-submit>{{ section.settings.text_claim_button }}</button>
            <div class="vpp-fine">{{ section.settings.text_email_fine_print }}</div>
          </div>

          {%- if section.settings.enable_sms_step -%}
          <div class="vpp-step" data-vpp-step="sms" hidden>
            {%- if section.settings.text_sms_kicker != blank -%}
              <div class="vpp-kicker" style="margin-top:0">{{ section.settings.text_sms_kicker }}</div>
            {%- endif -%}
            <div class="vpp-sms-title"{% if section.settings.text_sms_kicker == blank %} style="margin-top:0"{% endif %}>{{ section.settings.text_sms_title }}</div>
            {%- if section.settings.text_sms_subtitle != blank -%}
              <div class="vpp-sms-sub">{{ section.settings.text_sms_subtitle }}</div>
            {%- endif -%}
            <div class="vpp-tel" data-vpp-tel-wrap>
              {%- assign vpp_countries = 'US|+1|🇺🇸,CA|+1|🇨🇦,GB|+44|🇬🇧,IE|+353|🇮🇪,AU|+61|🇦🇺,NZ|+64|🇳🇿,SE|+46|🇸🇪,NO|+47|🇳🇴,DK|+45|🇩🇰,FI|+358|🇫🇮,IS|+354|🇮🇸,DE|+49|🇩🇪,NL|+31|🇳🇱,BE|+32|🇧🇪,FR|+33|🇫🇷,ES|+34|🇪🇸,IT|+39|🇮🇹,AT|+43|🇦🇹,CH|+41|🇨🇭,PT|+351|🇵🇹,PL|+48|🇵🇱,CZ|+420|🇨🇿,JP|+81|🇯🇵,SG|+65|🇸🇬' | split: ',' -%}
              <span class="vpp-prefix">
                <select class="vpp-prefix-select" data-vpp-country aria-label="{{ section.settings.text_sms_country_label | escape }}">
                  {%- for c in vpp_countries -%}
                    {%- assign cp = c | split: '|' -%}
                    <option value="{{ cp[1] }}"{% if section.settings.sms_default_country == cp[0] %} selected{% endif %}>{{ cp[2] }} {{ cp[1] }}</option>
                  {%- endfor -%}
                </select>
                <svg class="vpp-prefix-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
              </span>
              <input data-vpp-phone type="tel" inputmode="tel" autocomplete="tel-national" aria-label="{{ section.settings.text_sms_title | escape }}" placeholder="{{ section.settings.text_sms_placeholder | escape }}">
            </div>
            <div class="vpp-error" data-vpp-sms-error hidden role="alert"></div>
            <button type="button" class="vpp-submit" data-vpp-sms-submit>{{ section.settings.text_sms_button }}</button>
            <button type="button" class="vpp-skip" data-vpp-sms-skip>{{ section.settings.text_sms_skip }}</button>
            <div class="vpp-consent">{{ section.settings.text_sms_consent }}</div>
          </div>
          {%- endif -%}

          <div class="vpp-step" data-vpp-step="done" hidden>
            <div class="vpp-check">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
            </div>
            <div class="vpp-done-title">{{ section.settings.text_done_title }}</div>
            {%- if section.settings.text_done_subtitle != blank -%}
              <div class="vpp-done-sub">{{ section.settings.text_done_subtitle }}</div>
            {%- endif -%}
            <div class="vpp-code">{{ section.settings.discount_code }}</div>
            <div class="vpp-code-note">{{ section.settings.text_done_note }}</div>
          </div>

          <canvas class="vpp-canvas" data-vpp-canvas width="460" height="320" role="img" aria-label="{{ section.settings.text_scratch_pill | escape }}"></canvas>
          <div class="vpp-pill" data-vpp-pill>
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><g fill="#FFFFFF" transform="translate(12 12) rotate(-11)"><rect x="-9.4" y="-12" width="3.4" height="11" rx="1.7"></rect><rect x="-4.7" y="-12" width="3.4" height="13.5" rx="1.7"></rect><rect x="0" y="-12" width="3.4" height="12.5" rx="1.7"></rect><rect x="4.7" y="-12" width="3.4" height="10.5" rx="1.7"></rect><rect x="-9.8" y="-2.5" width="19.5" height="13" rx="5.5"></rect></g></svg>
            <span>{{ section.settings.text_scratch_pill }}</span>
          </div>
        </div>
        </div>

        <button type="button" class="vpp-decline" data-vpp-close>{{ section.settings.text_decline }}</button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" data-vpp-config="{{ uid }}">
{
  "scratchImage": {{ section.settings.scratch_image | image_url: width: 920 | json }},
  "trigger": {{ section.settings.trigger | json }},
  "delaySeconds": {{ section.settings.delay_seconds | json }},
  "scrollPercent": {{ section.settings.scroll_percent | json }},
  "hideDays": {{ section.settings.hide_days | json }},
  "storageKey": {{ section.settings.storage_key | json }},
  "companyId": {{ section.settings.klaviyo_company_id | json }},
  "emailListId": {{ section.settings.klaviyo_email_list_id | json }},
  "smsListId": {{ section.settings.klaviyo_sms_list_id | json }},
  "smsEnabled": {{ section.settings.enable_sms_step | json }},
  "errEmail": {{ section.settings.text_error_email | json }},
  "errPhone": {{ section.settings.text_error_phone | json }},
  "errGeneric": {{ section.settings.text_error_generic | json }}
}
</script>

<script>
(function () {
  var root = document.getElementById('vpp-{{ uid }}');
  if (!root || root.dataset.vppReady === '1') return;
  root.dataset.vppReady = '1';

  var cfgEl = document.querySelector('script[data-vpp-config="{{ uid }}"]');
  var cfg;
  try { cfg = JSON.parse(cfgEl.textContent); } catch (e) { return; }

  var designMode = !!(window.Shopify && window.Shopify.designMode);
  var q = function (sel) { return root.querySelector(sel); };
  var qa = function (sel) { return Array.prototype.slice.call(root.querySelectorAll(sel)); };

  var wrap = q('[data-vpp-wrap]');
  var card = q('.vpp-card');
  var canvas = q('[data-vpp-canvas]');
  var pill = q('[data-vpp-pill]');
  var emailInput = q('[data-vpp-email]');
  var emailError = q('[data-vpp-email-error]');
  var emailSubmit = q('[data-vpp-email-submit]');
  var phoneInput = q('[data-vpp-phone]');
  var telWrap = q('[data-vpp-tel-wrap]');
  var countrySelect = q('[data-vpp-country]');
  var smsError = q('[data-vpp-sms-error]');
  var smsSubmit = q('[data-vpp-sms-submit]');
  var smsSkip = q('[data-vpp-sms-skip]');

  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var isOpen = false;
  var scrollY = 0;
  var scratchedOnce = false;

  function track(event, props) {
    if (!window.klaviyo || typeof window.klaviyo.push !== 'function') return;
    try { window.klaviyo.push(['track', event, props || {}]); } catch (e) {}
  }

  function gateKey() { return cfg.storageKey || 'vetpets_welcome_popup'; }
  function suppressed() {
    if (designMode) return false;
    try {
      var raw = window.localStorage.getItem(gateKey());
      if (!raw) return false;
      var until = parseInt(raw, 10);
      if (!until || isNaN(until)) return true;
      if (Date.now() > until) { window.localStorage.removeItem(gateKey()); return false; }
      return true;
    } catch (e) { return false; }
  }
  function suppress() {
    if (designMode) return;
    try {
      var days = parseInt(cfg.hideDays, 10);
      if (isNaN(days) || days < 0) days = 7;
      window.localStorage.setItem(gateKey(), String(Date.now() + days * 86400000));
    } catch (e) {}
  }

  function open() {
    if (isOpen) return;
    isOpen = true;
    scrollY = window.scrollY || window.pageYOffset || 0;
    root.classList.add('vpp-open');
    root.setAttribute('aria-hidden', 'false');
    document.body.style.top = '-' + scrollY + 'px';
    document.body.style.position = 'fixed';
    document.body.style.width = '100%';
    document.body.style.overflow = 'hidden';
    paintScratch();
    track('Popup Viewed');
    var focusable = q('[data-vpp-close]');
    if (focusable) { try { focusable.focus({ preventScroll: true }); } catch (e) {} }
  }

  function close() {
    if (!isOpen) return;
    isOpen = false;
    root.classList.remove('vpp-open');
    root.setAttribute('aria-hidden', 'true');
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    document.body.style.overflow = '';
    window.scrollTo(0, scrollY);
    suppress();
  }

  qa('[data-vpp-close]').forEach(function (btn) { btn.addEventListener('click', close); });

  document.addEventListener('keydown', function (e) {
    if (!isOpen) return;
    if (e.key === 'Escape' || e.key === 'Esc') { e.preventDefault(); close(); }
  });

  /* Scrim click: a click on the overlay background, outside the content wrapper. */
  root.addEventListener('click', function (e) {
    if (e.target === root || (e.target.classList && e.target.classList.contains('vpp-tile'))) close();
  });

  /* ---------- scratch canvas ---------- */
  var COLS = 40, ROWS = 28, BRUSH = 56;
  var cells = {}, marked = 0, lastPt = null, dragging = false, finished = false;
  var bellyImg = null, bellyReady = false, painted = false;

  function loadBelly() {
    if (bellyImg || !cfg.scratchImage) { if (!cfg.scratchImage) reveal(true); return; }
    bellyImg = new Image();
    bellyImg.crossOrigin = 'anonymous';
    bellyImg.src = cfg.scratchImage;
    bellyImg.decode().then(function () {
      bellyReady = true;
      if (isOpen) paintScratch();
    }).catch(function () {
      bellyReady = false;
      reveal(true);
    });
  }

  function paintScratch() {
    if (!canvas || !bellyReady || !bellyImg || painted || finished) return;
    var ctx = canvas.getContext('2d');
    var rect = canvas.getBoundingClientRect();
    if (rect.width) { canvas.width = Math.round(rect.width); canvas.height = Math.round(rect.height); }
    var w = canvas.width, h = canvas.height;
    ctx.globalCompositeOperation = 'source-over';
    ctx.clearRect(0, 0, w, h);
    var s = Math.max(w / bellyImg.width, h / bellyImg.height);
    var dw = bellyImg.width * s, dh = bellyImg.height * s;
    ctx.drawImage(bellyImg, (w - dw) / 2, (h - dh) / 2, dw, dh);
    cells = {};
    marked = 0;
    lastPt = null;
    dragging = false;
    painted = true;
    canvas.style.opacity = '1';
    canvas.style.display = 'block';
    canvas.style.pointerEvents = 'auto';
    if (pill) pill.style.opacity = '1';
  }

  function ptFor(e) {
    var r = canvas.getBoundingClientRect();
    return {
      x: (e.clientX - r.left) * (canvas.width / r.width),
      y: (e.clientY - r.top) * (canvas.height / r.height)
    };
  }

  function mark(px, py) {
    var cw = canvas.width / COLS, ch = canvas.height / ROWS, rad = BRUSH / 2;
    var c0 = Math.max(0, Math.floor((px - rad) / cw)), c1 = Math.min(COLS - 1, Math.floor((px + rad) / cw));
    var r0 = Math.max(0, Math.floor((py - rad) / ch)), r1 = Math.min(ROWS - 1, Math.floor((py + rad) / ch));
    for (var ci = c0; ci <= c1; ci++) {
      for (var ri = r0; ri <= r1; ri++) {
        var dx = (ci + 0.5) * cw - px, dy = (ri + 0.5) * ch - py;
        if (dx * dx + dy * dy <= rad * rad) {
          var key = ci + ':' + ri;
          if (!cells[key]) { cells[key] = 1; marked++; }
        }
      }
    }
  }

  function erase(e) {
    if (!canvas || finished || !painted) return;
    var ctx = canvas.getContext('2d');
    var p = ptFor(e), l = lastPt || p;
    ctx.globalCompositeOperation = 'destination-out';
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.lineWidth = BRUSH;
    ctx.strokeStyle = 'rgba(0,0,0,1)';
    ctx.beginPath();
    ctx.moveTo(l.x, l.y);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
    var dist = Math.hypot(p.x - l.x, p.y - l.y), steps = Math.max(1, Math.ceil(dist / 6));
    for (var i = 0; i <= steps; i++) mark(l.x + (p.x - l.x) * (i / steps), l.y + (p.y - l.y) * (i / steps));
    lastPt = p;
    if (marked / (COLS * ROWS) >= 0.5) reveal(false);
  }

  function reveal(immediate) {
    if (finished) return;
    finished = true;
    dragging = false;
    var settle = function () {
      if (card) card.classList.add('vpp-revealed');
      if (canvas) canvas.style.display = 'none';
      if (pill) pill.style.display = 'none';
      if (emailInput) { try { emailInput.focus({ preventScroll: true }); } catch (e) {} }
    };
    if (!canvas || immediate || reduced) { settle(); return; }
    canvas.style.pointerEvents = 'none';
    canvas.style.transition = 'opacity .4s ease';
    canvas.style.opacity = '0';
    if (pill) pill.style.opacity = '0';
    window.setTimeout(settle, 430);
  }

  if (canvas) {
    canvas.addEventListener('pointerdown', function (e) {
      if (finished || !painted) return;
      dragging = true;
      try { e.currentTarget.setPointerCapture(e.pointerId); } catch (err) {}
      lastPt = null;
      if (pill) pill.style.opacity = '0';
      if (!scratchedOnce) { scratchedOnce = true; track('Popup Scratched'); }
      erase(e);
    });
    canvas.addEventListener('pointermove', function (e) { if (dragging) erase(e); });
    canvas.addEventListener('pointerup', function () { dragging = false; lastPt = null; });
    canvas.addEventListener('pointercancel', function () { dragging = false; lastPt = null; });
  }

  /* Keep the canvas at the card's real pixel size, and redraw, so the scratch
     coordinates stay aligned when the card resizes. */
  function refitCanvas() {
    if (!canvas || finished) return;
    var rect = canvas.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    var w = Math.round(rect.width), h = Math.round(rect.height);
    if (w === canvas.width && h === canvas.height) return;
    painted = false;
    paintScratch();
  }
  if (window.ResizeObserver && card) {
    new window.ResizeObserver(function () { refitCanvas(); }).observe(card);
  } else {
    var resizeTimer = null;
    window.addEventListener('resize', function () {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(refitCanvas, 150);
    });
  }

  /* ---------- Klaviyo ---------- */
  /* /client/subscriptions/ takes identifiers only - it derives consent from the
     list and from which identifier fields the profile carries. A "subscriptions"
     object is server-side-API only and is rejected here with a 400. */
  function subscribe(payloadProfile) {
    var listId = payloadProfile.channel === 'sms' ? cfg.smsListId : cfg.emailListId;
    var body = {
      data: {
        type: 'subscription',
        attributes: {
          custom_source: 'Website Popup',
          profile: { data: { type: 'profile', attributes: payloadProfile.attributes } }
        },
        relationships: { list: { data: { type: 'list', id: listId } } }
      }
    };
    return fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(cfg.companyId), {
      method: 'POST',
      headers: { 'content-type': 'application/json', revision: '2024-10-15' },
      body: JSON.stringify(body)
    }).then(function (res) {
      if (res.status !== 202) throw new Error('Klaviyo responded ' + res.status);
      return true;
    });
  }

  function showError(el, wrap, msg) {
    if (el) { el.textContent = msg; el.hidden = false; }
    if (wrap) wrap.classList.add('vpp-invalid');
  }
  function clearError(el, wrap) {
    if (el) { el.textContent = ''; el.hidden = true; }
    if (wrap) wrap.classList.remove('vpp-invalid');
  }

  function goStep(name) {
    qa('[data-vpp-step]').forEach(function (s) { s.hidden = s.getAttribute('data-vpp-step') !== name; });
  }

  if (emailSubmit) {
    emailSubmit.addEventListener('click', function () {
      var val = (emailInput.value || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(val)) {
        showError(emailError, emailInput, cfg.errEmail);
        emailInput.focus();
        return;
      }
      clearError(emailError, emailInput);
      emailSubmit.disabled = true;
      subscribe({
        channel: 'email',
        attributes: { email: val }
      }).then(function () {
        track('Popup Submitted', { channel: 'email' });
        suppress();
        goStep(cfg.smsEnabled ? 'sms' : 'done');
        if (cfg.smsEnabled && phoneInput) { try { phoneInput.focus({ preventScroll: true }); } catch (e) {} }
      }).catch(function () {
        showError(emailError, emailInput, cfg.errGeneric);
      }).then(function () {
        emailSubmit.disabled = false;
      });
    });
  }

  if (smsSubmit) {
    smsSubmit.addEventListener('click', function () {
      /* Digits only, 6-14, behind the selected dial code. A leading zero is
         passed through as typed - some countries need it, some do not, and
         guessing wrong is worse than sending what the visitor entered. */
      var digits = (phoneInput.value || '').replace(/\D/g, '');
      if (digits.length < 6 || digits.length > 14) {
        showError(smsError, telWrap, cfg.errPhone);
        phoneInput.focus();
        return;
      }
      clearError(smsError, telWrap);
      smsSubmit.disabled = true;
      var dial = ((countrySelect && countrySelect.value) || '+1').replace(/[^\d+]/g, '');
      var e164 = dial + digits;
      subscribe({
        channel: 'sms',
        attributes: {
          email: (emailInput.value || '').trim(),
          phone_number: e164
        }
      }).then(function () {
        track('Popup Submitted', { channel: 'sms' });
        goStep('done');
      }).catch(function () {
        showError(smsError, telWrap, cfg.errGeneric);
      }).then(function () {
        smsSubmit.disabled = false;
      });
    });
  }

  if (smsSkip) smsSkip.addEventListener('click', function () { goStep('done'); });

  /* ---------- triggers ---------- */
  function arm() {
    if (suppressed()) return;
    loadBelly();

    if (designMode) { open(); return; }

    var trigger = cfg.trigger || 'delay';

    if (trigger === 'scroll') {
      var onScroll = function () {
        var doc = document.documentElement;
        var max = (doc.scrollHeight - window.innerHeight) || 1;
        var pct = ((window.scrollY || window.pageYOffset || 0) / max) * 100;
        if (pct >= (parseFloat(cfg.scrollPercent) || 40)) {
          window.removeEventListener('scroll', onScroll);
          open();
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      return;
    }

    if (trigger === 'exit') {
      var onLeave = function (e) {
        if (e.clientY > 0) return;
        document.removeEventListener('mouseout', onLeave);
        open();
      };
      document.addEventListener('mouseout', onLeave);
      window.setTimeout(function () {
        if (!isOpen && window.matchMedia('(hover: none)').matches) {
          document.removeEventListener('mouseout', onLeave);
          open();
        }
      }, (parseFloat(cfg.delaySeconds) || 8) * 1000);
      return;
    }

    window.setTimeout(function () { open(); }, (parseFloat(cfg.delaySeconds) || 8) * 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', arm);
  } else {
    arm();
  }
})();
</script>
{%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "VetPets Welcome Popup",
  "tag": "section",
  "class": "vetpets-popup-section",
  "settings": [
    {
      "type": "checkbox",
