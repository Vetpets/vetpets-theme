{%- comment -%}
  EyeWipes lander
  ===============
  Shopify implementation of the founder-approved Claude Design page
  "EyeWipes Listicle - 3 remedies v2" (project "EyeWipes reference page and assets").
  Composition, copy, images and interactions are the design's own; per-element
  styles are kept inline exactly as the design has them, the design's <helmet>
  CSS lives in assets/eyewipes-lander.css and its component logic in
  assets/eyewipes-lander.js.

  Rendered only through templates/product.eyewipes-lander.json, an alternate view
  of the existing EyeWipes product:
    /products/eyewipes-prevention-that-keeps-eyes-clear?view=eyewipes-lander
  The default PDP, the offer page (?view=eyewipes-offer-page) and the pre-lander
  are untouched.

  COMMERCE OWNERSHIP
  ------------------
  Kaching Bundles is the source of truth for the deal, quantity, price, selling
  plan and free gifts. Its real app block is rendered inside `.ewld-kaching`
  (kept in the DOM, not painted). The approved picker drives Kaching's own
  controls — clicking a bundle selects that Kaching deal bar, the Routine Care
  checkbox toggles Kaching's own subscription checkbox — and every price shown
  in the picker is read back from Kaching's rendered bar, never typed here.
  Kaching then rewrites the add-to-cart request (bundle quantity, selling plan,
  gift lines), exactly as on the offer page.

  The bundle names, badges and gift rows are the approved design's. The JS checks
  them against the gifts Kaching actually renders for each bar; if Kaching serves a
  different gift set (e.g. another A/B variant of the deal block), that tier's gift
  badge and list fall back to Kaching's own gift rows so the page never claims a
  gift the cart will not contain.

  There is exactly ONE add-to-cart pathway: the theme's <product-form> in
  `.ewld-form-host`, whose submit button is the offer CTA. The theme's cart drawer
  opens as on every other product page.

  Everything is scoped under #eyewipes-lander.
{%- endcomment -%}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign product_form_id = 'ewld-product-form-' | append: section.id

  assign img_b1 = 'ewld-bundle-b1g1.webp' | asset_url
  assign img_b2 = 'ewld-bundle-b2g2.webp' | asset_url
  assign img_tick = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="#FFFFFF" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>'
  assign tick_badge = '<span style="width:16px;height:16px;border-radius:50%;background:#13B6B5;display:flex;align-items:center;justify-content:center;flex-shrink:0">' | append: img_tick | append: '</span>'
  assign tp_star = '<span style="width:20px;height:20px;background:#00B67A;display:flex;align-items:center;justify-content:center"><svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><path fill="#FFFFFF" d="M12 1.5l2.6 7.9H23l-6.8 4.9 2.6 7.9L12 17.3l-6.8 4.9 2.6-7.9L1 9.4h8.4z"></path></svg></span>'
  assign tp_stars = tp_star | append: tp_star | append: tp_star | append: tp_star | append: tp_star
  assign big_check = '<span style="width:22px;height:22px;border-radius:50%;background:#13B6B5;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>'
  assign payoff_check = '<span style="width:24px;height:24px;border-radius:50%;background:#13B6B5;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>'
  assign cta_style = 'display:flex;align-items:center;justify-content:center;width:100%;max-width:460px;min-height:56px;box-sizing:border-box;background:#47B5E9;color:#FFFFFF;font-size:16px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;padding:0 22px;border-radius:999px;box-shadow:0 10px 24px rgba(71,181,233,.42)'
  assign skip_style = 'display:flex;align-items:center;min-height:44px;padding:0 12px;font-size:14px;font-weight:700;color:#2E9FD8;text-decoration:underline;text-underline-offset:3px'
  assign guarantee_line = 'Healthy clear eyes OR your money back'

  # Low-stock bar (approved design). On by default: Shopify's inventory count for EyeWipes
  # is not the real warehouse stock (inventory policy "continue"), and the founder confirms
  # stock is low. Alternatively it can switch itself on from a tracked-inventory threshold.
  assign show_low_stock = section.settings.show_low_stock
  assign low_threshold = section.settings.low_stock_threshold | default: 0
  if v.inventory_management == 'shopify' and low_threshold > 0 and v.inventory_quantity > 0 and v.inventory_quantity <= low_threshold
    assign show_low_stock = true
  endif
-%}

