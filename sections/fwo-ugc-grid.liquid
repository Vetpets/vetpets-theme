{{ 'freshwipes-offer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st = section.settings
-%}

<div class="fwo fwo-ugc">
  <div class="fwo__inner fwo__section">
    {%- if st.heading != blank -%}
      <h2 class="fwo__heading" style="text-align: center;">{{ st.heading | escape }}</h2>
    {%- endif -%}

    {%- if st.rating_line != blank -%}
      <p class="fwo-ugc__rating">{{ st.rating_line | escape }}</p>
    {%- endif -%}

    {%- if st.subtext != blank -%}
      <p class="fwo-ugc__sub">{{ st.subtext | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="fwo-ugc__grid">
        {%- for block in section.blocks -%}
          <div class="fwo-ugc__item" {{ block.shopify_attributes }}>
            {%- render 'fwo-image',
              image: block.settings.image,
              url: block.settings.image_url,
              width: block.settings.image_width,
              height: block.settings.image_height,
              alt: block.settings.image_alt,
              aspect: '3 / 4',
              sizes: '(min-width: 750px) 30vw, 50vw',
              placeholder: 'Customer image'
            -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FWO UGC grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thousands of dog owners finally found a routine they can trust."
    },
    {
      "type": "text",
      "id": "rating_line",
      "label": "Rating line",
      "default": "Rated 4.86/5"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Used daily by 45,000+ dog owners who wanted an easier way to prevent plaque and gum disease."
    }
  ],
  "blocks": [
    {
      "type": "ugc_image",
      "name": "Customer image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL fallback",
          "info": "Used only when no image is picked above."
        },
        {
          "type": "number",
          "id": "image_width",
          "label": "Image URL width (px)"
        },
        {
          "type": "number",
          "id": "image_height",
          "label": "Image URL height (px)"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FWO UGC grid",
      "blocks": [
        { "type": "ugc_image" },
        { "type": "ugc_image" },
        { "type": "ugc_image" },
        { "type": "ugc_image" },
        { "type": "ugc_image" },
        { "type": "ugc_image" }
      ]
    }
  ]
}
{% endschema %}
