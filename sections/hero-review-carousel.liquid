{%- comment -%}
  Hero review carousel
  --------------------
  Left column: star badge pill, H1, subtext, CTA.
  Right side (>= 900px): four vertical image columns scrolling in an infinite
  loop, every other column running the opposite direction at a slightly
  different speed. Below 900px the columns are hidden and the same images run
  as a horizontal marquee under the text.

  The loop works by duplicating each column's item list and animating the
  track by exactly -50%. The item spacing is a margin-bottom (not a flex gap)
  so half the track height is exactly one full copy - a flex gap would leave
  half a gap unaccounted for and the loop would visibly jump.

  Every font size is an exact px setting with a separate mobile value; the
  mobile values are the base rules and the desktop ones live in the 900px
  media query, i.e. the type scale switches with the layout.

  Headline, subtext and button can each run a 90deg gradient instead of their
  solid colour. Text gradients only kick in inside @supports so a browser
  without background-clip: text keeps the solid colour rather than rendering
  invisible text.

  All classes are prefixed vp-hrc- so nothing collides with existing CSS.
{%- endcomment -%}

{%- liquid
  assign st = section.settings

  assign speed = st.scroll_speed | default: 45
  assign dur_1 = speed | times: 100 | divided_by: 100.0
  assign dur_2 = speed | times: 82 | divided_by: 100.0
  assign dur_3 = speed | times: 116 | divided_by: 100.0
  assign dur_4 = speed | times: 93 | divided_by: 100.0
  assign dur_marquee = speed | times: 90 | divided_by: 100.0

  assign image_blocks = section.blocks | where: 'type', 'image'
  assign has_images = false
  for block in image_blocks
    if block.settings.image != blank
      assign has_images = true
      break
    endif
  endfor

  comment
    Number settings come back nil when the merchant clears the field, so every
    size falls back to its documented default. 0 is truthy in Liquid, so an
    intentional 0 still survives the default filter.
  endcomment
  assign badge_fs = st.badge_text_size | default: 14
  assign badge_fs_m = st.badge_text_size_mobile | default: 13
  assign heading_fs = st.heading_size | default: 56
  assign heading_fs_m = st.heading_size_mobile | default: 34
  assign subtext_fs = st.subtext_size | default: 18
  assign subtext_fs_m = st.subtext_size_mobile | default: 16
  assign button_fs = st.button_text_size | default: 18
  assign button_fs_m = st.button_text_size_mobile | default: 16
  assign guarantee_fs = st.guarantee_text_size | default: 15
  assign guarantee_fs_m = st.guarantee_text_size_mobile | default: 14
  assign guarantee_weight = st.guarantee_weight | default: '600'

  assign heading_class = 'vp-hrc__heading'
  if st.heading_gradient
    assign heading_class = 'vp-hrc__heading vp-hrc__heading--grad'
  endif

  assign subtext_class = 'vp-hrc__subtext'
  if st.subtext_gradient
    assign subtext_class = 'vp-hrc__subtext vp-hrc__subtext--grad'
  endif

  assign cta_class = 'vp-hrc__cta'
  if st.button_gradient
    assign cta_class = 'vp-hrc__cta vp-hrc__cta--grad'
  endif

  comment
    Width comes from the theme's own .page-width class rather than a value of
    our own, so this section lines up with the header and every other Shrine
    section: max-width: var(--page-width) (140rem = 1400px with the theme's
    62.5% root font size) and padding 0 1.5rem below 750px, 0 5rem above.
    Full width adds the theme's .page-width--full (max-width: none) and keeps
    that padding; Custom overrides --page-width locally on this element only,
    which changes the max-width and nothing else.
  endcomment
  assign width_mode = st.section_width | default: 'page'
  assign inner_class = 'vp-hrc__inner page-width'
  if width_mode == 'full'
    assign inner_class = 'vp-hrc__inner page-width page-width--full'
  endif
  assign custom_max_width = st.custom_max_width | default: 1200
-%}

{%- capture star_icon -%}
  <svg class="vp-hrc__star" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.5l2.47 5.2 5.53.79-4 4.02.95 5.72L10 14.53 5.05 17.23l.95-5.72-4-4.02 5.53-.79L10 1.5z"/></svg>
{%- endcapture -%}

{%- comment -%}
  Guarantee icon. Filled = solid shape in the icon colour with a white
  checkmark knocked out of it; outline = stroked shape in the icon colour.
  The white check is hardcoded because it sits on top of the merchant's icon
  colour, not on the section background.
{%- endcomment -%}
{%- capture guarantee_icon -%}
  {%- if st.guarantee_icon_style == 'outline' -%}
    {%- case st.guarantee_icon -%}
      {%- when 'shield' -%}
        <svg class="vp-hrc__guarantee-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2.5l7.5 3v5.6c0 4.6-3.1 8.4-7.5 10.4-4.4-2-7.5-5.8-7.5-10.4V5.5l7.5-3z"/><path d="M8.7 11.8l2.3 2.3 4.3-4.6"/></svg>
      {%- when 'heart' -%}
        <svg class="vp-hrc__guarantee-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      {%- else -%}
        <svg class="vp-hrc__guarantee-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.2"/><path d="M7.8 12.3l2.9 2.9 5.5-6.1"/></svg>
    {%- endcase -%}
  {%- else -%}
    {%- case st.guarantee_icon -%}
      {%- when 'shield' -%}
        <svg class="vp-hrc__guarantee-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 2.3l7.7 3.1v5.7c0 4.8-3.2 8.7-7.7 10.7-4.5-2-7.7-5.9-7.7-10.7V5.4L12 2.3z" fill="currentColor"/><path d="M8.5 11.7l2.4 2.4 4.6-5" stroke="#ffffff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {%- when 'heart' -%}
        <svg class="vp-hrc__guarantee-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" fill="currentColor"/><path d="M9 10.6l2.3 2.3 4.4-4.7" stroke="#ffffff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {%- else -%}
        <svg class="vp-hrc__guarantee-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M7.6 12.3l3 3 5.8-6.4" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {%- endcase -%}
  {%- endif -%}
{%- endcapture -%}

<div
  class="vp-hrc"
  data-vp-hrc="{{ section.id }}"
  style="
    --vp-hrc-bg: {{ st.bg_color }};
    --vp-hrc-heading: {{ st.heading_color }};
    --vp-hrc-text: {{ st.text_color }};
    --vp-hrc-badge-bg: {{ st.badge_bg }};
    --vp-hrc-badge-text: {{ st.badge_text_color }};
    --vp-hrc-star: {{ st.star_color }};
    --vp-hrc-btn-bg: {{ st.button_bg }};
    --vp-hrc-btn-text: {{ st.button_text_color }};
    --vp-hrc-head-g1: {{ st.heading_gradient_start }};
    --vp-hrc-head-g2: {{ st.heading_gradient_end }};
    --vp-hrc-sub-g1: {{ st.subtext_gradient_start }};
    --vp-hrc-sub-g2: {{ st.subtext_gradient_end }};
    --vp-hrc-btn-g1: {{ st.button_gradient_start }};
    --vp-hrc-btn-g2: {{ st.button_gradient_end }};
    --vp-hrc-guar-icon: {{ st.guarantee_icon_color }};
    --vp-hrc-guar-text: {{ st.guarantee_text_color }};
    --vp-hrc-badge-fs: {{ badge_fs }}px;
    --vp-hrc-badge-fs-m: {{ badge_fs_m }}px;
    --vp-hrc-head-fs: {{ heading_fs }}px;
    --vp-hrc-head-fs-m: {{ heading_fs_m }}px;
    --vp-hrc-sub-fs: {{ subtext_fs }}px;
    --vp-hrc-sub-fs-m: {{ subtext_fs_m }}px;
    --vp-hrc-btn-fs: {{ button_fs }}px;
    --vp-hrc-btn-fs-m: {{ button_fs_m }}px;
    --vp-hrc-guar-fs: {{ guarantee_fs }}px;
    --vp-hrc-guar-fs-m: {{ guarantee_fs_m }}px;
    --vp-hrc-guar-weight: {{ guarantee_weight }};
    --vp-hrc-wall-h: {{ st.wall_height }}px;
    --vp-hrc-d1: {{ dur_1 }}s;
    --vp-hrc-d2: {{ dur_2 }}s;
    --vp-hrc-d3: {{ dur_3 }}s;
    --vp-hrc-d4: {{ dur_4 }}s;
    --vp-hrc-dm: {{ dur_marquee }}s;
    --vp-hrc-pad-top: {{ st.padding_top }}px;
    --vp-hrc-pad-bottom: {{ st.padding_bottom }}px;
  "
>
  <div
    class="{{ inner_class }}"
    {% if width_mode == 'custom' %}
      style="--page-width: {{ custom_max_width }}px;"
    {% endif %}
  >
    <div class="vp-hrc__content">
      {%- if st.badge_text != blank -%}
        <p class="vp-hrc__badge">
          {%- if st.show_stars -%}
            <span class="vp-hrc__stars" aria-hidden="true">
              {{ star_icon }}{{ star_icon }}{{ star_icon }}{{ star_icon }}{{ star_icon }}
            </span>
          {%- endif -%}
          <span class="vp-hrc__badge-text">{{ st.badge_text | escape }}</span>
        </p>
      {%- endif -%}

      {%- if st.heading != blank -%}
        <h1 class="{{ heading_class }}">{{ st.heading | escape }}</h1>
      {%- endif -%}

      {%- if st.subtext != blank -%}
        <div class="{{ subtext_class }}">{{ st.subtext }}</div>
      {%- endif -%}

      {%- if st.button_label != blank -%}
        <a
          class="{{ cta_class }}"
          {% if st.button_link != blank %}href="{{ st.button_link }}"{% else %}href="#" aria-disabled="true"{% endif %}
        >
          {{- st.button_label | escape -}}
        </a>
      {%- endif -%}

      {%- if st.show_guarantee and st.guarantee_text != blank -%}
        <p class="vp-hrc__guarantee">
          <span class="vp-hrc__guarantee-icon">{{ guarantee_icon }}</span>
          <span class="vp-hrc__guarantee-text">{{ st.guarantee_text | escape }}</span>
        </p>
      {%- endif -%}

      {%- comment -%} Mobile marquee: same images, horizontal, decorative. {%- endcomment -%}
      {%- capture marquee_items -%}
        {%- if has_images -%}
          {%- for block in image_blocks -%}
            {%- if block.settings.image != blank -%}
              <div class="vp-hrc__item vp-hrc__item--m">
                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', widths: '160,240,320,400', sizes: '38vw', class: 'vp-hrc__img', alt: ''
                }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..8) -%}
            <div class="vp-hrc__item vp-hrc__item--m">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'vp-hrc__img vp-hrc__img--placeholder' }}
            </div>
          {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}

      <div class="vp-hrc__marquee" aria-hidden="true">
        <div class="vp-hrc__marquee-track">
          {{ marquee_items }}{{ marquee_items }}
        </div>
      </div>
    </div>

    <div class="vp-hrc__wall" aria-hidden="true">
      {%- for col in (0..3) -%}
        {%- capture col_items -%}
          {%- if has_images -%}
            {%- assign position = 0 -%}
            {%- for block in image_blocks -%}
              {%- if block.settings.image == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign slot = position | modulo: 4 -%}
              {%- assign position = position | plus: 1 -%}
              {%- if slot != col -%}
                {%- continue -%}
              {%- endif -%}
              <div class="vp-hrc__item">
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '200,300,400,600', sizes: '(min-width: 1200px) 14vw, 20vw', class: 'vp-hrc__img', alt: ''
                }}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..3) -%}
              <div class="vp-hrc__item">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'vp-hrc__img vp-hrc__img--placeholder' }}
              </div>
            {%- endfor -%}
          {%- endif -%}
        {%- endcapture -%}

        {%- assign col_check = col_items | strip -%}
        {%- if col_check != blank -%}
          <div class="vp-hrc__col vp-hrc__col--{{ col | plus: 1 }}">
            <div class="vp-hrc__track">
              {{ col_items }}{{ col_items }}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  /* Vertical padding only: the horizontal padding is the theme's .page-width
     padding on the inner container, so the content lines up with the header
     and the sections below. */
  .vp-hrc {
    background-color: var(--vp-hrc-bg, #d5f7ff);
    padding-block: var(--vp-hrc-pad-top, 48px) var(--vp-hrc-pad-bottom, 48px);
    overflow: hidden;
    font-family: var(--font-body-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
    font-weight: 400;
  }

  /* max-width, margin and horizontal padding all come from .page-width. */
  .vp-hrc__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .vp-hrc__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  /* ---------- badge ---------- */

  .vp-hrc__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 20px;
    padding: 8px 16px;
    border-radius: 999px;
    background-color: var(--vp-hrc-badge-bg, #ffffff);
    color: var(--vp-hrc-badge-text, #10232b);
    font-size: var(--vp-hrc-badge-fs-m, 13px);
    font-weight: 600;
    line-height: 1.2;
  }

  .vp-hrc__stars {
    display: inline-flex;
    color: var(--vp-hrc-star, #ffb800);
  }

  .vp-hrc__star {
    display: block;
  }

  .vp-hrc__star + .vp-hrc__star {
    margin-left: 1px;
  }

  /* ---------- copy ---------- */

  .vp-hrc__heading {
    margin: 0;
    font-family: var(--font-heading-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
    font-weight: 700;
    font-size: var(--vp-hrc-head-fs-m, 34px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--vp-hrc-heading, #10232b);
    text-wrap: balance;
  }

  .vp-hrc__subtext {
    margin: 16px 0 0;
    max-width: 46ch;
    font-size: var(--vp-hrc-sub-fs-m, 16px);
    line-height: 1.6;
    color: var(--vp-hrc-text, #2c4650);
  }

  .vp-hrc__subtext > *:first-child {
    margin-top: 0;
  }

  .vp-hrc__subtext > *:last-child {
    margin-bottom: 0;
  }

  /* ---------- text gradients ----------
     The solid colour above stays as the fallback: only inside @supports do we
     paint a gradient and knock the glyph fill out to transparent, so a browser
     without background-clip: text never renders invisible text. */

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .vp-hrc__heading--grad,
    .vp-hrc__subtext--grad {
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }

    .vp-hrc__heading--grad {
      background-image: linear-gradient(90deg, var(--vp-hrc-head-g1, #47b5e9), var(--vp-hrc-head-g2, #13b6b5));
    }

    .vp-hrc__subtext--grad {
      background-image: linear-gradient(90deg, var(--vp-hrc-sub-g1, #47b5e9), var(--vp-hrc-sub-g2, #13b6b5));
    }

    /* Richtext can contain <strong>, <em> or links - let the container's
       gradient show through them instead of their own colour. */
    .vp-hrc__subtext--grad * {
      color: inherit;
      -webkit-text-fill-color: inherit;
    }
  }

  .vp-hrc__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
    padding: 16px 36px;
    border-radius: 999px;
    background-color: var(--vp-hrc-btn-bg, #47b5e9);
    color: var(--vp-hrc-btn-text, #ffffff);
    font-size: var(--vp-hrc-btn-fs-m, 16px);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
  }

  /* The solid background-color stays underneath as the fallback layer. */
  .vp-hrc__cta--grad {
    background-image: linear-gradient(90deg, var(--vp-hrc-btn-g1, #47b5e9), var(--vp-hrc-btn-g2, #13b6b5));
  }

  /* brightness() darkens the painted result, so one rule covers both the
     solid and the gradient button. */
  .vp-hrc__cta:hover {
    transform: translateY(-2px);
    filter: brightness(0.93);
    box-shadow: 0 8px 20px rgba(16, 35, 43, 0.18);
    text-decoration: none;
  }

  .vp-hrc__cta:active {
    transform: translateY(0);
    filter: brightness(0.88);
  }

  .vp-hrc__cta:focus-visible {
    outline: 2px solid var(--vp-hrc-heading, #10232b);
    outline-offset: 3px;
  }

  /* ---------- guarantee row ---------- */

  /* The row is a flex item of .vp-hrc__content (align-items: flex-start), so
     its left edge is the column's left edge - exactly where the CTA starts.
     Alignment is declared once here and never overridden per breakpoint; only
     the font size changes on desktop. */
  .vp-hrc__guarantee {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 8px;
    width: 100%;
    margin: 12px 0 0;
    padding: 0;
    font-size: var(--vp-hrc-guar-fs-m, 14px);
    font-weight: var(--vp-hrc-guar-weight, 600);
    line-height: 1.3;
    text-align: left;
    color: var(--vp-hrc-guar-text, #2c4650);
  }

  .vp-hrc__guarantee-icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--vp-hrc-guar-icon, #13b6b5);
  }

  /* Nudged down so the icon centres on the first line rather than on the
     whole block once the text wraps. */
  .vp-hrc__guarantee-svg {
    display: block;
    width: 1.25em;
    height: 1.25em;
    margin-top: 0.02em;
  }

  /* ---------- shared image styling ---------- */

  .vp-hrc__item {
    overflow: hidden;
    border-radius: 10px;
    line-height: 0;
  }

  .vp-hrc__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
  }

  .vp-hrc__img--placeholder {
    height: auto;
    aspect-ratio: 4 / 5;
    background-color: rgba(16, 35, 43, 0.06);
    fill: rgba(16, 35, 43, 0.22);
  }

  .vp-hrc__item--m .vp-hrc__img--placeholder {
    height: 100%;
    aspect-ratio: auto;
  }

  /* ---------- desktop wall ---------- */

  .vp-hrc__wall {
    display: none;
  }

  .vp-hrc__col {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: var(--vp-hrc-wall-h, 380px);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 10%, #000 90%, transparent 100%);
  }

  .vp-hrc__track {
    display: flex;
    flex-direction: column;
    will-change: transform;
    animation-name: vp-hrc-up;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-duration: var(--vp-hrc-d1, 45s);
  }

  .vp-hrc__track > .vp-hrc__item {
    margin-bottom: 14px;
  }

  .vp-hrc__col--1 .vp-hrc__track { animation-duration: var(--vp-hrc-d1, 45s); }
  .vp-hrc__col--2 .vp-hrc__track { animation-duration: var(--vp-hrc-d2, 37s); animation-name: vp-hrc-down; }
  .vp-hrc__col--3 .vp-hrc__track { animation-duration: var(--vp-hrc-d3, 52s); }
  .vp-hrc__col--4 .vp-hrc__track { animation-duration: var(--vp-hrc-d4, 42s); animation-name: vp-hrc-down; }

  @keyframes vp-hrc-up {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  @keyframes vp-hrc-down {
    from { transform: translateY(-50%); }
    to { transform: translateY(0); }
  }

  /* ---------- mobile marquee ---------- */

  /* Full-bleed without knowing the container's padding: centre a 100vw box on
     the (centred) content column. The old -20px margin assumed the section's
     own 20px padding, which now belongs to .page-width. */
  .vp-hrc__marquee {
    width: 100vw;
    margin: 32px 0 0 50%;
    transform: translateX(-50%);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  .vp-hrc__marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: vp-hrc-left var(--vp-hrc-dm, 40s) linear infinite;
  }

  .vp-hrc__item--m {
    flex: 0 0 auto;
    width: 38vw;
    max-width: 190px;
    height: 46vw;
    max-height: 230px;
    margin-right: 12px;
  }

  @keyframes vp-hrc-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ---------- desktop layout ---------- */

  @media screen and (min-width: 900px) {
    .vp-hrc__inner {
      flex-direction: row;
      align-items: center;
      gap: 48px;
    }

    .vp-hrc__content {
      flex: 1 1 45%;
      max-width: 560px;
    }

    /* Desktop type scale. Mobile values are the base rules above, so this is
       the only place the desktop sizes apply - the switch happens at the same
       breakpoint as the layout. */
    .vp-hrc__badge {
      font-size: var(--vp-hrc-badge-fs, 14px);
    }

    .vp-hrc__heading {
      font-size: var(--vp-hrc-head-fs, 56px);
    }

    .vp-hrc__subtext {
      font-size: var(--vp-hrc-sub-fs, 18px);
    }

    .vp-hrc__cta {
      font-size: var(--vp-hrc-btn-fs, 18px);
    }

    .vp-hrc__guarantee {
      font-size: var(--vp-hrc-guar-fs, 15px);
    }

    .vp-hrc__marquee {
      display: none;
    }

    .vp-hrc__wall {
      display: flex;
      flex: 1 1 55%;
      min-width: 0;
      gap: 14px;
    }
  }

  /* ---------- pausing ---------- */

  .vp-hrc--paused .vp-hrc__track,
  .vp-hrc--paused .vp-hrc__marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .vp-hrc__track,
    .vp-hrc__marquee-track {
      animation-play-state: paused;
    }

    .vp-hrc__cta {
      transition: none;
    }

    .vp-hrc__cta:hover {
      transform: none;
    }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.querySelector('[data-vp-hrc="{{ section.id }}"]');
    if (!root || !('IntersectionObserver' in window)) return;

    // Keep the loops from burning frames while the hero is off screen.
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          root.classList.toggle('vp-hrc--paused', !entry.isIntersecting);
        });
      },
      { rootMargin: '150px' }
    );

    observer.observe(root);

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') observer.disconnect();
    });
  })();
</script>

