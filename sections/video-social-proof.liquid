{%- comment -%}
  Video social proof
  ------------------
  Two-column social-proof unit: an editable copy column on the left (heading,
  supporting copy, stat rows and a highlight card) and a horizontal carousel of
  tall 9:16 UGC video cards on the right. On mobile the columns stack and the
  carousel keeps a partially visible next card so the swipe affordance reads
  without an instruction label.

  CLAIMS
  ------
  This section ships with neutral placeholders only ("00%", "Add a verified
  fact"). It states no rating, result or quote of its own - every number and
  line of copy is merchant-entered in the theme editor. Nothing here should
  ever be filled with a figure that is not independently verified.

  CAROUSEL
  --------
  CSS scroll-snap, not a transform track. The offer pages already use snap
  rails (assets/*-offer-page.css .rail/.slide), it gives native iOS momentum
  and, unlike the review-slider/product-cards-carousel engine, it needs no
  cloned slides - cloning would duplicate every <video> element, breaking the
  single-playback rule and multiplying network cost. Arrows call scrollTo and
  the dots derive from scrollLeft, so there is one source of truth.

  VIDEO LOADING
  -------------
  Nothing downloads on page load. Each <video> is preload="none" with a poster
  and its real URL parked in data-src on the <source>; the source is only
  promoted to src on the first play, then load() is called once. So the initial
  page cost is five poster images, not five videos.

  PLAYBACK RULES
  --------------
  One at a time - a capturing 'play' listener pauses every other video in the
  section (play does not bubble, hence capture). An IntersectionObserver pauses
  any card that leaves the viewport. Under prefers-reduced-motion the carousel
  scrolls without smooth behaviour; playback is always user-initiated, so there
  is no autoplay to suppress.

  All classes are prefixed vp-vsp- and the root is found by
  data-vp-vsp="{{ section.id }}" so multiple instances never collide.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign stats = section.blocks | where: 'type', 'stat'
  assign stats_cap = st.stats_visible | default: 3 | times: 1
  assign cards = section.blocks | where: 'type', 'video_card'

  assign width_mode = st.section_width | default: 'page'
  assign inner_class = 'vp-vsp__inner page-width'
  if width_mode == 'full'
    assign inner_class = 'vp-vsp__inner page-width page-width--full'
  endif
  assign custom_max_width = st.custom_max_width | default: 1200

  comment
    Full width leaves no gutter for the arrows to sit in, so they move inside
    the rail there. Without this they hang 20px past the viewport and raise a
    horizontal scrollbar on the whole page.
  endcomment
  assign root_class = 'vp-vsp'
  if width_mode == 'full'
    assign root_class = 'vp-vsp vp-vsp--full'
  endif

  comment
    Number settings come back nil when the field is cleared, so each one falls
    back to its documented default. 0 is truthy in Liquid, so a deliberate 0
    still survives the default filter.
  endcomment
  assign heading_fs = st.heading_size | default: 40
  assign heading_fs_m = st.heading_size_mobile | default: 26
  assign body_fs = st.body_size | default: 16
  assign stat_fs = st.stat_size | default: 38
  assign stat_fs_m = st.stat_size_mobile | default: 30
  assign card_radius = st.card_radius | default: 20
  assign card_gap = st.card_gap | default: 16
  assign peek_m = st.peek_mobile | default: 18
  assign per_view_d = st.per_view_desktop | default: 2.2
  assign stat_gap = st.stat_gap | default: 18
  assign num_col = st.stat_number_col | default: 104
  assign copy_align = st.copy_align | default: 'center'

  assign cta_flex = 'flex-start'
  if st.cta_align == 'center'
    assign cta_flex = 'center'
  elsif st.cta_align == 'right'
    assign cta_flex = 'flex-end'
  endif

  if st.hide_copy_column
    assign root_class = root_class | append: ' vp-vsp--nocopy'
  endif
-%}

<div
  class="{{ root_class }}"
  data-vp-vsp="{{ section.id }}"
  style="
    --vp-vsp-bg: {{ st.bg_color }};
    --vp-vsp-accent: {{ st.accent_color }};
    --vp-vsp-heading: {{ st.heading_color }};
    --vp-vsp-head-fs: {{ heading_fs }}px;
    --vp-vsp-head-fs-m: {{ heading_fs_m }}px;
    --vp-vsp-body: {{ st.body_color }};
    --vp-vsp-body-fs: {{ body_fs }}px;
    --vp-vsp-stat-color: {{ st.stat_color }};
    --vp-vsp-stat-fs: {{ stat_fs }}px;
    --vp-vsp-stat-fs-m: {{ stat_fs_m }}px;
    --vp-vsp-stat-gap: {{ stat_gap }}px;
    --vp-vsp-num-col: {{ num_col }}px;
    --vp-vsp-copy-align: {{ copy_align }};
    --vp-vsp-card-radius: {{ card_radius }}px;
    --vp-vsp-gap: {{ card_gap }}px;
    --vp-vsp-peek-m: {{ peek_m }}%;
    --vp-vsp-pv-d: {{ per_view_d }};
    --vp-vsp-pad-top: {{ st.padding_top | default: 64 }}px;
    --vp-vsp-pad-bottom: {{ st.padding_bottom | default: 64 }}px;
    --vp-vsp-pad-top-m: {{ st.padding_top_mobile | default: 40 }}px;
    --vp-vsp-pad-bottom-m: {{ st.padding_bottom_mobile | default: 40 }}px;
    {% if width_mode == 'custom' %}--page-width: {{ custom_max_width }}px;{% endif %}
  "
>
  <div class="{{ inner_class }}">
    <div class="vp-vsp__grid">

      {%- unless st.hide_copy_column -%}
      <div class="vp-vsp__copy">
        {%- if st.heading != blank -%}
          <h2 class="vp-vsp__heading">{{ st.heading | escape }}</h2>
        {%- endif -%}

        {%- if st.subheading != blank -%}
          <div class="vp-vsp__sub">{{ st.subheading }}</div>
        {%- endif -%}

        {%- if stats.size > 0 -%}
          <ul class="vp-vsp__stats" role="list">
            {%- for block in stats limit: stats_cap -%}
              {%- liquid
                assign bs = block.settings
                assign shape = bs.num_shape | default: 'circle'

                comment
                  Shape "none" and the background toggle both have to be on for
                  a badge to draw, so either control alone can turn it off.
                endcomment
                assign has_bg = false
                if bs.num_bg_show and shape != 'none'
                  assign has_bg = true
                endif

                assign row_classes = 'vp-vsp__stat vp-vsp__stat--shape-' | append: shape
                if has_bg
                  assign row_classes = row_classes | append: ' vp-vsp__stat--hasbg'
                endif
                if bs.row_border != blank
                  assign row_classes = row_classes | append: ' vp-vsp__stat--bordered'
                endif

                assign render_row = false
                if bs.show_stat
                  if bs.value != blank or bs.text != blank
                    assign render_row = true
                  endif
                endif
              -%}
              {%- if render_row -%}
                <li
                  class="{{ row_classes }}"
                  style="
                    --vsp-s-num-color: {{ bs.num_color }};
                    --vsp-s-num-fs: {{ bs.num_size | default: 38 }}px;
                    --vsp-s-num-bg: {{ bs.num_bg_color }};
                    {% if bs.row_bg != blank %}--vsp-s-row-bg: {{ bs.row_bg }};{% endif %}
                    {% if bs.row_border != blank %}--vsp-s-row-border: {{ bs.row_border }};{% endif %}
                    --vsp-s-row-radius: {{ bs.row_radius | default: 0 }}px;
                    --vsp-s-row-pad: {{ bs.row_padding | default: 0 }}px;
                  "
                  {{ block.shopify_attributes }}
                >
                  {%- if bs.value != blank -%}
                    <span class="vp-vsp__stat-value">{{ bs.value | escape }}</span>
                  {%- endif -%}
                  {%- if bs.text != blank -%}
                    <span class="vp-vsp__stat-text">{{ bs.text }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if st.guarantee_show -%}
          {%- liquid
            assign g_classes = 'vp-vsp__guarantee'
            if st.guarantee_shadow
              assign g_classes = g_classes | append: ' vp-vsp__guarantee--shadow'
            endif
            if st.guarantee_border != blank
              assign g_classes = g_classes | append: ' vp-vsp__guarantee--bordered'
            endif
          -%}
          <div
            class="{{ g_classes }}"
            style="
              --vsp-g-bg: {{ st.guarantee_bg }};
              --vsp-g-num: {{ st.guarantee_num_color }};
              --vsp-g-title: {{ st.guarantee_title_color }};
              --vsp-g-text: {{ st.guarantee_text_color }};
              {% if st.guarantee_border != blank %}--vsp-g-border: {{ st.guarantee_border }};{% endif %}
              --vsp-g-radius: {{ st.guarantee_radius | default: 16 }}px;
              --vsp-g-space: {{ st.guarantee_space | default: 24 }}px;
              --vsp-g-space-m: {{ st.guarantee_space_mobile | default: 18 }}px;
            "
          >
            {%- if st.guarantee_icon != blank -%}
              {{
                st.guarantee_icon
                | image_url: width: 120
                | image_tag: loading: 'lazy', class: 'vp-vsp__guarantee-icon', alt: ''
              }}
            {%- endif -%}
            {%- if st.guarantee_number != blank -%}
              <span class="vp-vsp__guarantee-value">{{ st.guarantee_number | escape }}</span>
            {%- endif -%}
            <span class="vp-vsp__guarantee-body">
              {%- if st.guarantee_title != blank -%}
                <span class="vp-vsp__guarantee-title">{{ st.guarantee_title | escape }}</span>
              {%- endif -%}
              {%- if st.guarantee_text != blank -%}
                <span class="vp-vsp__guarantee-text">{{ st.guarantee_text | escape }}</span>
              {%- endif -%}
            </span>
          </div>
        {%- endif -%}

        {%- if st.cta_show and st.cta_label != blank -%}
          {%- liquid
            assign cta_classes = 'vp-vsp__cta'
            if st.cta_width == 'full'
              assign cta_classes = cta_classes | append: ' vp-vsp__cta--full'
            endif
            if st.cta_full_mobile
              assign cta_classes = cta_classes | append: ' vp-vsp__cta--full-m'
            endif
            if st.cta_border != blank
              assign cta_classes = cta_classes | append: ' vp-vsp__cta--bordered'
            endif
          -%}
          <div
            class="vp-vsp__cta-wrap"
            style="--vsp-cta-align: {{ cta_flex }}; --vsp-cta-space: {{ st.cta_space | default: 20 }}px;"
          >
            <a
              class="{{ cta_classes }}"
              {% if st.cta_link != blank %}href="{{ st.cta_link }}"{% else %}href="#" aria-disabled="true"{% endif %}
              {% if st.cta_new_tab %}target="_blank" rel="noopener"{% endif %}
              style="
                --vsp-cta-bg: {{ st.cta_bg }};
                --vsp-cta-color: {{ st.cta_color }};
                --vsp-cta-hover: {{ st.cta_hover_bg }};
                {% if st.cta_border != blank %}--vsp-cta-border: {{ st.cta_border }};{% endif %}
                --vsp-cta-radius: {{ st.cta_radius | default: 999 }}px;
              "
            >{{ st.cta_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
      {%- endunless -%}

      {%- if cards.size > 0 -%}
        <div
          class="vp-vsp__carousel"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ st.heading | default: 'Customer videos' | strip_html | escape }}"
        >
          <button
            class="vp-vsp__arrow vp-vsp__arrow--prev"
            type="button"
            data-vp-vsp-prev
            aria-label="Previous video"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <div class="vp-vsp__rail" data-vp-vsp-rail>
            {%- for block in cards -%}
              {%- liquid
                assign bs = block.settings
                assign poster_url = ''
                if bs.poster != blank
                  assign poster_url = bs.poster | image_url: width: 720
                elsif bs.video != blank and bs.video.preview_image != blank
                  assign poster_url = bs.video.preview_image | image_url: width: 720
                elsif bs.poster_url != blank
                  assign poster_url = bs.poster_url
                endif

                assign label_text = bs.label | default: ''
                assign alt_text = bs.alt | default: label_text
                if alt_text == blank
                  assign alt_text = 'Customer video'
                endif
              -%}
              <div class="vp-vsp__slide" {{ block.shopify_attributes }}>
                <div class="vp-vsp__card" data-vp-vsp-card>
                  <video
                    class="vp-vsp__video"
                    data-vp-vsp-video
                    preload="none"
                    playsinline
                    disablepictureinpicture
                    {% if st.loop_videos %}loop{% endif %}
                    {% if st.start_muted %}muted{% endif %}
                    {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %}
                    aria-label="{{ alt_text | escape }}"
                  >
                    {%- if bs.video != blank -%}
                      {%- for source in bs.video.sources -%}
                        {%- if source.format == 'mp4' -%}
                          <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
                        {%- endif -%}
                      {%- endfor -%}
                    {%- elsif bs.video_url != blank -%}
                      <source data-src="{{ bs.video_url }}" type="video/mp4">
                    {%- endif -%}
                  </video>

                  <button class="vp-vsp__play" type="button" data-vp-vsp-play aria-label="Play video">
                    <span class="vp-vsp__play-icon" aria-hidden="true">
                      <svg class="vp-vsp__icon-play" viewBox="0 0 24 24" focusable="false"><path d="M8 5.5v13l11-6.5-11-6.5z" fill="currentColor"/></svg>
                      <svg class="vp-vsp__icon-pause" viewBox="0 0 24 24" focusable="false"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z" fill="currentColor"/></svg>
                    </span>
                  </button>

                  <button class="vp-vsp__mute" type="button" data-vp-vsp-mute aria-label="Unmute video">
                    <svg class="vp-vsp__icon-muted" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M17 9l4 6M21 9l-4 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
                    <svg class="vp-vsp__icon-sound" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16.5 8.5a5 5 0 010 7M19 6a8.5 8.5 0 010 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
                  </button>

                  {%- if label_text != blank -%}
                    <span class="vp-vsp__label">{{ label_text | escape }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>

          <button
            class="vp-vsp__arrow vp-vsp__arrow--next"
            type="button"
            data-vp-vsp-next
            aria-label="Next video"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <div class="vp-vsp__dots" data-vp-vsp-dots role="tablist" aria-label="Choose video"></div>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% style %}
  .vp-vsp {
    background: var(--vp-vsp-bg, #EDFAFF);
    padding-top: var(--vp-vsp-pad-top, 64px);
    padding-bottom: var(--vp-vsp-pad-bottom, 64px);
  }

  .vp-vsp__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: var(--vp-vsp-copy-align, center);
  }

  /* With the copy column hidden the carousel takes the whole row. */
  .vp-vsp--nocopy .vp-vsp__grid { grid-template-columns: 1fr; }

  /* Copy column ---------------------------------------------------------- */
  .vp-vsp__heading {
    margin: 0 0 12px;
    font-size: var(--vp-vsp-head-fs-m, 26px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--vp-vsp-heading, #1A1A1A);
  }

  .vp-vsp__sub {
    margin: 0 0 24px;
    font-size: var(--vp-vsp-body-fs, 16px);
    line-height: 1.5;
    color: var(--vp-vsp-body, #6B7A85);
  }

  .vp-vsp__sub > :first-child { margin-top: 0; }
  .vp-vsp__sub > :last-child { margin-bottom: 0; }

  .vp-vsp__stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--vp-vsp-stat-gap, 18px);
  }

  /* The number sits in a fixed-width column so every row lines up, whatever
     background shape each block chooses. The badge is centred inside it and
     may grow past it on extreme font sizes without shifting the text. */
  .vp-vsp__stat {
    display: grid;
    grid-template-columns: var(--vp-vsp-num-col, 104px) 1fr;
    align-items: center;
    gap: 16px;
    background: var(--vsp-s-row-bg, transparent);
    border-radius: var(--vsp-s-row-radius, 0px);
    padding: var(--vsp-s-row-pad, 0px);
  }

  .vp-vsp__stat--bordered { border: 1px solid var(--vsp-s-row-border, transparent); }

  .vp-vsp__stat-value {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    box-sizing: border-box;
    min-width: 100%;
    /* 89% must never break onto a second line inside a circle. */
    white-space: nowrap;
    font-size: var(--vsp-s-num-fs, 38px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--vsp-s-num-color, #1A1A1A);
    font-variant-numeric: tabular-nums;
  }

  .vp-vsp__stat--hasbg .vp-vsp__stat-value {
    background: var(--vsp-s-num-bg, #FFFFFF);
    padding: 0.2em 0.32em;
  }

  .vp-vsp__stat--hasbg.vp-vsp__stat--shape-circle .vp-vsp__stat-value {
    border-radius: 50%;
    aspect-ratio: 1;
  }

  .vp-vsp__stat--hasbg.vp-vsp__stat--shape-round .vp-vsp__stat-value {
    border-radius: 16px;
    aspect-ratio: 1;
  }

  .vp-vsp__stat--hasbg.vp-vsp__stat--shape-pill .vp-vsp__stat-value {
    border-radius: 999px;
    padding: 0.24em 0.6em;
  }

  .vp-vsp__stat-text {
    font-size: var(--vp-vsp-body-fs, 16px);
    line-height: 1.4;
    color: var(--vp-vsp-body, #6B7A85);
  }

  .vp-vsp__stat-text > :first-child { margin-top: 0; }
  .vp-vsp__stat-text > :last-child { margin-bottom: 0; }
  .vp-vsp__stat-text strong { color: var(--vp-vsp-heading, #1A1A1A); font-weight: 700; }

  /* Guarantee card ------------------------------------------------------- */
  .vp-vsp__guarantee {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: var(--vsp-g-space-m, 18px);
    background: var(--vsp-g-bg, #FFFFFF);
    border-radius: var(--vsp-g-radius, 16px);
    padding: 18px 20px;
  }

  .vp-vsp__guarantee--shadow { box-shadow: 0 8px 24px rgba(31, 127, 184, 0.10); }
  .vp-vsp__guarantee--bordered { border: 1px solid var(--vsp-g-border, transparent); }

  .vp-vsp__guarantee-icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
    display: block;
  }

  .vp-vsp__guarantee-value {
    font-size: var(--vp-vsp-stat-fs-m, 30px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--vsp-g-num, #1A1A1A);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .vp-vsp__guarantee-body { display: block; flex: 1 1 auto; min-width: 0; }

  .vp-vsp__guarantee-title {
    display: block;
    font-size: var(--vp-vsp-body-fs, 16px);
    font-weight: 700;
    line-height: 1.3;
    color: var(--vsp-g-title, #1A1A1A);
  }

  .vp-vsp__guarantee-text {
    display: block;
    margin-top: 2px;
    font-size: var(--vp-vsp-body-fs, 16px);
    line-height: 1.4;
    color: var(--vsp-g-text, #6B7A85);
  }

  /* CTA ------------------------------------------------------------------ */
  .vp-vsp__cta-wrap {
    display: flex;
    justify-content: var(--vsp-cta-align, flex-start);
    margin-top: var(--vsp-cta-space, 20px);
  }

  .vp-vsp__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px 28px;
    font-size: 14.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: none;
    background: var(--vsp-cta-bg, #47B5E9);
    color: var(--vsp-cta-color, #FFFFFF);
    border-radius: var(--vsp-cta-radius, 999px);
    transition: background 0.2s ease;
  }

  .vp-vsp__cta--bordered { border: 1px solid var(--vsp-cta-border, transparent); }
  .vp-vsp__cta:hover { background: var(--vsp-cta-hover, #2E9FD8); }
  .vp-vsp__cta:focus-visible { outline: 3px solid var(--vp-vsp-accent, #47B5E9); outline-offset: 3px; }
  .vp-vsp__cta--full { width: 100%; }


  /* Carousel ------------------------------------------------------------- */
  .vp-vsp__carousel { position: relative; min-width: 0; }

  .vp-vsp__rail {
    display: flex;
    gap: var(--vp-vsp-gap, 16px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* Horizontal swipe is the rail's, vertical scrolling stays with the page. */
    touch-action: pan-y pinch-zoom;
    padding-bottom: 4px;
  }

  .vp-vsp__rail::-webkit-scrollbar { display: none; }

  /* The peek is the slice of the next card left visible, gap included. */
  .vp-vsp__slide {
    flex: 0 0 calc(100% - var(--vp-vsp-peek-m, 18%));
    scroll-snap-align: start;
    min-width: 0;
  }

  .vp-vsp__card {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--vp-vsp-card-radius, 20px);
    overflow: hidden;
    background: #0E1B22;
    box-shadow: 0 10px 30px rgba(31, 127, 184, 0.16);
  }

  .vp-vsp__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Controls ------------------------------------------------------------- */
  .vp-vsp__play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .vp-vsp__play-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--vp-vsp-accent, #47B5E9);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  .vp-vsp__play-icon svg { width: 26px; height: 26px; }

  .vp-vsp__play:hover .vp-vsp__play-icon { transform: scale(1.06); }

  .vp-vsp__play:focus-visible {
    outline: 3px solid var(--vp-vsp-accent, #47B5E9);
    outline-offset: -3px;
  }

  .vp-vsp__icon-pause { display: none; }

  /* While playing the overlay stays clickable but its button fades out, so a
     tap anywhere on the card pauses without an icon covering the face. */
  .vp-vsp__card.is-playing .vp-vsp__icon-play { display: none; }
  .vp-vsp__card.is-playing .vp-vsp__icon-pause { display: block; }
  .vp-vsp__card.is-playing .vp-vsp__play-icon { opacity: 0; }
  .vp-vsp__card.is-playing .vp-vsp__play:hover .vp-vsp__play-icon,
  .vp-vsp__card.is-playing .vp-vsp__play:focus-visible .vp-vsp__play-icon { opacity: 1; }

  .vp-vsp__mute {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    padding: 0;
    border-radius: 999px;
    background: rgba(14, 27, 34, 0.55);
    color: #FFFFFF;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .vp-vsp__mute svg { width: 20px; height: 20px; }
  .vp-vsp__mute:focus-visible { outline: 3px solid #FFFFFF; outline-offset: 2px; }
  .vp-vsp__icon-sound { display: none; }
  .vp-vsp__card.is-unmuted .vp-vsp__icon-muted { display: none; }
  .vp-vsp__card.is-unmuted .vp-vsp__icon-sound { display: block; }

  .vp-vsp__label {
    position: absolute;
    left: 10px;
    bottom: 10px;
    max-width: calc(100% - 64px);
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(14, 27, 34, 0.55);
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Arrows are pointer-only; touch users swipe. */
  .vp-vsp__arrow { display: none; }

  .vp-vsp__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
  }

  .vp-vsp__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(31, 127, 184, 0.25);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .vp-vsp__dot[aria-selected='true'] {
    background: var(--vp-vsp-accent, #47B5E9);
    transform: scale(1.25);
  }

  .vp-vsp__dot:focus-visible {
    outline: 3px solid var(--vp-vsp-accent, #47B5E9);
    outline-offset: 3px;
  }

  /* Tablet --------------------------------------------------------------- */
  @media screen and (min-width: 750px) {
    .vp-vsp__slide { flex-basis: calc((100% - var(--vp-vsp-gap, 16px)) / 2); }
  }

  /* Desktop -------------------------------------------------------------- */
  @media screen and (min-width: 990px) {
    .vp-vsp {
      padding-top: var(--vp-vsp-pad-top, 64px);
      padding-bottom: var(--vp-vsp-pad-bottom, 64px);
    }

    .vp-vsp__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: 48px;
    }

    .vp-vsp__heading { font-size: var(--vp-vsp-head-fs, 40px); }

    .vp-vsp__stats { gap: var(--vp-vsp-stat-gap, 22px); }

    .vp-vsp__guarantee { margin-top: var(--vsp-g-space, 24px); }

    .vp-vsp__slide {
      flex-basis: calc(
        (100% - (var(--vp-vsp-pv-d, 2.2) - 1) * var(--vp-vsp-gap, 16px)) / var(--vp-vsp-pv-d, 2.2)
      );
    }

    .vp-vsp__arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: #FFFFFF;
      color: var(--vp-vsp-heading, #1A1A1A);
      box-shadow: 0 4px 14px rgba(31, 127, 184, 0.20);
      cursor: pointer;
    }

    .vp-vsp__arrow svg { width: 22px; height: 22px; }
    .vp-vsp__arrow--prev { left: -20px; }
    .vp-vsp__arrow--next { right: -20px; }
    .vp-vsp--full .vp-vsp__arrow--prev { left: 6px; }
    .vp-vsp--full .vp-vsp__arrow--next { right: 6px; }
    .vp-vsp__arrow[disabled] { opacity: 0.35; cursor: default; }
    .vp-vsp__arrow:focus-visible { outline: 3px solid var(--vp-vsp-accent, #47B5E9); outline-offset: 2px; }
  }

  /* Mobile padding ------------------------------------------------------- */
  @media screen and (max-width: 749px) {
    .vp-vsp {
      padding-top: var(--vp-vsp-pad-top-m, 40px);
      padding-bottom: var(--vp-vsp-pad-bottom-m, 40px);
    }
    /* The per-block number size is capped on small screens so a large
       desktop value cannot blow the row open on a phone. */
    .vp-vsp__stat-value { font-size: min(var(--vsp-s-num-fs, 38px), var(--vp-vsp-stat-fs-m, 30px)); }
    .vp-vsp__stat { grid-template-columns: min(var(--vp-vsp-num-col, 104px), 88px) 1fr; gap: 12px; }
    .vp-vsp__cta--full-m { width: 100%; }

    /* Keeps a tall 9:16 card from eating the whole phone viewport. */
    .vp-vsp__card { max-height: 68vh; }
    .vp-vsp__card { aspect-ratio: 9 / 16; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vp-vsp__rail { scroll-behavior: auto; }
    .vp-vsp__play-icon,
    .vp-vsp__dot { transition: none; }
  }
