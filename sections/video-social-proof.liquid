<script>
  (function () {
    var root = document.querySelector('[data-vp-vsp="{{ section.id }}"]');
    if (!root) return;

    var rail = root.querySelector('[data-vp-vsp-rail]');
    if (!rail) return;

    var slides = Array.prototype.slice.call(rail.querySelectorAll('.vp-vsp__slide'));
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-vp-vsp-card]'));
    var prevBtn = root.querySelector('[data-vp-vsp-prev]');
    var nextBtn = root.querySelector('[data-vp-vsp-next]');
    var dotsWrap = root.querySelector('[data-vp-vsp-dots]');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* The card currently being scrolled into view, exempt from the
       leave-the-viewport pause while it is on its way in. */
    var enteringCard = null;
    var enteringAt = 0;

    /* ---- lazy source promotion ------------------------------------------
       data-src only becomes src on the first play, so the initial page load
       costs five posters instead of five videos. */
    function ensureLoaded(video) {
      if (video.dataset.vpLoaded === 'true') return;
      var sources = video.querySelectorAll('source[data-src]');
      if (!sources.length) return;
      Array.prototype.forEach.call(sources, function (s) {
        s.setAttribute('src', s.getAttribute('data-src'));
        s.removeAttribute('data-src');
      });
      video.dataset.vpLoaded = 'true';
      video.load();
    }

    function cardOf(video) { return video.closest('[data-vp-vsp-card]'); }

    function pauseVideo(video) {
      if (!video.paused) video.pause();
    }

    function pauseAllExcept(video) {
      cards.forEach(function (card) {
        var v = card.querySelector('[data-vp-vsp-video]');
        if (v && v !== video) pauseVideo(v);
      });
    }

    /* play does not bubble, so the listener has to capture. */
    root.addEventListener(
      'play',
      function (e) {
        var v = e.target;
        if (!v || v.tagName !== 'VIDEO') return;
        pauseAllExcept(v);
        var card = cardOf(v);
        if (card) card.classList.add('is-playing');
      },
      true
    );

    ['pause', 'ended'].forEach(function (evt) {
      root.addEventListener(
        evt,
        function (e) {
          var v = e.target;
          if (!v || v.tagName !== 'VIDEO') return;
          var card = cardOf(v);
          if (card) card.classList.remove('is-playing');
        },
        true
      );
    });

    cards.forEach(function (card) {
      var video = card.querySelector('[data-vp-vsp-video]');
      var playBtn = card.querySelector('[data-vp-vsp-play]');
      var muteBtn = card.querySelector('[data-vp-vsp-mute]');
      if (!video) return;

      if (video.muted) card.classList.remove('is-unmuted');
      else card.classList.add('is-unmuted');

      if (playBtn) {
        playBtn.addEventListener('click', function () {
          if (video.paused) {
            /* The card being played becomes the active one, so a part-visible
               card is brought into view before it starts - otherwise it would
               play from behind the edge of the rail and the observer above
               would immediately pause it again. */
            var idx = cards.indexOf(card);
            if (idx > -1) {
              enteringCard = card;
              enteringAt = Date.now();
              scrollToIndex(idx);
            }
            ensureLoaded(video);
            var p = video.play();
            /* A rejected play (autoplay policy, decode error) must not leave
               the card stuck in the playing state. */
            if (p && typeof p.catch === 'function') {
              p.catch(function () { card.classList.remove('is-playing'); });
            }
            playBtn.setAttribute('aria-label', 'Pause video');
          } else {
            video.pause();
            playBtn.setAttribute('aria-label', 'Play video');
          }
        });
      }

      if (muteBtn) {
        muteBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          video.muted = !video.muted;
          card.classList.toggle('is-unmuted', !video.muted);
          muteBtn.setAttribute('aria-label', video.muted ? 'Unmute video' : 'Mute video');
          /* Unmuting is a clear intent to watch this one. */
          if (!video.muted && video.paused) {
            ensureLoaded(video);
            var p = video.play();
            if (p && typeof p.catch === 'function') { p.catch(function () {}); }
          }
        });
      }
    });

    /* ---- pause anything that leaves the viewport ------------------------- */
    if ('IntersectionObserver' in window) {
      /* Several thresholds, not one. A card that already sits below the
         visibility bar - a part-visible card peeking at the end of the rail -
         crosses no threshold when the page scrolls it fully out, so a single
         0.5 threshold would never fire again and it would keep playing
         off-screen. Crossing 0 is the case that actually matters here. */
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.intersectionRatio >= 0.25) {
              if (entry.target === enteringCard) enteringCard = null;
              return;
            }
            /* A card being scrolled into view crosses 0 on the way in, at a
               ratio still under the bar. Pausing there would kill the video
               the viewer just asked for, so the incoming card is exempt until
               it lands or the scroll gives up. */
            if (entry.target === enteringCard && Date.now() - enteringAt < 1200) return;
            var v = entry.target.querySelector('[data-vp-vsp-video]');
            if (v) pauseVideo(v);
          });
        },
        { threshold: [0, 0.25, 0.6] }
      );
      cards.forEach(function (card) { io.observe(card); });
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) cards.forEach(function (card) {
        var v = card.querySelector('[data-vp-vsp-video]');
        if (v) pauseVideo(v);
      });
    });

    /* ---- dots + arrows derived from scrollLeft --------------------------- */
    var dots = [];
    if (dotsWrap && slides.length > 1) {
      slides.forEach(function (slide, i) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'vp-vsp__dot';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', 'Go to video ' + (i + 1));
        dot.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        dot.addEventListener('click', function () { scrollToIndex(i); });
        dotsWrap.appendChild(dot);
        dots.push(dot);
      });
    } else if (dotsWrap) {
      dotsWrap.style.display = 'none';
    }

    function step() {
      if (slides.length < 2) return rail.clientWidth;
      var a = slides[0].getBoundingClientRect().left;
      var b = slides[1].getBoundingClientRect().left;
      return Math.abs(b - a) || rail.clientWidth;
    }

    function currentIndex() {
      var s = step();
      return s ? Math.round(rail.scrollLeft / s) : 0;
    }

    function scrollToIndex(i) {
      var max = slides.length - 1;
      var idx = Math.max(0, Math.min(max, i));
      rail.scrollTo({
        left: idx * step(),
        behavior: reduceMotion.matches ? 'auto' : 'smooth'
      });
    }

    function sync() {
      var idx = currentIndex();
      dots.forEach(function (d, i) {
        d.setAttribute('aria-selected', i === idx ? 'true' : 'false');
      });
      if (prevBtn) prevBtn.disabled = rail.scrollLeft <= 1;
      if (nextBtn) {
        nextBtn.disabled = rail.scrollLeft >= rail.scrollWidth - rail.clientWidth - 1;
      }
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { scrollToIndex(currentIndex() - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { scrollToIndex(currentIndex() + 1); });

    var raf = null;
    rail.addEventListener(
      'scroll',
      function () {
        if (raf) return;
        raf = window.requestAnimationFrame(function () {
          raf = null;
          sync();
        });
      },
      { passive: true }
    );

    window.addEventListener('resize', sync);
    sync();

    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        if (raf) window.cancelAnimationFrame(raf);
        window.removeEventListener('resize', sync);
      }
    });
  })();
</script>

