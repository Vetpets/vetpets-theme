{%- comment -%}
  Sale-event countdown
  ----------------------
  Two truthful timer modes:

  1. Fixed deadline - counts down to one real, merchant-configured
     date/time in the shop's timezone. There is no session/localStorage
     state - remaining time is always (deadline - now), computed fresh on
     every render and every tick, so it cannot "reset" on refresh, session,
     device or visitor.

  2. Daily recurring - counts down to 23:59:59 in the VISITOR'S OWN
     browser/device local time, using only the native JS Date API (no
     shop-timezone math at all for this mode). Because "end of today" is
     recomputed fresh on every tick from the visitor's current local clock,
     it naturally rolls over to tomorrow's 23:59:59 the instant local
     midnight passes - no special reset logic needed, and DST/timezone
     changes are handled for free by the browser. This mode has no
     no-JS/server-rendered value (the server cannot know a visitor's local
     clock), so its numbers appear the instant the tick script runs rather
     than being present in the initial HTML - documented in the schema.

  Robust date parsing: end_date/end_time are strictly validated (exact
  YYYY-MM-DD / HH:MM shape, in-range values) in Liquid before any date math
  runs. An invalid or incomplete value is treated as "not configured" (the
  countdown does not render) rather than being handed to Liquid's `date`
  filter, which silently returns unparseable input unchanged - the likely
  cause of a prior "ddd"-style broken-literal-text bug when a placeholder
  or partial value ended up in the field.

  Accessibility: the ticking numbers are intentionally NOT an aria-live
  region - a live region here would cause screen readers to announce a
  change every second, which is exactly the noisy behavior to avoid.

  Editor robustness: the tick script clears its own interval on
  shopify:section:unload (keyed by this exact section id) before a fresh
  copy starts on shopify:section:load, so repeated edits in the Theme
  Editor never stack up duplicate intervals. The interval is also paused
  while the tab is hidden (document.visibilitychange) and immediately
  recalculated from the real current time when the tab becomes visible
  again, rather than drifting.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign timer_mode = st.timer_mode | default: 'fixed'

  comment
    Animal Week visual style is a purely additive, opt-in presentation
    layer - it never touches timer_mode, display_units, or any of the
    date-validation / roll-up math below. A template that never sets
    "visual_theme" (every existing template today) resolves to 'default'
    and renders byte-identical to before this feature existed.
  endcomment
  assign visual_theme = st.visual_theme | default: 'default'
  assign show_supporting_line = false
  if visual_theme == 'animal_week' and st.aw_supporting_line_show and st.aw_supporting_line != blank
    assign show_supporting_line = true
  endif
  assign aw_pattern = st.aw_pattern | default: 'none'

  assign display_units = st.display_units | default: 'dhms'
  assign show_days = false
  assign show_hours = false
  assign show_minutes = true
  assign show_seconds = false
  if display_units == 'dhms'
    assign show_days = true
    assign show_hours = true
    assign show_seconds = true
  elsif display_units == 'hms'
    assign show_hours = true
    assign show_seconds = true
  elsif display_units == 'ms'
    assign show_seconds = true
  elsif display_units == 'hm'
    assign show_hours = true
  endif

  assign show_section = false
  if st.enabled and timer_mode == 'daily_recurring'
    assign show_section = true
  endif

  comment
    Strict validation: only a well-formed, in-range date/time reaches the
    `date` filter. Anything else is treated as "not configured" rather
    than rendered as garbage.
  endcomment
  assign date_valid = false
  assign time_valid = false
  if st.end_date.size == 10
    assign date_parts = st.end_date | split: '-'
    if date_parts.size == 3 and date_parts[0].size == 4 and date_parts[1].size == 2 and date_parts[2].size == 2
      assign yy = date_parts[0] | times: 1
      assign parsed_month = date_parts[1] | times: 1
      assign parsed_day = date_parts[2] | times: 1
      if yy >= 2000 and yy <= 2100 and parsed_month >= 1 and parsed_month <= 12 and parsed_day >= 1 and parsed_day <= 31
        assign date_valid = true
      endif
    endif
  endif
  if st.end_time.size == 5
    assign time_parts = st.end_time | split: ':'
    if time_parts.size == 2 and time_parts[0].size == 2 and time_parts[1].size == 2
      assign parsed_hour = time_parts[0] | times: 1
      assign parsed_minute = time_parts[1] | times: 1
      if parsed_hour >= 0 and parsed_hour <= 23 and parsed_minute >= 0 and parsed_minute <= 59
        assign time_valid = true
      endif
    endif
  endif

  if st.enabled and timer_mode == 'fixed' and date_valid and time_valid
    assign show_section = true
  endif
-%}

{%- if show_section -%}
  {%- liquid
    assign deadline_ts = 0
    assign is_expired = false

    if timer_mode == 'fixed'
      assign deadline_string = st.end_date | append: 'T' | append: st.end_time | append: ':00'
      assign deadline_ts = deadline_string | date: '%s' | times: 1
      assign now_ts = 'now' | date: '%s' | times: 1
      assign seconds_left = deadline_ts | minus: now_ts
      if seconds_left <= 0
        assign is_expired = true
      endif
    endif
  -%}

  {%- if timer_mode == 'fixed' and is_expired and st.expired_behavior == 'hide' -%}
    {%- comment -%} Deadline passed, merchant chose to hide. {%- endcomment -%}
  {%- else -%}
    {%- liquid
      assign remaining = seconds_left
      assign days_val = -1
      assign hours_val = -1
      assign minutes_val = -1
      assign seconds_val = -1

      if timer_mode == 'fixed' and is_expired and st.expired_behavior == 'show_zero'
        assign remaining = 0
      endif

      comment
        Roll-up: each enabled unit consumes whatever is left in `remaining`
        at its own granularity, so the first enabled unit always shows the
        TOTAL remaining duration at that granularity (e.g. Hours shows 55
        when Days is disabled and 2.3 days remain).
      endcomment
      if show_days
        assign days_val = remaining | divided_by: 86400
        assign days_seconds = days_val | times: 86400
        assign remaining = remaining | minus: days_seconds
      endif

      if show_hours
        assign hours_val = remaining | divided_by: 3600
        assign hours_seconds = hours_val | times: 3600
        assign remaining = remaining | minus: hours_seconds
      endif

      if show_minutes
        assign minutes_val = remaining | divided_by: 60
        assign minutes_seconds = minutes_val | times: 60
        assign remaining = remaining | minus: minutes_seconds
      endif

      if show_seconds
        assign seconds_val = remaining
      endif

      comment
        Zero-pad the same way the tick script does, so the first JS tick
        never visibly changes the text - a unit is padded only when it is
        a "remainder" unit following a larger visible unit.
      endcomment
      assign hours_display = hours_val
      if show_hours and show_days and hours_val >= 0 and hours_val < 10
        assign hours_display = '0' | append: hours_val
      endif

      assign minutes_display = minutes_val
      assign minutes_has_larger = false
      if show_days or show_hours
        assign minutes_has_larger = true
      endif
      if show_minutes and minutes_has_larger and minutes_val >= 0 and minutes_val < 10
        assign minutes_display = '0' | append: minutes_val
      endif

      assign seconds_display = seconds_val
      assign seconds_has_larger = false
      if show_days or show_hours or show_minutes
        assign seconds_has_larger = true
      endif
      if show_seconds and seconds_has_larger and seconds_val >= 0 and seconds_val < 10
        assign seconds_display = '0' | append: seconds_val
      endif

      comment
        Animal Week style computations - purely presentational, no effect
        on any value above. color_modify is Shopify's built-in Liquid
        filter for changing a color's alpha channel; used here for the
        countdown-box translucency (raster-free, CSS/SVG only).
      endcomment
      assign aw_pattern_color_val = st.aw_pattern_color | default: '#FFFFFF'
      assign aw_pattern_opacity_val = st.aw_pattern_opacity | default: 13 | divided_by: 100.0
      assign aw_pattern_scale_d = st.aw_pattern_scale_desktop | default: 100 | divided_by: 100.0
      assign aw_pattern_scale_m = st.aw_pattern_scale_mobile | default: 100 | divided_by: 100.0
      assign aw_id = section.id
      assign aw_box_opacity_decimal = st.aw_box_opacity | default: 20 | divided_by: 100.0
      assign aw_box_bg_rgba = st.aw_box_bg_color | default: '#FFFFFF' | color_modify: 'alpha', aw_box_opacity_decimal
      assign aw_box_border_rgba = st.aw_box_border_color | default: '#FFFFFF' | color_modify: 'alpha', aw_box_opacity_decimal
    -%}

    {%- comment -%}
      Approved Claude Design pattern ("Option B - hearts with a few paw
      prints"), ported verbatim: same heart-plus glyph, same paw glyph,
      same per-mark translate/scale/rotate values, same radial fade
      gradient stops and mask radii, same 13% base opacity. "Hearts" uses
      Option A's own all-hearts layout (not B with paws swapped back to
      hearts - a genuinely different, separately tuned composition in the
      source file). "Paws" reuses Option A's positions with the paw glyph
      substituted at every slot, since no paws-only mockup exists and this
      is the same technique Option B itself uses (swapping the glyph at a
      fixed slot, not re-deriving new coordinates). Desktop and mobile are
      two independently laid-out tiles, exactly as designed - never a CSS
      crop of one another. Real inline SVG (defs/pattern/mask), not a
      background-image: a childless element here would be caught by this
      theme's global `div:empty / svg:empty`-style cleanup rules, so every
      layer below always has real child content.
    {%- endcomment -%}
    {%- capture aw_hrt_path -%}<path fill-rule="evenodd" d="M12 21.2c-.3 0-.6-.1-.8-.3C7.9 18 3 14.4 3 10.1 3 6.9 5.4 4.4 8.5 4.4c1.4 0 2.7.6 3.5 1.6.8-1 2.1-1.6 3.5-1.6C18.6 4.4 21 6.9 21 10.1c0 4.3-4.9 7.9-8.2 10.8-.2.2-.5.3-.8.3Z M11 7.6h2v2.6h2.6v2H13v2.6h-2v-2.6H8.4v-2H11z"></path>{%- endcapture -%}
    {%- capture aw_paw_inner -%}<ellipse cx="6.4" cy="8.4" rx="2" ry="2.5"></ellipse><ellipse cx="10.7" cy="6" rx="2" ry="2.6"></ellipse><ellipse cx="15.1" cy="6" rx="2" ry="2.6"></ellipse><ellipse cx="19.1" cy="8.8" rx="2" ry="2.5"></ellipse><path d="M12.7 10.6c2.9 0 5.3 2.1 5.3 4.7 0 2-1.6 3.2-3.6 3.2-1 0-1.8-.3-2.6-.3-.8 0-1.6.3-2.6.3-2 0-3.6-1.2-3.6-3.2 0-2.6 2.4-4.7 5.3-4.7Z"></path>{%- endcapture -%}

    {%- capture aw_marks_d -%}
      {%- case aw_pattern -%}
        {%- when 'hearts' -%}
          <use href="#hrt-{{ aw_id }}" transform="translate(16,10) scale(1.417) rotate(-10,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(120,24) scale(0.750) rotate(12,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(212,4) scale(1.083) rotate(-4,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(272,58) scale(0.667) rotate(14,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(62,64) scale(0.917) rotate(8,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(166,76) scale(1.583) rotate(-12,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(6,106) scale(0.833) rotate(6,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(108,118) scale(1.167) rotate(-8,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(238,110) scale(0.792) rotate(10,12,12)"></use>
        {%- when 'paws' -%}
          <use href="#paw-{{ aw_id }}" transform="translate(16,10) scale(1.417) rotate(-10,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(120,24) scale(0.750) rotate(12,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(212,4) scale(1.083) rotate(-4,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(272,58) scale(0.667) rotate(14,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(62,64) scale(0.917) rotate(8,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(166,76) scale(1.583) rotate(-12,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(6,106) scale(0.833) rotate(6,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(108,118) scale(1.167) rotate(-8,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(238,110) scale(0.792) rotate(10,12,12)"></use>
        {%- when 'hearts_paws' -%}
          <use href="#hrt-{{ aw_id }}" transform="translate(16,10) scale(1.417) rotate(-10,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(120,24) scale(0.750) rotate(12,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(212,4) scale(0.932) rotate(-4,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(272,58) scale(0.667) rotate(14,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(62,64) scale(0.917) rotate(8,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(166,76) scale(1.583) rotate(-12,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(6,106) scale(0.717) rotate(6,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(108,118) scale(1.167) rotate(-8,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(238,110) scale(0.792) rotate(10,12,12)"></use>
      {%- endcase -%}
    {%- endcapture -%}

    {%- capture aw_marks_m -%}
      {%- case aw_pattern -%}
        {%- when 'hearts' -%}
          <use href="#hrt-{{ aw_id }}" transform="translate(10,6) scale(1.167) rotate(-8,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(104,18) scale(0.667) rotate(10,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(58,56) scale(0.833) rotate(6,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(134,68) scale(1.250) rotate(-12,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(4,94) scale(0.750) rotate(12,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(84,108) scale(1.000) rotate(-6,12,12)"></use>
        {%- when 'paws' -%}
          <use href="#paw-{{ aw_id }}" transform="translate(10,6) scale(1.167) rotate(-8,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(104,18) scale(0.667) rotate(10,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(58,56) scale(0.833) rotate(6,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(134,68) scale(1.250) rotate(-12,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(4,94) scale(0.750) rotate(12,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(84,108) scale(1.000) rotate(-6,12,12)"></use>
        {%- when 'hearts_paws' -%}
          <use href="#hrt-{{ aw_id }}" transform="translate(10,6) scale(1.167) rotate(-8,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(104,18) scale(0.600) rotate(10,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(58,56) scale(0.833) rotate(6,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(134,68) scale(1.250) rotate(-12,12,12)"></use><use href="#paw-{{ aw_id }}" transform="translate(4,94) scale(0.675) rotate(12,12,12)"></use><use href="#hrt-{{ aw_id }}" transform="translate(84,108) scale(1.000) rotate(-6,12,12)"></use>
      {%- endcase -%}
    {%- endcapture -%}

    <section
      class="vp-se-cd vp-se-cd--{{ st.style }} vp-se-cd--width-{{ st.width_mode }} vp-se-cd--align-{{ st.alignment }} vp-se-cd--mode-{{ timer_mode }}{% if timer_mode == 'fixed' and is_expired %} vp-se-cd--expired{% endif %}{% if st.separators_enabled %} vp-se-cd--separators{% endif %}{% if st.border_enabled %} vp-se-cd--border{% endif %}{% if visual_theme == 'animal_week' %} vp-se-cd--aw vp-se-cd--aw-bg-{{ st.aw_bg_style | default: 'solid' }}{% if st.aw_boxes_enabled %} vp-se-cd--aw-boxes{% endif %}{% endif %}"
      style="
        --vp-se-cd-bg: {{ st.color_background }};
        {% if visual_theme == 'animal_week' %}
          --vp-se-cd-aw-bg-solid: {{ st.aw_bg_solid_color | default: '#47B5E9' }};
          --vp-se-cd-aw-bg-start: {{ st.aw_bg_gradient_start | default: '#47B5E9' }};
          --vp-se-cd-aw-bg-end: {{ st.aw_bg_gradient_end | default: '#13B6B5' }};
          --vp-se-cd-aw-bg-angle: {{ st.aw_bg_gradient_angle | default: 90 }}deg;
          --vp-se-cd-aw-heading-color: {{ st.aw_heading_color | default: '#10232B' }};
          --vp-se-cd-aw-supporting-color: {{ st.aw_supporting_line_color | default: '#3A4A5F' }};
          --vp-se-cd-aw-number-color: {{ st.aw_number_color | default: '#10232B' }};
          --vp-se-cd-aw-label-color: {{ st.aw_label_color | default: '#3A4A5F' }};
          --vp-se-cd-aw-heading-fs-d: {{ st.aw_heading_font_size_desktop | default: 22 }}px;
          --vp-se-cd-aw-heading-fs-m: {{ st.aw_heading_font_size_mobile | default: 18 }}px;
          --vp-se-cd-aw-supporting-fs-d: {{ st.aw_supporting_font_size_desktop | default: 15 }}px;
          --vp-se-cd-aw-supporting-fs-m: {{ st.aw_supporting_font_size_mobile | default: 13 }}px;
          --vp-se-cd-aw-supporting-gap-d: {{ st.aw_supporting_gap_desktop | default: 10 }}px;
          --vp-se-cd-aw-supporting-gap-m: {{ st.aw_supporting_gap_mobile | default: 8 }}px;
          --vp-se-cd-aw-box-bg: {{ aw_box_bg_rgba }};
          --vp-se-cd-aw-box-border: {{ aw_box_border_rgba }};
          --vp-se-cd-aw-box-radius: {{ st.aw_box_radius | default: 12 }}px;
        {% endif %}
        --vp-se-cd-prefix: {{ st.color_prefix }};
        --vp-se-cd-number: {{ st.color_number }};
        --vp-se-cd-label: {{ st.color_label }};
        --vp-se-cd-separator: {{ st.color_separator }};
        --vp-se-cd-accent: {{ st.color_accent }};
        --vp-se-cd-border: {{ st.color_border }};
        --vp-se-cd-expired-text: {{ st.color_expired_text }};
        --vp-se-cd-box-bg: {{ st.color_timer_box_background }};
        --vp-se-cd-group-gap: {{ st.group_gap }}px;
        --vp-se-cd-group-padding: {{ st.group_padding }}px;
        --vp-se-cd-group-radius: {{ st.group_border_radius }}px;
        --vp-se-cd-font-weight: {{ st.font_weight }};
        --vp-se-cd-text-transform: {{ st.text_transform }};
        --vp-se-cd-letter-spacing: {{ st.letter_spacing | divided_by: 100.0 }}em;
        --vp-se-cd-prefix-fs-d: {{ st.prefix_font_size_desktop }}px;
        --vp-se-cd-prefix-fs-m: {{ st.prefix_font_size_mobile }}px;
        --vp-se-cd-number-fs-d: {{ st.number_font_size_desktop }}px;
        --vp-se-cd-number-fs-m: {{ st.number_font_size_mobile }}px;
        --vp-se-cd-label-fs-d: {{ st.label_font_size_desktop }}px;
        --vp-se-cd-label-fs-m: {{ st.label_font_size_mobile }}px;
        --vp-se-cd-sep-fs-d: {{ st.separator_font_size_desktop }}px;
        --vp-se-cd-sep-fs-m: {{ st.separator_font_size_mobile }}px;
        --vp-se-cd-expired-fs-d: {{ st.expired_font_size_desktop }}px;
        --vp-se-cd-expired-fs-m: {{ st.expired_font_size_mobile }}px;
        --vp-se-cd-pad-top-d: {{ st.desktop_padding_top }}px;
        --vp-se-cd-pad-bottom-d: {{ st.desktop_padding_bottom }}px;
        --vp-se-cd-pad-top-m: {{ st.mobile_padding_top }}px;
        --vp-se-cd-pad-bottom-m: {{ st.mobile_padding_bottom }}px;
        {% if st.width_mode == 'custom' %}max-width: {{ st.custom_max_width }}px;{% endif %}
      "
      data-vp-se-countdown
      data-section-id="{{ section.id }}"
      data-mode="{{ timer_mode }}"
      data-deadline="{{ deadline_ts }}"
      data-expired-behavior="{{ st.expired_behavior }}"
      data-show-days="{{ show_days }}"
      data-show-hours="{{ show_hours }}"
      data-show-minutes="{{ show_minutes }}"
      data-show-seconds="{{ show_seconds }}"
    >
      {%- if visual_theme == 'animal_week' -%}
        {%- if aw_pattern != 'none' -%}
          <svg aria-hidden="true" focusable="false" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0">
            <defs>
              <g id="hrt-{{ aw_id }}" fill="{{ aw_pattern_color_val }}">{{ aw_hrt_path }}</g>
              <g id="paw-{{ aw_id }}" fill="{{ aw_pattern_color_val }}" opacity=".72">{{ aw_paw_inner }}</g>
              <pattern id="pat-d-{{ aw_id }}" patternUnits="userSpaceOnUse" width="300" height="152" patternTransform="scale({{ aw_pattern_scale_d }})">{{ aw_marks_d }}</pattern>
              <pattern id="pat-m-{{ aw_id }}" patternUnits="userSpaceOnUse" width="172" height="148" patternTransform="scale({{ aw_pattern_scale_m }})">{{ aw_marks_m }}</pattern>
              <radialGradient id="fade-d-{{ aw_id }}" cx="50%" cy="50%" r="70%">
                <stop offset="0" stop-color="#000000"></stop>
                <stop offset=".38" stop-color="#0A0A0A"></stop>
                <stop offset=".72" stop-color="#8C8C8C"></stop>
                <stop offset="1" stop-color="#FFFFFF"></stop>
              </radialGradient>
              <radialGradient id="fade-m-{{ aw_id }}" cx="50%" cy="50%" r="64%">
                <stop offset="0" stop-color="#000000"></stop>
                <stop offset=".38" stop-color="#0A0A0A"></stop>
                <stop offset=".72" stop-color="#8C8C8C"></stop>
                <stop offset="1" stop-color="#FFFFFF"></stop>
              </radialGradient>
              <mask id="mask-d-{{ aw_id }}"><rect width="100%" height="100%" fill="url(#fade-d-{{ aw_id }})"></rect></mask>
              <mask id="mask-m-{{ aw_id }}"><rect width="100%" height="100%" fill="url(#fade-m-{{ aw_id }})"></rect></mask>
            </defs>
            <rect class="vp-se-cd-aw__pattern-rect vp-se-cd-aw__pattern-rect--desktop" width="100%" height="100%" fill="url(#pat-d-{{ aw_id }})" mask="url(#mask-d-{{ aw_id }})" opacity="{{ aw_pattern_opacity_val }}"></rect>
            <rect class="vp-se-cd-aw__pattern-rect vp-se-cd-aw__pattern-rect--mobile" width="100%" height="100%" fill="url(#pat-m-{{ aw_id }})" mask="url(#mask-m-{{ aw_id }})" opacity="{{ aw_pattern_opacity_val }}"></rect>
          </svg>
        {%- endif -%}
        <div class="vp-se-cd-aw__vignette" aria-hidden="true"></div>
      {%- endif -%}
      <div class="vp-se-cd__inner">
        {%- if timer_mode == 'fixed' and is_expired and st.expired_behavior == 'show_message' -%}
          <div class="vp-se-cd__expired" data-vp-se-countdown-expired>
            {%- if st.expired_headline != blank -%}
              <p class="vp-se-cd__expired-headline">{{ st.expired_headline | escape }}</p>
            {%- endif -%}
            {%- if st.expired_body != blank -%}
              <p class="vp-se-cd__expired-body">{{ st.expired_body | escape }}</p>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- comment -%}
            live_inner is the exact, unmodified countdown markup - same
            classes, same data attributes the tick script queries for.
            Animal Week style only changes what wraps it (an optional
            heading + supporting line), never this content, so the timer
            itself is byte-identical in both visual styles.
          {%- endcomment -%}
          {%- capture live_inner -%}
            <div class="vp-se-cd__live" data-vp-se-countdown-live>
              {%- if timer_mode == 'daily_recurring' -%}
                {%- if st.daily_prefix_text != blank -%}
                  <span class="vp-se-cd__prefix">{{ st.daily_prefix_text | escape }}</span>
                {%- endif -%}
              {%- else -%}
                {%- if st.prefix_text != blank -%}
                  <span class="vp-se-cd__prefix">{{ st.prefix_text | escape }}</span>
                {%- endif -%}
                {%- if st.deadline_text != blank -%}
                  <span class="vp-se-cd__deadline-text">{{ st.deadline_text | escape }}</span>
                {%- endif -%}
              {%- endif -%}

              <span class="vp-se-cd__units" data-vp-se-countdown-units{% if timer_mode == 'daily_recurring' %} hidden{% endif %}>
                {%- if show_days -%}
                  <span class="vp-se-cd__unit" data-vp-se-unit-wrap="days">
                    <span class="vp-se-cd__number" data-vp-se-unit="days">{{ days_val }}</span>
                    <span class="vp-se-cd__label">{{ st.label_days | escape }}</span>
                  </span>
                {%- endif -%}
                {%- if show_hours -%}
                  {%- if show_days -%}<span class="vp-se-cd__sep" aria-hidden="true">{{ st.separator_character | default: '·' }}</span>{%- endif -%}
                  <span class="vp-se-cd__unit" data-vp-se-unit-wrap="hours">
                    <span class="vp-se-cd__number" data-vp-se-unit="hours">{{ hours_display }}</span>
                    <span class="vp-se-cd__label">{{ st.label_hours | escape }}</span>
                  </span>
                {%- endif -%}
                {%- if show_minutes -%}
                  {%- if show_days or show_hours -%}<span class="vp-se-cd__sep" aria-hidden="true">{{ st.separator_character | default: '·' }}</span>{%- endif -%}
                  <span class="vp-se-cd__unit" data-vp-se-unit-wrap="minutes">
                    <span class="vp-se-cd__number" data-vp-se-unit="minutes">{{ minutes_display }}</span>
                    <span class="vp-se-cd__label">{{ st.label_minutes | escape }}</span>
                  </span>
                {%- endif -%}
                {%- if show_seconds -%}
                  {%- if show_days or show_hours or show_minutes -%}<span class="vp-se-cd__sep" aria-hidden="true">{{ st.separator_character | default: '·' }}</span>{%- endif -%}
                  <span class="vp-se-cd__unit vp-se-cd__unit--accent" data-vp-se-unit-wrap="seconds">
                    <span class="vp-se-cd__number vp-se-cd__number--accent" data-vp-se-unit="seconds">{{ seconds_display }}</span>
                    <span class="vp-se-cd__label">{{ st.label_seconds | escape }}</span>
                  </span>
                {%- endif -%}
              </span>
            </div>
          {%- endcapture -%}

          {%- if visual_theme == 'animal_week' -%}
            <div class="vp-se-cd-aw__row">
              {%- if st.aw_heading != blank -%}
                <p class="vp-se-cd-aw__heading">{{ st.aw_heading | escape }}</p>
              {%- endif -%}
              {{ live_inner }}
              {%- if show_supporting_line and st.aw_supporting_line_position == 'beside' -%}
                <p class="vp-se-cd-aw__supporting vp-se-cd-aw__supporting--beside">{{ st.aw_supporting_line | escape }}</p>
              {%- endif -%}
            </div>
            {%- if show_supporting_line and st.aw_supporting_line_position != 'beside' -%}
              <p class="vp-se-cd-aw__supporting vp-se-cd-aw__supporting--below">{{ st.aw_supporting_line | escape }}</p>
            {%- endif -%}
          {%- else -%}
            {{ live_inner }}
          {%- endif -%}
        {%- endif -%}
      </div>
    </section>

    <script>
      (function () {
        var sectionId = {{ section.id | json }};
        var root = document.querySelector('[data-vp-se-countdown][data-section-id="' + sectionId + '"]');
        if (!root) return;

        var mode = root.getAttribute('data-mode');
        var fixedDeadlineTs = parseInt(root.getAttribute('data-deadline'), 10) * 1000;
        var expiredBehavior = root.getAttribute('data-expired-behavior');
        var showDays = root.getAttribute('data-show-days') === 'true';
        var showHours = root.getAttribute('data-show-hours') === 'true';
        var showMinutes = root.getAttribute('data-show-minutes') === 'true';
        var showSeconds = root.getAttribute('data-show-seconds') === 'true';

        var liveEl = root.querySelector('[data-vp-se-countdown-live]');
        var unitsEl = root.querySelector('[data-vp-se-countdown-units]');
        var expiredEl = root.querySelector('[data-vp-se-countdown-expired]');
        var daysEl = root.querySelector('[data-vp-se-unit="days"]');
        var hoursEl = root.querySelector('[data-vp-se-unit="hours"]');
        var minutesEl = root.querySelector('[data-vp-se-unit="minutes"]');
        var secondsEl = root.querySelector('[data-vp-se-unit="seconds"]');

        function pad(n) {
          return String(n).length < 2 ? '0' + n : String(n);
        }

        function getDeadline() {
          if (mode === 'daily_recurring') {
            var now = new Date();
            return new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59, 999).getTime();
          }
          return fixedDeadlineTs;
        }

        function render() {
          var deadline = getDeadline();
          var remainingMs = deadline - Date.now();

          if (unitsEl && unitsEl.hidden) unitsEl.hidden = false;

          if (remainingMs <= 0) {
            if (mode === 'daily_recurring') {
              // getDeadline() recomputes "end of today" from the current
              // local clock on every call, so the very next tick already
              // reflects the new day - nothing else to reset.
              return true;
            }
            if (expiredBehavior === 'hide') {
              root.hidden = true;
              return false;
            }
            if (expiredBehavior === 'show_zero') {
              if (daysEl) daysEl.textContent = 0;
              if (hoursEl) hoursEl.textContent = showDays ? '00' : 0;
              if (minutesEl) minutesEl.textContent = (showDays || showHours) ? '00' : 0;
              if (secondsEl) secondsEl.textContent = (showDays || showHours || showMinutes) ? '00' : 0;
              return true;
            }
            // show_message
            if (liveEl) liveEl.hidden = true;
            if (expiredEl) expiredEl.hidden = false;
            root.classList.add('vp-se-cd--expired');
            return false;
          }

          var remaining = Math.floor(remainingMs / 1000);

          if (showDays) {
            var days = Math.floor(remaining / 86400);
            remaining -= days * 86400;
            if (daysEl) daysEl.textContent = days;
          }
          if (showHours) {
            var hours = Math.floor(remaining / 3600);
            remaining -= hours * 3600;
            if (hoursEl) hoursEl.textContent = showDays ? pad(hours) : hours;
          }
          if (showMinutes) {
            var minutes = Math.floor(remaining / 60);
            remaining -= minutes * 60;
            if (minutesEl) minutesEl.textContent = (showDays || showHours) ? pad(minutes) : minutes;
          }
          if (showSeconds) {
            var seconds = remaining;
            if (secondsEl) secondsEl.textContent = (showDays || showHours || showMinutes) ? pad(seconds) : seconds;
          }
          return true;
        }

        var intervalId = null;

        function start() {
          if (intervalId) return;
          var keepTicking = render();
          if (keepTicking) {
            intervalId = window.setInterval(function () {
              if (!render()) stop();
            }, 1000);
          }
        }

        function stop() {
          if (intervalId) {
            window.clearInterval(intervalId);
            intervalId = null;
          }
        }

        start();

        document.addEventListener('visibilitychange', function () {
          if (document.hidden) {
            stop();
          } else {
            start();
          }
        });

        document.addEventListener('shopify:section:unload', function (event) {
          if (event.target && event.target.getAttribute && event.target.getAttribute('data-section-id') === sectionId) {
            stop();
          }
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{%- style -%}
  .vp-se-cd {
    background: var(--vp-se-cd-bg, #EAF6FD);
    font-family: var(--font-body-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
  }
  .vp-se-cd--border { border-top: 1px solid var(--vp-se-cd-border, rgba(20,144,204,.16)); border-bottom: 1px solid var(--vp-se-cd-border, rgba(20,144,204,.16)); }

  .vp-se-cd__inner {
    margin-inline: auto;
    padding: var(--vp-se-cd-pad-top-m, 15px) 24px var(--vp-se-cd-pad-bottom-m, 15px);
  }
  .vp-se-cd--width-full .vp-se-cd__inner { max-width: none; }
  .vp-se-cd--width-page .vp-se-cd__inner { max-width: var(--page-width, 1200px); }
  .vp-se-cd--width-contained .vp-se-cd__inner { max-width: 1320px; }
  .vp-se-cd--width-custom .vp-se-cd__inner { max-width: 100%; }

  .vp-se-cd__live {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 10px 18px;
    min-height: 24px;
    text-transform: var(--vp-se-cd-text-transform, none);
  }
  .vp-se-cd--align-left .vp-se-cd__live { justify-content: flex-start; }
  .vp-se-cd--align-right .vp-se-cd__live { justify-content: flex-end; }

  .vp-se-cd__prefix {
    font-size: var(--vp-se-cd-prefix-fs-m, 11px);
    font-weight: 700;
    letter-spacing: var(--vp-se-cd-letter-spacing, 0.16em);
    color: var(--vp-se-cd-prefix, #1490CC);
  }

  .vp-se-cd__deadline-text {
    font-size: 14px;
    font-weight: 600;
    color: var(--vp-se-cd-number, #0F172A);
  }

  .vp-se-cd__units {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--vp-se-cd-group-gap, 12px);
  }

  .vp-se-cd__unit {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    padding: var(--vp-se-cd-group-padding, 0px);
    border-radius: var(--vp-se-cd-group-radius, 0px);
    background: var(--vp-se-cd-box-bg, transparent);
  }

  .vp-se-cd__number {
    font-variant-numeric: tabular-nums;
    font-size: var(--vp-se-cd-number-fs-m, 19px);
    font-weight: var(--vp-se-cd-font-weight, 700);
    letter-spacing: -0.01em;
    color: var(--vp-se-cd-number, #0F172A);
  }
  .vp-se-cd__number--accent { color: var(--vp-se-cd-accent, #1490CC); }

  .vp-se-cd__label {
    font-size: var(--vp-se-cd-label-fs-m, 11px);
    font-weight: 600;
    letter-spacing: var(--vp-se-cd-letter-spacing, 0.1em);
    text-transform: var(--vp-se-cd-text-transform, uppercase);
    color: var(--vp-se-cd-label, #5A6B80);
  }

  .vp-se-cd__sep {
    color: var(--vp-se-cd-separator, #A9C4D6);
    font-size: var(--vp-se-cd-sep-fs-m, 15px);
  }
  .vp-se-cd:not(.vp-se-cd--separators) .vp-se-cd__sep { display: none; }

  .vp-se-cd__expired { text-align: center; padding: 4px 0; width: 100%; }
  .vp-se-cd__expired-headline { margin: 0 0 4px; font-weight: 700; font-size: var(--vp-se-cd-expired-fs-m, 14px); color: var(--vp-se-cd-expired-text, #0F172A); }
  .vp-se-cd__expired-body { margin: 0; font-size: 13px; color: var(--vp-se-cd-expired-text, #0F172A); opacity: 0.85; }

  /* compact_grouped style: stacked, larger numbers, no separators */
  .vp-se-cd--compact_grouped .vp-se-cd__inner { padding-top: max(var(--vp-se-cd-pad-top-m, 15px), 28px); padding-bottom: max(var(--vp-se-cd-pad-bottom-m, 15px), 28px); }
  .vp-se-cd--compact_grouped .vp-se-cd__live { flex-direction: column; align-items: center; gap: 10px; }
  .vp-se-cd--compact_grouped.vp-se-cd--align-left .vp-se-cd__live { align-items: flex-start; }
  .vp-se-cd--compact_grouped.vp-se-cd--align-right .vp-se-cd__live { align-items: flex-end; }
  .vp-se-cd--compact_grouped .vp-se-cd__units { gap: max(var(--vp-se-cd-group-gap, 12px), 30px); }
  .vp-se-cd--compact_grouped .vp-se-cd__unit { flex-direction: column; align-items: center; gap: 2px; min-width: 52px; }
  .vp-se-cd--compact_grouped .vp-se-cd__number { font-size: calc(var(--vp-se-cd-number-fs-m, 19px) + 11px); line-height: 1; }
  .vp-se-cd--compact_grouped .vp-se-cd__sep { display: none; }

  /* hero_integrated style: same slim layout, tighter padding */
  .vp-se-cd--hero_integrated .vp-se-cd__inner { padding-top: min(var(--vp-se-cd-pad-top-m, 15px), 13px); padding-bottom: min(var(--vp-se-cd-pad-bottom-m, 15px), 13px); }

  @media (max-width: 480px) {
    .vp-se-cd__units { row-gap: 6px; }
  }

  @media screen and (min-width: 750px) {
    .vp-se-cd__inner { padding-top: var(--vp-se-cd-pad-top-d, 15px); padding-bottom: var(--vp-se-cd-pad-bottom-d, 15px); }
    .vp-se-cd__prefix { font-size: var(--vp-se-cd-prefix-fs-d, 11px); }
    .vp-se-cd__number { font-size: var(--vp-se-cd-number-fs-d, 19px); }
    .vp-se-cd__label { font-size: var(--vp-se-cd-label-fs-d, 11px); }
    .vp-se-cd__sep { font-size: var(--vp-se-cd-sep-fs-d, 15px); }
    .vp-se-cd__expired-headline { font-size: var(--vp-se-cd-expired-fs-d, 14px); }
    .vp-se-cd--compact_grouped .vp-se-cd__number { font-size: calc(var(--vp-se-cd-number-fs-d, 19px) + 11px); }
  }

  /* ---------- Animal Week visual style (opt-in via "Visual style" setting) ---------- */
  /* Entirely scoped under .vp-se-cd--aw, so a section that never sets
     visual_theme to "animal_week" is completely unaffected by anything
     below - same selectors, same specificity, zero risk of bleeding into
     the default look used by every existing template today. */

  .vp-se-cd--aw { position: relative; overflow: hidden; }
  .vp-se-cd--aw-bg-solid { background: var(--vp-se-cd-aw-bg-solid, #47B5E9); }
  .vp-se-cd--aw-bg-gradient {
    background: linear-gradient(var(--vp-se-cd-aw-bg-angle, 90deg), var(--vp-se-cd-aw-bg-start, #47B5E9), var(--vp-se-cd-aw-bg-end, #13B6B5));
  }

  /* The pattern is a real inline <svg> (see the section markup), not a
     background-image: a childless element here would be caught by this
     theme's global empty-element cleanup rules (div:empty etc), which is
     exactly what silently hid an earlier background-image-only attempt.
     Mobile-first: the mobile <rect> shows by default, the desktop one
     takes over at the same 750px breakpoint used everywhere else in this
     file. Both patterns and their defs are always present in the DOM;
     only which <rect> paints is switched, so there's no flash/relayout
     when the viewport crosses the breakpoint. */
  .vp-se-cd-aw__pattern-rect--desktop { display: none; }
  .vp-se-cd-aw__pattern-rect--mobile { display: block; }

  .vp-se-cd-aw__vignette {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 62% 130% at 50% 50%, rgba(5, 50, 76, .34) 0%, rgba(5, 50, 76, .16) 52%, rgba(5, 50, 76, 0) 80%);
  }

  .vp-se-cd--aw .vp-se-cd__inner { position: relative; z-index: 1; }

  /* Animal Week uses its own heading/supporting line in place of the
     default prefix/deadline text, so those are hidden here rather than
     showing both and looking cluttered. */
  .vp-se-cd--aw .vp-se-cd__prefix,
  .vp-se-cd--aw .vp-se-cd__deadline-text { display: none; }

  .vp-se-cd-aw__row {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
  }

  .vp-se-cd-aw__heading {
    margin: 0;
    font-size: var(--vp-se-cd-aw-heading-fs-m, 18px);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--vp-se-cd-aw-heading-color, #10232B);
    text-shadow: 0 1px 3px rgba(15, 23, 42, 0.18);
  }

  .vp-se-cd-aw__supporting {
    margin: 0;
    font-size: var(--vp-se-cd-aw-supporting-fs-m, 13px);
    font-weight: 600;
    color: var(--vp-se-cd-aw-supporting-color, #3A4A5F);
    text-shadow: 0 1px 3px rgba(15, 23, 42, 0.14);
  }
  .vp-se-cd-aw__supporting--below { text-align: center; margin-top: var(--vp-se-cd-aw-supporting-gap-m, 8px); }

  .vp-se-cd--aw .vp-se-cd__number,
  .vp-se-cd--aw .vp-se-cd__number--accent { color: var(--vp-se-cd-aw-number-color, #10232B); text-shadow: 0 1px 3px rgba(15, 23, 42, 0.18); }
  .vp-se-cd--aw .vp-se-cd__label { color: var(--vp-se-cd-aw-label-color, #3A4A5F); }

  .vp-se-cd--aw-boxes .vp-se-cd__unit {
    background: var(--vp-se-cd-aw-box-bg, transparent);
    border: 1px solid var(--vp-se-cd-aw-box-border, transparent);
    border-radius: var(--vp-se-cd-aw-box-radius, 12px);
    padding: 8px 14px;
  }

  /* Mobile-only fix: on a narrow phone, 4 boxes at their desktop padding/
     gap/font-size don't fit on one row and .vp-se-cd__units' own
     flex-wrap: wrap (further up this file) lets Seconds drop to a second
     line. nowrap + flex: 1 1 0 on each box is a structural fix, not a
     tuning one - four equal-width flex children with wrap disabled
     always sum to exactly the row's width, so wrapping becomes
     impossible regardless of content length. The clamp()s alongside it
     just keep that guaranteed-to-fit content comfortably sized instead
     of cramped. Explicitly undone at 750px below, so desktop (which
     already fits and was already approved) renders exactly as before -
     none of this touches how desktop looks. */
  .vp-se-cd--aw .vp-se-cd__units {
    flex-wrap: nowrap;
    gap: clamp(2px, 1.5vw, var(--vp-se-cd-group-gap, 12px));
  }
  .vp-se-cd--aw .vp-se-cd__unit {
    flex: 1 1 0;
    min-width: 0;
    justify-content: center;
    overflow: hidden;
    gap: clamp(2px, 1vw, 5px);
  }
  .vp-se-cd--aw .vp-se-cd__number {
    font-size: clamp(12px, 4.2vw, var(--vp-se-cd-number-fs-m, 19px));
  }
  .vp-se-cd--aw .vp-se-cd__label {
    font-size: clamp(7px, 2.4vw, var(--vp-se-cd-label-fs-m, 11px));
    white-space: nowrap;
  }
  .vp-se-cd--aw-boxes .vp-se-cd__unit {
    padding: clamp(4px, 1.6vw, 8px) clamp(5px, 2.6vw, 14px);
  }
  /* Each box already visually separates its own unit, so the dot
     separators between them are redundant once boxes are on - removing
     them (rather than just shrinking them) frees the most space of any
     single change here, since hiding a flex child also collapses the
     row-gap on both of its sides. Only when boxes are on: with boxes
     off there's no border/fill doing that separating job, so the
     dots stay exactly as they always have. */
  .vp-se-cd--aw-boxes .vp-se-cd__sep {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .vp-se-cd-aw__pattern-rect--desktop { display: block; }
    .vp-se-cd-aw__pattern-rect--mobile { display: none; }
    .vp-se-cd-aw__row {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 24px;
      text-align: left;
    }
    .vp-se-cd-aw__heading { font-size: var(--vp-se-cd-aw-heading-fs-d, 22px); }
    .vp-se-cd-aw__supporting { font-size: var(--vp-se-cd-aw-supporting-fs-d, 15px); }
    .vp-se-cd-aw__supporting--below { text-align: center; margin-top: var(--vp-se-cd-aw-supporting-gap-d, 10px); }

    /* Restore the exact pre-fix desktop behavior - desktop already fits
       on one row at its normal sizing, so none of the mobile-only
       tightening above should carry through. */
    .vp-se-cd--aw .vp-se-cd__units { flex-wrap: wrap; gap: var(--vp-se-cd-group-gap, 12px); }
    .vp-se-cd--aw .vp-se-cd__unit { flex: 0 1 auto; justify-content: flex-start; overflow: visible; gap: 5px; }
    .vp-se-cd--aw .vp-se-cd__number { font-size: var(--vp-se-cd-number-fs-d, 19px); }
    .vp-se-cd--aw .vp-se-cd__label { font-size: var(--vp-se-cd-label-fs-d, 11px); }
    .vp-se-cd--aw-boxes .vp-se-cd__unit { padding: 8px 14px; }
    .vp-se-cd--aw-boxes .vp-se-cd__sep { display: inline; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Sale-event countdown",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable countdown", "default": false, "info": "Ships off by default." },
    { "type": "select", "id": "timer_mode", "label": "Timer mode", "default": "fixed", "options": [
      { "value": "fixed", "label": "Fixed end date and time" },
      { "value": "daily_recurring", "label": "Daily recurring (visitor local time)" }
    ] },

    { "type": "header", "content": "Fixed deadline" },
    { "type": "paragraph", "content": "Used when Timer mode is \"Fixed end date and time\". Read in the shop's own timezone (the same timezone Shopify admin shows you)." },
    { "type": "text", "id": "end_date", "label": "Campaign end date", "info": "Format YYYY-MM-DD, e.g. 2026-09-30. An incomplete or invalid value is treated as not configured - the countdown stays hidden rather than showing broken text." },
    { "type": "text", "id": "end_time", "label": "Campaign end time", "info": "Format HH:MM, 24-hour, e.g. 23:59" },
    { "type": "text", "id": "prefix_text", "label": "Prefix text", "default": "Sale ends in" },
    { "type": "text", "id": "deadline_text", "label": "Optional supporting line", "info": "e.g. \"Sale ends Sunday 11 October\"." },
    { "type": "select", "id": "expired_behavior", "label": "Expired behavior", "default": "show_message", "options": [
      { "value": "hide", "label": "Hide the countdown entirely" },
      { "value": "show_message", "label": "Show an ended-state message" },
      { "value": "show_zero", "label": "Show zero values (00:00:00)" }
    ] },
    { "type": "text", "id": "expired_headline", "label": "Ended headline", "default": "This event has ended" },
    { "type": "text", "id": "expired_body", "label": "Ended body text (optional)", "default": "Check back soon for the next event." },

    { "type": "header", "content": "Daily recurring" },
