    { "type": "range", "id": "aw_pattern_scale_desktop", "min": 40, "max": 200, "step": 10, "unit": "px", "label": "Pattern scale - desktop", "default": 100 },
    { "type": "range", "id": "aw_pattern_scale_mobile", "min": 30, "max": 160, "step": 10, "unit": "px", "label": "Pattern scale - mobile", "default": 70 },

    { "type": "header", "content": "Animal Week - background" },
    { "type": "select", "id": "aw_bg_style", "label": "Background style", "default": "solid", "options": [
      { "value": "solid", "label": "Solid" },
      { "value": "gradient", "label": "Gradient" }
    ] },
    { "type": "color", "id": "aw_bg_solid_color", "label": "Solid background color", "default": "#47B5E9" },
    { "type": "color", "id": "aw_bg_gradient_start", "label": "Gradient start color", "default": "#47B5E9" },
    { "type": "color", "id": "aw_bg_gradient_end", "label": "Gradient end color", "default": "#13B6B5" },
    { "type": "range", "id": "aw_bg_gradient_angle", "min": 0, "max": 360, "step": 5, "unit": "deg", "label": "Gradient angle", "default": 90 },

    { "type": "header", "content": "Animal Week - countdown boxes" },
    { "type": "checkbox", "id": "aw_boxes_enabled", "label": "Show boxes around each number", "default": false },
    { "type": "color", "id": "aw_box_bg_color", "label": "Box background color", "default": "#FFFFFF" },
    { "type": "color", "id": "aw_box_border_color", "label": "Box border color", "default": "#FFFFFF" },
    { "type": "range", "id": "aw_box_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Box opacity", "default": 20, "info": "Applies to both the box background and border, for a cohesive translucent look." },
