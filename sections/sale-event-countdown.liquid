      { "value": "animal_week", "label": "Animal Week" }
    ], "info": "Animal Week unlocks the settings below. It never changes the countdown's timing, timer mode or expiry behavior - only how it looks." },

    { "type": "header", "content": "Animal Week - content" },
    { "type": "paragraph", "content": "Only used when Visual style above is set to Animal Week. Replaces the default prefix/supporting-line text above with a short heading and an independent supporting line." },
    { "type": "text", "id": "aw_heading", "label": "Heading" },
