{% comment %} CG - Image with Text {% endcomment %}

{%- liquid
  assign img_position   = section.settings.image_position
  assign content_align  = section.settings.content_align
  assign content_align_mobile = section.settings.content_align_mobile
  assign mobile_order   = section.settings.mobile_order
-%}

<style>
  /* ── ROOT VARIABLES ── */
  #cg-iwt-{{ section.id }} {
    --iwt-section-bg:      {{ section.settings.section_bg }};
    --iwt-content-bg:      {{ section.settings.content_bg }};
    --iwt-max-width:       {{ section.settings.max_width }}px;
    --iwt-col-gap:         {{ section.settings.col_gap }}px;
    --iwt-img-pct:         {{ section.settings.image_width }}%;
    --iwt-img-radius:      {{ section.settings.image_radius }}px;
    --iwt-content-radius:  {{ section.settings.content_radius }}px;
    --iwt-content-pv:      {{ section.settings.content_pv }}px;
    --iwt-content-ph:      {{ section.settings.content_ph }}px;
    --iwt-block-gap:       {{ section.settings.block_gap }}px;
  }

  /* ── SECTION SHELL ── */
  #cg-iwt-{{ section.id }} {
    display: block;
    width: 100%;
    overflow-x: hidden;
  }

  #cg-iwt-{{ section.id }} .iwt-outer {
    background: var(--iwt-section-bg);
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_sides }}rem {{ section.settings.padding_bottom }}px;
    width: 100%;
    overflow-x: hidden;
  }

  #cg-iwt-{{ section.id }} .iwt-inner {
    max-width: var(--iwt-max-width);
    margin: 0 auto;
    display: flex;
    align-items: {{ section.settings.vertical_align }};
    gap: var(--iwt-col-gap);
    flex-direction: {% if img_position == 'right' %}row{% else %}row-reverse{% endif %};
    width: 100%;
  }

  /* ── MEDIA COLUMN ── */
  #cg-iwt-{{ section.id }} .iwt-media {
    flex: 0 0 var(--iwt-img-pct);
    width: var(--iwt-img-pct);
    max-width: var(--iwt-img-pct);
    min-width: 0;
    position: relative;
    overflow: hidden;
  }

  #cg-iwt-{{ section.id }} .iwt-media img,
  #cg-iwt-{{ section.id }} .iwt-media video {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--iwt-img-radius);
    object-fit: cover;
  }

  {%- unless section.settings.image_aspect == 'auto' -%}
  #cg-iwt-{{ section.id }} .iwt-media img,
  #cg-iwt-{{ section.id }} .iwt-media video {
    aspect-ratio: {{ section.settings.image_aspect }};
  }
  {%- endunless -%}

  /* ── CONTENT COLUMN ── */
  #cg-iwt-{{ section.id }} .iwt-content {
    flex: 1 1 0;
    min-width: 0;
    width: 0; /* force flex shrink on small screens */
    background: var(--iwt-content-bg);
    padding: var(--iwt-content-pv) var(--iwt-content-ph);
    border-radius: var(--iwt-content-radius);
    text-align: {{ content_align }};
    display: flex;
    flex-direction: column;
    gap: var(--iwt-block-gap);
    /* inherit theme fonts — no font-family override */
  }

  /* ── EYEBROW ── */
  #cg-iwt-{{ section.id }} .iwt-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.2;
    {% if content_align == 'center' %}justify-content: center;{% elsif content_align == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
  }
  #cg-iwt-{{ section.id }} .iwt-eyebrow-line {
    flex-shrink: 0;
    height: 2px;
    width: 20px;
    border-radius: 2px;
    background: currentColor;
  }

  /* ── HEADLINE ── */
  #cg-iwt-{{ section.id }} .iwt-headline {
    margin: 0;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  /* ── SUBHEADLINE ── */
  #cg-iwt-{{ section.id }} .iwt-subheadline {
    margin: 0;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  /* ── BODY TEXT ── */
  #cg-iwt-{{ section.id }} .iwt-body {
    line-height: 1.7;
    margin: 0;
  }
  #cg-iwt-{{ section.id }} .iwt-body p { margin: 0 0 0.75em; }
  #cg-iwt-{{ section.id }} .iwt-body p:last-child { margin-bottom: 0; }
  #cg-iwt-{{ section.id }} .iwt-body * { max-width: 100%; }

  /* ── USP LIST ── */
  #cg-iwt-{{ section.id }} .iwt-usp-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  #cg-iwt-{{ section.id }} .iwt-usp-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    text-align: left;
  }
  #cg-iwt-{{ section.id }} .iwt-usp-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  #cg-iwt-{{ section.id }} .iwt-usp-text {
    flex: 1;
    min-width: 0;
    line-height: 1.45;
    word-break: break-word;
  }
  #cg-iwt-{{ section.id }} .iwt-usp-label { font-weight: 700; display: block; }
  #cg-iwt-{{ section.id }} .iwt-usp-desc  { display: block; opacity: 0.75; margin-top: 2px; }

  /* ── STEPS LIST ── */
  #cg-iwt-{{ section.id }} .iwt-steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  #cg-iwt-{{ section.id }} .iwt-step-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    text-align: left;
  }
  #cg-iwt-{{ section.id }} .iwt-step-num {
    flex-shrink: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }
  #cg-iwt-{{ section.id }} .iwt-step-text {
    flex: 1;
    min-width: 0;
    line-height: 1.5;
    padding-top: 4px;
    word-break: break-word;
  }

  /* ── STAT ROW ── */
  #cg-iwt-{{ section.id }} .iwt-stat-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    {% if content_align == 'center' %}justify-content: center;{% elsif content_align == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
  }
  #cg-iwt-{{ section.id }} .iwt-stat-item {
    display: flex;
    flex-direction: column;
  }
  #cg-iwt-{{ section.id }} .iwt-stat-number { font-weight: 900; line-height: 1; }
  #cg-iwt-{{ section.id }} .iwt-stat-label  { font-size: 13px; opacity: 0.7; margin-top: 3px; }

  /* ── PILLS ── */
  #cg-iwt-{{ section.id }} .iwt-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    {% if content_align == 'center' %}justify-content: center;{% elsif content_align == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
  }
  #cg-iwt-{{ section.id }} .iwt-pill {
    display: inline-block;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* ── BUTTON ── */
  #cg-iwt-{{ section.id }} .iwt-btn-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    {% if content_align == 'center' %}justify-content: center;{% elsif content_align == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
  }
  #cg-iwt-{{ section.id }} .iwt-btn {
    display: inline-block;
    text-decoration: none;
    cursor: pointer;
    border: none;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
    transition: opacity 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }
  #cg-iwt-{{ section.id }} .iwt-btn:hover { opacity: 0.85; transform: translateY(-1px); }

  /* ── GUARANTEE ── */
  #cg-iwt-{{ section.id }} .iwt-guarantee {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
  }
  #cg-iwt-{{ section.id }} .iwt-guarantee-icon { flex-shrink: 0; }
  #cg-iwt-{{ section.id }} .iwt-guarantee-text { flex: 1; min-width: 0; line-height: 1.4; }
  #cg-iwt-{{ section.id }} .iwt-guarantee-title { font-weight: 700; display: block; }
  #cg-iwt-{{ section.id }} .iwt-guarantee-desc  { display: block; opacity: 0.7; margin-top: 2px; }

  /* ── STAR RATING ── */
  #cg-iwt-{{ section.id }} .iwt-stars {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    {% if content_align == 'center' %}justify-content: center;{% elsif content_align == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
  }
  #cg-iwt-{{ section.id }} .iwt-stars-icons { display: flex; gap: 2px; flex-shrink: 0; }
  #cg-iwt-{{ section.id }} .iwt-stars-text  { line-height: 1.2; }

  /* ── DIVIDER ── */
  #cg-iwt-{{ section.id }} .iwt-divider {
    border: none;
    margin: 0;
    width: 100%;
  }

  /* ── IMAGE CAPTION ── */
  #cg-iwt-{{ section.id }} .iwt-caption {
    font-size: 12px;
    opacity: 0.55;
    text-align: center;
    margin-top: 8px;
    word-break: break-word;
  }

  /* ── VIDEO EMBED WRAPPER ── */
  #cg-iwt-{{ section.id }} .iwt-video-embed {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    border-radius: var(--iwt-img-radius);
    overflow: hidden;
  }
  #cg-iwt-{{ section.id }} .iwt-video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ── MOBILE ── */
  @media screen and (max-width: 749px) {
    #cg-iwt-{{ section.id }} .iwt-outer {
      padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_sides_mobile }}rem {{ section.settings.padding_bottom_mobile }}px;
    }

    #cg-iwt-{{ section.id }} .iwt-inner {
      flex-direction: {% if mobile_order == 'image_first' %}column{% else %}column-reverse{% endif %};
      gap: {{ section.settings.mobile_gap }}px;
      align-items: stretch;
    }

    /* media: full width, no fixed percentage */
    #cg-iwt-{{ section.id }} .iwt-media {
      flex: none;
      width: 100%;
      max-width: 100%;
    }

    /* content: full width */
    #cg-iwt-{{ section.id }} .iwt-content {
      flex: none;
      width: 100%;
      min-width: 0;
      padding: {{ section.settings.content_pv_mobile }}px {{ section.settings.content_ph_mobile }}px;
      gap: {{ section.settings.block_gap_mobile }}px;
      text-align: {{ content_align_mobile }};
    }

    /* re-align flex items to match mobile content alignment */
    #cg-iwt-{{ section.id }} .iwt-eyebrow {
      {% if content_align_mobile == 'center' %}justify-content: center;{% elsif content_align_mobile == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
    }
    #cg-iwt-{{ section.id }} .iwt-btn-wrap {
      {% if content_align_mobile == 'center' %}justify-content: center;{% elsif content_align_mobile == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
    }
    #cg-iwt-{{ section.id }} .iwt-pills {
      {% if content_align_mobile == 'center' %}justify-content: center;{% elsif content_align_mobile == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
    }
    #cg-iwt-{{ section.id }} .iwt-stat-row {
      {% if content_align_mobile == 'center' %}justify-content: center;{% elsif content_align_mobile == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
      gap: 16px;
    }
    #cg-iwt-{{ section.id }} .iwt-stars {
      {% if content_align_mobile == 'center' %}justify-content: center;{% elsif content_align_mobile == 'right' %}justify-content: flex-end;{% else %}justify-content: flex-start;{% endif %}
    }

    /* stat numbers slightly smaller on mobile */
    #cg-iwt-{{ section.id }} .iwt-stat-number { font-size: 28px !important; }
  }
</style>

<div id="cg-iwt-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="iwt-outer">
    <div class="iwt-inner">

      {%- comment -%} ── MEDIA ── {%- endcomment -%}
      <div class="iwt-media">
        {%- if section.settings.video_url != blank -%}
          <div class="iwt-video-embed">
            <iframe src="{{ section.settings.video_url }}" allow="autoplay; fullscreen" loading="lazy"></iframe>
          </div>
        {%- elsif section.settings.video != blank -%}
          {{- section.settings.video | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              playsinline: true,
              style: 'width:100%;height:auto;display:block;border-radius:var(--iwt-img-radius);object-fit:cover;'
          -}}
        {%- elsif section.settings.image != blank -%}
          {{- section.settings.image | image_url: width: 1200 | image_tag:
              loading: 'lazy',
              style: 'width:100%;height:auto;display:block;border-radius:var(--iwt-img-radius);object-fit:cover;'
          -}}
        {%- else -%}
          <div style="background:#e5e7eb;aspect-ratio:1/1;border-radius:var(--iwt-img-radius);display:flex;align-items:center;justify-content:center;color:#9ca3af;font-size:13px;">No image selected</div>
        {%- endif -%}
        {%- if section.settings.image_caption != blank -%}
          <p class="iwt-caption">{{ section.settings.image_caption }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} ── CONTENT ── {%- endcomment -%}
      <div class="iwt-content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              <div class="iwt-eyebrow"
                {{ block.shopify_attributes }}
                style="color:{{ block.settings.color }};font-size:{{ block.settings.size }}px;"
              >
                {%- if block.settings.show_lines -%}<span class="iwt-eyebrow-line"></span>{%- endif -%}
                {{- block.settings.text -}}
                {%- if block.settings.show_lines -%}<span class="iwt-eyebrow-line"></span>{%- endif -%}
              </div>

            {%- when 'headline' -%}
              <{{ block.settings.tag }} class="iwt-headline"
                {{ block.shopify_attributes }}
                style="font-size:clamp({{ block.settings.size_mobile }}px,4vw,{{ block.settings.size }}px);font-weight:{{ block.settings.weight }};color:{{ block.settings.color }};text-transform:{{ block.settings.transform }};line-height:{{ block.settings.line_height | divided_by: 100.0 }};"
              >{{ block.settings.text }}</{{ block.settings.tag }}>

            {%- when 'subheadline' -%}
              <{{ block.settings.tag }} class="iwt-subheadline"
                {{ block.shopify_attributes }}
                style="font-size:clamp({{ block.settings.size_mobile }}px,3vw,{{ block.settings.size }}px);font-weight:{{ block.settings.weight }};color:{{ block.settings.color }};"
              >{{ block.settings.text }}</{{ block.settings.tag }}>

            {%- when 'body_text' -%}
              <div class="iwt-body rte"
                {{ block.shopify_attributes }}
                style="font-size:{{ block.settings.size }}px;color:{{ block.settings.color }};"
              >{{ block.settings.text }}</div>

            {%- when 'usp_list' -%}
              <ul class="iwt-usp-list"
                {{ block.shopify_attributes }}
                style="gap:{{ block.settings.gap }}px;"
              >
                {%- for i in (1..5) -%}
                  {%- assign item_key  = 'item_'  | append: i -%}
                  {%- assign label_key = 'label_' | append: i -%}
                  {%- assign icon_key  = 'icon_'  | append: i -%}
                  {%- if block.settings[item_key] != blank or block.settings[label_key] != blank -%}
                    <li class="iwt-usp-item">
                      <div class="iwt-usp-icon" style="width:{{ block.settings.icon_size }}px;height:{{ block.settings.icon_size }}px;background:{{ block.settings.icon_bg }};min-width:{{ block.settings.icon_size }}px;">
                        {%- if block.settings[icon_key] != blank -%}
                          {{- block.settings[icon_key] | image_url: width: 80 | image_tag:
                              loading: 'lazy',
                              style: 'width:' | append: block.settings.icon_size | append: 'px;height:auto;'
                          -}}
                        {%- else -%}
                          <svg width="{{ block.settings.icon_size | times: 0.5 }}" height="{{ block.settings.icon_size | times: 0.5 }}" viewBox="0 0 20 20" fill="{{ block.settings.icon_color }}"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                        {%- endif -%}
                      </div>
                      <div class="iwt-usp-text" style="font-size:{{ block.settings.text_size }}px;color:{{ block.settings.text_color }};">
                        {%- if block.settings[label_key] != blank -%}<span class="iwt-usp-label">{{ block.settings[label_key] }}</span>{%- endif -%}
                        {%- if block.settings[item_key] != blank -%}<span class="iwt-usp-desc">{{ block.settings[item_key] }}</span>{%- endif -%}
                      </div>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'steps_list' -%}
              {%- assign step_num = 0 -%}
              <ol class="iwt-steps-list"
                {{ block.shopify_attributes }}
                style="gap:{{ block.settings.gap }}px;"
              >
                {%- for i in (1..5) -%}
                  {%- assign step_key = 'step_' | append: i -%}
                  {%- if block.settings[step_key] != blank -%}
                    {%- assign step_num = step_num | plus: 1 -%}
                    <li class="iwt-step-item">
                      <div class="iwt-step-num" style="width:{{ block.settings.num_size }}px;height:{{ block.settings.num_size }}px;min-width:{{ block.settings.num_size }}px;background:{{ block.settings.num_bg }};color:{{ block.settings.num_color }};font-size:{{ block.settings.num_font_size }}px;">{{ step_num }}</div>
                      <div class="iwt-step-text" style="font-size:{{ block.settings.text_size }}px;color:{{ block.settings.text_color }};">{{ block.settings[step_key] }}</div>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ol>

            {%- when 'stat_row' -%}
              <div class="iwt-stat-row"
                {{ block.shopify_attributes }}
                style="gap:{{ block.settings.gap }}px;"
              >
                {%- for i in (1..4) -%}
                  {%- assign num_key = 'num_' | append: i -%}
                  {%- assign lbl_key = 'lbl_' | append: i -%}
                  {%- if block.settings[num_key] != blank -%}
                    <div class="iwt-stat-item">
                      <span class="iwt-stat-number" style="font-size:{{ block.settings.num_size }}px;color:{{ block.settings.num_color }};">{{ block.settings[num_key] }}</span>
                      {%- if block.settings[lbl_key] != blank -%}
                        <span class="iwt-stat-label" style="color:{{ block.settings.lbl_color }};">{{ block.settings[lbl_key] }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'pills' -%}
              <div class="iwt-pills" {{ block.shopify_attributes }}>
                {%- for i in (1..6) -%}
                  {%- assign pill_key = 'pill_' | append: i -%}
                  {%- if block.settings[pill_key] != blank -%}
                    <span class="iwt-pill" style="background:{{ block.settings.bg }};color:{{ block.settings.color }};font-size:{{ block.settings.size }}px;border-radius:{{ block.settings.radius }}px;padding:{{ block.settings.pv }}px {{ block.settings.ph }}px;">{{ block.settings[pill_key] }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'button' -%}
              <div class="iwt-btn-wrap" {{ block.shopify_attributes }}>
                <a
                  href="{{ block.settings.url | default: '#' }}"
                  class="iwt-btn"
                  style="background:{{ block.settings.bg }};color:{{ block.settings.color }};border:{{ block.settings.border_width }}px solid {{ block.settings.border_color }};border-radius:{{ block.settings.radius }}px;padding:{{ block.settings.pv }}px {{ block.settings.ph }}px;font-size:{{ block.settings.size }}px;"
                  {% if block.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                >{{ block.settings.label }}</a>
              </div>

            {%- when 'guarantee' -%}
              <div class="iwt-guarantee" {{ block.shopify_attributes }}>
                <div class="iwt-guarantee-icon">
                  {%- if block.settings.icon != blank -%}
                    <img src="{{ block.settings.icon | image_url: width: 80 }}" 
     width="{{ block.settings.icon_size }}" 
     height="{{ block.settings.icon_size }}" 
     style="width:{{ block.settings.icon_size }}px;height:auto;display:block;" 
     loading="lazy" alt="">
                  {%- else -%}
                    <svg width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {%- endif -%}
                </div>
                <div class="iwt-guarantee-text" style="color:{{ block.settings.text_color }};font-size:{{ block.settings.size }}px;">
                  {%- if block.settings.title != blank -%}<span class="iwt-guarantee-title">{{ block.settings.title }}</span>{%- endif -%}
                  {%- if block.settings.desc != blank -%}<span class="iwt-guarantee-desc">{{ block.settings.desc }}</span>{%- endif -%}
                </div>
              </div>

            {%- when 'star_rating' -%}
              <div class="iwt-stars" {{ block.shopify_attributes }}>
                <div class="iwt-stars-icons">
                  {%- for i in (1..5) -%}
                    <svg width="{{ block.settings.star_size }}" height="{{ block.settings.star_size }}" viewBox="0 0 20 20" fill="{{ block.settings.star_color }}"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  {%- endfor -%}
                </div>
                {%- if block.settings.text != blank -%}
                  <span class="iwt-stars-text" style="color:{{ block.settings.text_color }};font-size:{{ block.settings.text_size }}px;">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>

            {%- when 'divider' -%}
              <hr class="iwt-divider"
                {{ block.shopify_attributes }}
                style="border-top:{{ block.settings.thickness }}px {{ block.settings.style }} {{ block.settings.color }};opacity:{{ block.settings.opacity }};"
              >

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

