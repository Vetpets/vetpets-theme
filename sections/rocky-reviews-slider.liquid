    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#fbbf24" },
    { "type": "color", "id": "subheadline_color", "label": "Rating Text", "default": "#a0a0a0" },
    { "type": "color", "id": "quote_color", "label": "Quote Text", "default": "#d4d4d4" },
    { "type": "color", "id": "name_color", "label": "Name", "default": "#ffffff" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#fbbf24" },
    { "type": "color", "id": "verified_color", "label": "Verified Badge", "default": "#4ade80" },
    { "type": "header", "content": "─── Backgrounds ───" },
    { "type": "color", "id": "bg_color", "label": "Section Background", "default": "#111111" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#1a1a1a" },
    { "type": "color", "id": "card_border", "label": "Card Border", "default": "#2a2a2a" },
