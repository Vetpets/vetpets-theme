    { "type": "range", "id": "card_width_desktop", "label": "Card Width Desktop", "min": 280, "max": 420, "step": 5, "default": 340, "unit": "px" },
    { "type": "range", "id": "headline_size_mobile", "label": "Headline Mobile", "min": 20, "max": 42, "step": 1, "default": 26, "unit": "px" },
    { "type": "range", "id": "headline_size_desktop", "label": "Headline Desktop", "min": 28, "max": 56, "step": 1, "default": 38, "unit": "px" },
    { "type": "header", "content": "─── Spacing & Speed ───" },
    { "type": "range", "id": "padding_mobile", "label": "Padding Mobile", "min": 24, "max": 80, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_desktop", "label": "Padding Desktop", "min": 40, "max": 120, "step": 4, "default": 72, "unit": "px" },
    { "type": "range", "id": "scroll_speed", "label": "Scroll Speed", "min": 20, "max": 80, "step": 5, "default": 40, "unit": "s" }
