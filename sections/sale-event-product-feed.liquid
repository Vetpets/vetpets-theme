{%- comment -%}
  Sale-event product feed
  --------------------------
  The core deliverable: a real, shoppable grid of the current collection's
  products (mobile: 1 column, desktop: 2 or 3 columns), reusing the theme's
  existing card design language (see snippets/card-product-sale-event.liquid)
  plus Theme-Editor-placed "editorial insert" blocks between rows.

  Filtering/sorting reuses the theme's own native facets system unmodified -
  same snippets/facets.liquid render call and the same #main-collection-filters /
  #ProductGridContainer / #product-grid(data-id) id contract that
  sections/main-collection-product-grid.liquid already uses, so assets/facets.js
  (already loaded globally, not duplicated here) can AJAX-swap this grid exactly
  like it does the native grid. Pagination reuses snippets/pagination.liquid.

  Editorial insert positioning is evaluated against the CURRENT PAGE's product
  index (pagination-relative), which is deterministic per page. If a configured
  position number is beyond the current page's product count, that block simply
  does not render on that page - no error, no broken layout.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign inserts = section.blocks | where: 'type', 'editorial_insert'

  assign feed_collection = st.collection
  if feed_collection == blank
    assign feed_collection = collection
  endif

  assign columns_desktop = st.columns_desktop | default: 3
-%}

<section class="vp-se-feed" id="{{ st.anchor_id | default: 'product-feed' }}" style="--vp-se-feed-columns: {{ columns_desktop }};">
  <div class="vp-se-feed__inner page-width">
    {%- if st.heading != blank -%}
      <div class="vp-se-feed__heading-wrap">
        <h2 class="vp-se-feed__heading">{{ st.heading | escape }}</h2>
        {%- if st.subheading != blank -%}
          <p class="vp-se-feed__subheading">{{ st.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if feed_collection == blank or feed_collection.products.size == 0 -%}
      <p class="vp-se-feed__empty">{{ 'sections.collection_template.empty' | t }}</p>
    {%- else -%}
      {%- if st.enable_filtering or st.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless st.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: feed_collection,
            enable_filtering: st.enable_filtering,
            enable_sorting: st.enable_sorting,
            filter_type: st.filter_type
          %}
        </aside>
      {%- endif -%}

      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

      <div class="product-grid-container" id="ProductGridContainer">
        {%- paginate feed_collection.products by st.products_per_page -%}
          <div
            class="vp-se-feed__grid"
            id="product-grid"
            data-id="{{ section.id }}"
          >
            {%- for product in feed_collection.products -%}
              {%- liquid
                assign columns_int = columns_desktop | times: 1
                assign lazy = true
                if forloop.index <= columns_int
                  assign lazy = false
                endif

                assign row_numerator = forloop.index | plus: columns_int | minus: 1
                assign current_row = row_numerator | divided_by: columns_int

                assign row_mod = forloop.index0 | modulo: columns_int
                assign row_boundary = columns_int | minus: 1
                assign completes_row = false
                if row_mod == row_boundary
                  assign completes_row = true
                endif
              -%}

              {% render 'card-product-sale-event',
                card_product: product,
                lazy_load: lazy,
                enable_quick_add: st.enable_quick_add,
                section_id: section.id
              %}

              {%- for block in inserts -%}
                {%- assign bs = block.settings -%}
                {%- liquid
                  assign should_render_insert = false
                  if bs.position_mode == 'after_product' and forloop.parentloop.index == bs.position_value
                    assign should_render_insert = true
                  elsif bs.position_mode == 'after_row' and completes_row and current_row == bs.position_value
                    assign should_render_insert = true
                  endif
                -%}
                {%- if should_render_insert -%}
                  {%- render 'sale-event-editorial-insert', block: block, section_id: section.id -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate, anchor: '' %}
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- style -%}
  .vp-se-feed {
    font-family: var(--font-body-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
    padding-block: 32px;
    overflow-x: hidden;
  }

  .vp-se-feed__heading-wrap { text-align: center; margin-bottom: 24px; }

  .vp-se-feed__heading {
    font-family: var(--font-heading-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
    font-size: clamp(22px, 3vw, 30px);
    color: #0F172A;
    margin: 0 0 6px;
  }

  .vp-se-feed__subheading { margin: 0; color: #0F172A; opacity: 0.75; }

  .vp-se-feed__empty { text-align: center; padding: 40px 0; }

  .vp-se-feed__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px 16px;
    margin-top: 16px;
  }

  @media (min-width: 750px) {
    .vp-se-feed__grid {
      grid-template-columns: repeat(var(--vp-se-feed-columns, 3), 1fr);
    }
  }

  /* Card */
  .vp-se-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(16, 35, 43, 0.07);
    background: #ffffff;
  }

  .vp-se-card__media-link { display: block; }

  .vp-se-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #F1F5F9;
  }

  .vp-se-card__image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vp-se-card__image--placeholder { padding: 24px; }

  .vp-se-card__label {
    position: absolute;
    top: 10px;
    left: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #13B6B5;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
  }

  .vp-se-card__label--sale {
    left: auto;
    right: 10px;
    background: #ffffff;
    color: #0F172A;
  }

  .vp-se-card__label-icon { width: 10px; height: 10px; }

  .vp-se-card__body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .vp-se-card__benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vp-se-card__benefit {
    padding: 3px 10px;
    border-radius: 999px;
    background: #D5F7FF;
    color: #0F172A;
    font-size: 11px;
    font-weight: 600;
  }

  .vp-se-card__title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }

  .vp-se-card__title-link {
    color: #0F172A;
    text-decoration: none;
  }
  .vp-se-card__title-link:hover { text-decoration: underline; }

  .vp-se-card__stars {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .vp-se-card__star { width: 15px; height: 15px; color: #FBBF24; }
  .vp-se-card__star--empty { color: #E2E8F0; }
  .vp-se-card__star-wrap { position: relative; display: inline-block; width: 15px; height: 15px; overflow: hidden; }
  .vp-se-card__star-clip { position: absolute; inset: 0; width: 50%; overflow: hidden; }
  .vp-se-card__stars-count { font-size: 12px; color: #0F172A; opacity: 0.6; margin-left: 2px; }

  .vp-se-card__price { font-size: 15px; color: #0F172A; }
  .vp-se-card__price .price__sale .price-item--regular { text-decoration: line-through; opacity: 0.6; }

  .vp-se-card__foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .vp-se-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 999px;
    background: #D5F7FF;
    color: #0F172A;
    font-size: 11px;
    font-weight: 600;
  }
  .vp-se-card__badge-icon { width: 13px; height: 13px; }

  .vp-se-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 10px 16px;
    border-radius: 999px;
    background: #47B5E9;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }
  .vp-se-card__cta:hover { opacity: 0.88; }
  .vp-se-card__cta:focus-visible { outline: 2px solid #0F172A; outline-offset: 2px; }
  .vp-se-card__cta .loading-overlay__spinner { width: 16px; height: 16px; }
  .vp-se-card__cta .loading-overlay__spinner .spinner { width: 100%; height: 100%; animation: vp-se-spin 0.8s linear infinite; }
  .vp-se-card__cta .loading-overlay__spinner .path { stroke: currentColor; }

  @keyframes vp-se-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .vp-se-card__cta { transition: none; }
    .vp-se-card__cta .loading-overlay__spinner .spinner { animation: none; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Sale-event product feed",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "product-feed", "info": "Used by nav-chip anchor links." },
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "text", "id": "subheading", "label": "Subheading (optional)" },
    { "type": "collection", "id": "collection", "label": "Product source", "info": "Leave blank to use the collection this template is assigned to." },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "columns_desktop", "label": "Desktop columns", "default": "3", "options": [
      { "value": "2", "label": "2 columns" },
      { "value": "3", "label": "3 columns" }
    ] },
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 24 },

    { "type": "header", "content": "Filtering and sorting" },
    { "type": "paragraph", "content": "Reuses the theme's existing filter/sort system - the same one used on the standard collection grid." },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "default": false },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "select", "id": "filter_type", "label": "Filter layout", "default": "horizontal", "options": [
      { "value": "horizontal", "label": "Horizontal" },
      { "value": "vertical", "label": "Vertical" },
      { "value": "drawer", "label": "Drawer" }
    ] },

    { "type": "header", "content": "Cards" },
    { "type": "checkbox", "id": "enable_quick_add", "label": "Enable quick add-to-cart on cards", "default": false, "info": "Only used for products with a single variant; other products link through to the product page." }
  ],
  "blocks": [
    {
      "type": "editorial_insert",
      "name": "Editorial insert",
      "settings": [
        { "type": "header", "content": "Position" },
        { "type": "select", "id": "position_mode", "label": "Position mode", "default": "after_product", "options": [
          { "value": "after_product", "label": "After product number" },
          { "value": "after_row", "label": "After row number" }
        ] },
        { "type": "number", "id": "position_value", "label": "Position value", "default": 6, "info": "Relative to the products shown on the current page. If the page has fewer products than this position, the insert is skipped on that page." },

        { "type": "header", "content": "Content" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "body", "label": "Body text" },
        { "type": "text", "id": "cta_label", "label": "CTA label" },
        { "type": "url", "id": "cta_link", "label": "CTA link" },

        { "type": "header", "content": "Media" },
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "video", "id": "video", "label": "Shopify-hosted video (optional)" },
        { "type": "image_picker", "id": "video_poster", "label": "Video poster / fallback" },
        { "type": "checkbox", "id": "video_autoplay", "label": "Autoplay video (muted, looped)", "default": false },
        { "type": "checkbox", "id": "video_loop", "label": "Loop video", "default": true },
        { "type": "checkbox", "id": "video_controls", "label": "Show video controls", "default": true },
        { "type": "select", "id": "aspect_ratio", "label": "Media aspect ratio", "default": "landscape", "options": [
          { "value": "landscape", "label": "Landscape (16:9)" },
          { "value": "square", "label": "Square (1:1)" },
          { "value": "portrait", "label": "Portrait (4:5)" }
        ] },

        { "type": "header", "content": "Layout" },
        { "type": "select", "id": "width_mode", "label": "Width", "default": "full", "options": [
          { "value": "full", "label": "Full-width (spans the grid)" },
          { "value": "grid", "label": "Grid-width (one column)" }
        ] },
        { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" },
          { "value": "right", "label": "Right" }
        ] },
        { "type": "color", "id": "color_background", "label": "Background color", "default": "#D5F7FF" },
        { "type": "color", "id": "color_text", "label": "Text color", "default": "#0F172A" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Sale-event product feed"
    }
  ]
}
{% endschema %}
