<div style="min-height:100vh;background:#FFFFFF">

  <div data-screen-label="Quiz header" style="position:sticky;top:0;z-index:30;background:#FFFFFF;border-bottom:1px solid rgba(71,181,233,.18)">
    <div class="wrap" style="max-width:980px;display:grid;grid-template-columns:88px minmax(0,1fr) 88px;align-items:center;height:56px">
      <div style="display:flex;align-items:center">
        <sc-if value="{{ showBack }}" hint-placeholder-val="{{ false }}">
          <button type="button" onClick="{{ goBack }}" style="display:flex;align-items:center;gap:6px;min-height:44px;padding:0 6px 0 0;background:transparent;border:none;font-family:inherit;font-size:15px;font-weight:600;color:#2E9FD8;cursor:pointer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 5 8 12l6.5 7" stroke="#47B5E9" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span>Back</span>
          </button>
        </sc-if>
      </div>
      <div style="display:flex;justify-content:center"><img src="assets/vetpets-logo.png" alt="VetPets" style="display:block;height:24px;width:auto"></div>
      <div style="text-align:right;font-size:13px;font-weight:600;color:rgba(18,18,18,.6);white-space:nowrap">{{ stepLabel }}</div>
    </div>
    <div style="height:6px;background:#D5F7FF">
      <div style="height:100%;width:{{ progressPct }};background:linear-gradient(90deg,#47B5E9,#2E9FD8);border-radius:0 999px 999px 0;transition:width 260ms ease-out"></div>
    </div>
  </div>

  <sc-if value="{{ isNames }}" hint-placeholder-val="{{ true }}">
    <section data-screen-label="Question 1 — What is your pet’s name?" style="background:linear-gradient(180deg,#FFFFFF 0%,#EDFAFF 70%,#D5F7FF 100%);min-height:calc(100vh - 63px);padding:26px 0 48px;box-sizing:border-box">
      <div class="wrap" style="display:flex;flex-direction:column;gap:20px">
        <div style="display:flex;flex-direction:column;align-items:flex-start;gap:10px">
          <span style="display:inline-block;background:#D5F7FF;color:#2E9FD8;font-size:11.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:7px 14px;border-radius:999px">Your personalised dental-care routine</span>
          <p class="lede" style="font-size:15px;line-height:1.5">Answer a few quick questions about your pet to get a personalised dental-care routine for cleaner teeth and fresher breath.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px">
          <div style="font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#2E9FD8">{{ namesEyebrow }}</div>
          <h1 style="margin:0;font-size:clamp(28px,3.2vw,34px);line-height:1.12;letter-spacing:-0.02em;font-weight:700;color:#121212;text-wrap:pretty">What is your pet’s name?</h1>
        </div>
        <div style="display:flex;flex-direction:column;gap:14px">
          <sc-for list="{{ nameFields }}" as="f" hint-placeholder-count="1">
            <label style="display:flex;flex-direction:column;gap:7px">
              <span style="font-size:15px;font-weight:700;color:#121212">{{ f.label }}</span>
              <span style="display:flex;align-items:center;gap:8px">
                <input type="text" value="{{ f.value }}" onChange="{{ f.onChange }}" onKeyDown="{{ onNameKey }}" placeholder="{{ f.placeholder }}" maxLength="30" autoComplete="off" spellCheck="false" style="flex:1;min-width:0;height:58px;box-sizing:border-box;padding:0 18px;background:#FFFFFF;border:2px solid rgba(71,181,233,.4);border-radius:16px;font-family:inherit;font-size:18px;font-weight:600;color:#121212;outline:none;box-shadow:0 4px 14px rgba(71,181,233,.10)" style-focus="border-color:#47B5E9">
                <sc-if value="{{ f.removable }}" hint-placeholder-val="{{ false }}">
                  <button type="button" onClick="{{ f.onRemove }}" aria-label="{{ f.removeLabel }}" style="width:48px;height:48px;flex-shrink:0;border-radius:50%;border:1.5px solid rgba(71,181,233,.4);background:#FFFFFF;color:#2E9FD8;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path></svg></button>
                </sc-if>
              </span>
            </label>
          </sc-for>
          <sc-if value="{{ canAddDog }}" hint-placeholder-val="{{ true }}">
            <button type="button" onClick="{{ addDog }}" style="align-self:flex-start;display:flex;align-items:center;gap:8px;min-height:44px;padding:0 4px;background:transparent;border:none;font-family:inherit;font-size:16px;font-weight:700;color:#2E9FD8;cursor:pointer">+ Add another pet</button>
          </sc-if>
        </div>
        <div style="display:flex;flex-direction:column;align-items:center;gap:6px">
          <button type="button" class="cta" onClick="{{ namesContinue }}" style="display:flex;align-items:center;justify-content:center;width:100%;min-height:56px;box-sizing:border-box;background:#47B5E9;color:#FFFFFF;border:none;font-family:inherit;font-size:16px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;padding:0 22px;border-radius:999px;box-shadow:0 10px 24px rgba(71,181,233,.42);cursor:pointer" style-hover="background:#2E9FD8">Let’s personalise their routine →</button>
          <button type="button" onClick="{{ namesSkip }}" style="min-height:44px;padding:0 12px;background:transparent;border:none;font-family:inherit;font-size:15px;font-weight:600;color:rgba(18,18,18,.62);text-decoration:underline;text-underline-offset:3px;cursor:pointer">Skip</button>
        </div>
        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;font-size:13.5px;font-weight:600;color:#121212;text-align:center">
          <span><span class="stars">★★★★★</span>&nbsp; 60,000 happy pet owners</span>
          <span>No email or account needed</span>
        </div>
      </div>
    </section>
  </sc-if>

  <sc-if value="{{ isChoice }}" hint-placeholder-val="{{ false }}">
    <section data-screen-label="{{ q.screenLabel }}" style="background:linear-gradient(180deg,#FFFFFF 0%,#EDFAFF 70%,#D5F7FF 100%);min-height:calc(100vh - 63px);padding:26px 0 48px;box-sizing:border-box">
      <div class="wrap" style="display:flex;flex-direction:column;gap:20px">
        <sc-if value="{{ showMigrated }}" hint-placeholder-val="{{ false }}">
          <div role="status" style="display:flex;align-items:flex-start;gap:10px;background:#FFFFFF;border:1.5px solid rgba(71,181,233,.45);border-radius:14px;padding:12px 14px">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="9.5" fill="#47B5E9"></circle><path d="M12 10.5v6" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round"></path><circle cx="12" cy="7.4" r="1.4" fill="#FFFFFF"></circle></svg>
            <p style="margin:0;font-size:14.5px;line-height:1.45;color:#121212;text-wrap:pretty">{{ migratedLine }}</p>
          </div>
        </sc-if>
        <div style="display:flex;flex-direction:column;gap:8px">
          <div style="font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#2E9FD8">{{ q.eyebrow }}</div>
          <h1 style="margin:0;font-size:clamp(28px,3.2vw,34px);line-height:1.12;letter-spacing:-0.02em;font-weight:700;color:#121212;text-wrap:pretty;overflow-wrap:anywhere">{{ q.title }}</h1>
          <p class="lede">{{ q.helper }}</p>
        </div>
        <div role="group" aria-label="{{ q.title }}" style="display:flex;flex-direction:column;gap:12px">
          <sc-for list="{{ q.options }}" as="o" hint-placeholder-count="4">
            <button class="opt" type="button" onClick="{{ o.onPick }}" aria-pressed="{{ o.pressed }}" style="display:flex;align-items:center;gap:14px;width:100%;min-height:68px;box-sizing:border-box;padding:13px 18px;background:{{ o.bg }};border:2px solid {{ o.border }};border-radius:16px;box-shadow:0 4px 14px rgba(71,181,233,.10);font-family:inherit;text-align:left;cursor:pointer;color:#121212">
              <span style="display:flex;flex-direction:column;gap:3px;flex:1;min-width:0">
                <span style="font-size:18px;font-weight:600;line-height:1.25;overflow-wrap:anywhere">{{ o.label }}</span>
                <sc-if value="{{ o.hasSub }}" hint-placeholder-val="{{ false }}">
                  <span style="font-size:14px;font-weight:500;line-height:1.35;color:rgba(18,18,18,.62)">{{ o.sub }}</span>
                </sc-if>
              </span>
              <span style="width:26px;height:26px;box-sizing:border-box;border-radius:{{ o.radius }};border:2px solid #47B5E9;background:{{ o.dot }};display:flex;align-items:center;justify-content:center;flex-shrink:0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12.5 5 5 9-11" stroke="#FFFFFF" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </span>
            </button>
          </sc-for>
        </div>
        <sc-if value="{{ q.multi }}" hint-placeholder-val="{{ false }}">
          <button type="button" class="cta" onClick="{{ q.onContinue }}" aria-disabled="{{ q.contDisabled }}" style="display:flex;align-items:center;justify-content:center;width:100%;min-height:56px;box-sizing:border-box;background:{{ q.contBg }};color:#FFFFFF;border:none;font-family:inherit;font-size:16px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;padding:0 22px;border-radius:999px;cursor:pointer">Continue →</button>
        </sc-if>
        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;font-size:13.5px;font-weight:600;color:#121212;text-align:center">
          <span><span class="stars">★★★★★</span>&nbsp; 60,000 happy pet owners</span>
          <span>100-Day Money-Back Guarantee</span>
        </div>
      </div>
    </section>
  </sc-if>

