{%- comment -%}
  FreshWipes personalised quiz lander
  ===================================
  GENERATED by scripts/build-freshwipes-quiz.py from the founder-approved Claude Design
  export "FreshWipes Quiz v4" (project "EyeWipes reference page and assets").
  Edit the design or the build script, not the template/logic blocks below.

  Rendered only through templates/product.freshwipes-quiz.json, an alternate view of the
  existing FreshWipes product:
    /products/freshwipes-kit-protects-against-dental-diseases?view=freshwipes-quiz
  The default PDP, the offer pages and the pre-lander are untouched.

  HOW IT RUNS
  The design's own template (<x-dc>) and logic (<script data-dc-script>) run on Claude
  Design's runtime (assets/fwq-dc-runtime.js, unmodified) with React 18.3.1 from theme
  assets (assets/fwq-react*.js, byte-identical to the SRI-pinned unpkg builds). No Babel
  and no CDN. The runtime mounts only inside its own <div id="dc-root">.

  COMMERCE OWNERSHIP
  Kaching Bundles owns deal, quantity, price, selling plan and free gifts. Its real app
  block and the theme <product-form> sit in #fwq-commerce (not painted). The quiz reads
  every price from Kaching and adds to cart through that form via window.FWQK
  (assets/fwq-kaching.js); Kaching rewrites the request; the theme cart drawer opens.

  ATTRIBUTION
  The quiz never changes the URL (history.pushState keeps the address), so utm_* and
  click ids stay on the page through to the cart, as on every other storefront page.
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign product_form_id = 'fwq-product-form-' | append: section.id
  assign fwq_base = 'fwq-kaching.js' | asset_url | split: 'fwq-kaching.js' | first | append: 'fwq-'
  assign fwq_qbase = '"' | append: fwq_base
-%}
{{ 'fwq-quiz.css' | asset_url | stylesheet_tag }}

<div id="freshwipes-quiz" data-deal-ids="{{ section.settings.deal_bundle_1 | escape }}|{{ section.settings.deal_bundle_2 | escape }}">

  {%- comment -%} Static first screen shown until the quiz runtime has mounted (same markup as question 1). {%- endcomment -%}
  <div class="fwq-boot" aria-hidden="true">
    <div style="position:sticky;top:0;z-index:30;background:#FFFFFF;border-bottom:1px solid rgba(71,181,233,.18)">
      <div class="wrap" style="max-width:980px;display:grid;grid-template-columns:88px minmax(0,1fr) 88px;align-items:center;height:56px">
        <div></div>
        <div style="display:flex;justify-content:center"><img src="{{ 'fwq-vetpets-logo.png' | asset_url }}" alt="VetPets" style="display:block;height:24px;width:auto"></div>
        <div style="text-align:right;font-size:13px;font-weight:600;color:rgba(18,18,18,.6);white-space:nowrap">1 of 4</div>
      </div>
      <div style="height:6px;background:#D5F7FF"><div style="height:100%;width:20%;background:linear-gradient(90deg,#47B5E9,#2E9FD8);border-radius:0 999px 999px 0"></div></div>
    </div>
    <section style="background:linear-gradient(180deg,#FFFFFF 0%,#EDFAFF 70%,#D5F7FF 100%);min-height:calc(100vh - 63px);padding:26px 0 48px;box-sizing:border-box">
      <div class="wrap" style="display:flex;flex-direction:column;gap:20px">
        <div style="display:flex;flex-direction:column;align-items:flex-start;gap:10px">
          <span style="display:inline-block;background:#D5F7FF;color:#2E9FD8;font-size:11.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:7px 14px;border-radius:999px">Your personalised dental-care routine</span>
          <p class="lede" style="font-size:15px;line-height:1.5">Answer a few quick questions about your pet to get a personalised dental-care routine for cleaner teeth and fresher breath.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px">
          <div style="font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#2E9FD8">Question 1 of 4</div>
          <div style="margin:0;font-size:clamp(28px,3.2vw,34px);line-height:1.12;letter-spacing:-0.02em;font-weight:700;color:#121212">What is your pet’s name?</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:7px">
          <span style="font-size:15px;font-weight:700;color:#121212">Your pet's name</span>
          <span style="display:block;height:58px;box-sizing:border-box;background:#FFFFFF;border:2px solid rgba(71,181,233,.4);border-radius:16px;box-shadow:0 4px 14px rgba(71,181,233,.10)"></span>
        </div>
        <span class="cta" style="display:flex;align-items:center;justify-content:center;width:100%;min-height:56px;box-sizing:border-box;background:#47B5E9;color:#FFFFFF;font-size:16px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;padding:0 22px;border-radius:999px;box-shadow:0 10px 24px rgba(71,181,233,.42)">Let’s personalise their routine →</span>
      </div>
    </section>
  </div>

