{%- comment -%}
  Sale-event banner
  --------------------
  Configurable campaign banner with four modes: text-only, image-only,
  split (text + image), and background image with a text overlay card.
  Visual reference: Claude Design project "VetPets sale-event collection page"
  (bc120b61-4aa0-4ef8-8918-267c0fb182df), artboard "Sale Event Collection.dc.html".
  Ships with no default image - the section must look correct with text only,
  and text-only mode stays compact (no large empty hero area).
  Isolated, prefix vp-se-banner__.

  Optional content blocks (appended after the button, in the order the
  merchant arranges them): review stars, a guarantee box, and a small
  supporting offer line. None are added by default and none fabricate
  review counts or claims - review text/count ship blank.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign mode = st.mode | default: 'text_only'
  assign has_desktop_image = false
  if st.desktop_image != blank
    assign has_desktop_image = true
  endif

  assign width_class = 'vp-se-banner--width-' | append: st.width_mode
  assign height_class_d = 'vp-se-banner--h-d-' | append: st.desktop_height
  assign height_class_m = 'vp-se-banner--h-m-' | append: st.mobile_height

  assign custom_width_style = ''
  if st.width_mode == 'custom'
    assign custom_width_style = 'max-width:' | append: st.custom_max_width | append: 'px;'
  endif

  assign desktop_focal = st.focal_point
  if st.desktop_image.presentation.focal_point
    assign desktop_focal = st.desktop_image.presentation.focal_point
  endif
  assign mobile_focal = desktop_focal
  if st.mobile_image.presentation.focal_point
    assign mobile_focal = st.mobile_image.presentation.focal_point
  endif
-%}

<section
  class="vp-se-banner vp-se-banner--{{ mode }} {{ width_class }} {{ height_class_d }} {{ height_class_m }} vp-se-banner--content-h-{{ st.content_horizontal_position }}{% if st.border_radius_enabled %} vp-se-banner--radius{% endif %}{% if st.shadow_enabled %} vp-se-banner--shadow{% endif %}{% if st.border_enabled %} vp-se-banner--border{% endif %}"
  style="
    --vp-se-banner-bg: {{ st.color_background }};
    --vp-se-banner-eyebrow-bg: {{ st.color_eyebrow_bg }};
    --vp-se-banner-eyebrow-text: {{ st.color_eyebrow_text }};
    --vp-se-banner-heading: {{ st.color_heading }};
    --vp-se-banner-body: {{ st.color_body }};
    --vp-se-banner-btn-bg: {{ st.color_button_bg }};
    --vp-se-banner-btn-text: {{ st.color_button_text }};
    --vp-se-banner-btn-hover-bg: {{ st.color_button_hover_bg }};
    --vp-se-banner-btn-hover-text: {{ st.color_button_hover_text }};
    --vp-se-banner-overlay-color: {{ st.overlay_color }};
    --vp-se-banner-overlay-opacity: {{ st.overlay_opacity | divided_by: 100.0 }};
    --vp-se-banner-border-color: {{ st.border_color }};
    --vp-se-banner-radius: {{ st.border_radius }}px;
    --vp-se-banner-text-max-width: {{ st.text_max_width }}ch;
    --vp-se-banner-desktop-height-custom: {{ st.desktop_height_custom }}px;
    --vp-se-banner-mobile-height-custom: {{ st.mobile_height_custom }}px;
    --vp-se-banner-desktop-min-height: {{ st.desktop_min_height }}px;
    --vp-se-banner-mobile-min-height: {{ st.mobile_min_height }}px;
    --vp-se-banner-padding-top-d: {{ st.desktop_padding_top }}px;
    --vp-se-banner-padding-bottom-d: {{ st.desktop_padding_bottom }}px;
    --vp-se-banner-padding-top-m: {{ st.mobile_padding_top }}px;
    --vp-se-banner-padding-bottom-m: {{ st.mobile_padding_bottom }}px;
    --vp-se-banner-eyebrow-fs-d: {{ st.eyebrow_font_size_desktop }}px;
    --vp-se-banner-eyebrow-fs-m: {{ st.eyebrow_font_size_mobile }}px;
    --vp-se-banner-heading-fs-d: {{ st.heading_font_size_desktop }}px;
    --vp-se-banner-heading-fs-m: {{ st.heading_font_size_mobile }}px;
    --vp-se-banner-body-fs-d: {{ st.body_font_size_desktop }}px;
    --vp-se-banner-body-fs-m: {{ st.body_font_size_mobile }}px;
    --vp-se-banner-button-fs-d: {{ st.button_font_size_desktop }}px;
    --vp-se-banner-button-fs-m: {{ st.button_font_size_mobile }}px;
    {% if custom_width_style != '' %}{{ custom_width_style }}{% endif %}
  "
  data-vp-se-banner-mode="{{ mode }}"
>
  <div class="vp-se-banner__frame">
    {%- if mode == 'image_only' or mode == 'split' or mode == 'background_overlay' -%}
      <div class="vp-se-banner__media{% if mode == 'split' and st.split_image_position == 'left' %} vp-se-banner__media--order-first{% endif %}">
        {%- if has_desktop_image -%}
          {%- liquid
            assign desktop_image_style = 'object-fit:' | append: st.object_fit | append: '; object-position:' | append: desktop_focal | append: ';'
            assign mobile_image_style = 'object-fit:' | append: st.object_fit | append: '; object-position:' | append: mobile_focal | append: ';'
          -%}
          {{
            st.desktop_image
            | image_url: width: 2000
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750,1100,1500,2000',
              sizes: '100vw',
              class: 'vp-se-banner__image vp-se-banner__image--desktop',
              style: desktop_image_style,
              alt: st.heading | default: ''
          }}
          {%- if st.mobile_image != blank -%}
            {{
              st.mobile_image
              | image_url: width: 900
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '480,640,900',
                sizes: '100vw',
                class: 'vp-se-banner__image vp-se-banner__image--mobile',
                style: mobile_image_style,
                alt: st.heading | default: ''
            }}
          {%- endif -%}
          {%- if mode == 'background_overlay' and st.overlay_enabled -%}
            <div class="vp-se-banner__overlay"></div>
          {%- endif -%}
        {%- else -%}
          <div class="vp-se-banner__media-empty" role="presentation"></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if mode != 'image_only' -%}
      <div class="vp-se-banner__content vp-se-banner__content--align-{{ st.text_alignment }} vp-se-banner__content--pos-{{ st.content_position }}">
        {%- if st.eyebrow != blank -%}
          <p class="vp-se-banner__eyebrow">{{ st.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if st.heading != blank -%}
          <h1 class="vp-se-banner__heading">{{ st.heading | escape }}</h1>
        {%- endif -%}
        {%- if st.body != blank -%}
          <div class="vp-se-banner__body rte">{{ st.body }}</div>
        {%- endif -%}
        {%- if st.button_label != blank -%}
          <a href="{{ st.button_link | default: '#' }}" class="vp-se-banner__button">{{ st.button_label | escape }}</a>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'review_stars' -%}
              {%- liquid
                assign bs = block.settings
                assign rs_rating = bs.rating | default: 0 | at_most: 5 | at_least: 0
                assign rs_full = rs_rating | floor
                assign rs_rest = rs_rating | minus: rs_full
                assign rs_half_at = rs_full | plus: 1
              -%}
              {%- if bs.enabled and rs_rating > 0 -%}
                <div
                  class="vp-se-banner__reviews vp-se-banner__reviews--{{ bs.alignment }}"
                  style="--vp-se-banner-star-size-d: {{ bs.star_size_desktop }}px; --vp-se-banner-star-size-m: {{ bs.star_size_mobile }}px; --vp-se-banner-star-color: {{ bs.star_color }}; --vp-se-banner-review-text-color: {{ bs.review_text_color }};"
                  {{ block.shopify_attributes }}
                >
                  <span class="vp-se-banner__stars" role="img" aria-label="{{ rs_rating }} out of 5 stars">
                    {%- for i in (1..5) -%}
                      {%- if i <= rs_full -%}
                        <svg class="vp-se-banner__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.5l2.47 5.2 5.53.79-4 4.02.95 5.72L10 14.53 5.05 17.23l.95-5.72-4-4.02 5.53-.79L10 1.5z"/></svg>
                      {%- elsif rs_rest >= 0.5 and i == rs_half_at -%}
                        <span class="vp-se-banner__star vp-se-banner__star-wrap">
                          <svg class="vp-se-banner__star vp-se-banner__star--empty" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.5l2.47 5.2 5.53.79-4 4.02.95 5.72L10 14.53 5.05 17.23l.95-5.72-4-4.02 5.53-.79L10 1.5z"/></svg>
                          <span class="vp-se-banner__star-clip"><svg class="vp-se-banner__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.5l2.47 5.2 5.53.79-4 4.02.95 5.72L10 14.53 5.05 17.23l.95-5.72-4-4.02 5.53-.79L10 1.5z"/></svg></span>
                        </span>
                      {%- else -%}
                        <svg class="vp-se-banner__star vp-se-banner__star--empty" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.5l2.47 5.2 5.53.79-4 4.02.95 5.72L10 14.53 5.05 17.23l.95-5.72-4-4.02 5.53-.79L10 1.5z"/></svg>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                  {%- if bs.review_text != blank -%}
                    <span class="vp-se-banner__review-text">{{ bs.review_text | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'guarantee_box' -%}
              {%- liquid
                assign bs = block.settings
                assign has_gb_content = false
                if bs.heading != blank or bs.text != blank
                  assign has_gb_content = true
                endif
              -%}
              {%- if bs.enabled and has_gb_content -%}
                {%- assign gb_tag = 'div' -%}
                {%- if bs.link != blank -%}{%- assign gb_tag = 'a' -%}{%- endif -%}
                <{{ gb_tag }}
                  {% if bs.link != blank %}href="{{ bs.link }}"{% endif %}
                  class="vp-se-banner__guarantee vp-se-banner__guarantee--{{ bs.layout }}"
                  style="
                    --vp-se-banner-guarantee-bg: {{ bs.color_background }};
                    --vp-se-banner-guarantee-text: {{ bs.color_text }};
                    --vp-se-banner-guarantee-border: {{ bs.color_border }};
                    --vp-se-banner-guarantee-radius: {{ bs.border_radius }}px;
                    --vp-se-banner-guarantee-icon-size: {{ bs.icon_size }}px;
                    {% if bs.width_desktop > 0 %}--vp-se-banner-guarantee-width-d: {{ bs.width_desktop }}px;{% endif %}
                    {% if bs.width_mobile > 0 %}--vp-se-banner-guarantee-width-m: {{ bs.width_mobile }}px;{% endif %}
                  "
                  {{ block.shopify_attributes }}
                >
                  {%- if bs.custom_image != blank -%}
                    <span class="vp-se-banner__guarantee-icon">{{ bs.custom_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}</span>
                  {%- elsif bs.icon != 'none' -%}
                    <span class="vp-se-banner__guarantee-icon">
                      {%- case bs.icon -%}
                        {%- when 'shield' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
                        {%- when 'check_circle' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 5-5"/></svg>
                        {%- when 'badge' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="6"/><path d="M9 14.5L7 22l5-3 5 3-2-7.5"/></svg>
                        {%- when 'clock' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
                      {%- endcase -%}
                    </span>
                  {%- endif -%}
                  <span class="vp-se-banner__guarantee-copy">
                    {%- if bs.heading != blank -%}<span class="vp-se-banner__guarantee-heading">{{ bs.heading | escape }}</span>{%- endif -%}
                    {%- if bs.text != blank -%}<span class="vp-se-banner__guarantee-text">{{ bs.text | escape }}</span>{%- endif -%}
                  </span>
                </{{ gb_tag }}>
              {%- endif -%}

            {%- when 'offer_line' -%}
              {%- liquid
                assign bs = block.settings
              -%}
              {%- if bs.text != blank -%}
                <p
                  class="vp-se-banner__offer-line"
                  style="--vp-se-banner-offer-fs-d: {{ bs.font_size_desktop }}px; --vp-se-banner-offer-fs-m: {{ bs.font_size_mobile }}px; --vp-se-banner-offer-text-color: {{ bs.color_text }}; --vp-se-banner-offer-icon-color: {{ bs.color_icon }};"
                  {{ block.shopify_attributes }}
                >
                  {%- if bs.icon != 'none' -%}
                    <span class="vp-se-banner__offer-icon">
                      {%- case bs.icon -%}
                        {%- when 'gift' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                        {%- when 'truck' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="1" y="6" width="14" height="11"/><path d="M15 10h4l4 4v3h-8z"/><circle cx="6" cy="19" r="2"/><circle cx="17" cy="19" r="2"/></svg>
                        {%- when 'tag' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0l-7.2-7.2a2 2 0 0 1-.6-1.4V4.4a2 2 0 0 1 2-2h7.6a2 2 0 0 1 1.4.6l6.8 6.8a2 2 0 0 1 0 2.8z"/><circle cx="8" cy="8" r="1.2" fill="currentColor"/></svg>
                      {%- endcase -%}
                    </span>
                  {%- endif -%}
                  {{ bs.text | escape }}
                </p>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%}
        image_only mode has no visible content block, so it has no visible
        heading either - but the page still needs exactly one real <h1> for
        accessibility and SEO. Reuses the same "heading" setting other modes
        already use (falling back to the collection's own title when it's
        blank), rendered visually-hidden with the theme's existing
        .visually-hidden utility (clip-rect, not display:none, so it stays
        in the accessibility tree and is crawlable) rather than shown on
        top of the image.
      {%- endcomment -%}
      {%- assign hidden_h1_text = st.heading | default: collection.title -%}
      {%- if hidden_h1_text != blank -%}
        <h1 class="visually-hidden">{{ hidden_h1_text | escape }}</h1>
      {%- endif -%}
      {%- if st.button_label != blank and st.button_link != blank -%}
        <a href="{{ st.button_link }}" class="vp-se-banner__image-link" aria-label="{{ st.button_label | escape }}"></a>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{%- style -%}
  .vp-se-banner {
    background: var(--vp-se-banner-bg, #D5F7FF);
    font-family: var(--font-body-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
    padding-top: var(--vp-se-banner-padding-top-m, 32px);
    padding-bottom: var(--vp-se-banner-padding-bottom-m, 32px);
    overflow: hidden;
  }
  .vp-se-banner--radius { border-radius: var(--vp-se-banner-radius, 14px); }
  .vp-se-banner--shadow { box-shadow: 0 6px 18px rgba(13, 35, 64, 0.08); }
  .vp-se-banner--border { border: 1px solid var(--vp-se-banner-border-color, rgba(15,23,42,.1)); }

  .vp-se-banner__frame {
    margin-inline: auto;
    padding-inline: 24px;
  }
  .vp-se-banner--width-full_bleed .vp-se-banner__frame { max-width: none; padding-inline: 0; }
  .vp-se-banner--width-full_width_contained .vp-se-banner__frame { max-width: 1320px; }
  .vp-se-banner--width-page .vp-se-banner__frame { max-width: var(--page-width, 1200px); }
  .vp-se-banner--width-custom .vp-se-banner__frame { max-width: var(--vp-se-banner-text-max-width, 1320px); }

  /* text_only - compact by design; min-height only ever comes from the
     explicit height setting, never from an implicit large default. */
  .vp-se-banner--text_only .vp-se-banner__frame { display: flex; }
  .vp-se-banner--h-d-compact.vp-se-banner--text_only .vp-se-banner__frame { min-height: 0; }
  .vp-se-banner--h-d-medium.vp-se-banner--text_only .vp-se-banner__frame { min-height: 184px; }
  .vp-se-banner--h-d-large.vp-se-banner--text_only .vp-se-banner__frame { min-height: 260px; }
  .vp-se-banner--h-d-custom.vp-se-banner--text_only .vp-se-banner__frame { min-height: var(--vp-se-banner-desktop-height-custom, 184px); }
  .vp-se-banner--text_only .vp-se-banner__frame { min-height: max(var(--vp-se-banner-desktop-min-height, 0px), 0px); }

  /* split / image_only / background_overlay frame layout */
  .vp-se-banner--split .vp-se-banner__frame {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    align-items: stretch;
    gap: 0;
  }
  .vp-se-banner__media--order-first { order: -1; }

  .vp-se-banner--image_only .vp-se-banner__frame,
  .vp-se-banner--background_overlay .vp-se-banner__frame {
    position: relative;
    min-height: 220px;
  }
  .vp-se-banner--h-d-compact .vp-se-banner__frame { min-height: 120px; }
  .vp-se-banner--h-d-medium .vp-se-banner__frame { min-height: 280px; }
  .vp-se-banner--h-d-large .vp-se-banner__frame { min-height: 420px; }
  .vp-se-banner--h-d-custom .vp-se-banner__frame { min-height: var(--vp-se-banner-desktop-height-custom, 280px); }
  .vp-se-banner__frame { min-height: max(var(--vp-se-banner-desktop-min-height, 0px), 0px); }

  .vp-se-banner__media { position: relative; background: #E2E8F0; min-height: 220px; }
  .vp-se-banner--image_only .vp-se-banner__media,
  .vp-se-banner--background_overlay .vp-se-banner__media { position: absolute; inset: 0; min-height: 0; }
  .vp-se-banner--split .vp-se-banner__media { min-height: 280px; }

  .vp-se-banner__image { width: 100%; height: 100%; display: block; }
  .vp-se-banner--image_only .vp-se-banner__image,
  .vp-se-banner--background_overlay .vp-se-banner__image { position: absolute; inset: 0; }
  .vp-se-banner__image--mobile { display: none; }
  .vp-se-banner__media-empty { width: 100%; height: 100%; min-height: 220px; background: rgba(15,23,42,.04); }

  .vp-se-banner__overlay {
    position: absolute;
    inset: 0;
    background: var(--vp-se-banner-overlay-color, #0F172A);
    opacity: var(--vp-se-banner-overlay-opacity, 0.35);
  }

  .vp-se-banner__image-link { position: absolute; inset: 0; }

  /* content block */
  .vp-se-banner__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: var(--vp-se-banner-text-max-width, 52ch);
  }
  .vp-se-banner--text_only .vp-se-banner__content { width: 100%; justify-content: center; }
  .vp-se-banner--content-h-left .vp-se-banner__content { margin-inline: 0; }
  .vp-se-banner--content-h-center .vp-se-banner__content { margin-inline: auto; }
  .vp-se-banner--content-h-right .vp-se-banner__content { margin-inline: 0 0 0 auto; }
  .vp-se-banner--split .vp-se-banner__content { padding: 38px 34px; justify-content: center; }
  .vp-se-banner--background_overlay .vp-se-banner__content {
    position: relative;
    z-index: 1;
    background: rgba(255,255,255,.9);
    border-radius: 14px;
    padding: 24px 28px;
    max-width: min(440px, var(--vp-se-banner-text-max-width, 440px));
    margin: 24px;
  }
  .vp-se-banner--background_overlay .vp-se-banner__frame { display: flex; }
  .vp-se-banner__content--pos-top { align-self: flex-start; }
  .vp-se-banner__content--pos-middle { align-self: center; }
  .vp-se-banner__content--pos-bottom { align-self: flex-end; }

  .vp-se-banner__content--align-center { text-align: center; align-items: center; }
  .vp-se-banner__content--align-right { text-align: right; align-items: flex-end; }

  .vp-se-banner__eyebrow {
    display: inline-flex;
    align-self: flex-start;
    margin: 0;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--vp-se-banner-eyebrow-bg, #FFFFFF);
    color: var(--vp-se-banner-eyebrow-text, #1490CC);
    font-size: var(--vp-se-banner-eyebrow-fs-m, 11px);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .vp-se-banner__content--align-center .vp-se-banner__eyebrow { align-self: center; }
  .vp-se-banner__content--align-right .vp-se-banner__eyebrow { align-self: flex-end; }

  .vp-se-banner__heading {
    margin: 0;
    font-family: var(--font-heading-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
    font-size: var(--vp-se-banner-heading-fs-m, 30px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--vp-se-banner-heading, #0F172A);
  }

  .vp-se-banner__body {
    margin: 0;
    font-size: var(--vp-se-banner-body-fs-m, 16px);
    line-height: 1.5;
    color: var(--vp-se-banner-body, #3A4A5F);
  }

  .vp-se-banner__button {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    padding: 13px 26px;
    border-radius: 999px;
    background: var(--vp-se-banner-btn-bg, #47B5E9);
    color: var(--vp-se-banner-btn-text, #FFFFFF);
    font-size: var(--vp-se-banner-button-fs-m, 15px);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .vp-se-banner__content--align-center .vp-se-banner__button { align-self: center; }
  .vp-se-banner__content--align-right .vp-se-banner__button { align-self: flex-end; }
  .vp-se-banner__button:hover {
    background: var(--vp-se-banner-btn-hover-bg, #339FD1);
    color: var(--vp-se-banner-btn-hover-text, #FFFFFF);
  }
  .vp-se-banner__button:focus-visible { outline: 2px solid #0F172A; outline-offset: 2px; }

  /* review stars block */
  .vp-se-banner__reviews { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .vp-se-banner__reviews--center { justify-content: center; }
  .vp-se-banner__reviews--right { justify-content: flex-end; }
  .vp-se-banner__stars { display: inline-flex; gap: 2px; color: var(--vp-se-banner-star-color, #F5A623); }
  .vp-se-banner__star { display: block; width: var(--vp-se-banner-star-size-m, 16px); height: var(--vp-se-banner-star-size-m, 16px); }
  .vp-se-banner__star--empty { opacity: 0.25; }
  .vp-se-banner__star-wrap { position: relative; }
  .vp-se-banner__star-wrap > .vp-se-banner__star { position: absolute; top: 0; left: 0; }
  .vp-se-banner__star-clip { position: absolute; top: 0; left: 0; width: 50%; height: 100%; overflow: hidden; }
  .vp-se-banner__review-text { font-size: 13px; color: var(--vp-se-banner-review-text-color, #5A6B80); }

  /* guarantee box block */
  .vp-se-banner__guarantee {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--vp-se-banner-guarantee-bg, #FFFFFF);
    color: var(--vp-se-banner-guarantee-text, #0F172A);
    border: 1px solid var(--vp-se-banner-guarantee-border, #E2E8F0);
    border-radius: var(--vp-se-banner-guarantee-radius, 12px);
    text-decoration: none;
    width: var(--vp-se-banner-guarantee-width-m, auto);
    max-width: 100%;
  }
  .vp-se-banner__guarantee--compact { padding: 6px 10px; gap: 6px; }
  .vp-se-banner__guarantee-icon { flex: 0 0 auto; width: var(--vp-se-banner-guarantee-icon-size, 24px); height: var(--vp-se-banner-guarantee-icon-size, 24px); }
  .vp-se-banner__guarantee-icon svg,
  .vp-se-banner__guarantee-icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .vp-se-banner__guarantee-copy { display: flex; flex-direction: column; text-align: left; }
  .vp-se-banner__guarantee-heading { font-size: 13px; font-weight: 700; line-height: 1.2; }
  .vp-se-banner__guarantee-text { font-size: 12px; opacity: 0.8; line-height: 1.3; }
  .vp-se-banner__guarantee:focus-visible { outline: 2px solid #0F172A; outline-offset: 2px; }

  /* offer line block */
  .vp-se-banner__offer-line {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-size: var(--vp-se-banner-offer-fs-m, 13px);
    color: var(--vp-se-banner-offer-text-color, #0F172A);
  }
  .vp-se-banner__offer-icon { flex: 0 0 auto; width: 1em; height: 1em; color: var(--vp-se-banner-offer-icon-color, currentColor); }
  .vp-se-banner__offer-icon svg { width: 100%; height: 100%; display: block; }

  @media (max-width: 749px) {
    .vp-se-banner__image--desktop { display: none; }
    .vp-se-banner__image--mobile { display: block; }
    .vp-se-banner--h-m-compact .vp-se-banner__frame { min-height: 0; }
    .vp-se-banner--h-m-medium .vp-se-banner__frame { min-height: 184px; }
    .vp-se-banner--h-m-large .vp-se-banner__frame { min-height: 320px; }
    .vp-se-banner--h-m-custom .vp-se-banner__frame { min-height: var(--vp-se-banner-mobile-height-custom, 200px); }
    .vp-se-banner--image_only.vp-se-banner--h-m-compact .vp-se-banner__frame,
    .vp-se-banner--background_overlay.vp-se-banner--h-m-compact .vp-se-banner__frame { min-height: 160px; }
    .vp-se-banner__frame { min-height: max(var(--vp-se-banner-mobile-min-height, 0px), 0px); }
    .vp-se-banner--split .vp-se-banner__frame { grid-template-columns: 1fr; }
    .vp-se-banner__content { max-width: 100%; }
    .vp-se-banner__star { width: var(--vp-se-banner-star-size-m, 16px); height: var(--vp-se-banner-star-size-m, 16px); }
    .vp-se-banner__offer-line { font-size: var(--vp-se-banner-offer-fs-m, 13px); }
  }

  @media (min-width: 750px) {
    .vp-se-banner {
      padding-top: var(--vp-se-banner-padding-top-d, 44px);
      padding-bottom: var(--vp-se-banner-padding-bottom-d, 44px);
    }
    .vp-se-banner__eyebrow { font-size: var(--vp-se-banner-eyebrow-fs-d, 11px); }
    .vp-se-banner__heading { font-size: var(--vp-se-banner-heading-fs-d, 38px); }
    .vp-se-banner__body { font-size: var(--vp-se-banner-body-fs-d, 17px); }
    .vp-se-banner__button { font-size: var(--vp-se-banner-button-fs-d, 15px); }
    .vp-se-banner__star { width: var(--vp-se-banner-star-size-d, 17px); height: var(--vp-se-banner-star-size-d, 17px); }
    .vp-se-banner__guarantee { width: var(--vp-se-banner-guarantee-width-d, auto); }
    .vp-se-banner__offer-line { font-size: var(--vp-se-banner-offer-fs-d, 14px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .vp-se-banner__button { transition: none; }
  }
{%- endstyle -%}

