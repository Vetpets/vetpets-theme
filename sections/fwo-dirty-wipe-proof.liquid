{{ 'freshwipes-offer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st = section.settings
-%}

<div class="fwo fwo-proof">
  <div class="fwo__inner fwo__section">
    {%- if st.heading != blank -%}
      <h2 class="fwo__heading" style="text-align: center;">{{ st.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="fwo-proof__pair">
        {%- for block in section.blocks -%}
          <div class="fwo-proof__item" {{ block.shopify_attributes }}>
            {%- render 'fwo-image',
              image: block.settings.image,
              url: block.settings.image_url,
              width: block.settings.image_width,
              height: block.settings.image_height,
              alt: block.settings.image_alt,
              aspect: '1 / 1',
              sizes: '(min-width: 750px) 36vw, 50vw',
              placeholder: block.settings.label
            -%}
            {%- if block.settings.label != blank -%}
              <p class="fwo-proof__label">{{ block.settings.label | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if st.caption != blank -%}
      <p class="fwo-proof__caption">{{ st.caption | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FWO dirty wipe proof",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This is what comes off in 30 seconds"
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption",
      "default": "Plaque and bacteria lifted off the gumline — not spread around it."
    }
  ],
  "blocks": [
    {
      "type": "proof_image",
      "name": "Proof image",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label under the image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL fallback",
          "info": "Used only when no image is picked above."
        },
        {
          "type": "number",
          "id": "image_width",
          "label": "Image URL width (px)"
        },
        {
          "type": "number",
          "id": "image_height",
          "label": "Image URL height (px)"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FWO dirty wipe proof",
      "blocks": [
        { "type": "proof_image" },
        { "type": "proof_image" }
      ]
    }
  ]
}
{% endschema %}
