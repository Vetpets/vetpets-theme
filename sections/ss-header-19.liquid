{%- liquid 
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_opacity = section.settings.border_opacity
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_horizontal_mobile = section.settings.margin_horizontal_mobile
  assign margin_horizontal = section.settings.margin_horizontal
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign background_opacity = section.settings.background_opacity
  assign background_blur = section.settings.background_blur
  assign width = section.settings.width
  assign content_width = section.settings.content_width
  assign lazy = section.settings.lazy
  assign section_radius = section.settings.section_radius
  assign background_style = section.settings.background_style

  assign border_opacity_decimal = section.settings.border_opacity | divided_by: 100.0

  assign transparent_bg = section.settings.transparent_bg

  assign mobile_menu_divider_color = section.settings.mobile_menu_divider_color

  assign link_size = section.settings.link_size
  assign link_size_mobile = section.settings.link_size_mobile
  assign link_color = section.settings.link_color
  assign link_hover_color = section.settings.link_hover_color
  assign link_hero_color = section.settings.link_hero_color
  assign link_custom = section.settings.link_custom
  assign link_font = section.settings.link_font
  assign link_height = section.settings.link_height

  assign menu_icon_size_mobile = section.settings.menu_icon_size_mobile

  assign submenu_link_hover_color = section.settings.submenu_link_hover_color
  assign submenu_link_color = section.settings.submenu_link_color
  assign submenu_background_color = section.settings.submenu_background_color
  assign submenu_background_gradient = section.settings.submenu_background_gradient
  assign submenu_background_style = section.settings.submenu_background_style
  assign submenu_background_opacity = section.settings.submenu_background_opacity
  assign submenu_background_blur = section.settings.submenu_background_blur

  assign promo_custom = section.settings.promo_custom
  assign promo_font = section.settings.promo_font
  assign promo_size = section.settings.promo_size
  assign promo_size_mobile = section.settings.promo_size_mobile
  assign promo_height = section.settings.promo_height
  assign promo_color = section.settings.promo_color

  assign card_title_custom = section.settings.card_title_custom
  assign card_title_font = section.settings.card_title_font
  assign card_title_size = section.settings.card_title_size
  assign card_title_size_mobile = section.settings.card_title_size_mobile
  assign card_title_height = section.settings.card_title_height
  assign card_title_color = section.settings.card_title_color

  assign card_image_radius = section.settings.card_image_radius
  assign card_image_border_thickness = section.settings.card_image_border_thickness
  assign card_image_border_color = section.settings.card_image_border_color
  assign card_image_ratio = section.settings.card_image_ratio
  assign card_image_width = section.settings.card_image_width
  
  assign logo = section.settings.logo
  assign second_logo = section.settings.second_logo
  assign logo_mobile = section.settings.logo_mobile
  assign second_logo_mobile = section.settings.second_logo_mobile
  assign logo_width = section.settings.logo_width
  assign logo_width_mobile = section.settings.logo_width_mobile

  assign name_size = section.settings.name_size
  assign name_size_mobile = section.settings.name_size_mobile
  assign name_color = section.settings.name_color
  assign name_hover_color = section.settings.name_hover_color
  assign name_hero_color = section.settings.name_hero_color
  assign name_custom = section.settings.name_custom
  assign name_font = section.settings.name_font
  assign name_height = section.settings.name_height

  assign right_gap_mobile = section.settings.right_gap_mobile
  assign right_gap = section.settings.right_gap

  assign icon_size_mobile = section.settings.icon_size_mobile
  assign icon_size = section.settings.icon_size  

  assign use_search = section.settings.use_search
  assign search_text  = section.settings.search_text
  assign search_icon_desktop  = section.settings.search_icon_desktop
  assign search_menu_mobile = section.settings.search_menu_mobile

  assign use_account = section.settings.use_account
  assign account_text  = section.settings.account_text
  assign account_icon_desktop  = section.settings.account_icon_desktop
  assign account_menu_mobile = section.settings.account_menu_mobile

  assign cart_text  = section.settings.cart_text
  assign cart_icon_desktop  = section.settings.cart_icon_desktop  

  assign cart_text_color = section.settings.cart_text_color
  assign cart_text_hover_color = section.settings.cart_text_hover_color
  assign cart_text_hero_color = section.settings.cart_text_hero_color
  assign cart_button_background_color = section.settings.cart_button_background_color
  assign cart_button_background_hover_color = section.settings.cart_button_background_hover_color
  assign cart_button_background_color_transparent = section.settings.cart_button_background_color_transparent

  assign pill_padding_horizontal = section.settings.pill_padding_horizontal
  assign pill_padding_vertical = section.settings.pill_padding_vertical

  assign slider_background_color = section.settings.slider_background_color
  assign slider_background_opacity = section.settings.slider_background_opacity

  assign cta_text_alignment = section.settings.cta_text_alignment
  assign cta_text_alignment_mobile = section.settings.cta_text_alignment_mobile

  assign cta_text_custom = section.settings.cta_text_custom
  assign cta_text_font = section.settings.cta_text_font
  assign cta_text_size = section.settings.cta_text_size
  assign cta_text_size_mobile = section.settings.cta_text_size_mobile
  assign cta_text_height = section.settings.cta_text_height
  assign cta_text_color = section.settings.cta_text_color
  assign cta_text_hover_color = section.settings.cta_text_hover_color

  assign menu_heading_custom = section.settings.menu_heading_custom
  assign menu_heading_font = section.settings.menu_heading_font
  assign menu_heading_size = section.settings.menu_heading_size
  assign menu_heading_size_mobile = section.settings.menu_heading_size_mobile
  assign menu_heading_height = section.settings.menu_heading_height
  assign menu_heading_case = section.settings.menu_heading_case
  assign menu_heading_color = section.settings.menu_heading_color

  assign menu_count = 0
  assign announcement_block = nil

  for block in section.blocks
    if block.type == "menu_item"
      assign menu_count = menu_count | plus: 1
    elsif block.type == "announcement"
      assign announcement_block = block
    endif
  endfor

  assign bg_opacity_decimal = background_opacity | divided_by: 100.0
  assign submenu_bg_opacity_decimal = submenu_background_opacity | divided_by: 100.0
  assign slider_background_opacity_decimal = slider_background_opacity | divided_by: 100.0
-%}

{%- style -%}
  {{ link_font | font_face: font_display: 'swap' }}
  {{ name_font | font_face: font_display: 'swap' }}
  {{ card_title_font | font_face: font_display: 'swap' }}
  {{ menu_heading_font | font_face: font_display: 'swap' }}
  {{ cta_text_font | font_face: font_display: 'swap' }}
  
  .section-{{ section.id }} {
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-left: {{ margin_horizontal_mobile }}rem;
    margin-right: {{ margin_horizontal_mobile }}rem;
  }
  
  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  .header-announcement-{{ section.id }} {
    margin: 0 auto;
    max-width: 100%;
    width: 100%;
  }

  .header-announcement-text-{{ section.id }} {
    text-decoration: none !important;
  }

  .header-announcement-text-{{ section.id }} * {
    margin: 0;  
    text-align: center;
    text-transform: unset;
    text-decoration: none !important;
    transition: all .25s cubic-bezier(.76,0,.24,1);
  }
  
  {% if transparent_bg == "all" %}
    .header-{{ section.id }}.transparent {
      background-color: transparent !important;
      background-image: none !important;
      position: absolute;
      width: calc(100% - {{margin_horizontal_mobile | times: 2 }}rem);
      top: 0;
      left: 0;
      z-index: 999;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
  {% elsif transparent_bg == "home"  %}
    {% if template.name == "index" %}
    .header-{{ section.id }}.transparent {
      background-color: transparent !important;
      background-image: none !important;
      position: absolute;
      width: calc(100% - {{margin_horizontal_mobile | times: 2 }}rem);
      top: 0;
      left: 0;
      z-index: 999;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
    {% endif %}
  {% endif %}

  .header-{{ section.id }}.fixed {
    position: fixed;
    top: 0;
    left: 0;
    width: calc(100% - {{margin_horizontal_mobile | times: 2 }}rem);
    z-index: 999;
  }
  
  .header-body-{{ section.id }} {
    display: grid;
    align-items: center;
    grid-template-columns: 1fr {{ logo_width_mobile }}px 1fr;
    position: relative;
  }

  .header-pill-left-{{ section.id }} {
    gap: 16px;
  }

  @media(max-width: 1024px) {
    .header-menu-{{ section.id }} {
      order: 1;
      border-radius: {{ section_radius }}px;
      padding: 8px 8px 8px 16px;
      {% if background_style == 'solid' %}
        background-color: {{ background_color | color_modify: 'alpha', bg_opacity_decimal }};
      {% else %}
        background-image: {{ background_gradient }};
      {% endif %}
      {% if background_blur > 0 %}
        backdrop-filter: blur({{ background_blur }}px);
        -webkit-backdrop-filter: blur({{ background_blur }}px);
      {% endif %}
      transition: all 0.25s ease 0s;
      width: fit-content;
    }
  }    

  .header-logo-{{ section.id }} {
    order: 2;
    text-align: center;
  }

  .header-menu-list-{{ section.id }} {
    padding: 0px;
    margin: 0px;
    display: none;
    align-items: center;
    flex-wrap: wrap;
    list-style: none;
    position: relative;
  }

  .header-menu-mobile-{{ section.id }} .header-menu-list-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: start;
  }

  .header-menu-item-{{ section.id }} {
    line-height: 100%;
    cursor: pointer;
    box-sizing: border-box;
    padding-bottom: 3px;
    min-width: max-content;
  }

  .header-menu-link-{{ section.id }},
  .header-mobile-link-{{ section.id }} {
    margin: 0;
    font-size: {{ link_size_mobile }}px;
    color: {{ link_color }};
    line-height: {{ link_height }}%;
    text-transform: unset;
    text-decoration: none;
    transition: all 0.25s ease 0s;
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .header-menu-item-main-{{ section.id }}:hover .header-menu-link-{{ section.id }} {
    color: {{ link_hover_color }};
  }

  .header-mobile-link-{{ section.id }} {
    color: {{ submenu_link_color }};
  }

  .header-menu-link-{{ section.id }} svg {
    display: inline-block;
    width: 16px;
  }

  .header-menu-link-title-{{ section.id }} {
    opacity: 1;
  }

  {% if transparent_bg == "all" %}
    .header-{{ section.id }}:not(.onscroll).transparent .header-menu-link-{{ section.id }} {
      color: {{ link_hero_color }};
    }
  {% elsif transparent_bg == "home"  %}
    {% if template.name == "index" %}
    .header-{{ section.id }}:not(.onscroll).transparent .header-menu-link-{{ section.id }} {
      color: {{ link_hero_color }};
    }
    {% endif %}
  {% endif %}

  .header-{{ section.id }}.open.transparent .header-menu-link-{{ section.id }} {
    color: {{ link_color }};
    transition: all 0.25s ease 0s;
  }

  .header-submenu-{{ section.id }} .header-menu-link-{{ section.id }} {
    color: {{ submenu_link_color }} !important;
    font-weight: 400;
  }

  .header-menu-item-parent-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: fit-content;
    flex-basis: 0;
  }

  .header-menu-item-icon-{{ section.id }} {
    display: block;
    flex: 0 0 8px;
    width: 8px;
    transition: all 0.25s ease 0s;
    color: {{ link_color }};
  }

  .header-menu-item-icon-{{ section.id }} svg path {
    fill: {{ link_color }}
  }

  .header-{{ section.id }}:not(.onscroll).transparent.open .header-menu-item-icon-{{ section.id }} svg path {
    fill: {{ link_color }};
    transition: all 0.25s ease 0s;
  }

  .header-menu-item-icon-{{ section.id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .header-submenu-{{ section.id }} {
    position: fixed; 
    top: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease 0s;
    list-style: none;
    margin: 0px;
    width: 350px;
    z-index: 9999;
    visibility: hidden;
  }

  .header-submenu-desktop-{{ section.id }} {
    border-radius: 16px;
    box-shadow: 0px 0px 10px 0px rgba(0,0,0,.15);
    {% if submenu_background_style == 'solid' %}
      background-color: {{ submenu_background_color | color_modify: 'alpha', submenu_bg_opacity_decimal }};
    {% else %}
      background-image: {{ submenu_background_gradient }};
    {% endif %}
    {% if submenu_background_blur > 0 %}
      backdrop-filter: blur({{ submenu_background_blur }}px);
      -webkit-backdrop-filter: blur({{ submenu_background_blur }}px);
    {% endif %}
  }

  .header-submenu-{{ section.id }}.active {
    visibility: visible;
  }

  .header-submenu-inner-{{ section.id }} {
    display: block;
    padding: 20px 20px 32px;
    max-height: 450px;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .header-menu-heading-{{ section.id }} {
    font-size: {{ menu_heading_size_mobile }}px;
    line-height: {{ menu_heading_height }}%;
    color: {{ menu_heading_color }};
    margin: 12px 0 0 0;
    font-weight: 600;
    {% if menu_heading_case == 'uppercase' %}
      text-transform: uppercase;
    {% else %}
      text-transform: none;
    {% endif %}
  }

  .header-megamenu-promo-{{ section.id }},
  .header-mobile-promo-{{ section.id }} {
    background: rgba(0,0,0,0.05);
    padding: 12px 16px;
    border-radius: 8px;
    font-size: {{ promo_size_mobile }}px;
    color: {{ promo_color }};
    line-height: {{ promo_height }}%;
  }

  .header-megamenu-content-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .header-megamenu-products-{{ section.id }},
  .header-megamenu-collections-{{ section.id }},
  .header-megamenu-links-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .header-megamenu-product-card-{{ section.id }},
  .header-megamenu-collection-card-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .header-megamenu-product-image-{{ section.id }},
  .header-megamenu-collection-image-{{ section.id }} {
    flex: 0 0 {{ card_image_width }}px;
    width: {{ card_image_width }}px;
    border-radius: {{ card_image_radius }}px;
    overflow: hidden;
    background-color: #ffffff17;
    border: {{ card_image_border_thickness }}px solid {{ card_image_border_color }};
  }

  {% if card_image_ratio == "portrait" %}
    .header-megamenu-product-image-{{ section.id }},
    .header-megamenu-collection-image-{{ section.id }} {
      aspect-ratio: 9/12;
    }
  {% elsif card_image_ratio == "landscape" %}
    .header-megamenu-product-image-{{ section.id }},
    .header-megamenu-collection-image-{{ section.id }} {
      aspect-ratio: 12/9;
    }
  {% elsif card_image_ratio == "square" %}
    .header-megamenu-product-image-{{ section.id }},
    .header-megamenu-collection-image-{{ section.id }} {
      aspect-ratio: 1/1;
    }
  {% else %}
    .header-megamenu-product-image-{{ section.id }},
    .header-megamenu-collection-image-{{ section.id }} {
      aspect-ratio: auto;
    }
  {% endif %}

  .header-megamenu-product-image-{{ section.id }} img,
  .header-megamenu-collection-image-{{ section.id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .header-megamenu-product-info-{{ section.id }},
  .header-megamenu-collection-info-{{ section.id }} {
    flex: 1;
  }

  .header-megamenu-product-sku-{{ section.id }} {
    font-size: 11px;
    color: {{ submenu_link_color }};
    opacity: 0.6;
    margin-bottom: 2px;
  }

  .header-megamenu-product-title-{{ section.id }},
  .header-megamenu-collection-title-{{ section.id }} {
    font-size: {{ card_title_size_mobile }}px;
    color: {{ card_title_color }};
    margin: 0;
    line-height: {{ card_title_height }}%;
  }

  .header-mobile-link-{{ section.id }} {
    font-size: {{ link_size_mobile }}px !important;
  }

  .header-megamenu-collection-desc-{{ section.id }} {
    font-size: 12px;
    color: {{ submenu_link_color }};
    opacity: 0.7;
    margin: 4px 0 0 0;
    line-height: 1.3;
  }

  .header-mobile-footer-{{ section.id }} {
    padding-top: 16px;
    text-align: {{ cta_text_alignment_mobile }};
  }

  .header-megamenu-cta-{{ section.id }} {
    color: {{ cta_text_color }};
    font-size: {{ cta_text_size_mobile }}px;
    line-height: {{ cta_text_height }}%;
    text-decoration: none;
    display: inline-flex;
    font-weight: 700;
    align-items: center;
    gap: 6px;
    transition: all 0.25s ease;
  }

  .header-menu-burger-{{ section.id }} {
    display: block;
    width: {{ menu_icon_size_mobile }}px;
    height: 16px;
    position: relative;
    z-index: 3;
    transition: all 0.25s ease 0s;
    cursor: pointer;
    background-color: transparent;
    border: 0px;
    box-shadow: none;
  }

  .header-menu-burger-icon-{{ section.id }} {
    position: absolute;
    top: 50%;
    left: 0;
    margin-top: -1px;
    width: 100%;
    height: 1.5px;
    background: {{ link_color }};
    transition: transform .4s ease; 
  }

  {% if transparent_bg == "all" %}
    .header-{{ section.id }}:not(.onscroll).transparent .header-menu-burger-icon-{{ section.id }} {
      background: {{ link_hero_color }};
    }
  {% elsif transparent_bg == "home"  %}
    {% if template.name == "index" %}
      .header-{{ section.id }}:not(.onscroll).transparent .header-menu-burger-icon-{{ section.id }} {
        background: {{ link_hero_color }};
      }
    {% endif %}
  {% endif %}

  .header-menu-burger-icon-{{ section.id }}::before,
  .header-menu-burger-icon-{{ section.id }}::after{
    content: "";
    display: block;
    position: absolute;
    width: 100%;
    height: 1.5px;
    background-color: inherit;
    background: {{ link_color }};
  }

  .header-menu-burger-icon-{{ section.id }}::before {
    top: -7px;
    transition: top .25s ease .27s, opacity .25s ease, width .25s ease;
  }

  .header-menu-burger-icon-{{ section.id }}::after {
    bottom: -7px;
    transition: bottom .25s ease .27s, transform .25s ease, width .25s ease;
  }

  {% if transparent_bg == "all" %}
    .header-{{ section.id }}:not(.onscroll).transparent .header-menu-burger-icon-{{ section.id }}::before,
    .header-{{ section.id }}:not(.onscroll).transparent .header-menu-burger-icon-{{ section.id }}::after{
      background: {{ link_hero_color }};
    }
  {% elsif transparent_bg == "home"  %}
    {% if template.name == "index" %}
      .header-{{ section.id }}:not(.onscroll).transparent .header-menu-burger-icon-{{ section.id }}::before,
      .header-{{ section.id }}:not(.onscroll).transparent .header-menu-burger-icon-{{ section.id }}::after{
        background: {{ link_hero_color }};
      }
    {% endif %}
  {% endif %}

  .header-logo-{{ section.id }} {
    max-width: {{ logo_width_mobile }}px;
    text-align: center;
    position: relative;
    z-index: 3;
    transition: all 0.25s ease 0s;
    border-radius: {{ section_radius }}px;
    padding: 8px 0;
  }

  @media(max-width: 1024px) {
    .header-inner-{{ section.id }} {
      position: relative;
    }

    .header-body-{{ section.id }} {
      border: {{ border_thickness }}px solid transparent;
    }

    .header-logo-{{ section.id }} {
      padding: 8px;
      {% if background_style == 'solid' %}
        background-color: {{ background_color | color_modify: 'alpha', bg_opacity_decimal }};
      {% else %}
        background-image: {{ background_gradient }};
      {% endif %}
      {% if background_blur > 0 %}
        backdrop-filter: blur({{ background_blur }}px);
        -webkit-backdrop-filter: blur({{ background_blur }}px);
      {% endif %}
    }

    .header-body-{{ section.id }} {
      border-radius: {{ section_radius }}px;
      padding: 8px 8px 8px 16px;
      {% if background_style == 'solid' %}
        background-color: {{ background_color | color_modify: 'alpha', bg_opacity_decimal }};
      {% else %}
        background-image: {{ background_gradient }};
      {% endif %}
      {% if background_blur > 0 %}
        backdrop-filter: blur({{ background_blur }}px);
        -webkit-backdrop-filter: blur({{ background_blur }}px);
      {% endif %}
      transition: all 0.25s ease 0s;
    }

    /* Убираем фоны у отдельных элементов */
    .header-menu-{{ section.id }} {
      border-radius: 0;
      padding: 0;
      background-color: transparent !important;
      background-image: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }

    .header-logo-{{ section.id }} {
      padding: 0;
      background-color: transparent !important;
      background-image: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }

    .header-{{ section.id }}.open .header-body-{{ section.id }} {
      opacity: 0;
      transition: all 0.25s ease 0s;
    }

    /* Логика для transparent фона */
    {% if transparent_bg == "all" %}
      .header-{{ section.id }}:not(.onscroll).transparent .header-body-{{ section.id }} {
        background-color: transparent !important;
        background-image: none !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
      }
      
      .header-{{ section.id }}.onscroll.transparent .header-body-{{ section.id }},
      .header-{{ section.id }}.open.transparent .header-body-{{ section.id }} {
        {% if background_style == 'solid' %}
          background-color: {{ background_color | color_modify: 'alpha', bg_opacity_decimal }} !important;
        {% else %}
