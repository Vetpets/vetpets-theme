        padding-top: {{ block.settings.announcement_padding_top }}px;
        padding-bottom: {{ block.settings.announcement_padding_bottom }}px;
      }

      .header-announcement-text-{{ section.id }} * {
        font-size: {{ block.settings.announcement_link_size_mobile }}px;
        color: {{ block.settings.announcement_link_color }};
        line-height: {{ block.settings.announcement_link_height }}%;
        {% if block.settings.case == 'uppercase' %}
          text-transform: uppercase;
        {% else %}
          text-transform: none;
        {% endif %}
      }

      .header-announcement-text-{{ section.id }}:hover * {
        color: {{ block.settings.announcement_link_hover_color }};
      }

      @media(min-width: 1024px) {
        .header-announcement-text-{{ section.id }} * {
          font-size: {{ block.settings.announcement_link_size }}px;
