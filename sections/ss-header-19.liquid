          fill: {{ link_hero_color }};
        }

        .header-{{ section.id }}:not(.onscroll).transparent .header-search-icon-{{ section.id }}:hover svg path {
          fill: {{ link_hero_color }}
        }

        .header-{{ section.id }}:not(.onscroll).transparent .header-cart-icon-{{ section.id }}:hover svg path {
          fill: {{ link_hero_color }};
        }
