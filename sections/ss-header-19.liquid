<div class="section-{{ section.id }} header-{{ section.id }} {% if transparent_bg == 'all' or transparent_bg == 'home' and template.name == 'index' %}transparent{% endif %} fixed">

  {% comment %} Announcement Block {% endcomment %}
  {% if announcement_block %}
    {% if announcement_block.settings.announcement_text != blank %}
      <div class="header-announcement-{{ section.id }}" {{ announcement_block.shopify_attributes }}>
        <div class="section-{{ section.id }}-settings">
          <{% if announcement_block.settings.announcement_url != blank %}a href="{{ announcement_block.settings.announcement_url }}" target="_blank"{% else %}div{% endif %} class="header-announcement-text-{{ section.id }}">
            {{ announcement_block.settings.announcement_text }}
          </{% if announcement_block.settings.announcement_url != blank %}a{% else %}div{% endif %}>
        </div>
      </div>
    {% endif %}
  {% endif %}
  
  <div class="section-{{ section.id }}-settings">
    <div class="header-inner-{{ section.id }}">
      <div class="header-body-{{ section.id }}">
        
        <!-- Desktop: Left pill with logo + menu -->
        <div class="header-pill-{{ section.id }} header-pill-left-{{ section.id }}">
          <div class="header-logo-{{ section.id }}">
            {% if logo != blank %}
              <a href="{{ shop.url }}" class="header-logo-image-{{ section.id }} {% if logo_mobile != blank %}header-logo-desktop-{{ section.id }}{% endif %}">
                <img src="{{ logo | image_url }}" alt="{{ logo.alt }}" {% if second_logo != blank %}class="header-logo-first-{{ section.id }}"{% endif %}>
                {% if second_logo != blank %}
                  <img src="{{ second_logo | image_url }}" alt="{{ second_logo.alt }}" class="header-logo-second-{{ section.id }}">
                {% endif %}
              </a>
              {% if logo_mobile != blank %}
                <a href="{{ shop.url }}" class="header-logo-image-{{ section.id }} header-logo-mobile-{{ section.id }}">
                  <img src="{{ logo_mobile | image_url }}" alt="{{ logo_mobile.alt }}" {% if second_logo_mobile != blank %}class="header-logo-first-{{ section.id }}"{% endif %}>
                  {% if second_logo_mobile != blank %}
                    <img src="{{ second_logo_mobile | image_url }}" alt="{{ second_logo_mobile.alt }}" class="header-logo-second-{{ section.id }}">
                  {% endif %}
                </a>
              {% endif %}
            {% else %}
              <a href="{{ shop.url }}" class="header-logo-text-{{ section.id }}">{{ shop.name }}</a>
            {% endif %}
          </div>

          <div class="header-menu-{{ section.id }}">
            {% if menu_count > 0 %}
              <ul class="header-menu-list-{{ section.id }}" data-menu-list>
                <span class="header-menu-slider-{{ section.id }}" data-menu-slider></span>
                {% for block in section.blocks %}
                  {% if block.type == "menu_item" %}
                    <li class="header-menu-item-{{ section.id }} header-menu-item-main-{{ section.id }} header-menu-item-parent-{{ section.id }}" 
                        data-menu-item 
                        data-submenu-id="submenu-{{ section.id }}-{{ forloop.index }}"
                        {{ block.shopify_attributes }}>
                      <p class="header-menu-link-{{ section.id }}">
                        {{ block.settings.text }}
                      </p>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>             
            {% endif %}
          </div>
        </div>

         {% for block in section.blocks %}
                {% if block.type == "menu_item" %}
                  <div class="header-submenu-{{ section.id }} header-submenu-desktop-{{ section.id }}" 
                      data-submenu-target="submenu-{{ section.id }}-{{ forloop.index }}">
                    <div class="header-submenu-inner-{{ section.id }}">
                      <div class="header-megamenu-content-{{ section.id }}">
                        
                        {% if block.settings.promo_text != blank %}
                          <div class="header-megamenu-promo-{{ section.id }}">
                            {{ block.settings.promo_text }}
                          </div>
                        {% endif %}
                        
                        {% if block.settings.products_list != blank %}
                          <div class="header-megamenu-products-{{ section.id }}">
                            {% for product in block.settings.products_list %}
                              <a href="{{ product.url }}" class="header-megamenu-product-card-{{ section.id }}">
                                <div class="header-megamenu-product-image-{{ section.id }}">
                                  {% if product.featured_image %}
                                    <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title }}" {% if lazy %}loading="lazy"{% endif %}>
                                  {% else %}
                                    {{ 'product-1' | placeholder_svg_tag }}
                                  {% endif %}
                                </div>
                                <div class="header-megamenu-product-info-{{ section.id }}">
                                  {% if product.metafields.custom.sku != blank %}
                                    <div class="header-megamenu-product-sku-{{ section.id }}">{{ product.metafields.custom.sku }}</div>
                                  {% endif %}
                                  <h4 class="header-megamenu-product-title-{{ section.id }}">{{ product.title }}</h4>
                                </div>
                              </a>
                            {% endfor %}
                          </div>
                        {% endif %}
                        
                        {% if block.settings.collections_list != blank %}
                          <div class="header-megamenu-collections-{{ section.id }}">
                            {% for collection in block.settings.collections_list %}
                              <a href="{{ collection.url }}" class="header-megamenu-collection-card-{{ section.id }}">
                                <div class="header-megamenu-collection-image-{{ section.id }}">
                                  {% if collection.image %}
                                    <img src="{{ collection.image | image_url: width: 200 }}" alt="{{ collection.title }}" {% if lazy %}loading="lazy"{% endif %}>
                                  {% else %}
                                    {{ 'collection-1' | placeholder_svg_tag }}
                                  {% endif %}
                                </div>
                                <div class="header-megamenu-collection-info-{{ section.id }}">
                                  <h4 class="header-megamenu-collection-title-{{ section.id }}">{{ collection.title }}</h4>
                                  {% if collection.description != blank %}
                                    <p class="header-megamenu-collection-desc-{{ section.id }}">{{ collection.description | truncate: 60 }}</p>
                                  {% endif %}
                                </div>
                              </a>
                            {% endfor %}
                          </div>
                        {% endif %}

                        {% if block.settings.heading_text != blank %}
                          <h3 class="header-menu-heading-{{ section.id }}">{{ block.settings.heading_text }}</h3>
                        {% endif %}
                        
                        {% if block.settings.submenu != blank %}
                          <div class="header-megamenu-links-{{ section.id }}">
                            {% for link in block.settings.submenu.links %}
                              <a href="{{ link.url }}" class="header-menu-link-{{ section.id }} header-menu-link-title-{{ section.id }}">{{ link.title }}</a>
                            {% endfor %}
                          </div>
                        {% endif %}
                        
                        {% if block.settings.cta_link != blank %}
                          <div class="header-megamenu-footer-{{ section.id }}">
                            <a href="{{ block.settings.cta_link }}" class="header-megamenu-cta-{{ section.id }}">{{ block.settings.cta_text }}</a>
                          </div>
                        {% endif %}
                        
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}

        <div class="header-pill-{{ section.id }} header-pill-right-{{ section.id }}">
          <div class="header-right-{{ section.id }}">

            {% if use_search %}
              <a href="{{ routes.search_url }}" class="header-search-{{ section.id }}">
                <span class="header-search-icon-{{ section.id }}">
                  <svg enable-background="new 0 0 32 32" height="512" viewBox="0 0 32 32" width="512" xmlns="http://www.w3.org/2000/svg"><g id="_01"><g><path d="m18 26c-6.6 0-12-5.4-12-12s5.4-12 12-12 12 5.4 12 12-5.4 12-12 12zm0-22c-5.5 0-10 4.5-10 10s4.5 10 10 10 10-4.5 10-10-4.5-10-10-10z"></path></g><g><path d="m3 30c-.3 0-.5-.1-.7-.3-.4-.4-.4-1 0-1.4l7.2-7.2c.4-.4 1-.4 1.4 0s.4 1 0 1.4l-7.2 7.2c-.2.2-.4.3-.7.3z"></path></g></g></svg>
                </span>
                <span class="header-search-text-{{ section.id }}">{{ search_text }}</span>
              </a>
            {% endif %}

            {%- if shop.customer_accounts_enabled and use_account -%}
              <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header-account-{{ section.id }}">
                <span class="header-account-icon-{{ section.id }}">
                  <svg enable-background="new 0 0 32 32" height="512" viewBox="0 0 32 32" width="512" xmlns="http://www.w3.org/2000/svg"><g id="_01"><g><path d="m20 30h-8c-3.3 0-6-2.7-6-6v-3c0-3.3 2.7-6 6-6h8c3.3 0 6 2.7 6 6v3c0 3.3-2.7 6-6 6zm-8-13c-2.2 0-4 1.8-4 4v3c0 2.2 1.8 4 4 4h8c2.2 0 4-1.8 4-4v-3c0-2.2-1.8-4-4-4z"></path></g><g><path d="m16 14c-3.3 0-6-2.7-6-6s2.7-6 6-6 6 2.7 6 6-2.7 6-6 6zm0-10c-2.2 0-4 1.8-4 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4z"></path></g></g></svg>
                </span>
                <span class="header-account-text-{{ section.id }}">{{ account_text }}</span>
              </a>
            {%- endif -%}

            <a href="{{ routes.cart_url }}" class="header-cart-{{ section.id }}">
              <span class="header-cart-icon-{{ section.id }}">
                <svg enable-background="new 0 0 32 32" height="512" viewBox="0 0 32 32" width="512" xmlns="http://www.w3.org/2000/svg"><g id="_01"><g><path d="m23.8 30h-15.6c-3.3 0-6-2.7-6-6v-.2l.6-16c.1-3.3 2.8-5.8 6-5.8h14.4c3.2 0 5.9 2.5 6 5.8l.6 16c.1 1.6-.5 3.1-1.6 4.3s-2.6 1.9-4.2 1.9c0 0-.1 0-.2 0zm-15-26c-2.2 0-3.9 1.7-4 3.8l-.6 16.2c0 2.2 1.8 4 4 4h15.8c1.1 0 2.1-.5 2.8-1.3s1.1-1.8 1.1-2.9l-.6-16c-.1-2.2-1.8-3.8-4-3.8z"></path></g><g><path d="m16 14c-3.9 0-7-3.1-7-7 0-.6.4-1 1-1s1 .4 1 1c0 2.8 2.2 5 5 5s5-2.2 5-5c0-.6.4-1 1-1s1 .4 1 1c0 3.9-3.1 7-7 7z"></path></g></g></svg>
              </span>
              <span class="header-cart-text-{{ section.id }}">{{ cart_text }}</span>       
              <div class="cart-count-bubble">
                {%- if cart.item_count < 100 -%}
                  <span aria-hidden="true"><sup>{{ cart.item_count }}</sup></span>
                {%- endif -%}
              </div>  
            </a>
          </div>
        </div>

        <div class="header-menu-{{ section.id }}">
          {% if menu_count > 0 %}
            <button 
              class="header-menu-burger-{{ section.id }}" 
              aria-label="Open menu" 
              aria-expanded="false" 
              aria-controls="mobile-menu-{{ section.id }}"
            >
              <span class="header-menu-burger-icon-{{ section.id }}"></span>
            </button>
          {% endif %}
        </div>

        <div class="header-logo-{{ section.id }}">
          {% if logo != blank %}
            <a href="{{ shop.url }}" class="header-logo-image-{{ section.id }} {% if logo_mobile != blank %}header-logo-desktop-{{ section.id }}{% endif %}">
              <img src="{{ logo | image_url }}" alt="{{ logo.alt }}" {% if second_logo != blank %}class="header-logo-first-{{ section.id }}"{% endif %}>
              {% if second_logo != blank %}
                <img src="{{ second_logo | image_url }}" alt="{{ second_logo.alt }}" class="header-logo-second-{{ section.id }}">
              {% endif %}
            </a>
            {% if logo_mobile != blank %}
              <a href="{{ shop.url }}" class="header-logo-image-{{ section.id }} header-logo-mobile-{{ section.id }}">
                <img src="{{ logo_mobile | image_url }}" alt="{{ logo_mobile.alt }}" {% if second_logo_mobile != blank %}class="header-logo-first-{{ section.id }}"{% endif %}>
                {% if second_logo_mobile != blank %}
                  <img src="{{ second_logo_mobile | image_url }}" alt="{{ second_logo_mobile.alt }}" class="header-logo-second-{{ section.id }}">
                {% endif %}
              </a>
            {% endif %}
          {% else %}
            <a href="{{ shop.url }}" class="header-logo-text-{{ section.id }}">{{ shop.name }}</a>
          {% endif %}
        </div>

        <div class="header-right-{{ section.id }}">

          {% if use_search %}
            <a href="{{ routes.search_url }}" class="header-search-{{ section.id }}">
              <span class="header-search-icon-{{ section.id }}">
                <svg enable-background="new 0 0 32 32" height="512" viewBox="0 0 32 32" width="512" xmlns="http://www.w3.org/2000/svg"><g id="_01"><g><path d="m18 26c-6.6 0-12-5.4-12-12s5.4-12 12-12 12 5.4 12 12-5.4 12-12 12zm0-22c-5.5 0-10 4.5-10 10s4.5 10 10 10 10-4.5 10-10-4.5-10-10-10z"></path></g><g><path d="m3 30c-.3 0-.5-.1-.7-.3-.4-.4-.4-1 0-1.4l7.2-7.2c.4-.4 1-.4 1.4 0s.4 1 0 1.4l-7.2 7.2c-.2.2-.4.3-.7.3z"></path></g></g></svg>
              </span>
              <span class="header-search-text-{{ section.id }}">{{ search_text }}</span>
            </a>
          {% endif %}

          {%- if shop.customer_accounts_enabled and use_account -%}
            <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header-account-{{ section.id }}">
              <span class="header-account-icon-{{ section.id }}">
                <svg enable-background="new 0 0 32 32" height="512" viewBox="0 0 32 32" width="512" xmlns="http://www.w3.org/2000/svg"><g id="_01"><g><path d="m20 30h-8c-3.3 0-6-2.7-6-6v-3c0-3.3 2.7-6 6-6h8c3.3 0 6 2.7 6 6v3c0 3.3-2.7 6-6 6zm-8-13c-2.2 0-4 1.8-4 4v3c0 2.2 1.8 4 4 4h8c2.2 0 4-1.8 4-4v-3c0-2.2-1.8-4-4-4z"></path></g><g><path d="m16 14c-3.3 0-6-2.7-6-6s2.7-6 6-6 6 2.7 6 6-2.7 6-6 6zm0-10c-2.2 0-4 1.8-4 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4z"></path></g></g></svg>
              </span>
              <span class="header-account-text-{{ section.id }}">{{ account_text }}</span>
            </a>
          {%- endif -%}

          <a href="{{ routes.cart_url }}" class="header-cart-{{ section.id }} header-cart-mobile-{{ section.id }}">
            <span class="header-cart-icon-{{ section.id }}">
              <svg enable-background="new 0 0 32 32" height="512" viewBox="0 0 32 32" width="512" xmlns="http://www.w3.org/2000/svg"><g id="_01"><g><path d="m23.8 30h-15.6c-3.3 0-6-2.7-6-6v-.2l.6-16c.1-3.3 2.8-5.8 6-5.8h14.4c3.2 0 5.9 2.5 6 5.8l.6 16c.1 1.6-.5 3.1-1.6 4.3s-2.6 1.9-4.2 1.9c0 0-.1 0-.2 0zm-15-26c-2.2 0-3.9 1.7-4 3.8l-.6 16.2c0 2.2 1.8 4 4 4h15.8c1.1 0 2.1-.5 2.8-1.3s1.1-1.8 1.1-2.9l-.6-16c-.1-2.2-1.8-3.8-4-3.8z"></path></g><g><path d="m16 14c-3.9 0-7-3.1-7-7 0-.6.4-1 1-1s1 .4 1 1c0 2.8 2.2 5 5 5s5-2.2 5-5c0-.6.4-1 1-1s1 .4 1 1c0 3.9-3.1 7-7 7z"></path></g></g></svg>
            </span>
            <span class="header-cart-text-{{ section.id }}">{{ cart_text }}</span>       
            <div class="cart-count-bubble">
              {%- if cart.item_count < 100 -%}
                <span aria-hidden="true"><sup>{{ cart.item_count }}</sup></span>
              {%- endif -%}
            </div>      
          </a>
        </div>

      
      </div>

      {% if menu_count > 0 %}
        <div class="header-menu-mobile-{{ section.id }}" id="mobile-menu-{{ section.id }}">
          <div class="header-menu-mobile-inner-{{ section.id }}">
            
            <div class="header-mobile-menu-header-{{ section.id }}">

              <div class="header-mobile-tabs-{{ section.id }}" role="tablist">
                {% assign tab_index = 0 %}
                {% for block in section.blocks %}
                  {% if block.type == "menu_item" %}
                    <button 
                      class="header-mobile-tab-{{ section.id }}{% if tab_index == 0 %} active{% endif %}" 
                      role="tab" 
                      aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
                      aria-controls="panel-{{ section.id }}-{{ tab_index }}"
                      data-tab-index="{{ tab_index }}"
                    >
                      {{ block.settings.text }}
                    </button>
                    {% assign tab_index = tab_index | plus: 1 %}
                  {% endif %}
                {% endfor %}
                
                {%- if shop.customer_accounts_enabled and use_account and account_menu_mobile -%}
                  <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header-mobile-tab-{{ section.id }}">
                    {{ account_text }}
                  </a>
                {%- endif -%}
              </div>

              <!-- Close button -->
              <button class="header-mobile-close-{{ section.id }}" aria-label="Close menu" data-mobile-close>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <path fill="currentColor" fill-linecap="round" fill-linejoin="round" d="M18 6L6 18M6 6l12 12"/>
                </svg>
              </button>
            </div>

            <!-- Divider line -->
            <div class="header-mobile-divider-{{ section.id }}"></div>

            <!-- Tab panels -->
            <div class="header-mobile-panels-{{ section.id }}">
              {% assign panel_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == "menu_item" %}
                  <div 
                    class="header-mobile-panel-{{ section.id }}{% if panel_index == 0 %} active{% endif %}" 
                    role="tabpanel" 
                    id="panel-{{ section.id }}-{{ panel_index }}"
                    data-panel-index="{{ panel_index }}"
                    {{ block.shopify_attributes }}
                  >
                    {% if block.settings.promo_text != blank %}
                      <div class="header-mobile-promo-{{ section.id }}">
                        {{ block.settings.promo_text }}
                      </div>
                    {% endif %}

                    {% comment %} Products list {% endcomment %}
                    {% if block.settings.products_list != blank %}
                      <div class="header-mobile-products-{{ section.id }}">
                        {% for product in block.settings.products_list %}
                          <a href="{{ product.url }}" class="header-mobile-product-card-{{ section.id }}">
                            <div class="header-megamenu-collection-image-{{ section.id }}">
                              {% if product.featured_image %}
                                <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title }}" {% if lazy %}loading="lazy"{% endif %}>
                              {% else %}
                                {{ 'product-1' | placeholder_svg_tag }}
                              {% endif %}
                            </div>
                            <div class="header-mobile-product-info-{{ section.id }}">
                              {% if product.metafields.custom.sku != blank %}
                                <div class="header-mobile-product-sku-{{ section.id }}">{{ product.metafields.custom.sku }}</div>
                              {% endif %}
                              <h4 class="header-mobile-product-title-{{ section.id }}">{{ product.title }}</h4>
                            </div>
                          </a>
                        {% endfor %}
                      </div>
                    {% endif %}

                    {% comment %} Collections list {% endcomment %}
                    {% if block.settings.collections_list != blank %}
                      <div class="header-mobile-collections-{{ section.id }}">
                        {% for collection in block.settings.collections_list %}
                          <a href="{{ collection.url }}" class="header-mobile-collection-card-{{ section.id }}">
                            <div class="header-megamenu-collection-image-{{ section.id }}">
                              {% if collection.image %}
                                <img src="{{ collection.image | image_url: width: 200 }}" alt="{{ collection.title }}" {% if lazy %}loading="lazy"{% endif %}>
                              {% else %}
                                {{ 'collection-1' | placeholder_svg_tag }}
                              {% endif %}
                            </div>
                            <div class="header-mobile-collection-info-{{ section.id }}">
                              <h4 class="header-mobile-collection-title-{{ section.id }}">{{ collection.title }}</h4>
                              {% if collection.description != blank %}
                                <p class="header-mobile-collection-desc-{{ section.id }}">{{ collection.description | truncate: 60 }}</p>
                              {% endif %}
                            </div>
                          </a>
                        {% endfor %}
                      </div>
                    {% endif %}

                    {% if block.settings.heading_text != blank %}
                      <h3 class="header-mobile-heading-{{ section.id }}">{{ block.settings.heading_text }}</h3>
                    {% endif %}

                    {% comment %} Submenu links {% endcomment %}
                    {% if block.settings.submenu != blank %}
                      <div class="header-mobile-links-{{ section.id }}">
                        {% for link in block.settings.submenu.links %}
                          <a href="{{ link.url }}" class="header-mobile-product-card-{{ section.id }}" style="padding: 10px 0;">
                            <span class="header-mobile-link-{{ section.id }}">{{ link.title }}</span>
                          </a>
                        {% endfor %}
                      </div>
                    {% endif %}

                    {% if block.settings.cta_link != blank %}
                      <div class="header-mobile-footer-{{ section.id }}">
                        <a href="{{ block.settings.cta_link }}" class="header-mobile-cta-{{ section.id }}">{{ block.settings.cta_text }}</a>
                      </div>
                    {% endif %}
                  </div>
                  {% assign panel_index = panel_index | plus: 1 %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  function initHeader19() {
    const sectionId = '{{ section.id }}';
    let header = document.querySelector('.header-' + sectionId);
    let burgerButton = header ? header.querySelector('.header-menu-burger-' + sectionId) : null;
    let closeButton = header ? header.querySelector('[data-mobile-close]') : null;
    let parentItems = document.querySelectorAll('.header-pill-left-' + sectionId + ' .header-menu-item-parent-' + sectionId);
    let cartButton = header ? header.querySelector('.header-cart-mobile-' + sectionId) : null;
    
    const menuList = document.querySelector('.header-pill-left-' + sectionId + ' [data-menu-list]');
    const slider = document.querySelector('.header-pill-left-' + sectionId + ' [data-menu-slider]');
    const menuItems = document.querySelectorAll('.header-pill-left-' + sectionId + ' [data-menu-item]');
    
    if (menuList && slider && menuItems.length > 0) {
      const updateSlider = (item) => {
        const itemRect = item.getBoundingClientRect();
        const listRect = menuList.getBoundingClientRect();
        const offsetLeft = itemRect.left - listRect.left;
        slider.style.width = `${itemRect.width}px`;
        slider.style.transform = `translateX(${offsetLeft}px)`;
      };
      
      menuItems.forEach((item) => {
        item.addEventListener('mouseenter', () => {
          updateSlider(item);
        });
      });
      
      menuList.addEventListener('mouseleave', () => {
        slider.style.opacity = '0';
      });
      
      menuList.addEventListener('mouseenter', () => {
        slider.style.opacity = '1';
      });
    }
    
    let submenuTimeout;
    let currentSubmenu = null;
    
    parentItems.forEach(item => {
      const submenuId = item.getAttribute('data-submenu-id');
      const submenu = document.querySelector('[data-submenu-target="' + submenuId + '"]');
      
      if (submenu) {
        item.addEventListener('mouseenter', () => {
          clearTimeout(submenuTimeout);
          
          document.querySelectorAll('.header-submenu-' + sectionId).forEach(s => {
            if (s !== submenu) {
              s.style.opacity = '0';
              s.style.pointerEvents = 'none';
              s.classList.remove('active');
            }
          });
          
          const rect = item.getBoundingClientRect();
          submenu.style.top = (rect.bottom + 15) + 'px';
          submenu.style.left = rect.left + 'px';
          
          submenu.classList.add('active');
          submenu.style.opacity = '1';
          submenu.style.pointerEvents = 'all';
          
          currentSubmenu = submenu;
        });
        
        item.addEventListener('mouseleave', () => {
          submenuTimeout = setTimeout(() => {
            if (currentSubmenu && !currentSubmenu.matches(':hover')) {
              currentSubmenu.style.opacity = '0';
              currentSubmenu.style.pointerEvents = 'none';
              currentSubmenu.classList.remove('active');
              currentSubmenu = null;
            }
          }, 100);
        });
        
        submenu.addEventListener('mouseenter', () => {
          clearTimeout(submenuTimeout);
        });
        
        submenu.addEventListener('mouseleave', () => {
          submenuTimeout = setTimeout(() => {
            submenu.style.opacity = '0';
            submenu.style.pointerEvents = 'none';
            submenu.classList.remove('active');
            currentSubmenu = null;
          }, 100);
        });
      }
    });

    const closeMobileMenu = () => {
      header.classList.remove('open');
      document.body.style.overflow = '';
      if (burgerButton) {
        burgerButton.setAttribute('aria-expanded', 'false');
        burgerButton.setAttribute('aria-label', 'Open menu');
      }
    };

    const openMobileMenu = () => {
      header.classList.add('open');
      document.body.style.overflow = 'hidden';
      if (burgerButton) {
        burgerButton.setAttribute('aria-expanded', 'true');
        burgerButton.setAttribute('aria-label', 'Close menu');
      }
    };

    if (header) {
      if (window.scrollY > 0) {
        header.classList.add('onscroll');
      }

      document.addEventListener('scroll', () => {
        document.querySelectorAll('.header-submenu-' + sectionId).forEach(s => {
          s.style.opacity = '0';
          s.style.pointerEvents = 'none';
          s.classList.remove('active');
        });
        
        const currentScrollTop = window.scrollY;

        if (header.classList.contains('transparent')) {
          if (currentScrollTop === 0) {
            header.classList.remove('onscroll');
          } else {
            header.classList.add('onscroll');
          }
        }
      });

      if (burgerButton) {
        burgerButton.addEventListener('click', () => {
          const isOpen = header.classList.contains('open');
          if (isOpen) {
            closeMobileMenu();
          } else {
            openMobileMenu();
          }
          header.classList.remove('onscroll');
        });
      }

      header.addEventListener('click', (e) => {
        if (e.target === header && header.classList.contains('open')) {
          closeMobileMenu();
        }
      });

      // Close button click
      if (closeButton) {
        closeButton.addEventListener('click', () => {
          closeMobileMenu();
        });
      }

      header.addEventListener('mouseenter', () => {
        header.classList.add('onscroll');
      });

      header.addEventListener('mouseleave', () => {
        if (window.scrollY === 0) {
          header.classList.remove('onscroll');
        }
      });

      // Mobile tabs
      const tabs = header.querySelectorAll('.header-mobile-tab-' + sectionId);
      const panels = header.querySelectorAll('.header-mobile-panel-' + sectionId);

      tabs.forEach((tab) => {
        tab.addEventListener('click', (e) => {
          if (tab.tagName.toLowerCase() === 'a') return;
          
          const tabIndex = tab.getAttribute('data-tab-index');
          
          tabs.forEach(t => {
            if (t.tagName.toLowerCase() !== 'a') {
              t.classList.remove('active');
              t.setAttribute('aria-selected', 'false');
            }
          });

          panels.forEach(p => {
            p.classList.remove('active');
          });

          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');

          const panel = header.querySelector('[data-panel-index="' + tabIndex + '"]');
          if (panel) {
            panel.classList.add('active');
          }
        });
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initHeader19);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initHeader19);
     document.addEventListener('shopify:section:load', initHeader19);
  }
</script>

{% schema %}
  {
    "name": "SS - Header #19",
    "settings": [
      {
        "type": "header",
        "content": "Header"
      },
      {
        "type": "select",
        "id": "transparent_bg",
        "label": "Transparent background",
        "default": "all",
        "options": [
          {
            "label": "All pages",
            "value": "all"
          },
          {
            "label": "Home page",
            "value": "home"
          },
          {
            "label": "None",
            "value": "none"
          }
        ]
      },
      {
        "type": "header",
        "content": "Logo",
        "info": "Leave blank to display shop name instead of logo"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "second_logo",
        "label": "Second logo",
        "info": "Use for transparent header"
      },
      {
        "type": "image_picker",
        "id": "logo_mobile",
        "label": "Logo - mobile"
      },
      {
        "type": "image_picker",
        "id": "second_logo_mobile",
        "label": "Second logo - mobile",
        "info": "Use for transparent header"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 400,
        "step": 10,
        "unit": "px",
        "label": "Width",
        "default": 130
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Width - mobile",
        "default": 130
      },
      {
        "type": "header",
        "content": "Shop name"
      },
      {
        "type": "checkbox",
        "id": "name_custom",
        "label": "Use custom font",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "name_font",
