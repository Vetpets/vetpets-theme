{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign margin_horizontal = section.settings.margin_horizontal
  assign margin_horizontal_mobile = section.settings.margin_horizontal_mobile
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign width = section.settings.width
  assign content_width = section.settings.content_width
  assign section_radius = section.settings.section_radius
  assign background_style = section.settings.background_style

  assign display_options = section.settings.display_options
  assign seconds = section.settings.seconds
  assign percent = section.settings.percent
  assign hide_modal_days = section.settings.hide_modal_days

  assign button = section.settings.button
  assign button_size = section.settings.button_size
  assign button_size_mobile = section.settings.button_size_mobile
  assign button_color = section.settings.button_color
  assign button_hover_color = section.settings.button_hover_color
  assign button_custom = section.settings.button_custom
  assign button_font = section.settings.button_font
  assign button_height = section.settings.button_height
  assign button_padding_vertical = section.settings.button_padding_vertical
  assign button_padding_vertical_mobile = section.settings.button_padding_vertical_mobile
  assign button_padding_horizontal = section.settings.button_padding_horizontal
  assign button_padding_horizontal_mobile = section.settings.button_padding_horizontal_mobile
  assign button_radius = section.settings.button_radius
  assign button_border_thickness = section.settings.button_border_thickness
  assign button_border_color = section.settings.button_border_color
  assign button_border_hover_color = section.settings.button_border_hover_color
  assign button_bg_color = section.settings.button_bg_color
  assign button_bg_hover_color = section.settings.button_bg_hover_color
  assign button_align_mobile = section.settings.button_align_mobile
  assign button_align = section.settings.button_align
  assign button_vertical_align = section.settings.button_vertical_align
  assign button_vertical_align_mobile = section.settings.button_vertical_align_mobile
  assign button_fixed = section.settings.button_fixed
  assign button_horizontal_dst_to_edge = section.settings.button_horizontal_dst_to_edge
  assign button_horizontal_dst_to_edge_mobile = section.settings.button_horizontal_dst_to_edge_mobile
  assign button_vertical_dst_to_edge = section.settings.button_vertical_dst_to_edge
  assign button_vertical_dst_to_edge_mobile = section.settings.button_vertical_dst_to_edge_mobile
  assign button_close_size = section.settings.button_close_size
  assign button_close_size_mobile = section.settings.button_close_size_mobile

  assign modal_background_style = section.settings.modal_background_style
  assign modal_background_gradient = section.settings.modal_background_gradient
  assign modal_bg_color = section.settings.modal_bg_color

  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign image_width = section.settings.image_width
  assign image_hide_mobile = section.settings.image_hide_mobile
  assign mobile_overlay_color = section.settings.mobile_overlay_color | default: '#000000'
  assign mobile_overlay_opacity_decimal = section.settings.mobile_overlay_opacity | default: 40 | divided_by: 100.0
  assign image_position_desktop = section.settings.image_position_desktop

  assign content_padding_vertical = section.settings.content_padding_vertical
  assign content_padding_vertical_mobile = section.settings.content_padding_vertical_mobile
  assign content_padding_horizontal = section.settings.content_padding_horizontal
  assign content_padding_horizontal_mobile = section.settings.content_padding_horizontal_mobile
  assign content_align = section.settings.content_align
  assign content_align_mobile = section.settings.content_align_mobile

  assign content_horizontal_align = ''
  if content_align == 'center'
    assign content_horizontal_align = 'center'
  elsif content_align == 'right'
    assign content_horizontal_align = 'end'
  else
    assign content_horizontal_align = 'start'
  endif

  assign content_horizontal_align_mobile = ''
  if content_align_mobile == 'center'
    assign content_horizontal_align_mobile = 'center'
  elsif content_align_mobile == 'right'
    assign content_horizontal_align_mobile = 'end'
  else
    assign content_horizontal_align_mobile = 'start'
  endif

  assign close_color = section.settings.close_color
  assign close_align = section.settings.close_align | default: 'top_right'
  assign close_offset = section.settings.close_offset | default: 16
  assign close_offset_mobile = section.settings.close_offset_mobile | default: 12
  assign close_size = section.settings.close_size
  assign close_size_mobile = section.settings.close_size_mobile

  assign has_scratch_card = false
  for block in section.blocks
    if block.type == 'scratch_card'
      assign has_scratch_card = true
    endif
  endfor
-%}

{%- style -%}
  .section-{{ section.id }} {
    {% unless button_fixed %}
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    {% endunless %}
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    margin-inline: {{ margin_horizontal_mobile }}rem;
    border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
    overflow: hidden;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    {% unless button_fixed %}
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-inline: {{ padding_horizontal_mobile }}rem;
    {% endunless %}
  }

  .modal-button-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: fit-content;
    font-size: {{ button_size_mobile }}px;
    color: {{ button_color }};
    line-height: {{ button_height }}%;
    text-align: center;
    text-transform: unset;
    text-decoration: none;
    gap: 10px;
    padding: {{ button_padding_vertical_mobile }}px {{ button_padding_horizontal_mobile }}px;
    border-radius: {{ button_radius }}px;
    border: {{ button_border_thickness }}px solid {{ button_border_color }};
    background-color: {{ button_bg_color }};
    transition: color 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
    box-shadow: none;
    cursor: pointer;
    font-family: inherit;
    z-index: 3;
    text-wrap: nowrap;
  }

  .modal-button-{{ section.id }}:hover {
    color: {{ button_hover_color }};
    border: {{ button_border_thickness }}px solid {{ button_border_hover_color }};
    background-color: {{ button_bg_hover_color }};
  }

  .modal-button-close-{{ section.id }} svg {
    display: block;
    width: {{ button_close_size_mobile }}px;
    height: {{ button_close_size_mobile }}px;
  }

  .modal-button-close-{{ section.id }} svg path {
    fill: {{ button_color }};
    transition: fill 0.25s ease;
  }

  .modal-button-{{ section.id }}:hover .modal-button-close-{{ section.id }} svg path {
    fill: {{ button_hover_color }};
  }


  .modal-popup-{{ section.id }} {
    width: 100vw;
    inset: 0;
    position: fixed;
    display: flex;
    opacity: 0;
    pointer-events: none;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    z-index: -1;
  }

  .modal-popup-{{ section.id }}.active {
    opacity: 1;
    z-index: 100;
    pointer-events: all;
    transition: opacity 250ms ease-in 0s;
  }

  .modal-popup-inner-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-inline: {{ padding_horizontal_mobile }}rem;
  }

  .modal-popup-content-{{ section.id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: {{ content_horizontal_align_mobile }};
    padding: {{ content_padding_vertical_mobile }}px {{ content_padding_horizontal_mobile }}px;
    scrollbar-width: none;
    flex: 1;
  }

  {% if image_hide_mobile %}
  .modal-popup-right-{{ section.id }} {
    display: none;
  }
  {% else %}
  .modal-popup-right-{{ section.id }} {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .modal-popup-mobile-overlay-{{ section.id }} {
    display: block !important;
    position: fixed;
    inset: 0;
    z-index: 1;
    background-color: {{ mobile_overlay_color | color_modify: 'alpha', mobile_overlay_opacity_decimal }};
  }

  .modal-popup-content-{{ section.id }} {
    position: relative;
    z-index: 2;
  }
  {% endif %}

  .modal-popup-image-{{ section.id }} {
    width: 100%;
    height: 100%;
  }

  .modal-popup-image-{{ section.id }} img,
  .modal-popup-image-{{ section.id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .modal-popup-image-{{ section.id }} svg {
    background-color: #DEDEDE;
  }

  .modal-popup-image-{{ section.id }} .modal-popup-mobile-image {
    display: block;
  }

  .modal-popup-image-{{ section.id }} .modal-popup-desktop-image {
    display: none;
  }

  .modal-popup-close-{{ section.id }} {
    position: fixed;
    top: {{ close_offset_mobile }}px;
    {% if close_align == 'top_left' %}
    left: {{ close_offset_mobile }}px;
    right: auto;
    {% elsif close_align == 'top_center' %}
    left: 50%;
    transform: translateX(-50%);
    right: auto;
    {% else %}
    right: {{ close_offset_mobile }}px;
    left: auto;
    {% endif %}
    z-index: 101;
    box-shadow: none;
    background-color: transparent;
    border: 0px;
    cursor: pointer;
    padding: 0;
    display: none;
  }

  .modal-popup-{{ section.id }}.active .modal-popup-close-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-popup-close-{{ section.id }} svg {
    display: block;
    width: {{ close_size_mobile }}px;
    height: {{ close_size_mobile }}px;
  }

  .modal-popup-close-{{ section.id }} svg path {
    fill: {{ close_color }};
  }

  .modal-popup-newsletter-row-{{ section.id }}.hide {
    display: none !important;
  }

  .modal-popup-heading-{{ section.id }}.hide {
    display: none !important;
  }

  .modal-popup-subheading-{{ section.id }}.hide {
    display: none !important;
  }

  .modal-popup-text-{{ section.id }}.hide {
    display: none !important;
  }

  .modal-popup-disclaimer-{{ section.id }}.hide {
    display: none !important;
  }

  .modal-popup-no-thanks-{{ section.id }}.hide {
    display: none !important;
  }

  /* Step management for scratch card flow */
  .modal-popup-content-{{ section.id }}[data-step="scratch"] .modal-popup-newsletter-form-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="scratch"] .scratch-email-heading-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="scratch"] .modal-popup-disclaimer-{{ section.id }} {
    display: none !important;
  }

  .modal-popup-newsletter-form-{{ section.id }} form {
    display: flex;
    flex-direction: column;
    align-items: {{ content_horizontal_align_mobile }};
  }

  .modal-popup-content-{{ section.id }}[data-step="email"] .modal-popup-heading-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="email"] .modal-popup-subheading-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="email"] .modal-popup-text-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="email"] .scratch-card-container-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="email"] .modal-popup-no-thanks-{{ section.id }} {
    display: none !important;
  }

  .modal-popup-content-{{ section.id }}[data-step="success"] .modal-popup-heading-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="success"] .modal-popup-subheading-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="success"] .modal-popup-text-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="success"] .scratch-card-container-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="success"] .modal-popup-disclaimer-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="success"] .modal-popup-no-thanks-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="success"] .scratch-email-heading-{{ section.id }},
  .modal-popup-content-{{ section.id }}[data-step="success"] .modal-popup-newsletter-row-{{ section.id }} {
    display: none !important;
  }

  @media(min-width: 1024px) {
    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      margin-inline: {{ margin_horizontal }}rem;
      border-radius: {{ section_radius }}px;
    }

    .modal-popup-mobile-overlay-{{ section.id }} {
      display: none !important;
    }

    .section-{{ section.id }}-settings {
      {% unless button_fixed %}
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-inline: {{ padding_horizontal }}rem;
      {% endunless %}
    }

    .modal-popup-newsletter-form-{{ section.id }} form {
        align-items: {{ content_horizontal_align }};
    }

    .modal-button-{{ section.id }} {
      padding: {{ button_padding_vertical }}px {{ button_padding_horizontal }}px;
      font-size: {{ button_size }}px;
    }

    .modal-button-close-{{ section.id }} svg {
      width: {{ button_close_size }}px;
      height: {{ button_close_size }}px;
    }

    .modal-popup-{{ section.id }} {
      overflow: hidden;
    }

    .modal-popup-inner-{{ section.id }} {
      flex-direction: row;
      align-items: stretch;
      height: 100vh;
      min-height: unset;
      overflow: hidden;
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-inline: {{ padding_horizontal }}rem;
    }

    .modal-popup-content-{{ section.id }} {
      width: {{ 100 | minus: image_width }}%;
      flex-shrink: 0;
      flex: unset;
      align-items: {{ content_horizontal_align }};
      padding: {{ content_padding_vertical }}px {{ content_padding_horizontal }}px;
      overflow-y: auto;
      height: 100%;
      justify-content: flex-start;
    }

    .modal-popup-content-{{ section.id }}::before,
    .modal-popup-content-{{ section.id }}::after {
      content: '';
      flex: 1;
    }

    .modal-popup-right-{{ section.id }} {
      width: {{ image_width }}%;
      flex-shrink: 0;
      {% unless image_hide_mobile %}
      position: static;
      inset: auto;
      {% endunless %}
    }

    .modal-popup-image-{{ section.id }} .modal-popup-mobile-image {
      display: none;
    }

    .modal-popup-image-{{ section.id }} .modal-popup-desktop-image {
      display: block;
    }

    .modal-popup-close-{{ section.id }} {
      top: {{ close_offset }}px;
      {% if close_align == 'top_left' %}
      left: {{ close_offset }}px;
      right: auto;
      {% elsif close_align == 'top_center' %}
      left: 50%;
      right: auto;
      {% else %}
      right: {{ close_offset }}px;
      left: auto;
      {% endif %}
    }

    .modal-popup-close-{{ section.id }} svg {
      width: {{ close_size }}px;
      height: {{ close_size }}px;
    }
  }
{%- endstyle -%}

{% if width == 'custom' %}
  <style>
    .modal-popup-inner-{{ section.id }} {
      max-width: {{ content_width }}px;
      margin: 0 auto;
    }
  </style>
{% elsif width == 'page' %}
  <style>
    .modal-popup-inner-{{ section.id }} {
      max-width: clamp(100px, var(--page-content-width, var(--page-width)), 100%);
      margin: 0 auto;
    }
  </style>
{% endif %}

{% if margin_horizontal_mobile > 0 %}
  <style>
    .section-{{ section.id }} {
      {% unless button_fixed %}
      border-left: solid {{ border_color }} {{ border_thickness }}px;
      border-right: solid {{ border_color }} {{ border_thickness }}px;
      {% endunless %}
    }

    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: 0px;
        border-right: 0px;
      }
    }
  </style>
{% endif %}

{% if margin_horizontal > 0 %}
  <style>
    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: solid {{ border_color }} {{ border_thickness }}px;
        border-right: solid {{ border_color }} {{ border_thickness }}px;
      }
    }
  </style>
{% endif %}

{% if image_position_desktop == 'left' %}
  <style>
    @media(min-width: 1024px) {
      .modal-popup-right-{{ section.id }} {
        order: -1;
      }
      .modal-popup-content-{{ section.id }} {
        order: 1;
      }
    }
  </style>
{% endif %}

{% if image_hide_mobile %}
  <style>
    .modal-popup-right-{{ section.id }} {
      display: none;
    }
    .modal-popup-content-{{ section.id }} {
      width: 100%;
      flex: 1;
    }
    @media(min-width: 1024px) {
      .modal-popup-right-{{ section.id }} {
        display: block;
      }
      .modal-popup-content-{{ section.id }} {
        width: {{ 100 | minus: image_width }}%;
        flex: unset;
      }
    }
  </style>
{% endif %}

{% if button_fixed %}
  <style>
    .modal-button-{{ section.id }} {
      left: {{ button_horizontal_dst_to_edge_mobile }}px;
      right: inherit;
      bottom: {{ button_vertical_dst_to_edge_mobile }}px;
      position: fixed;
    }

    @media(min-width: 1024px) {
      .modal-button-{{ section.id }} {
        left: {{ button_horizontal_dst_to_edge }}px;
        bottom: {{ button_vertical_dst_to_edge }}px;
      }
    }
  </style>

  {% if button_vertical_align_mobile == 'top' %}
    <style>
      .modal-button-{{ section.id }} {
        top: {{ button_vertical_dst_to_edge_mobile }}px;
        bottom: inherit;
      }
    </style>
  {% elsif button_vertical_align_mobile == 'center' %}
    <style>
      .modal-button-{{ section.id }} {
        top: 50%;
        bottom: inherit;
        transform: translateY(-50%);
      }
    </style>
  {% endif %}

  {% if button_vertical_align == 'top' %}
    <style>
      @media(min-width: 1024px) {
        .modal-button-{{ section.id }} {
          top: {{ button_vertical_dst_to_edge }}px;
          bottom: inherit;
        }
      }
    </style>
  {% elsif button_vertical_align == 'center' %}
    <style>
      @media(min-width: 1024px) {
        .modal-button-{{ section.id }} {
          top: 50%;
          bottom: inherit;
          transform: translateY(-50%);
        }
      }
    </style>
  {% endif %}

  {% unless button_vertical_align == 'top' or button_vertical_align == 'center' %}
    <style>
      @media(min-width: 1024px) {
        .modal-button-{{ section.id }} {
          bottom: {{ button_vertical_dst_to_edge }}px;
          top: inherit;
        }
      }
    </style>
  {% endunless %}

  {% if button_align_mobile == 'center' %}
    <style>
      .modal-button-{{ section.id }} {
        left: 50%;
        {% if button_vertical_align_mobile == 'center' %}
        transform: translate(-50%, -50%);
        {% else %}
        transform: translateX(-50%);
        {% endif %}
      }
    </style>
  {% elsif button_align_mobile == 'right' %}
    <style>
      .modal-button-{{ section.id }} {
        right: {{ button_horizontal_dst_to_edge_mobile }}px;
        left: inherit;
        transform: translateX(0%);
      }
    </style>
  {% endif %}

  {% if button_align == 'center' %}
    <style>
      @media(min-width: 1024px) {
        .modal-button-{{ section.id }} {
          left: 50%;
          right: inherit;
          {% if button_vertical_align == 'center' %}
          transform: translate(-50%, -50%);
          {% else %}
          transform: translateX(-50%);
          {% endif %}
        }
      }
    </style>
  {% elsif button_align == 'right' %}
    <style>
      @media(min-width: 1024px) {
        .modal-button-{{ section.id }} {
          right: {{ button_horizontal_dst_to_edge }}px;
          left: inherit;
          transform: translateX(0%);
        }
      }
    </style>
  {% else %}
    <style>
      @media(min-width: 1024px) {
        .modal-button-{{ section.id }} {
          left: {{ button_horizontal_dst_to_edge }}px;
          right: inherit;
          transform: translateX(0%);
        }
      }
    </style>
  {% endif %}
{% endif %}

{% if button_align_mobile == 'center' %}
  <style>
    .modal-button-{{ section.id }} {
      margin-inline: auto;
    }
  </style>
{% elsif button_align_mobile == 'right' %}
  <style>
    .modal-button-{{ section.id }} {
      margin-inline-start: auto;
    }
  </style>
{% endif %}

{% if button_align == 'center' %}
  <style>
    @media(min-width: 1024px) {
      .modal-button-{{ section.id }} {
        margin-inline: auto;
      }
    }
  </style>
{% elsif button_align == 'right' %}
  <style>
    @media(min-width: 1024px) {
      .modal-button-{{ section.id }} {
        margin-inline-start: auto;
        margin-inline-end: 0;
      }
    }
  </style>
{% else %}
  <style>
    @media(min-width: 1024px) {
      .modal-button-{{ section.id }} {
        margin-inline: 0;
      }
    }
  </style>
{% endif %}

{% for block in section.blocks %}
  {% case block.type %}
    {% when 'logo' %}
      <style>
        .modal-popup-logo-{{ block.id }} {
          margin-top: {{ block.settings.logo_mt_mobile }}px;
          width: {{ block.settings.logo_width_mobile }}px;
          overflow: hidden;
          flex-shrink: 0;
        }

        .modal-popup-logo-{{ block.id }} img {
          display: block;
          width: 100%;
          height: auto;
          object-fit: contain;
        }

        @media(min-width: 1024px) {
          .modal-popup-logo-{{ block.id }} {
            margin-top: {{ block.settings.logo_mt }}px;
            width: {{ block.settings.logo_width }}px;
          }
        }
      </style>

    {% when 'sub_heading' %}
      <style>
        .modal-popup-subheading-{{ block.id }} {
          width: 100%;
          text-align: {{ content_align_mobile }};
          margin-top: {{ block.settings.sub_heading_mt_mobile }}px;
        }

        .modal-popup-subheading-{{ block.id }} * {
          margin: 0;
          font-size: {{ block.settings.sub_heading_size_mobile }}px;
          color: {{ block.settings.sub_heading_color }};
          line-height: {{ block.settings.sub_heading_height }}%;
          word-break: break-word;
          font-weight: 400;
          text-transform: unset;
        }

        @media(min-width: 1024px) {
          .modal-popup-subheading-{{ block.id }} {
            text-align: {{ content_align }};
            margin-top: {{ block.settings.sub_heading_mt }}px;
          }

          .modal-popup-subheading-{{ block.id }} * {
            font-size: {{ block.settings.sub_heading_size }}px;
          }
        }
      </style>

