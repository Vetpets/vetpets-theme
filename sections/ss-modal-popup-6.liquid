            <path fill-rule="evenodd" clip-rule="evenodd" d="M12.0002 10.586L4.70718 3.29297L3.29297 4.70718L10.586 12.0002L3.29297 19.2933L4.70718 20.7075L12.0002 13.4145L19.2933 20.7075L20.7075 19.2933L13.4145 12.0002L20.7075 4.70723L19.2933 3.29302L12.0002 10.586Z" fill="currentColor"></path>
          </svg>
        </div>
      </button>
    </div>
  </div>
{% endif %}

<div
  class="modal-popup-{{ section.id }}"
  role="dialog"
  aria-modal="true"
  aria-label="{{ section.settings.button | default: 'Offer popup' | escape }}"
  {% if modal_background_style == 'gradient' %}
    style="background-image: {{ modal_background_gradient }};"
  {% else %}
    style="background-color: {{ modal_bg_color }};"
  {% endif %}
>
  <button class="modal-popup-close-{{ section.id }}" aria-label="Close">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M12.0002 10.586L4.70718 3.29297L3.29297 4.70718L10.586 12.0002L3.29297 19.2933L4.70718 20.7075L12.0002 13.4145L19.2933 20.7075L20.7075 19.2933L13.4145 12.0002L20.7075 4.70723L19.2933 3.29302L12.0002 10.586Z" fill="currentColor"></path>
    </svg>
  </button>

  <div class="modal-popup-inner-{{ section.id }}">
    <div
      class="modal-popup-content-{{ section.id }}"
      {% if has_scratch_card %}
        data-step="scratch"
      {% endif %}
    >
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'logo' %}
            {% if block.settings.logo != blank %}
              <div class="modal-popup-logo-{{ block.id }}">
                {%- capture sizes -%}{{ block.settings.logo_width }}px{%- endcapture -%}
                {{
                  block.settings.logo
                  | image_url: width: 600
                  | image_tag: sizes: sizes, widths: '100, 200, 400, 600'
                }}
              </div>
            {% endif %}

          {% when 'sub_heading' %}
            {% if block.settings.sub_heading != blank %}
              <div class="modal-popup-subheading-{{ block.id }} modal-popup-subheading-{{ section.id }}">
                {{ block.settings.sub_heading }}
              </div>
            {% endif %}

          {% when 'heading' %}
            {% if block.settings.heading != blank %}
              <div class="modal-popup-heading-{{ block.id }} modal-popup-heading-{{ section.id }}">
                {{ block.settings.heading }}
              </div>
            {% endif %}

          {% when 'text' %}
            {% if block.settings.text != blank %}
              <div class="modal-popup-text-{{ block.id }} modal-popup-text-{{ section.id }}">
                {{ block.settings.text }}
              </div>
            {% endif %}

          {% when 'disclaimer' %}
            {% if block.settings.disclaimer != blank %}
              <div class="modal-popup-disclaimer-{{ block.id }} modal-popup-disclaimer-{{ section.id }}">
                {{ block.settings.disclaimer }}
              </div>
            {% endif %}

          {% when 'no_thanks' %}
            {% if block.settings.no_thanks_text != blank %}
              <button class="modal-popup-no-thanks-{{ block.id }} modal-popup-no-thanks-{{ section.id }}">
                {{ block.settings.no_thanks_text }}
              </button>
            {% endif %}

          {% when 'scratch_card' %}
            <div
              class="scratch-card-container-{{ block.id }} scratch-card-container-{{ section.id }}"
              data-scratch-threshold="{{ block.settings.scratch_threshold }}"
              data-overlay-color="{{ block.settings.overlay_color }}"
              data-overlay-text="{{ block.settings.overlay_text }}"
              data-overlay-text-color="{{ block.settings.overlay_text_color }}"
              data-overlay-text-size="{{ block.settings.overlay_text_size }}"
              data-overlay-text-size-mobile="{{ block.settings.overlay_text_size_mobile }}"
              {% if block.settings.overlay_image != blank %}
                data-overlay-image="{{ block.settings.overlay_image | image_url: width: 800 }}"
              {% endif %}
            >
              <div class="scratch-card-inner-{{ block.id }}">
                <div class="scratch-card-reveal-{{ block.id }}">
                  {% if block.settings.reveal_subtitle != blank %}
                    <p class="scratch-card-reveal-subtitle-{{ block.id }}">{{ block.settings.reveal_subtitle }}</p>
                  {% endif %}
                  {% if block.settings.reveal_title != blank %}
                    <p class="scratch-card-reveal-title-{{ block.id }}">{{ block.settings.reveal_title }}</p>
                  {% endif %}
                </div>
                <canvas class="scratch-card-canvas-{{ section.id }}"></canvas>
              </div>
              <button
                type="button"
                class="scratch-card-claim-{{ block.id }} scratch-card-claim-{{ section.id }}"
                style="display:none;"
              >
                {{ block.settings.claim_label }}
              </button>
            </div>

          {% when 'newsletter' %}
            <div class="modal-popup-newsletter-form-{{ section.id }}">
              {%- assign modal_return_to = request.path | append: '?customer_posted=' | append: section.id -%}
              {% form 'customer',
                class: 'modal-popup-newsletter-form',
                data-success: form.posted_successfully?,
                return_to: modal_return_to
              %}
                <input type="hidden" name="contact[tags]" value="newsletter">

                {% if block.settings.email_heading != blank %}
                  <div class="scratch-email-heading-{{ block.id }} scratch-email-heading-{{ section.id }}">
                    {{ block.settings.email_heading }}
                  </div>
                {% endif %}

                <div class="modal-popup-newsletter-row-{{ block.id }} modal-popup-newsletter-row-{{ section.id }}">
                  <input
                    type="email"
                    name="contact[email]"
                    class="modal-popup-newsletter-input-{{ block.id }}"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="Newsletter-error--{{ block.id }}"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="Newsletter-success--{{ block.id }}"
                    {% endif %}
                    placeholder="{{ block.settings.placeholder_mail }}"
                    required
                  >
                  <input
                    type="submit"
                    class="modal-popup-newsletter-submit-{{ block.id }} modal-popup-newsletter-submit-{{ section.id }}"
                    name="commit"
                    value="{{ block.settings.submit }}"
                  >
                </div>

                {% if form.errors %}
                  <p
                    id="Newsletter-error--{{ block.id }}"
                    class="modal-popup-newsletter-error-{{ section.id }}"
                    role="alert"
                  >
                    {{ form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email }}
                  </p>
                {% endif %}

                {% if block.settings.heading_thanks_text != blank %}
                  <p class="modal-popup-newsletter-thanks-text-{{ block.id }} modal-popup-newsletter-heading-thanks-text-{{ block.id }} modal-popup-newsletter-heading-thanks-text-{{ section.id }}">
                    {{ block.settings.heading_thanks_text }}
                  </p>
                {% endif %}

                {% if block.settings.thanks_text != blank %}
                  <p class="modal-popup-newsletter-thanks-text-{{ block.id }} modal-popup-newsletter-thanks-text-{{ section.id }}">
                    {{ block.settings.thanks_text }}
                  </p>
                {% endif %}

                {% if block.settings.discount_code != blank %}
                  <div class="modal-popup-discount-code-{{ block.id }} modal-popup-discount-code-{{ section.id }}">
                    <div
                      class="discount-code-box-{{ block.id }} discount-code-box-{{ section.id }}"
                      data-code="{{ block.settings.discount_code }}"
                    >
                      <span class="discount-code-value-{{ block.id }}">{{ block.settings.discount_code }}</span>
                      <span class="discount-code-copy-{{ block.id }}">
                        <svg
                          aria-hidden="true"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                        </svg>
                      </span>
                    </div>
                    <span class="discount-code-label-{{ block.id }} discount-code-label-{{ section.id }}">
                      {{- block.settings.discount_code_label -}}
                    </span>
                  </div>
                {% endif %}

                {% if block.settings.success_close_label != blank %}
                  {% if block.settings.success_button_url != blank %}
                    <a
                      href="{{ block.settings.success_button_url }}"
                      class="modal-popup-success-close-{{ block.id }} modal-popup-success-close-{{ section.id }}"
                    >
                      {{ block.settings.success_close_label }}
                    </a>
                  {% else %}
                    <button
                      type="button"
                      class="modal-popup-success-close-{{ block.id }} modal-popup-success-close-{{ section.id }}"
                      aria-label="{{ block.settings.success_close_label }}"
                    >
                      {{ block.settings.success_close_label }}
                    </button>
                  {% endif %}
                {% endif %}
              {% endform %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <div class="modal-popup-right-{{ section.id }}">
      {% unless image_hide_mobile %}<div class="modal-popup-mobile-overlay-{{ section.id }}"></div>{% endunless %}
      <div class="modal-popup-image-{{ section.id }}">
        {% if image != blank %}
          {%- capture sizes -%}{{ image_width }}vw{%- endcapture -%}
          {% if image_mobile != blank %}
            {{
              image
              | image_url: width: 2400
              | image_tag: sizes: sizes, widths: '750, 1000, 1200, 1500, 2000, 2400', class: 'modal-popup-desktop-image'
            }}
          {% else %}
            {{ image | image_url: width: 2400 | image_tag: sizes: sizes, widths: '750, 1000, 1200, 1500, 2000, 2400' }}
          {% endif %}
        {% else %}
          {{ 'image' | placeholder_svg_tag }}
        {% endif %}
        {% if image_mobile != blank %}
          {%- capture sizes -%}100vw{%- endcapture -%}
          {{
            image_mobile
            | image_url: width: 1200
            | image_tag: sizes: sizes, widths: '375, 550, 750, 1000, 1200', class: 'modal-popup-mobile-image'
          }}
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script>
    function initModalPopup6_{{ section.id | replace: '-', '_' }}() {
      const toggle = document.querySelector('.modal-button-{{ section.id }}');
      const modal = document.querySelector('.modal-popup-{{ section.id }}');
      const buttonClose = document.querySelector('.modal-button-close-{{ section.id }}');
      const close = document.querySelector('.modal-popup-close-{{ section.id }}');
      const noThanksButtons = document.querySelectorAll('.modal-popup-no-thanks-{{ section.id }}');
      const modalKey = 'modalDisplayedAt_{{ section.id }}';
      const contentWrapper = document.querySelector('.modal-popup-content-{{ section.id }}');
      const hasScratchCard = !!document.querySelector('.scratch-card-container-{{ section.id }}');

      let previouslyFocusedElement = null;

      function openModal() {
        if (modal) {
          previouslyFocusedElement = document.activeElement;
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
          document.body.style.transform = 'none';
          requestAnimationFrame(function() {
            if (close) close.focus();
          });
        }
      }

      function closeModal() {
        if (modal) {
          modal.classList.remove('active');
          document.body.style.overflow = '';
          document.body.style.transform = '';
          if (previouslyFocusedElement) {
            previouslyFocusedElement.focus();
            previouslyFocusedElement = null;
          }
        }
      }

      function showSuccessState() {
        const thanksTexts = document.querySelectorAll('.modal-popup-newsletter-thanks-text-{{ section.id }}');
        const thanksHeadings = document.querySelectorAll('.modal-popup-newsletter-heading-thanks-text-{{ section.id }}');
        const headings = document.querySelectorAll('.modal-popup-heading-{{ section.id }}');
        const subHeadings = document.querySelectorAll('.modal-popup-subheading-{{ section.id }}');
        const textBlocks = document.querySelectorAll('.modal-popup-text-{{ section.id }}');
        const disclaimers = document.querySelectorAll('.modal-popup-disclaimer-{{ section.id }}');
        const noThanks = document.querySelectorAll('.modal-popup-no-thanks-{{ section.id }}');
        const rows = document.querySelectorAll('.modal-popup-newsletter-row-{{ section.id }}');
        const submitButtons = document.querySelectorAll('.modal-popup-newsletter-submit-{{ section.id }}');

        thanksTexts.forEach(el => el.classList.add('active'));
        thanksHeadings.forEach(el => el.classList.add('active'));
        headings.forEach(el => el.classList.add('hide'));
        subHeadings.forEach(el => el.classList.add('hide'));
        textBlocks.forEach(el => el.classList.add('hide'));
        disclaimers.forEach(el => el.classList.add('hide'));
        noThanks.forEach(el => el.classList.add('hide'));
        rows.forEach(el => el.classList.add('hide'));
        submitButtons.forEach(btn => btn.setAttribute('disabled', true));

        /* Hide scratch card elements in success state */
        const scratchContainers = document.querySelectorAll('.scratch-card-container-{{ section.id }}');
        scratchContainers.forEach(el => el.style.display = 'none');
        const scratchEmailHeadings = document.querySelectorAll('.scratch-email-heading-{{ section.id }}');
        scratchEmailHeadings.forEach(el => el.style.display = 'none');

        if (hasScratchCard && contentWrapper) {
          contentWrapper.setAttribute('data-step', 'success');
        }

        /* Show discount code */
        const discountCodes = document.querySelectorAll('.modal-popup-discount-code-{{ section.id }}');
        discountCodes.forEach(el => el.classList.add('active'));

        const successCloseButtons = document.querySelectorAll('.modal-popup-success-close-{{ section.id }}');
        successCloseButtons.forEach(btn => {
          btn.classList.add('active');
          if (btn.tagName !== 'A') {
            btn.addEventListener('click', closeModal);
          }
        });
      }

      /* Scratch card logic */
  /* Scratch card logic */
  if (hasScratchCard) {
    const scratchContainer = document.querySelector('.scratch-card-container-{{ section.id }}');
    const canvas = scratchContainer.querySelector('.scratch-card-canvas-{{ section.id }}');
    const claimBtn = document.querySelector('.scratch-card-claim-{{ section.id }}');

    if (canvas) {
      const ctx = canvas.getContext('2d');
      const threshold = parseInt(scratchContainer.dataset.scratchThreshold) || 40;
      const overlayColor = scratchContainer.dataset.overlayColor || '#CCCCCC';
      const overlayText = scratchContainer.dataset.overlayText || 'SCRATCH HERE';
      const overlayTextColor = scratchContainer.dataset.overlayTextColor || '#121212';

      const overlayImageUrl = scratchContainer.dataset.overlayImage || '';
      const inner = canvas.parentElement;

      let isDrawing = false;
      let isRevealed = false;
      let currentOverlayImage = null;

      function getOverlayTextSize() {
        const isMobile = window.innerWidth < 768; // Изменено с 1024 на 768 для точности
        return isMobile
          ? (scratchContainer.dataset.overlayTextSizeMobile || '16')
          : (scratchContainer.dataset.overlayTextSize || '18');
      }

      function initCanvas() {
        // Даём браузеру время на рендер DOM
        requestAnimationFrame(() => {
          const rect = inner.getBoundingClientRect();
          const dpr = window.devicePixelRatio || 1;

          // Устанавливаем реальные размеры canvas с учётом DPR
          canvas.width = Math.max(1, Math.floor(rect.width * dpr));
          canvas.height = Math.max(1, Math.floor(rect.height * dpr));

          // CSS размеры должны соответствовать контейнеру
          canvas.style.width = rect.width + 'px';
          canvas.style.height = rect.height + 'px';

          ctx.scale(dpr, dpr);
          ctx.globalCompositeOperation = 'source-over';

          drawOverlay();
        });
      }

      function drawOverlay() {
        const rect = inner.getBoundingClientRect();
        const width = rect.width;
        const height = rect.height;

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        if (overlayImageUrl && currentOverlayImage) {
          // Рисуем изображение с сохранением пропорций или растягиваем на весь canvas
          ctx.drawImage(currentOverlayImage, 0, 0, width, height);
        } else {
          // Сплошной цвет с текстом
          ctx.fillStyle = overlayColor;
          ctx.fillRect(0, 0, width, height);

          if (overlayText) {
            ctx.fillStyle = overlayTextColor;
            const fontSize = parseInt(getOverlayTextSize());
            ctx.font = '600 ' + fontSize + 'px -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(overlayText, width / 2, height / 2);
          }
        }
      }

      // Загрузка изображения если нужно
      if (overlayImageUrl) {
        currentOverlayImage = new Image();
        currentOverlayImage.crossOrigin = "anonymous";
        currentOverlayImage.onload = function() {
          drawOverlay();
        };
        currentOverlayImage.onerror = function() {
          // При ошибке загрузки используем fallback с цветом
          currentOverlayImage = null;
          drawOverlay();
        };
        currentOverlayImage.src = overlayImageUrl;
      }

      // Инициализация с небольшой задержкой для гарантии рендера DOM
      setTimeout(initCanvas, 50);

      // Пересчёт при ресайзе с debounce
      let resizeTimeout;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(function() {
          if (!isRevealed) {
            initCanvas();
          }
        }, 100);
      });

      // Пересчёт при изменении ориентации на мобильных
      window.addEventListener('orientationchange', function() {
        setTimeout(initCanvas, 100);
      });

      function scratch(x, y) {
        ctx.globalCompositeOperation = 'destination-out';
        ctx.beginPath();
        ctx.arc(x, y, 25, 0, Math.PI * 2);
        ctx.fill();
      }

      function checkReveal() {
        if (isRevealed) return;

        try {
          var imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          var transparent = 0;
          var total = imageData.data.length / 4;

          // Проверяем каждый 4-й пиксель для оптимизации
          for (var i = 3; i < imageData.data.length; i += 16) {
            if (imageData.data[i] === 0) transparent += 4;
          }

          if ((transparent / total) * 100 >= threshold) {
            isRevealed = true;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            canvas.style.display = 'none';
            if (claimBtn) claimBtn.style.display = '';
          }
        } catch (e) {
          // Fallback если getImageData не работает (например, tainted canvas)
          console.warn('Scratch check failed:', e);
        }
      }

      function getPos(e) {
        var rect = canvas.getBoundingClientRect();
        var clientX, clientY;

        if (e.touches && e.touches.length > 0) {
          clientX = e.touches[0].clientX;
          clientY = e.touches[0].clientY;
        } else {
          clientX = e.clientX;
          clientY = e.clientY;
        }

        return {
          x: clientX - rect.left,
          y: clientY - rect.top
        };
      }

      // Mouse events
      canvas.addEventListener('mousedown', function(e) {
        isDrawing = true;
        var p = getPos(e);
        scratch(p.x, p.y);
      });

      canvas.addEventListener('mousemove', function(e) {
        if (!isDrawing) return;
        e.preventDefault();
        var p = getPos(e);
        scratch(p.x, p.y);
      });

      canvas.addEventListener('mouseup', function() {
        isDrawing = false;
        checkReveal();
      });

      canvas.addEventListener('mouseleave', function() {
        if (isDrawing) {
          isDrawing = false;
          checkReveal();
        }
      });

      // Touch events с улучшенной обработкой
      canvas.addEventListener('touchstart', function(e) {
        e.preventDefault();
        isDrawing = true;
        var p = getPos(e);
        scratch(p.x, p.y);
      }, { passive: false });

      canvas.addEventListener('touchmove', function(e) {
        e.preventDefault();
        if (!isDrawing) return;
        var p = getPos(e);
        scratch(p.x, p.y);
      }, { passive: false });

      canvas.addEventListener('touchend', function(e) {
        e.preventDefault();
        isDrawing = false;
        checkReveal();
      });

      canvas.addEventListener('touchcancel', function() {
        isDrawing = false;
      });
    }

    /* Claim button -> transition to email step */
    if (claimBtn) {
      claimBtn.addEventListener('click', function() {
        if (contentWrapper) contentWrapper.setAttribute('data-step', 'email');
      });
    }
  }

      /* Discount code copy to clipboard */
      const discountCodeBoxes = document.querySelectorAll('.discount-code-box-{{ section.id }}');
      discountCodeBoxes.forEach(function(box) {
        box.addEventListener('click', function() {
          var code = box.dataset.code;
          if (!code) return;
          var label = box.parentElement.querySelector('.discount-code-label-{{ section.id }}');
          function onCopied() {
            if (label) {
              var original = label.textContent;
              label.textContent = 'Copied!';
              setTimeout(function() { label.textContent = original; }, 2000);
            }
          }
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(code).then(onCopied).catch(function() {
              fallbackCopy(code);
              onCopied();
            });
          } else {
            fallbackCopy(code);
            onCopied();
          }
        });
      });

      /* Newsletter success handling */
      const hasNewsletterForm = document.querySelector('.modal-popup-newsletter-form-{{ section.id }}');
      const isCustomerPosted = new URLSearchParams(window.location.search).get('customer_posted') === '{{ section.id }}';
      if (hasNewsletterForm && isCustomerPosted) {
        {% for block in section.blocks %}
          {% if block.type == 'newsletter' %}
            {% if block.settings.success_redirect_enabled and block.settings.success_redirect_url != blank %}
              window.location.href = '{{ block.settings.success_redirect_url }}';
            {% else %}
              openModal();
              showSuccessState();
            {% endif %}
          {% endif %}
        {% endfor %}
      }

      if (toggle) {
        if (buttonClose) {
          buttonClose.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            toggle.style.display = 'none';
          });
        }

        toggle.addEventListener('click', function() {
          {% if hide_modal_days > 0 and display_options != 'click' %}
            if (hasModalCookieExpired()) {
              openModal();
              setModalCookie();
            }
          {% else %}
            openModal();
          {% endif %}
        });
      }

      if (close) {
        close.addEventListener('click', closeModal);
      }

      noThanksButtons.forEach(function(btn) {
        btn.addEventListener('click', closeModal);
      });

      {% if display_options == "after_seconds" %}
        setTimeout(function() {
          {% if hide_modal_days > 0 %}
            if (hasModalCookieExpired()) {
              openModal();
              setModalCookie();
            }
          {% else %}
            openModal();
          {% endif %}
        }, {{ seconds | times: 1000 }});
      {% endif %}

      {% if display_options == "after_scrolling" %}
        let hasShownScrollMessage = false;
        window.addEventListener("scroll", function() {
          if (!hasShownScrollMessage) {
            var scrollPosition = window.scrollY;
            var windowHeight = window.innerHeight;
            var documentHeight = document.body.clientHeight;
            var scrollPercentage = (scrollPosition + windowHeight) / documentHeight * 100;
            if (scrollPercentage >= {{ percent }}) {
              {% if hide_modal_days > 0 %}
                if (hasModalCookieExpired()) {
                  openModal();
                  hasShownScrollMessage = true;
                  setModalCookie();
                }
              {% else %}
                openModal();
                hasShownScrollMessage = true;
              {% endif %}
            }
          }
        });
      {% endif %}

      {% if display_options == "mouse_close" %}
        let hasShownMouseMessage = false;
        document.addEventListener("mouseleave", function(event) {
          if (!hasShownMouseMessage) {
            {% if hide_modal_days > 0 %}
              if (hasModalCookieExpired()) {
                openModal();
                hasShownMouseMessage = true;
                setModalCookie();
              }
            {% else %}
              openModal();
              hasShownMouseMessage = true;
            {% endif %}
          }
        });
      {% endif %}

      {% if hide_modal_days > 0 %}
        function hasModalCookieExpired() {
          const lastDisplayed = localStorage.getItem(modalKey);
          if (lastDisplayed) {
            const lastDisplayedDate = new Date(lastDisplayed);
            const now = new Date();
            const daysPassed = (now - lastDisplayedDate) / (1000 * 60 * 60 * 24);
            return daysPassed >= {{ hide_modal_days }};
          }
          return true;
        }

        function setModalCookie() {
          localStorage.setItem(modalKey, new Date().toISOString());
        }
      {% endif %}
    }

    function fallbackCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch(e) {}
      document.body.removeChild(ta);
    }

    document.addEventListener('DOMContentLoaded', initModalPopup6_{{ section.id | replace: '-', '_' }});

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:unload', initModalPopup6_{{ section.id | replace: '-', '_' }});
      document.addEventListener('shopify:section:load', initModalPopup6_{{ section.id | replace: '-', '_' }});
    }
