{%- comment -%}
  Product cards grid
  ----------------------
  Direct structural copy of sections/product-cards-carousel.liquid (that
  section is never read from or modified here). Centred heading and
  subheading over a responsive CSS grid of product cards: image with a
  status label top left and an offer label top right, benefit pills, title,
  star rating, description, an offer badge and a CTA.

  Each card takes a product picker, and every piece of text falls back to
  the product when the merchant leaves the override empty - title,
  description, image and link. This is IDENTICAL to the carousel's block
  model: merchants manually add one "product" block per card. This section
  does NOT loop over collection.products automatically.

  The ONLY change from the carousel: the slider viewport/track/arrows/dots
  and their JS are replaced by a plain responsive CSS grid (4 columns
  desktop / 2 tablet / 1 mobile by default, each configurable) with rows
  that continue vertically - no horizontal scrolling. Every card-level
  setting, fallback and the full card markup/CSS below is unchanged from
  the carousel (same vp-prodcards__* classes and rules).

  Stars use the same full/half/empty markup as the carousel: a full star
  laid over an empty one inside a 50%-wide overflow:hidden wrapper.

  Width reuses the theme's .page-width, so the section lines up with the
  header and its neighbours. Card classes are prefixed vp-prodcards-
  (unchanged from the carousel); the new grid wrapper uses vp-prodgrid-.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign all_blocks = section.blocks

  assign width_mode = st.section_width | default: 'page'
  assign inner_class = 'vp-prodgrid__inner page-width'
  if width_mode == 'full'
    assign inner_class = 'vp-prodgrid__inner page-width page-width--full'
  endif
  assign custom_max_width = st.custom_max_width | default: 1200

  comment
    Number settings come back nil when cleared, so each falls back to its
    documented default. 0 is truthy in Liquid, so a deliberate 0 survives.
  endcomment
  assign heading_fs = st.heading_size | default: 40
  assign heading_fs_m = st.heading_size_mobile | default: 26
  assign sub_fs = st.subheading_size | default: 17
  assign sub_fs_m = st.subheading_size_mobile | default: 15
  assign title_fs = st.title_size | default: 18
  assign title_fs_m = st.title_size_mobile | default: 16
  assign desc_fs = st.desc_size | default: 14
  assign desc_fs_m = st.desc_size_mobile | default: 13
  assign tag_fs = st.tag_size | default: 12
  assign tag_fs_m = st.tag_size_mobile | default: 11
  assign star_size = st.star_size | default: 17
  assign star_size_m = st.star_size_mobile | default: 16

  assign columns_desktop = st.columns_desktop | default: '4'
  assign columns_tablet = st.columns_tablet | default: '2'
  assign columns_mobile = st.columns_mobile | default: '1'

  assign heading_class = 'vp-prodcards__heading'
  if st.heading_gradient
    assign heading_class = 'vp-prodcards__heading vp-prodcards__heading--grad'
  endif
-%}

{%- capture star_full -%}
  <svg class="vp-prodcards__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.5l2.47 5.2 5.53.79-4 4.02.95 5.72L10 14.53 5.05 17.23l.95-5.72-4-4.02 5.53-.79L10 1.5z"/></svg>
{%- endcapture -%}

{%- capture star_empty -%}
  <svg class="vp-prodcards__star vp-prodcards__star--empty" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.5l2.47 5.2 5.53.79-4 4.02.95 5.72L10 14.53 5.05 17.23l.95-5.72-4-4.02 5.53-.79L10 1.5z"/></svg>
{%- endcapture -%}

{%- capture star_half -%}
  <span class="vp-prodcards__star-wrap">
    {{- star_empty -}}
    <span class="vp-prodcards__star-clip">{{- star_full -}}</span>
  </span>
{%- endcapture -%}

{%- if all_blocks.size > 0 -%}
  <div
    class="vp-prodgrid"
    style="
      --vp-pc-bg: {{ st.bg_color }};
      --vp-pc-heading: {{ st.heading_color }};
      --vp-pc-head-g1: {{ st.heading_gradient_start }};
      --vp-pc-head-g2: {{ st.heading_gradient_end }};
      --vp-pc-head-fs: {{ heading_fs }}px;
      --vp-pc-head-fs-m: {{ heading_fs_m }}px;
      --vp-pc-sub: {{ st.subheading_color }};
      --vp-pc-sub-fs: {{ sub_fs }}px;
      --vp-pc-sub-fs-m: {{ sub_fs_m }}px;
      --vp-pc-card-bg: {{ st.card_bg }};
      --vp-pc-card-border: {{ st.card_border_color }};
      --vp-pc-card-radius: {{ st.card_radius }}px;
      --vp-pc-title: {{ st.title_color }};
      --vp-pc-title-fs: {{ title_fs }}px;
      --vp-pc-title-fs-m: {{ title_fs_m }}px;
      --vp-pc-desc: {{ st.desc_color }};
      --vp-pc-desc-fs: {{ desc_fs }}px;
      --vp-pc-desc-fs-m: {{ desc_fs_m }}px;
      --vp-pc-tag-fs: {{ tag_fs }}px;
      --vp-pc-tag-fs-m: {{ tag_fs_m }}px;
      --vp-pc-weight: {{ st.font_weight }};
      --vp-pc-star: {{ st.star_color }};
      --vp-pc-star-size: {{ star_size }}px;
      --vp-pc-star-size-m: {{ star_size_m }}px;
      --vp-pg-gap: {{ st.grid_gap }}px;
      --vp-pg-cols-d: {{ columns_desktop }};
      --vp-pg-cols-t: {{ columns_tablet }};
      --vp-pg-cols-m: {{ columns_mobile }};
      --vp-pc-pad-top: {{ st.padding_top }}px;
      --vp-pc-pad-bottom: {{ st.padding_bottom }}px;
      --vp-pc-pad-top-m: {{ st.padding_top_mobile }}px;
      --vp-pc-pad-bottom-m: {{ st.padding_bottom_mobile }}px;
    "
  >
    <div
      class="{{ inner_class }}"
      {% if width_mode == 'custom' %}
        style="--page-width: {{ custom_max_width }}px;"
      {% endif %}
    >
      {%- if st.heading != blank or st.subheading != blank -%}
        <div class="vp-prodcards__intro">
          {%- if st.heading != blank -%}
            <div class="{{ heading_class }}">{{ st.heading }}</div>
          {%- endif -%}
          {%- if st.subheading != blank -%}
            <div class="vp-prodcards__subheading">{{ st.subheading }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="vp-prodgrid__grid">
        {%- for block in all_blocks -%}
        {%- if block.type == 'product' -%}
          {%- liquid
            assign bs = block.settings
            assign product = bs.product

            assign card_title = bs.title
            if card_title == blank
              assign card_title = product.title
            endif

            assign card_link = bs.link
            if card_link == blank
              assign card_link = product.url
            endif

            assign card_image = bs.image
            if card_image == blank
              assign card_image = product.featured_image
            endif

            assign card_desc = bs.description
            if card_desc == blank and product != blank
              assign card_desc = product.description | strip_html | truncatewords: 18
            endif

            assign rating = bs.rating | default: 5 | at_most: 5 | at_least: 0
            assign rating_full = rating | floor
            assign rating_rest = rating | minus: rating_full
            assign rating_half_at = rating_full | plus: 1

            assign benefits = bs.benefits | split: ','
          -%}

          <div class="vp-prodgrid__item" {{ block.shopify_attributes }}>
            <article class="vp-prodcards__card{% if st.card_shadow %} vp-prodcards__card--shadow{% endif %}">
              <div class="vp-prodcards__media">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', widths: '200,300,400,600,800', sizes: '(min-width: 990px) 25vw, 80vw', class: 'vp-prodcards__image', alt: card_title
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'vp-prodcards__image vp-prodcards__image--placeholder' }}
                {%- endif -%}

                {%- if bs.show_status and bs.status_text != blank -%}
                  <span
                    class="vp-prodcards__label vp-prodcards__label--status"
                    style="background-color: {{ bs.status_bg }}; color: {{ bs.status_text_color }};"
                  >
                    <svg class="vp-prodcards__label-icon" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="4"/></svg>
                    {{ bs.status_text | escape }}
                  </span>
                {%- endif -%}

                {%- if bs.show_offer and bs.offer_text != blank -%}
                  <span
                    class="vp-prodcards__label vp-prodcards__label--offer"
                    style="background-color: {{ bs.offer_bg }}; color: {{ bs.offer_text_color }};"
                  >
                    <svg class="vp-prodcards__label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0l-7.2-7.2a2 2 0 0 1-.6-1.4V4.4a2 2 0 0 1 2-2h7.6a2 2 0 0 1 1.4.6l6.8 6.8a2 2 0 0 1 0 2.8z"/><circle cx="8" cy="8" r="1.2" fill="currentColor"/></svg>
                    {{ bs.offer_text | escape }}
                  </span>
                {%- endif -%}
              </div>

              <div class="vp-prodcards__body">
                {%- if benefits.size > 0 -%}
                  <ul class="vp-prodcards__benefits" role="list">
                    {%- for benefit in benefits limit: 4 -%}
                      {%- assign benefit_text = benefit | strip -%}
                      {%- if benefit_text != blank -%}
                        <li
                          class="vp-prodcards__benefit"
                          style="background-color: {{ bs.benefit_bg }}; color: {{ bs.benefit_text_color }};"
                        >
                          {{- benefit_text | escape -}}
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                {%- if card_title != blank -%}
                  <h3 class="vp-prodcards__title">
                    {%- if card_link != blank -%}
                      <a class="vp-prodcards__title-link" href="{{ card_link }}">{{ card_title | escape }}</a>
                    {%- else -%}
                      {{ card_title | escape }}
                    {%- endif -%}
                  </h3>
                {%- endif -%}

                <div class="vp-prodcards__stars" role="img" aria-label="{{ rating }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    {%- if i <= rating_full -%}
                      {{ star_full }}
                    {%- elsif rating_rest >= 0.5 and i == rating_half_at -%}
                      {{ star_half }}
                    {%- else -%}
                      {{ star_empty }}
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                {%- if card_desc != blank -%}
                  <p class="vp-prodcards__desc">{{ card_desc | escape }}</p>
                {%- endif -%}

                <div class="vp-prodcards__foot">
                  {%- if bs.show_badge and bs.badge_text != blank -%}
                    <span
                      class="vp-prodcards__badge"
                      style="background-color: {{ bs.badge_bg }}; color: {{ bs.badge_text_color }};"
                    >
                      {%- case bs.badge_icon -%}
                        {%- when 'tag' -%}
                          <svg class="vp-prodcards__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0l-7.2-7.2a2 2 0 0 1-.6-1.4V4.4a2 2 0 0 1 2-2h7.6a2 2 0 0 1 1.4.6l6.8 6.8a2 2 0 0 1 0 2.8z"/><circle cx="8" cy="8" r="1.2" fill="currentColor"/></svg>
                        {%- when 'star' -%}
                          <svg class="vp-prodcards__badge-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.5l2.47 5.2 5.53.79-4 4.02.95 5.72L10 14.53 5.05 17.23l.95-5.72-4-4.02 5.53-.79L10 1.5z"/></svg>
                        {%- when 'none' -%}
                        {%- else -%}
                          <svg class="vp-prodcards__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                      {%- endcase -%}
                      {{ bs.badge_text | escape }}
                    </span>
                  {%- endif -%}

                  {%- if bs.cta_text != blank -%}
                    <a
                      class="vp-prodcards__cta"
                      style="background-color: {{ bs.cta_bg }}; color: {{ bs.cta_text_color }}; border-radius: {{ bs.cta_radius }}px;"
                      {% if bs.cta_link != blank %}
                        href="{{ bs.cta_link }}"
                      {% elsif card_link != blank %}
                        href="{{ card_link }}"
                      {% else %}
                        href="#" aria-disabled="true"
                      {% endif %}
                    >
                      {{- bs.cta_text | escape -}}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </article>
          </div>
        {%- elsif block.type == 'editorial_media' -%}
          {%- render 'product-cards-grid-editorial-media', block: block -%}
        {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% style %}
  .vp-prodgrid {
    background-color: var(--vp-pc-bg, #ffffff);
    padding-block: var(--vp-pc-pad-top-m, 40px) var(--vp-pc-pad-bottom-m, 40px);
    font-family: var(--font-body-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
  }

  /* max-width, margin and horizontal padding all come from .page-width. */
  .vp-prodgrid__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .vp-prodcards__intro {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: center;
  }

  .vp-prodcards__heading {
    font-family: var(--font-heading-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
    font-weight: 700;
    font-size: var(--vp-pc-head-fs-m, 26px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--vp-pc-heading, #10232B);
    text-wrap: balance;
  }

  .vp-prodcards__heading > *:first-child,
  .vp-prodcards__subheading > *:first-child { margin-top: 0; }
  .vp-prodcards__heading > *:last-child,
  .vp-prodcards__subheading > *:last-child { margin-bottom: 0; }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .vp-prodcards__heading--grad {
      background-image: linear-gradient(90deg, var(--vp-pc-head-g1, #47B5E9), var(--vp-pc-head-g2, #13B6B5));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }

    .vp-prodcards__heading--grad * {
      color: inherit;
      -webkit-text-fill-color: inherit;
    }
  }

  .vp-prodcards__subheading {
    font-size: var(--vp-pc-sub-fs-m, 15px);
    line-height: 1.5;
    color: var(--vp-pc-sub, #5A737D);
    max-width: 62ch;
    margin-inline: auto;
  }

  /* ---------- grid (replaces the carousel viewport/track/arrows/dots) ---------- */

  .vp-prodgrid__grid {
    display: grid;
    grid-template-columns: repeat(var(--vp-pg-cols-m, 1), 1fr);
    gap: var(--vp-pg-gap, 16px);
  }

  .vp-prodgrid__item {
    display: flex;
    min-width: 0;
  }

  /* ---------- card (unchanged from sections/product-cards-carousel.liquid) ---------- */

  .vp-prodcards__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    background-color: var(--vp-pc-card-bg, #ffffff);
    border: 1px solid var(--vp-pc-card-border, #E3EEF2);
    border-radius: var(--vp-pc-card-radius, 16px);
  }

  .vp-prodcards__card--shadow {
    box-shadow: 0 4px 16px rgba(16, 35, 43, 0.07);
  }

  .vp-prodcards__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background-color: rgba(16, 35, 43, 0.03);
  }

  .vp-prodcards__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vp-prodcards__image--placeholder {
    fill: rgba(16, 35, 43, 0.16);
  }

  .vp-prodcards__label {
    position: absolute;
    top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: var(--vp-pc-tag-fs-m, 11px);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }

  .vp-prodcards__label--status { left: 10px; }
  .vp-prodcards__label--offer { right: 10px; }

  .vp-prodcards__label-icon {
    display: block;
    width: 1em;
    height: 1em;
  }

  .vp-prodcards__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    flex: 1 1 auto;
    padding: 14px;
  }

  .vp-prodcards__benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vp-prodcards__benefit {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: var(--vp-pc-tag-fs-m, 11px);
    font-weight: 600;
    line-height: 1.2;
  }

  .vp-prodcards__title {
    margin: 0;
    font-size: var(--vp-pc-title-fs-m, 16px);
    font-weight: var(--vp-pc-weight, 700);
    line-height: 1.25;
    color: var(--vp-pc-title, #10232B);
  }

  .vp-prodcards__title-link {
    color: inherit;
    text-decoration: none;
  }

  .vp-prodcards__title-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .vp-prodcards__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--vp-pc-star, #F5A623);
  }

  .vp-prodcards__star,
  .vp-prodcards__star-wrap {
    display: block;
    flex: 0 0 auto;
    width: var(--vp-pc-star-size-m, 16px);
    height: var(--vp-pc-star-size-m, 16px);
  }

  .vp-prodcards__star--empty {
    opacity: 0.22;
  }

  .vp-prodcards__star-wrap {
    position: relative;
  }

  .vp-prodcards__star-wrap > .vp-prodcards__star {
    position: absolute;
    top: 0;
    left: 0;
  }

  .vp-prodcards__star-clip {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
  }

  .vp-prodcards__star-clip > .vp-prodcards__star {
    position: absolute;
    top: 0;
    left: 0;
  }

  .vp-prodcards__desc {
    margin: 0;
    font-size: var(--vp-pc-desc-fs-m, 13px);
    line-height: 1.5;
    color: var(--vp-pc-desc, #5A737D);
  }

  .vp-prodcards__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    width: 100%;
    margin-top: auto;
    padding-top: 4px;
  }

  .vp-prodcards__badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: var(--vp-pc-tag-fs-m, 11px);
    font-weight: 600;
    line-height: 1.2;
  }

  .vp-prodcards__badge-icon {
    display: block;
    width: 1.1em;
    height: 1.1em;
  }

  .vp-prodcards__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 12px 20px;
    font-size: var(--vp-pc-desc-fs-m, 13px);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: filter 0.18s ease;
  }

  .vp-prodcards__cta:hover {
    filter: brightness(0.94);
    text-decoration: none;
  }

  /* ---------- tablet ---------- */

  @media screen and (min-width: 750px) {
    .vp-prodgrid {
      padding-block: var(--vp-pc-pad-top, 64px) var(--vp-pc-pad-bottom, 64px);
    }

    .vp-prodgrid__inner { gap: 32px; }
    .vp-prodgrid__grid { grid-template-columns: repeat(var(--vp-pg-cols-t, 2), 1fr); }
    .vp-prodcards__heading { font-size: var(--vp-pc-head-fs, 40px); }
    .vp-prodcards__subheading { font-size: var(--vp-pc-sub-fs, 17px); }
    .vp-prodcards__title { font-size: var(--vp-pc-title-fs, 18px); }
    .vp-prodcards__desc,
    .vp-prodcards__cta { font-size: var(--vp-pc-desc-fs, 14px); }
    .vp-prodcards__label,
    .vp-prodcards__benefit,
    .vp-prodcards__badge { font-size: var(--vp-pc-tag-fs, 12px); }

    .vp-prodcards__star,
    .vp-prodcards__star-wrap {
      width: var(--vp-pc-star-size, 17px);
      height: var(--vp-pc-star-size, 17px);
    }

    .vp-prodcards__body { padding: 18px; gap: 12px; }
  }

  /* ---------- desktop ---------- */

  @media screen and (min-width: 990px) {
    .vp-prodgrid__grid { grid-template-columns: repeat(var(--vp-pg-cols-d, 4), 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .vp-prodcards__cta {
      transition: none;
    }
  }

  /* ---------- editorial media block (snippets/product-cards-grid-editorial-media.liquid) ---------- */
  /* Lives here, not in the snippet, so it renders exactly once regardless
     of how many editorial_media blocks the merchant adds. */

  .vp-prodgrid-media {
    grid-column: 1 / -1;
    background: var(--vp-pgm-bg, transparent);
    color: var(--vp-pgm-text, #10232B);
    margin-top: var(--vp-pgm-spacing-top, 8px);
    margin-bottom: var(--vp-pgm-spacing-bottom, 8px);
    overflow: hidden;
  }

  .vp-prodgrid-media--contained {
    border-radius: var(--vp-pgm-radius, 16px);
  }

  .vp-prodgrid-media--full_bleed {
    border-radius: 0;
  }

  .vp-prodgrid-media__media {
    position: relative;
    background: rgba(16, 35, 43, 0.03);
    aspect-ratio: var(--vp-pgm-ratio-m, 4/5);
  }

  .vp-prodgrid-media__image,
  .vp-prodgrid-media__video-wrap,
  .vp-prodgrid-media__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vp-prodgrid-media__image--mobile-only { display: block; }
  .vp-prodgrid-media__image--desktop-only { display: none; }

  .vp-prodgrid-media__content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .vp-prodgrid-media__heading {
    margin: 0;
    font-family: var(--font-heading-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    color: inherit;
  }

  .vp-prodgrid-media__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: inherit;
    opacity: 0.9;
  }

  .vp-prodgrid-media__cta {
    align-self: flex-start;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border-radius: 999px;
    background: #47B5E9;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .vp-prodgrid-media__cta:focus-visible { outline: 2px solid #10232B; outline-offset: 2px; }

  @media screen and (min-width: 750px) {
    .vp-prodgrid-media__media { aspect-ratio: var(--vp-pgm-ratio-d, 21/9); }
    .vp-prodgrid-media__image--desktop-only { display: block; }
    .vp-prodgrid-media__image--mobile-only { display: none; }
    .vp-prodgrid-media__content { padding: 28px; }
    .vp-prodgrid-media__heading { font-size: 26px; }
    .vp-prodgrid-media__text { font-size: 16px; }
  }
{% endstyle %}

