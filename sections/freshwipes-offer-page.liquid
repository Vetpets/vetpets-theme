    },
    { "type": "text", "id": "deal_start", "label": "Start The Routine Kit deal ID", "default": "f040c6e7-5e2a-4829-beb2-20ffae287ddd" },
    { "type": "text", "id": "deal_clean", "label": "The Clean Smile Kit deal ID", "default": "179eaa84-019d-42c9-9d03-35e2b1bcacab" },
    { "type": "text", "id": "deal_family", "label": "The Full Family Plan deal ID", "default": "be60c842-23bc-4d85-b7a7-8a67cddec0f7" },
