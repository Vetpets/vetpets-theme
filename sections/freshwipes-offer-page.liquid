{%- comment -%}
  FreshWipes offer page — World Animal Week 2026 campaign build
  ===================
  Faithful Shopify implementation of the approved Claude Design page
  "FreshWipes Offer Page - World Animal Week 2026" (project: VetPets FreshWipes
  Offer Page). Campaign window is 28 Sep – 4 Oct 2026, 23:59:59 local time —
  the fixed end date lives in the countdown clock at the bottom of
  assets/freshwipes-offer-page.js. No charity or donation messaging anywhere
  on this page.

  The campaign narrows the plan picker to the two Kaching deals the design
  shows (Starter Routine / Complete Dental Routine); the third ("Full Family
  Plan") deal stays fully configured in Kaching but its bar is hidden with
  CSS for the duration of the campaign — see ".fwof-kaching" rules tagged
  WAW in assets/freshwipes-offer-page.css. Nothing about Kaching's own
  config changes.

  Rendered only through templates/product.freshwipes-offer-page.json, assigned to
  the existing live FreshWipes product. The canonical product URL is unchanged.

  COMMERCE OWNERSHIP
  ------------------
  Kaching Bundles is the source of truth for tier, quantity, deal, selling plan,
  bundle properties and free gifts. Its app block is rendered below inside the
  purchase module and its real controls stay authoritative — assets/freshwipes-offer-page.css
  restyles those exact nodes to the approved design rather than cloning them.

  There is exactly ONE add-to-cart pathway: the theme's <product-form> rendered
  in `.fwof-form-host`. The sticky bar and the final offer CTA are proxies that
  submit that same form; they carry no quantity, gift or selling-plan logic.

  Everything is scoped under #freshwipes-offer-page.
{%- endcomment -%}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign product_form_id = 'fwof-product-form-' | append: section.id
-%}

{{ 'freshwipes-offer-page.css' | asset_url | stylesheet_tag }}

<link rel="preload" as="image" href="{{ 'fwof-tier-2pack.webp' | asset_url }}">
<link rel="preload" as="image" href="{{ 'fwof-tier-4pack-waw.webp' | asset_url }}">

<div id="freshwipes-offer-page" data-rc="on" data-tier="clean" data-waw="on">

  {%- comment -%} ---------- World Animal Week event banner (replaces the evergreen rotating announcement bar) ---------- {%- endcomment -%}
  <div class="waw-bar waw-paws">
    <div class="waw-in">
      <div class="waw-meta">
        <div class="waw-meta-r1">
          <span class="waw-mark" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9.2" fill="#47B5E9"></circle><path d="M12 2.8c3 3.3 3 15 0 18.4M12 2.8c-3 3.3-3 15 0 18.4M3.2 9h17.6M3.2 15h17.6" stroke="#FFFFFF" stroke-width="1.5"></path></svg></span>
          <span class="waw-label">World Animal Week Sale</span>
          <span class="waw-ends-inline"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="#D92D20" stroke-width="2.6"></circle><path d="M12 7.2V12l3.4 2.2" stroke="#D92D20" stroke-width="2.6" stroke-linecap="round"></path></svg>Ends Oct 4</span>
        </div>
        <span class="waw-dates">28 September – 4 October 2026</span>
      </div>
      <div class="waw-center">
        <div class="waw-offer">Buy 2, Get 2 Free <span class="waw-plus">+ Free Gifts</span></div>
        <span class="waw-ends"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="#D92D20" stroke-width="2.6"></circle><path d="M12 7.2V12l3.4 2.2" stroke="#D92D20" stroke-width="2.6" stroke-linecap="round"></path></svg>Ends October 4</span>
      </div>
      <div class="waw-timer" role="timer" aria-label="World Animal Week sale ends 4 October 2026">
        <span class="waw-timer-l">Offer ends in</span>
        <div class="waw-cd">
          <div class="waw-cd-u"><div class="waw-cd-n" data-cd="d">00</div><div class="waw-cd-l">Days</div></div>
          <div class="waw-cd-u"><div class="waw-cd-n" data-cd="h">00</div><div class="waw-cd-l">Hrs</div></div>
          <div class="waw-cd-u"><div class="waw-cd-n" data-cd="m">00</div><div class="waw-cd-l">Min</div></div>
          <div class="waw-cd-u"><div class="waw-cd-n" data-cd="s">00</div><div class="waw-cd-l">Sec</div></div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ---------- SECTION 1 — above the fold ---------- {%- endcomment -%}
  <section class="hero" id="fwof-hero">
    <div class="hero-in">

      {%- comment -%} gallery: tier-driven slide 1 + approved PDP squares {%- endcomment -%}
      <div class="gal">
        <div class="g-badges" aria-live="polite">
          <span class="g-pill">Buy 2, Get 2 Free</span>
          <span class="g-pill2" hidden></span>
        </div>
        <div class="railwrap">
          <div class="rail" id="fwof-rail" tabindex="0" role="group" aria-label="FreshWipes gallery — use left and right arrow keys">
            <div class="slide s-offer">
              <img
                class="im im-fit"
                id="fwof-tier-img"
                src="{{ 'fwof-tier-4pack-waw.webp' | asset_url }}"
                width="900"
                height="900"
                fetchpriority="high"
                decoding="async"
                alt="World Animal Week — Buy 2, Get 2 Free. Four containers of VetPets FreshWipes with the Fresh Breath in 30 Days e-book and the Fresh Breath Routine Tracker">
              <div class="gift-badges" data-fwof-gift-badges aria-live="polite">
                <span class="gift-badge"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="9.5" width="18" height="11.5" rx="1.8" fill="#FFFFFF"></rect><rect x="2" y="6" width="20" height="4.5" rx="1.5" fill="#FFFFFF"></rect><path d="M12 6v15" stroke="#47B5E9" stroke-width="2"></path><path d="M12 6C10.5 2.8 6.6 3.2 7.2 5.4 7.6 6.9 10 6.6 12 6Zm0 0c1.5-3.2 5.4-2.8 4.8-.6-.4 1.5-2.8 1.2-4.8.6Z" fill="#FFFFFF"></path></svg>Free E-Book</span>
                <span class="gift-badge"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="9.5" width="18" height="11.5" rx="1.8" fill="#FFFFFF"></rect><rect x="2" y="6" width="20" height="4.5" rx="1.5" fill="#FFFFFF"></rect><path d="M12 6v15" stroke="#47B5E9" stroke-width="2"></path><path d="M12 6C10.5 2.8 6.6 3.2 7.2 5.4 7.6 6.9 10 6.6 12 6Zm0 0c1.5-3.2 5.4-2.8 4.8-.6-.4 1.5-2.8 1.2-4.8.6Z" fill="#FFFFFF"></path></svg>Free Routine Tracker</span>
              </div>
            </div>
            {%- assign pdp_slides = 'fwof-pdp-before-after.webp|A dog’s teeth before and after a consistent FreshWipes routine;fwof-pdp-textured.webp|Close-up of the textured FreshWipes finger wipe surface;fwof-pdp-risk-free.webp|100-Day Money-Back Guarantee — try FreshWipes risk-free;fwof-pdp-how-to.webp|How to use FreshWipes in three steps;fwof-pdp-signs.webp|Signs a dog may need dental care — bad breath, yellow buildup and red gums;fwof-pdp-ingredients.webp|FreshWipes gentle ingredients — green tea extract, glycerin, citric acid and allantoin;fwof-pdp-stick-to-it.webp|A hand holding the FreshWipes container — dental care you can stick to;fwof-pdp-lifestyle.webp|A dog owner using FreshWipes as part of a simple daily habit' | split: ';' -%}
            {%- for s in pdp_slides -%}
              {%- assign parts = s | split: '|' -%}
              <div class="slide s-pdp">
                <img class="im im-fit" src="{{ parts[0] | asset_url }}" width="1080" height="1080" loading="lazy" decoding="async" alt="{{ parts[1] }}">
              </div>
            {%- endfor -%}
          </div>
          <button type="button" class="navbtn navbtn-p" aria-label="Previous image">&lsaquo;</button>
          <button type="button" class="navbtn navbtn-n" aria-label="Next image">&rsaquo;</button>
        </div>

        <div class="dots" role="tablist" aria-label="Gallery slides">
          {%- for i in (1..9) -%}
            <button type="button" class="dot{% if forloop.first %} on{% endif %}" aria-label="Slide {{ i }}"></button>
          {%- endfor -%}
        </div>

        <div class="thumbs" role="tablist" aria-label="Gallery thumbnails">
          <button type="button" class="thumb on" aria-label="Selected kit bundle" aria-selected="true">
            <img src="{{ 'fwof-tier-4pack-waw.webp' | asset_url }}" data-fwof-tier-thumb width="900" height="900" alt="">
          </button>
          {%- for s in pdp_slides -%}
            {%- assign parts = s | split: '|' -%}
            <button type="button" class="thumb" aria-label="{{ parts[1] }}" aria-selected="false">
              <img src="{{ parts[0] | asset_url }}" width="1080" height="1080" loading="lazy" alt="">
            </button>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} purchase module {%- endcomment -%}
      <div class="buy">
        <div class="waw-hb">
          <span class="waw-hb-ic" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#FFFFFF" stroke-width="1.9"></circle><path d="M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18M3.2 9h17.6M3.2 15h17.6" stroke="#FFFFFF" stroke-width="1.6"></path></svg></span>
          <span class="waw-hb-c">
            <span class="waw-hb-t">World Animal Week</span>
            <span class="waw-hb-s">Limited-Time Sale</span>
          </span>
          <span class="waw-hb-d"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="#D92D20" stroke-width="2.6"></circle><path d="M12 7.2V12l3.4 2.2" stroke="#D92D20" stroke-width="2.6" stroke-linecap="round"></path></svg>Ends Oct 4</span>
        </div>

        <h1 class="h1">{{ section.settings.heading }}
          <span class="h1-sub">{{ section.settings.subheading }}</span>
        </h1>

        <div class="rating" style="margin-top:11px">
          <span class="stars" role="img" aria-label="Rated 4.8 out of 5">★★★★★</span>
          <span>4.8/5 · Trusted by 45,000+ Dog Owners</span>
        </div>

        <div class="bullets">
          {%- assign bullets = 'Textured surface lifts away plaque|Antibacterial ingredients help stop buildup|Gentle on gums — fits over one finger, no brush' | split: '|' -%}
          {%- for b in bullets -%}
            <div class="bullet">
              {% render 'fwof-check', size: 19 %}
              <span>{{ b }}</span>
            </div>
          {%- endfor -%}
        </div>

        <div class="waw-plan-head">
          <span class="pick-h">{{ section.settings.picker_heading }}</span>
          <span class="waw-badges">
            <span class="waw-badge waw-badge-teal"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="#FFFFFF" stroke-width="2"></circle><path d="M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18M3.2 9h17.6M3.2 15h17.6" stroke="#FFFFFF" stroke-width="1.7"></path></svg>World Animal Week Offer</span>
            <span class="waw-badge waw-badge-red"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="#D92D20" stroke-width="2.6"></circle><path d="M12 7.2V12l3.4 2.2" stroke="#D92D20" stroke-width="2.6" stroke-linecap="round"></path></svg>Ends October 4</span>
          </span>
        </div>

        {%- comment -%}
          Kaching Bundles app block — the real tier radios, the real RoutineCare
          subscription card and the real free-gift rows. Restyled by CSS, never cloned.
        {%- endcomment -%}
        <div class="fwof-kaching">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              {% render block %}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} the ONE authoritative add-to-cart pathway {%- endcomment -%}
        <div class="fwof-form-host">
          {%- if product != blank -%}
            <product-form
              id="ProductForm-{{ section.id }}"
              class="product-form main-product-form"
              data-section="{{ section.id }}"
              data-main="true"
            >
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                <svg aria-hidden="true" focusable="false" class="icon icon-error" viewBox="0 0 13 13" width="13" height="13">
                  <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"></circle>
                  <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"></path>
                </svg>
                <span class="product-form__error-message"></span>
              </div>

              {%- form 'product',
                product,
                id: product_form_id,
                class: 'form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input type="hidden" name="id" value="{{ v.id }}" class="product-variant-id">
                {%- comment -%}
                  Private line-item properties for the cart drawer's bundle image.
                  These ride the MAIN FreshWipes item only. Kaching adds free gifts as
                  separate lines and its `propagate_line_properties` flag is false, so
                  gift lines never inherit them. The JS keeps tier/image in sync.
                {%- endcomment -%}
                <input type="hidden" name="properties[_vp_offer_source]" value="freshwipes-offer-page">
                <input type="hidden" name="properties[_vp_bundle_tier]" id="fwof-prop-tier" value="4-pack">
                <input type="hidden" name="properties[_vp_bundle_image]" id="fwof-prop-image" value="{{ 'fwof-tier-4pack-waw.webp' | asset_url }}">
                <button
                  id="ProductSubmitButton-{{ section.id }}"
                  type="submit"
                  name="add"
                  data-fwof-submit
                  class="atc-button product-form__submit main-product-atc cta btn-buy"
                  {% if v.available == false %}disabled{% endif %}
                >
                  <span><span data-fwof-cta-label>Add To Cart — Buy 2, Get 2 Free</span> <span aria-hidden="true">→</span></span>
                </button>
              {%- endform -%}
            </product-form>
          {%- endif -%}
        </div>

        <div class="guar-row">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#13B6B5"></circle><path d="m7.4 12.3 3 3 6.2-6.6" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span>100-Day Money-Back Guarantee</span>
        </div>

        <div class="pay">
          <img class="pay-strip" src="{{ 'fwof-payment-badges.webp' | asset_url }}" width="700" height="64" loading="lazy" decoding="async" alt="Accepted payment methods: Mastercard, Visa, PayPal, American Express, Discover and Apple Pay">
        </div>

        <div class="secure">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10.5" rx="2.2" fill="#6B7A85"></rect><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" stroke="#6B7A85" stroke-width="2.2" stroke-linecap="round"></path></svg>
          <span>All transactions are secure and encrypted</span>
        </div>

        {%- render 'subscription-disclosure', frequency: section.settings.rc_frequency_label, manage_url: section.settings.manage_subscription_url -%}

        {%- comment -%} information panel {%- endcomment -%}
        <div class="info">
          <div class="info-tabs" role="tablist" aria-label="About FreshWipes">
            <button type="button" class="info-tab on" role="tab" aria-selected="true">Vet Reviewed</button>
            <button type="button" class="info-tab" role="tab" aria-selected="false">Ingredients</button>
            <button type="button" class="info-tab" role="tab" aria-selected="false">How To Use</button>
            <button type="button" class="info-tab" role="tab" aria-selected="false">Benefits</button>
          </div>
          <div class="info-body">
            <div class="info-panel" role="tabpanel">
              <div class="vet">
                <div class="vet-eyebrow">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.6 4.8 5.4v6.1c0 4.5 3 8.6 7.2 9.9 4.2-1.3 7.2-5.4 7.2-9.9V5.4L12 2.6Z" fill="#1F7FB8"></path><path d="m8.6 12.2 2.6 2.6 4.4-4.7" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  Veterinarian Reviewed
                </div>
                <h3 class="vet-h">A Practical Approach to At-Home Dental Care</h3>
                <div class="vet-grid">
                  <p class="vet-p">FreshWipes gives pet owners direct, finger-guided control over a textured cleaning surface — helping lift plaque and food debris from accessible teeth and along the gumline without the toothbrush struggle. A routine is only useful when it is simple enough to use consistently.</p>
                  <div class="vet-row">
                    <div class="vet-por"><img src="{{ 'fwpl-vet-portrait.webp' | asset_url }}" width="720" height="900" loading="lazy" alt="Dr. Michael Thompson, Veterinarian at VetPets"></div>
                    <div class="vet-who">
                      <div class="vet-name">Reviewed by Dr. Michael Thompson</div>
                      <div class="vet-role">Veterinarian · VetPets</div>
                      <span class="vet-badge">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.6 4.8 5.4v6.1c0 4.5 3 8.6 7.2 9.9 4.2-1.3 7.2-5.4 7.2-9.9V5.4L12 2.6Z" fill="#FFFFFF"></path><path d="m8.6 12.2 2.6 2.6 4.4-4.7" stroke="#13B6B5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                        Vet Reviewed
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="info-panel" role="tabpanel" hidden>
              <div class="info-ing">
                <div class="info-ing-r"><strong>EDI-purified water</strong> — base solution</div>
                <div class="info-ing-r"><strong>Green tea extract</strong> — helps freshen breath</div>
                <div class="info-ing-r"><strong>Tea polyphenols</strong> — plant-derived oral-care actives</div>
                <div class="info-ing-r"><strong>Cetylpyridinium chloride monohydrate</strong> — antibacterial, widely used in oral care</div>
                <div class="info-ing-r"><strong>Allantoin</strong> — soothes gums</div>
                <div class="info-ing-r"><strong>Glycerin</strong> — supports moisture</div>
                <div class="info-ing-r"><strong>Citric acid</strong> — balances pH</div>
              </div>
              <div class="info-free">
                <span>pH-balanced &amp; fragrance-free</span>
                <span>Designed for safe use in the mouth</span>
                <span>For dogs &amp; cats</span>
              </div>
            </div>

            <div class="info-panel" role="tabpanel" hidden>
              <ul class="info-list">
                {%- assign howto = 'Slip one FreshWipes finger wipe securely over your index finger.|Use small circular motions across the accessible outer tooth surfaces and gumline.|Check the wipe to see where the textured surface made contact, then discard it. No rinsing, brushing or toothpaste needed.|Keep the first sessions short and calm. Consistency matters more than pressure.' | split: '|' -%}
                {%- for h in howto -%}
                  <li class="info-li">{% render 'fwof-check', size: 16 %}<span>{{ h }}</span></li>
                {%- endfor -%}
              </ul>
            </div>

            <div class="info-panel" role="tabpanel" hidden>
              <ul class="info-list">
                {%- assign benefits = 'Textured surface physically lifts plaque instead of working around it.|Antibacterial ingredients help stop buildup between cleanings.|Gentle on gums — pH-balanced, fragrance-free and made for use in the mouth.|A 30-second routine you can actually keep up with.|Suitable for dogs and cats.' | split: '|' -%}
                {%- for b in benefits -%}
                  <li class="info-li">{% render 'fwof-check', size: 16 %}<span>{{ b }}</span></li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        </div>

        <div class="waw-scar">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 22 20H2L12 3Z" fill="#D92D20"></path><path d="M12 9.5v4.5" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round"></path><circle cx="12" cy="17" r="1.2" fill="#FFFFFF"></circle></svg>
          <div>
            <span class="waw-scar-t">High demand during World Animal Week</span>
            <span class="waw-scar-s">Order now while this offer and available stock last.</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  {%- comment -%} ---------- SECTION 2 — marquee ---------- {%- endcomment -%}
  {%- assign claims = '45,000+ Happy Dog Owners|100-Day Money-Back Guarantee|50 Textured Finger Wipes Per Jar|Works In 30 Seconds A Day' | split: '|' -%}
  <div class="mq">
    <ul class="fwof-sr">
      {%- for c in claims -%}<li>{{ c }}</li>{%- endfor -%}
    </ul>
    <div class="mq-track">
      {%- for group in (1..2) -%}
        <div class="mq-group" aria-hidden="true">
          {%- for copy in (1..2) -%}
            {%- for c in claims -%}
              <span class="mq-item"><span>{{ c }}</span>{% render 'fwof-paw' %}</span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ---------- SECTION 2B — how the World Animal Week offer works ---------- {%- endcomment -%}
  <section class="sec">
    <div class="col-c">
      <span class="waw-eyebrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="#FFFFFF" stroke-width="1.9"></circle><path d="M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18M3.2 9h17.6M3.2 15h17.6" stroke="#FFFFFF" stroke-width="1.6"></path></svg>World Animal Week · 28 Sep – 4 Oct</span>
      <h2 class="h2">Buy 2, Get 2 Free — <span class="accent">plus free gifts</span></h2>
      <p class="lead">One week, one offer. Everything below applies until the sale closes on October 4.</p>
      <div class="waw-steps">
        <div class="waw-step">
          <span class="waw-step-n">1</span>
          <h3 class="waw-step-t">Choose your kit</h3>
          <p class="waw-step-p">Pick the supply that fits your household. The Complete Dental Routine is the World Animal Week offer kit — 4 jars, two of them free.</p>
        </div>
        <div class="waw-step">
          <span class="waw-step-n">2</span>
          <h3 class="waw-step-t">The free jars are added</h3>
          <p class="waw-step-p">Buy 2, Get 2 Free is applied to the kit you select, together with the free gifts listed for it. Shipping is free.</p>
        </div>
        <div class="waw-step">
