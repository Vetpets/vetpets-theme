{{ 'freshwipes-offer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st = section.settings
  assign cols = 'col1,col2,col3' | split: ','
-%}

{%- comment -%}
  The tick/cross glyphs are decorative, so they carry an explicit accessible
  label. Both labels are editable so they can be translated with the page.
{%- endcomment -%}
{%- capture fwo_mark_yes -%}
  <span class="fwo-compare__mark fwo-compare__mark--yes" role="img" aria-label="{{ st.yes_label | default: 'Yes' | escape }}">✓</span>
{%- endcapture -%}
{%- capture fwo_mark_no -%}
  <span class="fwo-compare__mark fwo-compare__mark--no" role="img" aria-label="{{ st.no_label | default: 'No' | escape }}">✕</span>
{%- endcapture -%}

<div class="fwo fwo-compare">
  <div class="fwo__inner fwo__section">
    {%- if st.heading != blank -%}
      <h2 class="fwo__heading" style="text-align: center;">{{ st.heading | escape }}</h2>
    {%- endif -%}

    <div class="fwo-compare__scroller">
      <table class="fwo-compare__table">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">{{ st.row_header_label | default: 'Feature' }}</span></th>

            {%- for col in cols -%}
              {%- liquid
                assign label_key = col | append: '_label'
                assign image_key = col | append: '_image'
                assign url_key = col | append: '_image_url'
                assign alt_key = col | append: '_image_alt'
                assign col_label = st[label_key]
                assign col_image = st[image_key]
                assign col_url = st[url_key]
                assign col_alt = st[alt_key]
              -%}
              <th
                scope="col"
                {% if col == 'col1' %}class="fwo-compare__col--ours"{% endif %}
              >
                {%- if col_image != blank or col_url != blank -%}
                  {%- render 'fwo-image',
                    image: col_image,
                    url: col_url,
                    width: 1080,
                    height: 1080,
                    alt: col_alt,
                    aspect: '1 / 1',
                    sizes: '100px',
                    class: 'fwo-compare__col-media'
                  -%}
                {%- endif -%}
                <span class="fwo-compare__col-label">{{ col_label | escape }}</span>
              </th>
            {%- endfor -%}
          </tr>
        </thead>

        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row" class="fwo-compare__row-label">{{ block.settings.label | escape }}</th>

              {%- for col in cols -%}
                {%- liquid
                  assign type_key = col | append: '_type'
                  assign text_key = col | append: '_text'
                  assign cell_type = block.settings[type_key]
                  assign cell_text = block.settings[text_key]
                -%}
                <td {% if col == 'col1' %}class="fwo-compare__col--ours"{% endif %}>
                  {%- case cell_type -%}
                    {%- when 'yes' -%}
                      {{ fwo_mark_yes }}
                    {%- when 'no' -%}
                      {{ fwo_mark_no }}
                    {%- else -%}
                      {{ cell_text | escape }}
                  {%- endcase -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FWO comparison table",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FreshWipes vs. \"the other internet solutions\""
    },
    {
      "type": "text",
      "id": "row_header_label",
      "label": "Row header (screen readers only)",
      "default": "Feature"
    },
    {
      "type": "text",
      "id": "yes_label",
      "label": "Check mark label (screen readers only)",
      "default": "Yes"
    },
    {
      "type": "text",
      "id": "no_label",
      "label": "Cross mark label (screen readers only)",
      "default": "No"
    },
    {
      "type": "header",
      "content": "Column 1 (ours)"
    },
    {
      "type": "text",
      "id": "col1_label",
      "label": "Label",
      "default": "FreshWipes"
    },
    {
      "type": "image_picker",
      "id": "col1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "col1_image_url",
      "label": "Image URL fallback"
    },
    {
      "type": "text",
      "id": "col1_image_alt",
      "label": "Image alt text",
      "default": "FreshWipes"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "col2_label",
      "label": "Label",
      "default": "Toothbrush + Toothpaste"
    },
    {
      "type": "image_picker",
      "id": "col2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "col2_image_url",
      "label": "Image URL fallback"
    },
    {
      "type": "text",
      "id": "col2_image_alt",
      "label": "Image alt text",
      "default": "Toothbrush and toothpaste"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "text",
      "id": "col3_label",
      "label": "Label",
      "default": "Dental powders"
    },
    {
      "type": "image_picker",
      "id": "col3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "col3_image_url",
      "label": "Image URL fallback"
    },
    {
      "type": "text",
      "id": "col3_image_alt",
      "label": "Image alt text",
      "default": "Dental powder"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label"
        },
        {
          "type": "select",
          "id": "col1_type",
          "label": "Column 1 value",
          "options": [
            { "value": "yes", "label": "Check" },
            { "value": "no", "label": "Cross" },
            { "value": "text", "label": "Text" }
          ],
          "default": "yes"
        },
        {
          "type": "text",
          "id": "col1_text",
          "label": "Column 1 text",
          "info": "Used when Column 1 value is set to Text."
        },
        {
          "type": "select",
          "id": "col2_type",
          "label": "Column 2 value",
          "options": [
            { "value": "yes", "label": "Check" },
            { "value": "no", "label": "Cross" },
            { "value": "text", "label": "Text" }
          ],
          "default": "no"
        },
        {
          "type": "text",
          "id": "col2_text",
          "label": "Column 2 text"
        },
        {
          "type": "select",
          "id": "col3_type",
          "label": "Column 3 value",
          "options": [
            { "value": "yes", "label": "Check" },
            { "value": "no", "label": "Cross" },
            { "value": "text", "label": "Text" }
          ],
          "default": "no"
        },
        {
          "type": "text",
          "id": "col3_text",
          "label": "Column 3 text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FWO comparison table",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
