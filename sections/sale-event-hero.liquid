{%- comment -%}
  Sale-event hero
  ----------------
  Compact, configurable campaign hero for the sale-event collection template.
  Renders the page's single <h1>. Nothing here reads from or writes to any
  other section - fully isolated, prefix vp-se-hero__.
{%- endcomment -%}

{%- liquid
  assign st = section.settings
  assign has_video = false
  if st.video != blank
    assign has_video = true
  endif

  assign align_class = 'vp-se-hero--align-' | append: st.text_alignment
  assign position_class = 'vp-se-hero--pos-' | append: st.text_position
-%}

<section
  class="vp-se-hero {{ align_class }} {{ position_class }}{% if st.desktop_image == blank and st.mobile_image == blank and has_video == false %} vp-se-hero--no-media{% endif %}"
  style="
    --vp-se-hero-bg: {{ st.color_background }};
    --vp-se-hero-text: {{ st.color_text }};
    --vp-se-hero-overlay: {{ st.overlay_strength | divided_by: 100.0 }};
    --vp-se-hero-max-height: {{ st.max_height_desktop | default: 420 }}px;
  "
  data-vp-se-hero
>
  <div class="vp-se-hero__inner page-width">
    <div class="vp-se-hero__media" aria-hidden="{% if has_video %}false{% else %}true{% endif %}">
      {%- if has_video -%}
        <internal-video class="vp-se-hero__video-wrap"{% if st.video_autoplay %} data-autoplay="true" data-no-play-btn="true"{% endif %}>
          <video
            class="vp-se-hero__video"
            poster="{% if st.video_poster != blank %}{{ st.video_poster | image_url: width: 1600 }}{% else %}{{ st.video.preview_image | image_url: width: 1600 }}{% endif %}"
            {% if st.video_loop %}loop{% endif %}
            {% if st.video_autoplay %}muted{% endif %}
            playsinline
            {% unless st.video_autoplay %}controls{% endunless %}
          >
            {%- for source in st.video.sources -%}
              <source {% if st.video_autoplay %}data-{% endif %}src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          </video>
        </internal-video>
      {%- else -%}
        {%- if st.desktop_image != blank -%}
          {{
            st.desktop_image
            | image_url: width: 2000
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750,1100,1500,2000',
              sizes: '100vw',
              class: 'vp-se-hero__image vp-se-hero__image--desktop',
              style: 'object-position: ' | append: st.focal_point | append: ';',
              alt: ''
          }}
        {%- endif -%}
        {%- if st.mobile_image != blank -%}
          {{
            st.mobile_image
            | image_url: width: 900
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '480,640,900',
              sizes: '100vw',
              class: 'vp-se-hero__image vp-se-hero__image--mobile',
              style: 'object-position: ' | append: st.focal_point | append: ';',
              alt: ''
          }}
        {%- elsif st.desktop_image != blank -%}
          <div class="vp-se-hero__image vp-se-hero__image--mobile vp-se-hero__image--fallback" style="background-image: url({{ st.desktop_image | image_url: width: 900 }}); background-position: {{ st.focal_point }};"></div>
        {%- endif -%}
      {%- endif -%}
      {%- unless st.desktop_image == blank and st.mobile_image == blank and has_video == false -%}
        <div class="vp-se-hero__overlay"></div>
      {%- endunless -%}
    </div>

    <div class="vp-se-hero__content">
      {%- if st.badge_text != blank -%}
        <span class="vp-se-hero__badge">{{ st.badge_text | escape }}</span>
      {%- endif -%}

      {%- if st.eyebrow != blank -%}
        <p class="vp-se-hero__eyebrow">{{ st.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if st.heading != blank -%}
        <h1 class="vp-se-hero__heading">{{ st.heading | escape }}</h1>
      {%- endif -%}

      {%- if st.supporting_text != blank -%}
        <p class="vp-se-hero__supporting">{{ st.supporting_text | escape }}</p>
      {%- endif -%}

      {%- if st.offer_text != blank -%}
        <p class="vp-se-hero__offer">{{ st.offer_text | escape }}</p>
      {%- endif -%}

      {%- if st.countdown_placement == 'inside_hero' -%}
        <div class="vp-se-hero__countdown-slot" data-vp-se-hero-countdown-slot></div>
      {%- endif -%}

      {%- if st.primary_cta_label != blank -%}
        <div class="vp-se-hero__ctas">
          <a
            href="{{ st.primary_cta_link | default: '#' }}"
            class="vp-se-hero__cta vp-se-hero__cta--primary"
          >
            {{- st.primary_cta_label | escape -}}
          </a>
          {%- if st.secondary_cta_label != blank -%}
            <a
              href="{{ st.secondary_cta_link | default: '#' }}"
              class="vp-se-hero__cta vp-se-hero__cta--secondary"
            >
              {{- st.secondary_cta_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if st.countdown_placement == 'below_hero' -%}
    <div class="vp-se-hero__below-slot" data-vp-se-hero-countdown-slot></div>
  {%- endif -%}
</section>

{%- style -%}
  .vp-se-hero {
    position: relative;
    background: var(--vp-se-hero-bg, #ffffff);
    color: var(--vp-se-hero-text, #0F172A);
    overflow: hidden;
    font-family: var(--font-body-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
  }

  .vp-se-hero__inner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 260px;
    padding-top: 32px;
    padding-bottom: 32px;
  }

  .vp-se-hero:not(.vp-se-hero--no-media) .vp-se-hero__inner {
    min-height: min(var(--vp-se-hero-max-height, 420px), 60vw);
  }

  .vp-se-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .vp-se-hero__image,
  .vp-se-hero__video-wrap,
  .vp-se-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vp-se-hero__image--mobile { display: none; }

  .vp-se-hero__overlay {
    position: absolute;
    inset: 0;
    background: #0F172A;
    opacity: var(--vp-se-hero-overlay, 0.35);
  }

  .vp-se-hero__content {
    position: relative;
    z-index: 1;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .vp-se-hero--align-center .vp-se-hero__content { text-align: center; margin-inline: auto; align-items: center; }
  .vp-se-hero--align-right .vp-se-hero__content { text-align: right; margin-left: auto; align-items: flex-end; }

  .vp-se-hero--pos-top .vp-se-hero__inner { align-items: flex-start; }
  .vp-se-hero--pos-bottom .vp-se-hero__inner { align-items: flex-end; }

  .vp-se-hero__badge {
    display: inline-flex;
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 999px;
    background: #D5F7FF;
    color: #0F172A;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .vp-se-hero--align-center .vp-se-hero__badge { align-self: center; }
  .vp-se-hero--align-right .vp-se-hero__badge { align-self: flex-end; }

  .vp-se-hero__eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--vp-se-hero-text, #0F172A);
    opacity: 0.75;
  }

  .vp-se-hero__heading {
    margin: 0;
    font-family: var(--font-heading-family, 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
    font-size: clamp(26px, 4vw, 40px);
    line-height: 1.1;
    font-weight: 700;
    color: var(--vp-se-hero-text, #0F172A);
  }

  .vp-se-hero__supporting,
  .vp-se-hero__offer {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    color: var(--vp-se-hero-text, #0F172A);
    opacity: 0.9;
  }

  .vp-se-hero__offer { font-weight: 600; }

  .vp-se-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .vp-se-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .vp-se-hero__cta--primary { background: #47B5E9; color: #ffffff; }
  .vp-se-hero__cta--secondary { background: transparent; color: var(--vp-se-hero-text, #0F172A); border: 1px solid currentColor; }
  .vp-se-hero__cta:hover { opacity: 0.88; }
  .vp-se-hero__cta:focus-visible { outline: 2px solid #47B5E9; outline-offset: 2px; }

  @media (max-width: 749px) {
    .vp-se-hero__image--desktop { display: none; }
    .vp-se-hero__image--mobile { display: block; }
    .vp-se-hero:not(.vp-se-hero--no-media) .vp-se-hero__inner { min-height: min(var(--vp-se-hero-max-height, 420px), 133vw); aspect-ratio: 4 / 3; }
    .vp-se-hero__content { max-width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vp-se-hero .vp-se-hero__cta { transition: none; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Sale-event hero",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "World Animal Week" },
    { "type": "text", "id": "heading", "label": "Heading (H1)", "default": "Daily care for healthier routines", "info": "This is the page's single H1. If you also enable the collection banner section, hide its title to avoid a duplicate H1." },
    { "type": "textarea", "id": "supporting_text", "label": "Supporting text", "default": "Discover everyday care for eyes, teeth and ears." },
    { "type": "text", "id": "offer_text", "label": "Offer text", "info": "Use only a real, confirmed offer. Leave blank until final terms are set." },
    { "type": "text", "id": "badge_text", "label": "Campaign badge (optional)" },

    { "type": "header", "content": "Primary action" },
    { "type": "text", "id": "primary_cta_label", "label": "Primary CTA label", "default": "Shop the event" },
    { "type": "url", "id": "primary_cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "secondary_cta_label", "label": "Secondary CTA label (optional)" },
    { "type": "url", "id": "secondary_cta_link", "label": "Secondary CTA link" },

    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Falls back to the desktop image, cropped, if left blank." },
    { "type": "select", "id": "focal_point", "label": "Image focal point", "default": "center center", "options": [
      { "value": "top left", "label": "Top left" },
      { "value": "top center", "label": "Top center" },
      { "value": "top right", "label": "Top right" },
      { "value": "center left", "label": "Center left" },
      { "value": "center center", "label": "Center" },
      { "value": "center right", "label": "Center right" },
      { "value": "bottom left", "label": "Bottom left" },
      { "value": "bottom center", "label": "Bottom center" },
      { "value": "bottom right", "label": "Bottom right" }
    ] },
    { "type": "video", "id": "video", "label": "Shopify-hosted video (optional)", "info": "Replaces the image when set. Never autoplays with sound." },
    { "type": "checkbox", "id": "video_autoplay", "label": "Autoplay video (muted)", "default": true },
    { "type": "checkbox", "id": "video_loop", "label": "Loop video", "default": true },
    { "type": "image_picker", "id": "video_poster", "label": "Video poster / fallback image" },
    { "type": "range", "id": "overlay_strength", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image/video overlay strength", "default": 25 },
    { "type": "range", "id": "max_height_desktop", "min": 280, "max": 600, "step": 10, "unit": "px", "label": "Max desktop height", "default": 420 },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "text_position", "label": "Text vertical position", "default": "middle", "options": [
      { "value": "top", "label": "Top" },
      { "value": "middle", "label": "Middle" },
      { "value": "bottom", "label": "Bottom" }
    ] },
    { "type": "select", "id": "countdown_placement", "label": "Countdown placement", "default": "none", "info": "Requires a 'Sale-event countdown' section placed immediately after this one.", "options": [
      { "value": "none", "label": "Countdown not used here" },
      { "value": "inside_hero", "label": "Group visually inside hero" },
      { "value": "below_hero", "label": "Directly below hero" }
    ] },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_background", "label": "Background color", "default": "#D5F7FF" },
    { "type": "color", "id": "color_text", "label": "Text color", "default": "#0F172A" }
  ],
  "presets": [
    {
      "name": "Sale-event hero"
    }
  ]
}
{% endschema %}
