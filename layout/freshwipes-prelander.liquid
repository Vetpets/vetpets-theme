<!doctype html>
{%- comment -%}
  FreshWipes pre-lander — dedicated layout.

  Used only by templates/page.freshwipes-prelander.json. Deliberately excludes
  the store header, main navigation, announcement bar, footer and every other
  global theme element so the approved Claude Design page renders as designed.

  Everything Shopify needs is still here: content_for_header, content_for_layout,
  viewport metadata, title/meta and canonical.
{%- endcomment -%}
{%- liquid
  # World Animal Week automatic date gate + ?waw_preview=1 QA override.
  # Fixed UTC epochs, not the visitor's local timezone: start 2026-09-28T04:00:00Z
  # (midnight America/New_York), end 2026-10-05T03:59:59Z (11:59:59 PM America/
  # New_York on Oct 4) - identical logic to sections/freshwipes-prelander.liquid so
  # the server-rendered <head> (font choice) and body never disagree on state.
  assign waw_start_epoch = 1790568000
  assign waw_end_epoch = 1791172799
  assign waw_now_epoch = 'now' | date: '%s' | times: 1
  assign waw_in_window = false
  if waw_now_epoch >= waw_start_epoch and waw_now_epoch <= waw_end_epoch
    assign waw_in_window = true
  endif
  assign waw_preview = false
  assign waw_qs_parts = request.query_string | split: '&'
  for waw_qs_part in waw_qs_parts
    if waw_qs_part == 'waw_preview=1'
      assign waw_preview = true
    endif
  endfor
  assign waw_active = false
  if waw_in_window or waw_preview
    assign waw_active = true
  endif
-%}
<html class="freshwipes-prelander-html" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#47B5E9">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title }}{% if shop.name != page_title %} &ndash; {{ shop.name }}{% endif %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="preload" as="font" type="font/woff2" href="{{ 'fwpl-geist-bold.woff2' | asset_url }}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{ 'fwpl-geist-regular.woff2' | asset_url }}" crossorigin>
    {%- if waw_active -%}
      {%- comment -%} Permanent Marker: the World Animal Week "Week" script lockup only. {%- endcomment -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Permanent+Marker&display=swap">
    {%- endif -%}
    <link rel="stylesheet" href="{{ 'freshwipes-prelander.css' | asset_url }}">

    <style>
      @font-face { font-family: "GeistFwpl"; src: url("{{ 'fwpl-geist-regular.woff2' | asset_url }}") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
      @font-face { font-family: "GeistFwpl"; src: url("{{ 'fwpl-geist-semibold.woff2' | asset_url }}") format("woff2"); font-weight: 600; font-style: normal; font-display: swap; }
      @font-face { font-family: "GeistFwpl"; src: url("{{ 'fwpl-geist-bold.woff2' | asset_url }}") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }
      @font-face { font-family: "GeistFwpl"; src: url("{{ 'fwpl-geist-extrabold.woff2' | asset_url }}") format("woff2"); font-weight: 800; font-style: normal; font-display: swap; }
    </style>

    {{ content_for_header }}
  </head>

  <body class="freshwipes-prelander-body">
    {{ content_for_layout }}

    <script src="{{ 'freshwipes-prelander.js' | asset_url }}" defer></script>
  </body>
</html>
