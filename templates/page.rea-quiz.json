    "custom_liquid_GrzCEV": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<div id=\"why-we-ask-shopify\"\nstyle=\"\ndisplay:none;\nmax-width:520px;\nmargin:24px auto 0;\nbackground:#F9F4E8;\nborder-left:4px solid #C89A3D;\npadding:16px 18px;\ntext-align:left;\nborder-radius:4px;\nbox-sizing:border-box;\nposition:relative;\nz-index:999;\n\">\n\n  <div style=\"\n    font-size:12px;\n    font-weight:700;\n    color:#C89A3D;\n    letter-spacing:1px;\n    margin-bottom:8px;\n    text-transform:uppercase;\n  \">\n    WHY WE ASK\n  </div>\n\n  <div style=\"\n    font-size:14px;\n    line-height:1.6;\n    color:#555;\n  \">\n    Most solutions improve breath temporarily. Breaking the cycle requires both removing bacteria from the teeth and preventing it from growing back. Professional cleanings help, but without daily care the buildup usually returns.\n  </div>\n\n</div>\n\n<script>\n(function() {\n\n  function handleQuestion(questionTitle) {\n\n    var box = document.getElementById('why-we-ask-shopify');\n    if (!box) return;\n\n    if (\n      questionTitle &&\n      questionTitle.indexOf('What have you already tried') !== -1\n    ) {\n\n      box.style.display = 'block';\n\n      setTimeout(function() {\n\n        var btnWrapper =\n          document.querySelector('.oct-quiz-btn-wrapper') ||\n          document.querySelector('.oct-quiz-btn');\n\n        if (btnWrapper && box.parentNode !== btnWrapper.parentNode) {\n          btnWrapper.insertAdjacentElement('afterend', box);\n        }\n\n      }, 300);\n\n    } else {\n\n      box.style.display = 'none';\n\n    }\n  }\n\n  document.addEventListener('octane.quiz.questionLoaded', function(e) {\n\n    if (\n      e.detail &&\n      e.detail.question_title\n    ) {\n      handleQuestion(e.detail.question_title);\n    }\n\n  }, false);\n\n})();\n</script>",
        "color_scheme": "background-2",
        "padding_top": 40,
        "padding_bottom": 52
      }
