    "custom_liquid_8F3aPN": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<style>\n.vetpets-love-section{\n  max-width:1200px;\n  margin:20px auto 80px;\n  padding:40px 20px;\n  text-align:center;\n  background:#D5F7FF;\n  border-radius:20px;\n}\n\n.vetpets-love-heading{\n  font-size:54px;\n  font-weight:700;\n  line-height:1.15;\n  margin-top:0;\n  margin-bottom:50px;\n  color:#111;\n}\n\n.vetpets-love-heading .highlight{\n  background:linear-gradient(90deg,#47B5E9 0%,#13B6B5 100%);\n  -webkit-background-clip:text;\n  -webkit-text-fill-color:transparent;\n  background-clip:text;\n  color:transparent;\n}\n\n/* DESKTOP */\n.vetpets-love-grid{\n  display:grid;\n  grid-template-columns:280px 500px 280px;\n  justify-content:center;\n  align-items:center;\n  gap:40px;\n}\n\n.vetpets-benefits{\n  display:flex;\n  flex-direction:column;\n  gap:50px;\n}\n\n.vetpets-benefit{\n  text-align:center;\n}\n\n.vetpets-benefit h3{\n  font-size:18px;\n  font-weight:700;\n  margin-bottom:8px;\n  text-transform:uppercase;\n  color:#111;\n}\n\n.vetpets-benefit p{\n  font-size:15px;\n  line-height:1.6;\n  color:#555;\n  margin:0;\n}\n\n.vetpets-center{\n  display:flex;\n  justify-content:center;\n  align-items:center;\n}\n\n.vetpets-circle{\n  width:500px;\n  height:500px;\n  border-radius:50%;\n  overflow:hidden;\n  background:#fff;\n}\n\n.vetpets-circle img{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n}\n\n.vetpets-btn{\n  display:inline-block;\n  margin-top:40px;\n  background:#47B5E9;\n  color:#fff;\n  text-decoration:none;\n  padding:16px 42px;\n  border-radius:12px;\n  font-weight:700;\n  letter-spacing:1px;\n}\n\n.vetpets-btn:hover{\n  background:#fff;\n  color:#47B5E9;\n  border:2px solid #47B5E9;\n  opacity:1;\n  transition:all .3s ease;\n}\n\n/* MOBILE */\n@media(max-width:990px){\n\n  .vetpets-love-section{\n    margin:50px auto;\n    padding:30px 15px;\n  }\n\n  .vetpets-love-heading{\n    font-size:34px;\n    margin-bottom:25px;\n  }\n\n  .vetpets-love-grid{\n    display:flex;\n    flex-direction:column;\n    gap:25px;\n  }\n\n  .vetpets-center{\n    order:-1;\n  }\n\n  .vetpets-circle{\n  width:340px;\n  height:340px;\n  max-width:90vw;\n  max-height:90vw;\n  margin:0 auto;\n}\n\n  /* Hide desktop columns */\n  .desktop-benefits{\n    display:none;\n  }\n\n  /* Mobile benefits grid */\n  .mobile-benefits{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:28px 18px;\n    width:100%;\n  }\n\n  .mobile-benefits .vetpets-benefit h3{\n  font-size:16px;\n  margin-bottom:6px;\n  min-height:42px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  text-align:center;\n}\n\n  .mobile-benefits .vetpets-benefit p{\n    font-size:13px;\n    line-height:1.4;\n  }\n\n  .vetpets-btn{\n    width:100%;\n    max-width:300px;\n    margin-top:30px;\n  }\n}\n\n/* Hide mobile grid on desktop */\n@media(min-width:991px){\n  .mobile-benefits{\n    display:none;\n  }\n}\n\n.vetpets-btn{\n  display:inline-block;\n  margin-top:40px;\n  background:#47B5E9;\n  color:#fff;\n  text-decoration:none;\n  padding:16px 42px;\n  border-radius:12px;\n  font-weight:700;\n  letter-spacing:1px;\n  border:2px solid #47B5E9;\n  transition:all .3s ease;\n}\n</style>\n\n<div class=\"vetpets-love-section\">\n\n  <h2 class=\"vetpets-love-heading\">\n    Why Pet Parents<br>\n    Choose <span class=\"highlight\">VetPets</span>\n  </h2>\n\n  <div class=\"vetpets-love-grid\">\n\n    <!-- DESKTOP LEFT -->\n    <div class=\"vetpets-benefits desktop-benefits\">\n\n      <div class=\"vetpets-benefit\">\n        <h3>Easy Daily Care</h3>\n        <p>Just 1 minute a day.</p>\n      </div>\n\n      <div class=\"vetpets-benefit\">\n        <h3>Less Stress</h3>\n        <p>No brushing. No mess.</p>\n      </div>\n\n      <div class=\"vetpets-benefit\">\n        <h3>For Dogs & Cats</h3>\n        <p>All breeds & sizes.</p>\n      </div>\n\n    </div>\n\n    <!-- IMAGE -->\n    <div class=\"vetpets-center\">\n      <div class=\"vetpets-circle\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0735/4833/3323/files/FILE.png?v=1780629820\" alt=\"VetPets Happy Pets\">\n      </div>\n    </div>\n\n    <!-- DESKTOP RIGHT -->\n    <div class=\"vetpets-benefits desktop-benefits\">\n\n      <div class=\"vetpets-benefit\">\n        <h3>Fresher Breath</h3>\n        <p>Cleaner teeth daily.</p>\n      </div>\n\n      <div class=\"vetpets-benefit\">\n        <h3>Brighter Eyes</h3>\n        <p>Helps reduce buildup.</p>\n      </div>\n\n      <div class=\"vetpets-benefit\">\n        <h3>Healthier & Happier</h3>\n        <p>Daily care made simple.</p>\n      </div>\n\n    </div>\n\n    <!-- MOBILE GRID -->\n    <div class=\"mobile-benefits\">\n\n      <div class=\"vetpets-benefit\">\n        <h3>Easy Daily Care</h3>\n        <p>Less than 1 minute daily.</p>\n      </div>\n\n      <div class=\"vetpets-benefit\">\n        <h3>Fresher Breath</h3>\n        <p>Cleaner teeth daily.</p>\n      </div>\n\n      <div class=\"vetpets-benefit\">\n        <h3>Less Stress</h3>\n        <p>No brushing. No mess.</p>\n      </div>\n\n      <div class=\"vetpets-benefit\">\n        <h3>Brighter Eyes</h3>\n        <p>Helps reduce buildup.</p>\n      </div>\n\n      <div class=\"vetpets-benefit\">\n        <h3>For Dogs & Cats</h3>\n        <p>All breeds & sizes.</p>\n      </div>\n\n      <div class=\"vetpets-benefit\">\n        <h3>Healthier & Happier</h3>\n        <p>Daily care made simple.</p>\n      </div>\n\n    </div>\n\n  </div>\n\n  <button type=\"button\"\n        class=\"vetpets-btn\"\n        onclick=\"document.getElementById('ProductSubmitButton-template--25538452193547__main').click();\">\n   GET OFFER\n</button>\n\n</div>",
