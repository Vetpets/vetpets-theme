r i uken kan du gi hunden din sunnere tenner og et lykkeligere liv.<\/strong><\/p>","text_style":"body"}}},"block_order":["heading_f9jdby","text_BmNtng"],"name":"t:sections.image-with-text.presets.name","settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/bra_gif_9e0ff993-86c7-48ff-8c64-6c53032fb72a.webp","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"background-1","section_color_scheme":"background-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"section_divider_rfF4qA":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":false,"shape_color":"background-2","custom_shape_color":"#dd1d1d","background_color":"background-1","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"image_with_text_LxqdyB":{"type":"image-with-text","blocks":{"heading_8iGGCy":{"type":"heading","settings":{"title":"Samme kvalitet som hos veterinæren – <strong>men enkelt hjemme!<\/strong>","title_highlight_color":"#118fcb","heading_size":"h2"}},"text_dfLUDF":{"type":"text","settings":{"text":"<p>Hos veterinæren brukes spesialverktøy for å fjerne tannstein – ofte under narkose og til høye kostnader.<br\/><\/p><p><strong>FreshSmile™ bruker samme type teknologi, men er utviklet for å være trygg og enkel i et hjemmemiljø.<\/strong><\/p><p><\/p><p>På bare noen få minutter i uken kan du gi hunden din den samme behandlingen som hos veterinæren – uten stress, risiko eller dyre regninger.<\/p>","text_style":"body"}}},"block_order":["heading_8iGGCy","text_dfLUDF"],"name":"t:sections.image-with-text.presets.name","settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/Norska_Norska_Engelska.jpg","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"background-2","section_color_scheme":"background-2","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":16,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"section_divider_FB6HTU":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":true,"shape_color":"background-2","custom_shape_color":"#dd1d1d","background_color":"background-1","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"image_with_text_dWLdtL":{"type":"image-with-text","blocks":{"heading_GbVHxi":{"type":"heading","settings":{"title":"En sunnere munn på <strong>bare noen minutter<\/strong>","title_highlight_color":"#118fcb","heading_size":"h2"}},"text_LQ7PTe":{"type":"text","settings":{"text":"<p>Det betyr:<\/p><p>✅ Den bryter ned og fjerner plakk og tannstein direkte på tennene<\/p><p>✅ Den aktiveres kun på harde flater (tenner) – aldri på tannkjøttet<\/p><p>✅ Det gjør den skånsom, trygg og med lav risiko, selv for sensitive hunder<br\/><\/p><p>Resultatet er renere tenner, friskere ånde <strong>og en gladere hund – uten stress eller smerte.<\/strong><\/p>","text_style":"body"}}},"block_order":["heading_GbVHxi","text_LQ7PTe"],"name":"t:sections.image-with-text.presets.name","settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/bra_gif1_f5b6da69-7492-4a9b-8f85-a04689676f7d.webp","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"background-1","section_color_scheme":"background-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"section_divider_pbhGpk":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":false,"shape_color":"background-2","custom_shape_color":"#dd1d1d","background_color":"background-1","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"6b7afe89-5595-4016-a10d-f260d82ca9cc":{"type":"comparison-table","blocks":{"template--18472096170313__6b7afe89-5595-4016-a10d-f260d82ca9cc-167986455514a8e470-0":{"type":"row","settings":{"benefit":"Fjerner effekti