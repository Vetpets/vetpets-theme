"","swatches_position":"top","swatches_desktop_size":36,"swatches_mobile_size":24,"type":"slide","autoplay":false,"autoplay_speed":5,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":4,"slider_desktop":false,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":false,"desktop_dots_position":"under","desktop_arrows_position":"sides","columns_mobile":"2","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":false,"mobile_dots_position":"under","mobile_arrows_position":"under","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff"}},"section_divider_E3REbR":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":false,"shape_color":"background-2","custom_shape_color":"#dd1d1d","background_color":"background-1","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"collapsible_content_p7mjJe":{"type":"collapsible-content","blocks":{"collapsible_row_P43e4z":{"type":"collapsible_row","settings":{"heading":"Er det trygt for hunden min?","icon":"","filled_icon":false,"row_content":"<p>Ja, FreshSmile Kit er utviklet for hjemmebruk og virker kun på harde tannflater – aldri på tannkjøttet. Dette gjør det svært trygt og skånsomt å bruke.<\/p>","page":""}},"collapsible_row_q7TDhX":{"type":"collapsible_row","settings":{"heading":"Gjør det vondt for hunden?","icon":"","filled_icon":false,"row_content":"<p>Nei, behandlingen er helt smertefri når den brukes som anvist. Enheten vibrerer kun mot tennene og skader ikke tannkjøttet. De fleste hunder venner seg raskt til de<\/p>","page":""}},"collapsible_row_MxWYGH":{"type":"collapsible_row","settings":{"heading":"Fungerer det for alle raser og størrelser?","icon":"","filled_icon":false,"row_content":"<p>Ja, FreshSmile Kit passer for alle hunderaser og størrelser – fra små chihuahuaer til store hunder som schæfere.<\/p>","page":""}},"collapsible_row_QAJKrw":{"type":"collapsible_row","settings":{"heading":"Er det trygt å bruke på valper og eldre hunder?","icon":"","filled_icon":false,"row_content":"<p>Ja, men valper bør vente til de har fått sine permanente tenner. Eldre hunder kan bruke det på samme måte som yngre, men ekstra forsiktighet bør tas dersom tannkjøttet deres er sensitivt.<\/p>","page":""}},"collapsible_row_wR4VKn":{"type":"collapsible_row","settings":{"heading":"Hvor ofte bør jeg bruke FreshSmile Kit?","icon":"","filled_icon":false,"row_content":"<p>Vi anbefaler 1–2 ganger per uke. Det er nok til å holde tannstein borte og forebygge tannproblemer.<\/p>","page":""}},"collapsible_row_AzQGGG":{"type":"collapsible_row","settings":{"heading":"Hva om hunden min er sensitiv eller redd?","icon":"","filled_icon":false,"row_content":"<p>Begynn forsiktig og la hunden bli vant til lyden og følelsen. Start med korte økter og belønn med godbiter og ros etterpå.<\/p>","page":""}},"collapsible_row_N6izTp":{"type":"collapsible_row","settings":{"heading":"Kan jeg virkelig fjerne tannstein hjemme like effektivt som hos veterinær?","icon":"","filled_icon":false,"row_content":"<p>Veterinærer bruker ultralyd og spesialinstrumenter. FreshSmile Kit er ikke en erstatning for veterinærbehandling, men det er et effektivt verktøy for å fjerne plakk og tannstein hjemme – som kan redusere behovet for dyre rensinger.<\/p>","page":""}},"collapsible_row_CktV8Q":{"type":"collapsible_row","settings":{"heading":"Hva skjer hvis jeg ikke er fornøyd med resultatene?","icon":"","filled_icon":false,"row_content":"<p>Vi tilbyr en 100-dagers fornøydgaranti. Hvis du ikke er fornøyd, kan du returnere produktet og få pengene tilbake – helt risikofritt.<\/p>","page":""}}},"block_order":["collapsible_row_P43e4z","collapsible_row_q7TDhX","collapsible_row_MxWYGH","collapsible_row_QAJKrw","collapsible_row_wR4VKn","collapsible_row_AzQGGG","collapsible_row_N6izTp","collapsible_row_CktV8Q"],"name":"t:sections.collapsible_content.presets.name","settings":{"display_id":false,"visibility":"always-display","caption":"","title":"FAQ","title_highlight_color":"#6d388b","heading_size":"h1","heading_alignment":"center","layout":"none","color_scheme":"background-2","container_color_scheme":"background-2","open_first_collapsible_row":false,"video_muted_autoplay":true,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"medium","collapse_icon":"carret","display_top_border":true,"padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#000000","custom_contaner_colors_background":"#ffffff","custom_container_gradient_background":"","custom_contaner_colors_text":"#000000"}},"section_divider_LQG9Ja":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":false,"shape_color":"background-1","custom_shape_color":"#dd1d1d","background_color":"background-2","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"854b8c46-40a3-4c74-9b36-360886558b1f":{"type":"testimonials","blocks":{"template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-0":{"type":"column","settings":{"star_rating":5,"title":"Merket forskjell allerede etter andre gang","text":"<p>Jeg har aldri vært spesielt flink til å ta vare på hundens tenner, og å bruke tannbørste har mest føltes som en plikt. Men etter at veterinæren nevnte tannstein, ble jeg litt bekymret.<\/p><p>Jeg prøvde FreshSmile og merket faktisk forskjell allerede etter andre gang – både på hundens ånde og hvordan tennene så ut. Hunden min ser heller ikke ut til å bry seg, noe som overrasket meg. Vi kommer til å fortsette å bruke den!<\/p>","author":"<em>Maria L., Oslo – blandingsrase, 6 år<\/em>"}},"template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-1":{"type":"column","settings":{"star_rating":5,"title":"Et godt supplement til daglig tannpleie","text":"<p>Jeg bruker tannbørste og tyggeben regelmessig, men min eldre retriever har fortsatt misfarging og dårlig ånde. FreshSmile har ikke fjernet alt over natten, men det har hjulpet mye mot plakket.<\/p><p>Vi bruker det omtrent én gang i uken, og det har blitt en helt naturlig rutine nå. Produktet føles solid og er enkelt å bruke.<\/p>","author":"<em>– John K. – golden retriever, 8 år<\/em>"}},"template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-2":{"type":"column","settings":{"star_rating":5,"title":"Veterinæren ble imponert","text":"<p>Hunden min måtte fjerne tannstein hos veterinæren i fjor, noe som var både dyrt og stressende. Jeg ville unngå å dra dit igjen, så jeg bestilte dette settet. Jeg har brukt det i litt over to måneder, og da vi nylig var på kontroll, sa veterinæren at det så kjempebra ut. Det var virkelig godt å høre! Verdt hver eneste krone – bare for å slippe å måtte avlive ham for tidlig.<\/p>","author":"<em>– Elin S., Trysil– fransk bulldog, 4 år<\/em>"}}},"block_order":["template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-0","template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-1","template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-2"],"settings":{"display_id":false,"visibility":"always-display","title":"Bekreftede anmeldelser","title_highlight_color":"#6d388b","heading_size":"h1","text":"","color_scheme":"background-1","image_width":"full","image_ratio":"square","column_alignment":"center","show_stars":true,"inactive_stars_style":"solid","star_color":"#ffcc00","bg_star_color":"#ececec","show_quotes":true,"quotes_color_scheme":"accent-2","cards_color_scheme":"bg-overlay","type":"slide","autoplay":false,"autoplay_speed":5,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":3,"slider_desktop":false,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":false,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":false,"mobile_dots_position":"under","mobile_arrows_position":"under","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_cards_colors_background":"#f3f3f3","custom_cards_gradient_background":"","custom_cards_colors_text":"#2e2a39"}}},"order":["main","related-products","03c08e95-f0ce-4379-bc05-787da4136202","section_divider_mpJqcK","image_slider_VPRWTj","section_divider_pE3qdc","image_with_text_pbPPGT","section_divider_rfF4qA","image_with_text_LxqdyB","section_divider_FB6HTU","image_with_text_dWLdtL","section_divider_pbhGpk","6b7afe89-5595-4016-a10d-f260d82ca9cc","section_divider_GNqnAc","image_with_text_FPxBtf","featured_collection_aRPgAb","section_divider_E3REbR","collapsible_content_p7mjJe","section_divider_LQG9Ja","854b8c46-40a3-4c74-9b36-360886558b1f"]}