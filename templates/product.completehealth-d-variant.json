        "collapsible_row_a8UdbA": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are the wipes safe for sensitive skin?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>Yes, all wipes are pH balanced, hypoallergenic and free of alcohol, fluoride and harsh chemicals. Tested by veterinarians.</p>",
            "page": ""
          }
        },
        "collapsible_row_rAFmJk": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does a kit last?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>With daily use, FreshWipes and EarWipes will last about 1.5-2 months, EyeWipes about 3 months. Total of 200 wipes.</p>",
            "page": ""
          }
        },
