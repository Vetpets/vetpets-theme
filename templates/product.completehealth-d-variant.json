          }
        },
        "collapsible_row_zAQEn4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Does it work on cats too?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>Yes, the FreshCare Kit is safe for both dogs and cats. The same finger method works equally well.</p>",
            "page": ""
          }
