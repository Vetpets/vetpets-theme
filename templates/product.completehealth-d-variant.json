          "settings": {
            "heading": "Can I use them if my dog ​​already has dental problems/ear infections?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>FreshCare Kit is primarily preventative. If your dog already has serious problems, consult a veterinarian first. The wipes can be used as daily maintenance care after treatment.</p>",
            "page": ""
          }
        },
