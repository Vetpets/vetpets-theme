            "custom_liquid": "<style>\n  .custom-money-back {\n    background: #FFFFFF;\n    border: 2px solid #47B5E9;\n    border-radius: 7px;\n    padding: 10px 12px;\n    margin: 10px auto 0 auto;\n    max-width: 100%;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    overflow: hidden;\n  }\n  \n  .custom-money-back__badge {\n    flex-shrink: 0;\n    width: 35px;\n    height: 35px;\n  }\n  \n  .custom-money-back__badge img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n  }\n  \n  .custom-money-back__content {\n    flex: 1;\n    min-width: 0;\n  }\n  \n  .custom-money-back__title {\n    color: #000000;\n    font-family: 'Poppins', sans-serif;\n    font-size: 14px;\n    font-weight: 700;\n    margin-bottom: 3px;\n    line-height: 1.2;\n    letter-spacing: -0.03em;\n    white-space: nowrap;\n  }\n  \n  .custom-money-back__text {\n    color: #000000;\n    font-family: 'Poppins', sans-serif;\n    font-size: 8px;\n    font-weight: 400;\n    line-height: 1.3;\n    letter-spacing: 0;\n  }\n  \n  @media (min-width: 769px) {\n    .custom-money-back {\n      padding: 15px 20px;\n      gap: 18px;\n    }\n    .custom-money-back__badge {\n      width: 60px;\n      height: 60px;\n    }\n    .custom-money-back__title {\n      font-size: 18px;\n      margin-bottom: 6px;\n      letter-spacing: 0;\n    }\n    .custom-money-back__text {\n      font-size: 13px;\n      line-height: 1.5;\n    }\n  }\n</style>\n\n<div class=\"custom-money-back\">\n  <div class=\"custom-money-back__badge\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0735/4833/3323/files/Namnlos_design_44.svg?v=1771204616\" alt=\"Money Back Guarantee\">\n  </div>\n  <div class=\"custom-money-back__content\">\n    <div class=\"custom-money-back__title\">\n      No more plaque buildup OR your money back\n    </div>\n    <div class=\"custom-money-back__text\">\n      Use the FreshCare system daily — if you don’t see cleaner teeth, clearer eyes, and fresher ears, we’ll refund you. No