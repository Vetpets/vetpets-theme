            "text_size": "medium"
          }
        },
        "heading_qeaCDL": {
          "type": "heading",
          "settings": {
            "title": "The New Simple Solution – <strong>FreshWipes for Cats</strong>",
            "title_highlight_color": "#47b5e9",
            "heading_size": "h2"
          }
        },
        "text_AjezcB": {
          "type": "text",
          "settings": {
            "text": "<p><strong>FreshWipes for Cats</strong> make dental care simple and gentle.</p><p>Slip the soft wipe onto your finger and clean your cat’s teeth without stress or toothbrushes. <br/></p><p>The mild, scent-free formula removes plaque and bacteria, prevents gum disease, <strong>and keeps their breath fresh — even for stubborn cats. </strong></p><p></p><p><strong>Easy care that makes cuddles pleasant again.</strong></p>",
