        "ggZS4xi3GZP_minuteLabel": "min",
        "ggZS4xi3GZP_secondLabel": "sec",
        "ggZS4xi3GZP_weekLabel": "Weeks",
        "ggfRBomT8pi_text": "<strong>6. </strong><span style=\"background-color:transparent;color:#000000;\"><strong>30 SECONDS IS EASY ENOUGH TO DO EVERY SINGLE DAY</strong></span>",
        "ggjaYFpWFg6_text": "<p><span style=\"background-color:transparent;color:#000000;\">Cleaning removes what's there today. But bacteria start rebuilding within hours. FreshWipes have antibacterial ingredients that slow that regrowth down between sessions. That's the difference between buying yourself one clean day and actually interrupting the cycle.</span></p>",
        "ggjmiO5RIJA_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/hf_20260501_055058_90557624-f4e0-44f4-9d9c-98109e241cb0.png",
