          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Namnlos_design_17.svg",
            "muted_autoplay": true,
            "title": "Te-polyfenoler (Plantebasert)",
            "text": "<p>Te-polyfenoler er naturlige antioksidanter som bidrar til å redusere bakterier i munnen, friske opp pusten og beskytte mot betennelse i tannkjøttet.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_fK4EFx": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/ed707c4a-b1a4-402b-9865-284e9fe55528.png",
            "muted_autoplay": true,
            "title": "Glyserin",
            "text": "<p>Glyserin fukter slimhinnene og tannkjøttet i munnen, reduserer risikoen for irritasjon og gir en mildere rengjøring.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_HiWLQd": {
          "type": "column",
          "settings": {
