    "image_with_text_ij7gr6": {
      "type": "image-with-text",
      "blocks": {
        "heading_AyRBAn": {
          "type": "heading",
          "settings": {
            "title": "En enkel vane som<strong> gjør en stor forskjell</strong>",
            "title_highlight_color": "#118fcb",
            "heading_size": "h2"
          }
        },
        "text_G9h3Th": {
          "type": "text",
          "settings": {
            "text": "<p>Mange katteeiere tror at tannpleie er for vanskelig eller komplisert.</p><p><strong>Men med FreshWipes er det så enkelt at du faktisk vil bruke dem.</strong></p><p><br/></p><p>Å tørke kattens tenner 1–2 ganger i uken er nok til å holde plakk unna</p><p>og forebygge smertefulle problemer i fremtiden.</p><p><br/></p><p><strong>En frisk munn påvirker hele kroppen.</strong></p><p>Med FreshWipes får katten din ikke bare friskere pust og hvitere tenner,</p><p>men også <strong>et sterkere immunforsvar og mer energi.</strong></p><p><br/></p><p>Mindre smerte, mer lek – og mer nærhet.</p>",
            "text_style": "body"
          }
        }
      },
