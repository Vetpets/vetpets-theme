          "settings": {
            "custom_liquid": "<!-- SOSIALT BEVIS - ALT PÅ ÉN LINJE -->\n<style>\n  .sp-bar{\n    --bg:#fff; --radius:20px;\n    --shadow:0 2px 6px rgba(0,0,0,.08);\n    padding:8px 14px; background:var(--bg);\n    border-radius:var(--radius); box-shadow:var(--shadow);\n    width:fit-content; margin:14px auto 0;\n    font-size:12px; line-height:1.3;\n    display:flex; align-items:center; gap:5px;\n  }\n  .sp-avatars{ display:flex; align-items:center; }\n  .sp-avatar{\n    width:20px; height:22px; border-radius:9999px; overflow:hidden; flex:0 0 auto;\n    border:2px solid #fff; margin-right:-6px;\n  }\n  .sp-avatar img{ width:100%; height:100%; object-fit:cover; display:block; }\n  .sp-text{ display:flex; align-items:center; gap:5px; flex-wrap:nowrap; }\n  .sp-name{ font-weight:700; }\n  .sp-strong{ font-weight:700; }\n  .sp-check{ width:16px; height:16px; display:inline-block; }\n</style>\n\n{%- assign buyer_name = \"Lisa A\" -%}\n{%- assign buyer_count = 10.059 -%}\n\n<div class=\"sp-bar\">\n  <div class=\"sp-avatars\">\n    <span class=\"sp-avatar\">\n      <img src=\"https://randomuser.me/api/portraits/women/44.jpg\" alt=\"Kunde 1\">\n    </span>\n    <span class=\"sp-avatar\">\n      <img src=\"https://randomuser.me/api/portraits/women/65.jpg\" alt=\"Kunde 2\">\n    </span>\n    <span class=\"sp-avatar\">\n      <img src=\"https://randomuser.me/api/portraits/women/12.jpg\" alt=\"Kunde 3\">\n    </span>\n  </div>\n\n  <div class=\"sp-text\">\n    <span class=\"sp-name\">{{ buyer_name }}</span>\n    <span class=\"sp-check\">\n      <img src=\"https://cdn-icons-png.flaticon.com/512/7641/7641727.png\" alt=\"Verifisert\" width=\"16\" height=\"16\">\n    </span>\n    <span>og</span>\n    <span class=\"sp-strong\">{{ buyer_count }}</span>\n    <span>personer har kjøpt</span>\n  </div>\n</div>"
