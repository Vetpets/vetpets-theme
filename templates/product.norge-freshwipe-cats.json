    "image_with_text_tgMr7Y": {
      "type": "image-with-text",
      "blocks": {
        "heading_qyyYrN": {
          "type": "heading",
          "settings": {
            "title": "<strong>Tannpleie skal ikke være en luksus</strong>",
            "title_highlight_color": "#2e2a39",
            "heading_size": "h1"
          }
        },
        "text_xTU7RT": {
          "type": "text",
          "settings": {
            "text": "<p>Et besøk hos veterinæren for å fjerne tannstein kan koste flere tusen kroner</p><p>og krever ofte bedøvelse.</p><p><br/></p><p><strong>FreshWipes</strong> er en enkel hjemmeløsning som koster en brøkdel av prisen –</p><p>uten risiko, stress eller unødvendige utgifter.</p><p><br/></p><p>For oss handler det ikke om å tjene mest mulig,</p><p>men om å gi katter et sunnere liv – og eiere en <strong>tryggere og enklere hverdag.</strong></p>",
            "text_style": "body"
          }
        }
