        "ggQeL12Xxp__srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/5_reasons_why_page_37.webp",
        "ggQeL12Xxp__srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/gempages_577888762156024773-4338bf83-526f-4093-9367-5ab506e78c03.png",
        "ggS6jQYCKit_text": "<span style=\"color:#000000;\">5 Reasons Why Tear Stains Keep Coming Back Every Morning </span><span style=\"color:#47B5E9;\">(And the 30-Second Routine That Stops Them)</span>",
        "ggYmym2f1iC_text": "<p><span style=\"font-size:17px;\"><strong>4.8</strong></span>/5 | Trusted by 45,000+ Dog Owners</p>",
        "gggEL49kpJV_text": "<p>If you've tried baby wipes, tear stain shampoos, or expensive grooming appointments and the stains keep coming back every morning - here's why veterinarians recommend something different.</p>",
        "ggtS9FrHNsf_text": "<p><span style=\"font-size:14px;\"><strong>4.8</strong></span>/5 | Trusted by 4<strong>5,000+ </strong>Dog Owners</p>",
        "ggzB8PcR17b_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/gempages_577888762156024773-2f099bba-862b-4314-aae4-31a23fe77405.png",
