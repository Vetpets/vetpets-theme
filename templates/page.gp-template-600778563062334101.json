    "gp_section_600778563197076117": {
      "settings": {
        "checksum": "8161c5e0885488ea2f43c414bb3aec6687f8244879f367def49e38989a2212eb_1_1_1_0__1",
        "gg-oVDgsA3Y_srcSet_desktop_src": "https://campaigns.petlabco.co.uk/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fdynmc-signs-of-bad-breath.3d3d82ad.webp&w=640&q=75",
        "gg-oVDgsA3Y_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/Generated_Image_December_20_2025_-_8_02PM.jpg",
        "ggKKbcVrmmq_text": "<p>Jos päivittäinen hampaiden harjaus tuntuu <strong>stressaavalta tai epärealistiselta</strong>, et ole yksin.<br>Monet koiranomistajat kamppailevat harjaamisen kanssa – <strong>erityisesti aikuisten koirien kohdalla.</strong></p><p>Siksi FreshWipes-liinat kehitettiin.</p><p><br>FreshWipesit ovat hellävaraisia, käyttövalmiita hammaspyyhkeitä, jotka on suunniteltu <strong>tekemään päivittäisestä hoidosta helppoa</strong>. Harjan pakottamisen sijaan pyyhit vain kevyesti koirasi hampaat ja ienrajan.</p><p>Ne tuntuvat enemmän omalta kosketukseltasi — minkä vuoksi useimmat koirat pysyvät rauhallisina ja hyväksyvät ne paljon helpommin.</p><p>&nbsp;</p><p>&nbsp;</p><p><strong>Vain nopea päivittäinen rutiini kotona&nbsp;</strong></p><p>auttamaan plakin vähentämisessä ja tukemaan raikkaampaa hengitystä — <strong>ilman kamppailua.</strong></p>",
        "ggN3vN7iXaJ_label": "<p>Jatka lukemista</p>",
        "ggQXAbFtAYl_label": "<p>Jatka lukemista</p>",
        "ggfn25y656v_text": "Raikasta koirasi hengitys ja auta poistamaan plakki—<br><span style=\"color:#47B5E9;\"><i><strong>ilman hammasharjaa</strong></i></span>",
        "ggoqppDe9Is_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/Generated_Image_December_20_2025_-_8_02PM.jpg"
      },
      "type": "gp-section-600778563197076117"
