        "gg2lH5MX-HR_text": "Mitkä ovat yleisimmät merkit?",
        "ggDGLlLJeTY_srcSet_desktop_src": "https://campaigns.petlabco.co.uk/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fdynmc-signs-of-bad-breath.3d3d82ad.webp&w=640&q=75",
        "ggIVYtcyg5M_srcSet_desktop_src": "https://campaigns.petlabco.co.uk/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fdynmc-signs-of-bad-breath.3d3d82ad.webp&w=640&q=75",
        "ggdQgzDiSdf_label": "<p>Ohita</p>",
        "gghOsiLQW5A_text": "<p>Monet hammasongelmat alkavat huomaamatta. Nämä ovat merkkejä, jotka useimmat omistajat huomaavat ensimmäisenä:</p>",
        "ggm6YBCbdgc_text": "<p>Jos tunnistat yhden tai useamman näistä, se on usein varhainen merkki plakin kertymisestä</p>",
