    "gp_section_600778563197010581": {
      "settings": {
        "checksum": "7e937cea43e3e6a74d721241426d8c1ce48e085787eeeb1ecb01a6850df840c3_1_1_1_0__1",
        "gg5d1EafCpd_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/image_demo.jpg",
        "gg5d1EafCpd_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/gempages_577888762156024773-c5ca4e24-76c1-4f80-8223-2a9c1af81dd8.webp",
        "ggCsdNBmGYV_text": "<p><strong>Pahanhajuinen hengitys ja keltaiset hampaat eivät ole vain kosmeettisia haittoja. </strong>Ne ovat yleensä varhaisia merkkejä siitä, että plakkia ja bakteereja kertyy hampaiden pinnoille ja ienrajaan.</p><p>Kun plakkia ei poisteta säännöllisesti, se kovettuu hammaskiveksi. Tällöin ikenet ärsyyntyvät, tulehtuvat ja kipeytyvät – tila, jota eläinlääkärit kutsuvat <strong>ientulehdukseksi</strong>.</p><p>&nbsp;</p><p>Hoitamattomana hammasongelmat voivat johtaa:</p><ul><li>krooniseen pahanhajuiseen hengitykseen</li><li>iensairauksiin ja hampaiden menetykseen</li><li>kivuliaisiin toimenpiteisiin nukutuksessa</li><li>ja kalliisiin eläinlääkärilaskuihin myöhemmin</li></ul><p>&nbsp;</p><p>Hyvä uutinen?<br><strong>Useimmat hammasongelmat alkavat pieninä – ja niitä on paljon helpompi hallita varhaisessa vaiheessa kotona.</strong></p>",
        "ggL0jW18HMG_srcSet_desktop_src": "https://campaigns.petlabco.co.uk/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fdynmc-dog-show-teeth.0dae9264.webp&w=640&q=75",
        "ggXEpr5-fkx_text": "<strong>Miksi hammashoito on </strong><span style=\"color:#47B5E9;\"><i><strong>elintärkeää </strong></i></span><i><strong>koirallesi</strong></i>",
        "gg_sTcsSPdr_label": "<p>Katso yleiset merkit</p><p>&nbsp;</p>",
        "ggoypHO2WlR_srcSet_desktop_src": "https://campaigns.petlabco.co.uk/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fdynmc-dog-show-teeth.0dae9264.webp&w=640&q=75"
