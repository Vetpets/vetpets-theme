s":{"text":"<p><strong>They tear. They leak. They smell.<\/strong><br\/><br\/>Dogs refuse to use them – and you have to buy new ones week after week.<br\/><br\/><\/p>","text_style":"body"}}},"block_order":["heading_cGTWnT","text_a8YamM"],"settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/template4.webp","video_autoplay":true,"video_loop":true,"height":"medium","color_scheme":"background-1","section_color_scheme":"background-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":16,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"image_with_text_KrpC7V":{"type":"image-with-text","blocks":{"heading_wYYKJK":{"type":"heading","settings":{"title":"The DryPad succeeds – <strong>every single day<\/strong>","title_highlight_color":"#48b5e9","heading_size":"h2"}},"text_AAhKjp":{"type":"text","settings":{"text":"<p>Dogs use it. The floor stays dry. No smell.<br\/><br\/><strong>One purchase – and the problem is solved for good.<\/strong><\/p>","text_style":"body"}}},"block_order":["heading_wYYKJK","text_AAhKjp"],"settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/13_cd7aa8b5-d6d5-49fb-afc1-40dc274e1cba.jpg","video_autoplay":true,"video_loop":true,"height":"medium","color_scheme":"background-1","section_color_scheme":"background-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"image_with_text_d8CqFe":{"type":"image-with-text","blocks":{"heading_Qg4PKj":{"type":"heading","settings":{"title":"Disposable pee pads VS<strong> our DryPad<\/strong>","title_highlight_color":"#48b5e9","heading_size":"h2"}},"text_aN6xEU":{"type":"text","disabled":true,"settings":{"text":"<p>Dogs use it. The floor stays dry. No smell.<br\/><br\/>One purchase – and the problem is solved for good.<\/p>","text_style":"body"}}},"block_order":["heading_Qg4PKj","text_aN6xEU"],"settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/Engelska_29.jpg","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"background-1","section_color_scheme":"background-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"section_divider_qg3XJB":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":false,"shape_color":"background-2","custom_shape_color":"#dd1d1d","background_color":"background-1","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"testimonials_aPGL83":{"type":"testimonials","blocks":{"column_EfR4wq":{"type":"column","settings":{"star_rating":5,"title":"Finally stopped buying disposable pads!","text":"<p>Got my first DryPad in September when we brought home our Cockapoo puppy. Honestly wasn't expecting much but after wasting £60 on disposable pads that Bella just tore up, I was desperate. She actually uses this one! Goes straight to it every morning. I wash it twice a week (takes 2 minutes to chuck in the machine) and it still looks brand new after 3 months. My sister keeps asking where I got it because her Lab puppy is destroying her house.<\/p>","author":"<strong>Sarah Mitchell<\/strong> - Manchester, UK"}},"column_aPCzbV":{"type":"column","settings":{"star_rating":5,"title":"No more 6am mopping sessions","text":"<p>Don't usually write reviews but had to for this. My 12-week Beagle used to miss the disposable pads every single time. Bought DryPad after my vet mentioned something about scent markers. First night - he used it. I actually checked the floor thinking he must have gone somewhere else too. Nope. Just on the pad. It's been 6 weeks now and I haven't mopped once. Worth every penny just for the sleep I'm getting.<\/p>","author":"<strong>Jennifer K<\/strong> - Birmingham, UK"}},"column_WpJDYz":{"type":"column","settings":{"star_rating":5,"title":"Wish I'd found this sooner","text":"<p>My Cavalier King Charles is 5 months now and finally house trained thanks to this pad. Tried everything else first - spent probably £200 on different disposable brands. This one she understood immediately. No training needed which sounds fake but it's true. Even my husband noticed the house doesn't smell anymore. Only thing is I wish I'd bought 2 so I had one while the other is washing.<\/p>","author":"<strong>Patricia Thompson<\/strong> - Essex, UK"}},"column_rWeLKy":{"type":"column","settings":{"star_rating":5,"title":"Saved my sanity and my floors","text":"<p>Bought this for my daughter who just got a Golden Retriever puppy. She was ready to return him after 2 weeks of accidents everywhere. Ordered DryPad as a last resort. That was October. Today she sent me a video of him walking himself to the pad at 5am while she was still in bed. She's ordering another one for upstairs. Can't believe one pad fixed what weeks of training couldn't.<\/p>","author":"<strong>Linda M<\/strong> - Boston, USA"}},"column_P3aP6z":{"type":"column","settings":{"star_rating":5,"title":"Actually works - shocked","text":"<p>Not one for leaving reviews but this deserves it. Our Westie pup was impossible with regular pads. Would pee right next to them, never on them. Wife was at her wits end cleaning constantly. Got DryPad on a Friday, by Sunday no accidents. It's like he just knows that's his spot now. Been using same pad for 2 months, wash it weekly, still perfect. Neighbours asked what we're doing differently because there's no smell when they visit now.<\/p>","author":"<strong>Robert Davies<\/strong> - London, UK"}},"column_nEAp8H":{"type":"column","settings":{"star_rating":5,"title":"Game changer for apartment living","text":"<p>Living on the 4th floor with a new puppy was a nightmare until this. Those 3am trips downstairs in winter are over. My Yorkie goes straight to her DryPad now, even wakes up and uses it herself then goes back to sleep. I work from home and not having to interrupt calls to clean up accidents has been amazing. Already recommended to three friends in my building.<\/p>","author":"<strong>Mary Anderson<\/strong> - Chicago, USA"}},"column_PMWnjW":{"type":"column","settings":{"star_rating":5,"title":"Love Drypads!","text":"<p>Used to dread coming home from work to find accidents everywhere despite having pads down. Got DryPad after reading reviews and honestly thought people were exaggerating. They weren't. My Frenchie took to it immediately. First time in 3 months I haven't had to clean floors before bed. Husband keeps saying it's the best £32 we've spent. Even my cleaner commented the house smells fresher.<\/p>","author":"<strong>Karen Williams<\/strong> - Surrey, UK"}},"column_8kAFAG":{"type":"column","settings":{"star_rating":5,"title":"Absolutely fantastic solution!","text":"<p>We’ve tried so many disposable pads that just leak or smell.<br\/><br\/>This pad absorbs everything, and the floor stays dry.<br\/><br\/>Our dog used it right away – zero stress.<\/p>","author":"— <strong>Anne, 59 years old, Cocker Spaniel<\/strong>"}},"column_WdGwPp":{"type":"column","settings":{"star_rating":5,"title":"No more smell!","text":"<p>It always used to smell a bit in the hallway, even though I cleaned all the time.<br\/><br\/>Now it’s completely gone – the pad stays fresh for a long time between washes.<br\/><br\/>I only wash it once a week, and it still looks new.<br\/><\/p>","author":"— <strong>Per, 63 years old, Labrador<\/strong>"}},"column_krBzan":{"type":"column","settings":{"star_rating":5,"title":"Handles everything – even puppy chaos!","text":"<p>Our puppy chews on everything, but this pad has stayed just as nice.<br\/><br\/>It doesn’t slide and dries quickly after washing.<br\/><br\/>Really good quality – worth every penny.<\/p>","author":"— <strong>Marit, 54 years old, Border Collie<\/strong>"}},"column_eriatb":{"type":"column","disabled":true,"settings":{"star_rating":5,"title":"Jag är väldigt nöjd","text":"<p>Jag har använt denna produkt på min hund i några veckor nu och jag är väldigt nöjd. Hundens tänder ser mycket renare ut och andedräkten har förbättrats markant. Det är också väldigt enkelt att använda, vilket är ett stort plus.<\/p>","author":"Simon K"}},"column_DcK6iV":{"type":"column","disabled":true,"settings":{"star_rating":5,"title":"Hans tänder ser mycket renare ut","text":"<p>Jag har använt denna produkt dagligen på min hund och ser verkligen resultat. Hans tänder ser mycket renare ut och andedräkten har förbättrats. Det känns tryggt att använda något med naturliga ingredienser<\/p>","author_avatar":"shopify:\/\/shop_images\/Profilbild344.webp","author":"Lena K"}},"column_3RNVbf":{"type":"column","disabled":true,"settings":{"star_rating":5,"title":"En bra produkt som verkligen gör skillnad","text":"<p>En bra produkt som verkligen gör skillnad. Jag har märkt att min hunds tandsten har minskat betydligt och hans andedräkt är mycket fräschare. Dessutom är den väldigt lätt att använda.<\/p>","author_avatar":"shopify:\/\/shop_images\/profilbild.webp","author":"Oskar J"}},"column_MeHrVW":{"type":"column","disabled":true,"settings":{"star_rating":5,"title":"Ser bra resultat.","text":"<p>Min hund gillar det, och det är lätt att använda varje dag. Ser bra resultat.<\/p>","author_avatar":"shopify:\/\/shop_images\/Profilbild1.jpg","author":"Sofia N"}},"column_84qbPX":{"type":"column","disabled":true,"settings":{"star_rating":5,"title":"Jag ser en förbättring i hans munhälsa.","text":"<p>Min hund verkar tycka om det och jag ser en förbättring i hans munhälsa. <\/p>","author_avatar":"shopify:\/\/shop_images\/Profilbild3.webp","author":"Ingrid T"}}},"block_order":["column_EfR4wq","column_aPCzbV","column_WpJDYz","column_rWeLKy","column_P3aP6z","column_nEAp8H","column_PMWnjW","column_8kAFAG","column_WdGwPp","column_krBzan","column_eriatb","column_DcK6iV","column_3RNVbf","column_MeHrVW","column_84qbPX"],"settings":{"display_id":false,"visibility":"always-display","title":"Join 10,000+ Happy <strong>Puppy Owners<\/strong>","title_highlight_color":"#48b5e9","heading_size":"h2","text":"","color_scheme":"background-2","image_width":"half","image_ratio":"square","column_alignment":"center","show_stars":true,"inactive_stars_style":"solid","star_color":"#ffcc00","bg_star_color":"#ececec","show_quotes":true,"quotes_color_scheme":"accent-1","cards_color_scheme":"bg-overlay","type":"slide","autoplay":false,"autoplay_speed":8,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":true,"columns_desktop":5,"slider_desktop":true,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":false,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":false,"mobile_dots_position":"under","mobile_arrows_position":"under","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_cards_colors_background":"#f3f3f3","custom_cards_gradient_background":"","custom_cards_colors_text":"#2e2a39"}},"section_divider_Hr4gPB":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":true,"shape_color":"background-2","custom_shape_color":"#dd1d1d","background_color":"background-1","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"image_with_text_CYXNb6":{"type":"image-with-text","blocks":{"heading_ULcN7U":{"type":"heading","settings":{"title":"Why us?","title_highlight_color":"#6d388b","heading_size":"h1"}},"text_6zdm8f":{"type":"text","settings":{"text":"<p>So what is it that actually makes our <strong>DryPad so special?<\/strong><br\/><br\/>Unlike other pee pads, we have carefully thought through how to <strong>combine safety, comfort, and modern design.<\/strong><\/p><p>Our DryPad isn’t just made for indoor use – it works just as well for travel, in the car, or at the cabin.<\/p><p><strong>Try it completely risk-free for 100 days <\/strong>and experience the difference yourself.<br\/><br\/><strong>We guarantee it lasts for over a year, or you get your money back.<\/strong><\/p>","text_style":"body"}},"button_YnafJk":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style_secondary":false}}},"block_order":["heading_ULcN7U","text_6zdm8f","button_YnafJk"],"name":"t:sections.image-with-text.presets.name","settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/10_47637807-9218-4392-b15a-159a4b4827a0.webp","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"background-1","section_color_scheme":"background-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"section_divider_fnpzUL":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":false,"shape_color":"background-2","custom_shape_color":"#dd1d1d","background_color":"background-1","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"collapsible_content_carHra":{"type":"collapsible-content","blocks":{"collapsible_row_ne9KWb":{"type":"collapsible_row","settings":{"heading":"How does the pheromone technology work?","icon":"","filled_icon":false,"row_content":"<p>Our pads are infused with a specially designed pheromone scent that mimics the natural scent signals dogs use to mark their territory.<br\/><br\/>This scent is invisible to humans but instantly recognized by dogs – naturally encouraging them to use the pad as their toilet spot without you needing any kind of training.<\/p>","page":""}},"collapsible_row_LypmYW":{"type":"collapsible_row","settings":{"heading":"Is the Puppy Pad really chew- and tear-resistant?","icon":"","filled_icon":false,"row_content":"<p>Yes! The Puppy Pad is made from military-grade, tear-resistant fabric.<br\/><br\/>We’ve tested it against even the most eager chewers.<\/p><p>While nothing is 100% indestructible, our material is designed to withstand normal biting, scratching, and digging – unlike the thin disposable pads.<\/p>","page":""}},"collapsible_row_6aBdr3":{"type":"collapsible_row","settings":{"heading":"How do I wash the Puppy Pad?","icon":"","filled_icon":false,"row_content":"<p>It’s easy! Put the pad in the washing machine on a normal cycle.<br\/><br\/>You can then tumble dry it on low heat or hang it to dry.<\/p><p>The pad is designed to withstand over 300 washes while maintaining its absorbency and odor-protecting properties.<\/p>","page":""}},"collapsible_row_B8FakY":{"type":"collapsible_row","settings":{"heading":"Will it smell like dog after use?","icon":"","filled_icon":false,"row_content":"<p>Absolutely not.<br\/><br\/>The Puppy Pad has a 4-layer core with antimicrobial technology that captures and neutralizes odor.<br\/><br\/>The super-absorbent material locks in liquid immediately, keeping your home fresh between each wash.<\/p>","page":""}},"collapsible_row_hY3wLq":{"type":"collapsible_row","settings":{"heading":"How many Puppy Pads should I have?","icon":"","filled_icon":false,"row_content":"<p>We recommend our set of “6 Puppy Pads.”<br\/><br\/>It gives you enough pads to have a rotating system where some are in use while others are being washed or dried.<\/p><p>Many customers place pads in different rooms (living room, bedroom, by the door) so the dog always has easy access.<\/p><p>More pads also means less stress and less frequent washing – you always have one ready when you need it.<\/p>","page":""}},"collapsible_row_C4qMiA":{"type":"collapsible_row","settings":{"heading":"Can I return the product?","icon":"","filled_icon":false,"row_content":"<p>Yes, you get a 100-day satisfaction guarantee.<br\/><br\/>If you’re not completely satisfied with the Puppy Pad, you can return it and get your money back – with no questions asked.<\/p>","page":""}},"collapsible_row_WiNxPC":{"type":"collapsible_row","settings":{"heading":"How do I contact you?","icon":"","filled_icon":false,"row_content":"<p>You can contact us via email at <a href=\"mailto:info@shopvetpets.com\" target=\"_blank\">info@shopvetpets.com<\/a><br\/><br\/>We always try to respond within 24 hours and make sure you get the help you need.<\/p>","page":""}}},"block_order":["collapsible_row_ne9KWb","collapsible_row_LypmYW","collapsible_row_6aBdr3","collapsible_row_B8FakY","collapsible_row_hY3wLq","collapsible_row_C4qMiA","collapsible_row_WiNxPC"],"settings":{"display_id":false,"visibility":"always-display","caption":"","title":"Frequently asked questions","title_highlight_color":"#6d388b","heading_size":"h2","heading_alignment":"center","layout":"none","color_scheme":"background-2","container_color_scheme":"accent-1","open_first_collapsible_row":false,"video_muted_autoplay":true,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"medium","collapse_icon":"carret","display_top_border":true,"padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#000000","custom_contaner_colors_background":"#ffffff","custom_container_gradient_background":"","custom_contaner_colors_text":"#000000"}},"section_divider_PwKjDx":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","fli