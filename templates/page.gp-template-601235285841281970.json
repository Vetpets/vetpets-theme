        "ggS6jQYCKit_text": "<strong>How To Stop Crusty Eyes In 30 Seconds A Day&nbsp;</strong><span style=\"color:#47B5E9;\"><strong>— Without Baby Wipes, Grooming, Or Home Remedies</strong></span>",
        "ggzB8PcR17b_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/gempages_577888762156024773-2f099bba-862b-4314-aae4-31a23fe77405.png",
