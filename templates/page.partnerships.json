        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<style>\n  .partner-form-wrap {\n    max-width: 700px;\n    margin: 0 auto;\n    text-align: center;\n  }\n  .partner-form-wrap h2 {\n    font-size: 36px;\n    font-weight: 700;\n    margin-bottom: 24px;\n    font-family: inherit;\n  }\n  .partner-form {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n  .partner-form .row {\n    display: flex;\n    gap: 16px;\n  }\n  .partner-form .row input {\n    flex: 1;\n  }\n  .partner-form input,\n  .partner-form select,\n  .partner-form textarea {\n    width: 100%;\n    padding: 14px 16px;\n    border: 1.5px solid #000;\n    border-radius: 8px;\n    font-size: 15px;\n    font-family: inherit;\n    box-sizing: border-box;\n    background: #fff;\n    color: #333;\n  }\n  .partner-form input::placeholder,\n  .partner-form textarea::placeholder {\n    color: #aaa;\n  }\n  .partner-form input:focus,\n  .partner-form select:focus,\n  .partner-form textarea:focus {\n    outline: none;\n    border-color: #47B5E9;\n    box-shadow: 0 0 0 3px rgba(71,181,233,0.15);\n  }\n  .partner-form textarea {\n    height: 150px;\n    resize: vertical;\n  }\n  .partner-form button {\n    background: #47B5E9;\n    color: #fff;\n    padding: 16px;\n    border: none;\n    border-radius: 8px;\n    font-size: 16px;\n    font-family: inherit;\n    font-weight: 600;\n    cursor: pointer;\n    width: 100%;\n    transition: background 0.2s;\n  }\n  .partner-form button:hover {\n    background: #13B6B5;\n  }\n</style>\n\n<div class=\"partner-form-wrap\">\n  <form class=\"partner-form\" action=\"https://formspree.io/f/mdawwonl\" method=\"POST\">\n    <div class=\"row\">\n      <input type=\"text\" name=\"name\" placeholder=\"Name\" required>\n      <input type=\"email\" name=\"email\" placeholder=\"Email\" required>\n    </div>\n    <div>\n      <select name=\"country\" required>\n        <option value=\"\">Select your country</option>\n        <option>United States</option>\n        <option>United Kingdom</option>\n        <option>Canada</option>\n        <option>Australia</option>\n        <option>Sweden</option>\n      </select>\n    </div>\n    <div>\n      <textarea name=\"message\" placeholder=\"Tell us about your idea\" required></textarea>\n    </div>\n    <button type=\"submit\">Let's Collab →</button>\n  </form>\n</div>",
        "color_scheme": "background-1",
