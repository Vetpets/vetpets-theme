 hunds munhälsa – utan veterinärbesök, stress eller osäkerhet.<\/strong><\/p>","text_style":"body"}}},"block_order":["heading_cqqTnT","text_MK8LKH"],"settings":{"display_id":false,"visibility":"always-display","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"accent-2","section_color_scheme":"accent-2","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"section_divider_GwjHW4":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":false,"shape_color":"background-1","custom_shape_color":"#dd1d1d","background_color":"accent-2","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"image_with_text_PU9hUa":{"type":"image-with-text","blocks":{"heading_N8Ra34":{"type":"heading","settings":{"title":"Få veterinärresultat hemma","title_highlight_color":"#6d388b","heading_size":"h2"}},"text_qpknbU":{"type":"text","settings":{"text":"<p>FreshWipes rengör skonsamt din hunds <strong>tänder och tandkött på bara några sekunder.<\/strong><\/p><p>Tar bort plack, fräschar upp andedräkten och förebygger inflammation. <strong>Allt i en liten, enkel servett du trär på fingret.<\/strong><\/p><p>Inga borstar, inget språkande, inget krångel.<\/p>","text_style":"body"}}},"block_order":["heading_N8Ra