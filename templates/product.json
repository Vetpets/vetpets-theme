    "image_with_text_Ei4Ccz": {
      "type": "image-with-text",
      "blocks": {
        "heading_8gWHeA": {
          "type": "heading",
          "settings": {
            "title": "Your dog's ears tell a<strong> story you can't ignore</strong>",
            "title_highlight_color": "#d02b2b",
            "heading_size": "h2"
          }
        },
        "text_tzVfPD": {
          "type": "text",
          "settings": {
            "text": "<p><strong>A yeasty smell, brown wax, or constant head shaking</strong>—these may seem like minor problems.</p><p>But beneath the surface, they can quickly<strong> turn into something much worse.</strong></p><p>Moisture and bacteria build up in your dog's ears every day. Without cleaning, your dog risks painful infections, inflammation, and costly vet bills.</p><p>It hurts to think about, but the fact is:</p><p><strong>Paper towels and cotton pads can push bacteria deeper.</strong> Ear drops create stress and mess.</p><p>You shouldn't have to worry every time you check your dog's ears.</p><p><strong>That's why we—together with veterinarians—created EarWipes</strong> – a simple, gentle routine that both cleans and protects.</p>",
            "text_style": "body"
          }
        }
      },
