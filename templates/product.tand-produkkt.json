t_collapsible_row":false,"video_muted_autoplay":true,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"medium","collapse_icon":"carret","display_top_border":true,"padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#000000","custom_contaner_colors_background":"#ffffff","custom_container_gradient_background":"","custom_contaner_colors_text":"#000000"}},"section_divider_LQG9Ja":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":false,"shape_color":"background-1","custom_shape_color":"#dd1d1d","background_color":"background-2","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"854b8c46-40a3-4c74-9b36-360886558b1f":{"type":"testimonials","blocks":{"template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-0":{"type":"column","settings":{"star_rating":5,"title":"Merket en forskjell etter andre gang","text":"<p>Jeg har aldri vært særlig flink til å ta vare på tennene til hunden min, og å bruke tannbørste har føltes som et slit. Men etter at veterinæren nevnte tannstein, ble jeg litt bekymret.<br\/><br\/>Prøvde FreshSmile og merket faktisk en forskjell allerede etter andre gangs bruk - både i pusten og hvordan tennene så ut. Hunden min ser ikke ut til å ha noe imot det heller, noe som overrasket meg. Kommer til å fortsette å bruke!<\/p>","author":"Maria L., Umeå – blandras 6 år"}},"template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-1":{"type":"column","settings":{"star_rating":5,"title":"Et godt supplement til daglig tannpleie","text":"<p>Jeg bruker tannbørste og tyggeben regelmessig, men den eldre retrieveren min har fortsatt misfarging og litt dårlig ånde. FreshSmile har ikke fjernet alt over natten, men det har hjulpet mye med avleiringene.<br\/><br\/>Vi bruker det omtrent en gang i uken, og det har blitt en helt naturlig rutine nå. Produktet føles solid og enkelt å bruke.<\/p>","author":"Johan K., Skåne – golden retriever 9 år"}},"template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-2":{"type":"column","settings":{"star_rating":5,"title":"Veterinæren var imponert","text":"<p>Hunden min trengte tannsteinfjerning hos veterinæren i fjor, og det var både dyrt og stressende. Jeg ville unngå å gå dit igjen, så jeg bestilte dette settet.<br\/>Jeg har brukt det i litt over to måneder, og da vi nylig hadde et gjenbesøk, sa veterinæren at det så bra ut. Det var veldig godt å høre! Verdt hver eneste krone bare for å slippe å avlive ham igjen.<\/p>","author":"Elin S., Västerås – fransk bulldogg 4 år"}}},"block_order":["template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-0","template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-1","template--18472096170313__854b8c46-40a3-4c74-9b36-360886558b1f-16798646670717cf42-2"],"settings":{"display_id":false,"visibility":"always-display","title":"Verifierade Recensioner","title_highlight_color":"#6d388b","heading_size":"h1","text":"","color_scheme":"background-1","image_width":"full","image_ratio":"square","column_alignment":"center","show_stars":true,"inactive_stars_style":"solid","star_color":"#ffcc00","bg_star_color":"#ececec","show_quotes":true,"quotes_color_scheme":"accent-2","cards_color_scheme":"bg-overlay","type":"slide","autoplay":false,"autoplay_speed":5,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":3,"slider_desktop":false,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":false,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":false,"mobile_dots_position":"under","mobile_arrows_position":"und