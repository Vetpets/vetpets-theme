    "custom_liquid_yj4ALA": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<!-- Paste this into a \"Custom Liquid\" section in the Shopify theme editor, -->\n<!-- then replace each IMAGE_URL_x with your actual uploaded image URL. -->\n<!-- Desktop: 3x2 grid (unchanged). Mobile: 1 card visible at a time, swipeable, with arrows + dots. -->\n\n<div class=\"pf-grid-section\">\n  <h2 class=\"pf-grid-title\">From Muddy to Handled</h2>\n\n  <div class=\"pf-carousel-wrap\">\n    <button class=\"pf-arrow pf-arrow-prev\" aria-label=\"Previous\">&#8249;</button>\n\n    <div class=\"pf-grid\" id=\"pf-grid-06\">\n\n      <div class=\"pf-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0735/4833/3323/files/hf_20260807_063015_2c6ba5ce-dac7-44e1-bdb6-cb941fb8ad49.png?v=1786085395\" alt=\"Muddy paw before and after cleaning\" class=\"pf-img\">\n        <h3 class=\"pf-card-title\">Muddy &rarr; Spotless</h3>\n        <p class=\"pf-card-text\">Clean, dry paws before mud reaches the floor.</p>\n      </div>\n\n      <div class=\"pf-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0735/4833/3323/files/hf_20260807_063021_3760d24c-a27a-4d85-99ff-30ce1bcb4555.png?v=1786085393\" alt=\"Close-up of paw pad with foam lifting buildup\" class=\"pf-img\">\n        <h3 class=\"pf-card-title\">Buildup &rarr; Clean Pads</h3>\n        <p class=\"pf-card-text\">Residue lifted from between the pads.</p>\n      </div>\n\n      <div class=\"pf-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0735/4833/3323/files/hf_20260807_065028_bac905cf-a29c-4f69-814d-0cfd23d28a5f.png?v=1786085539\" alt=\"Clean paw resting on white towel\" class=\"pf-img\">\n        <h3 class=\"pf-card-title\">Smelly &rarr; Fresh</h3>\n        <p class=\"pf-card-text\">Odor-causing buildup cleared, not covered.</p>\n      </div>\n\n      <div class=\"pf-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0735/4833/3323/files/hf_20260807_065217_2f0f810f-ee9f-4a01-b1bd-efa316542d1d.png?v=1786085746\" alt=\"Paw in snow with road salt\" class=\"pf-img\">\n        <h3 class=\"pf-card-title\">Salt &amp; Grit &rarr; Safe</h3>\n        <p class=\"pf-card-text\">Nothing sharp or irritating left behind.</p>\n      </div>\n\n      <div class=\"pf-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0735/4833/3323/files/hf_20260807_065044_6e497487-b036-4170-94ad-188f7851f363.png?v=178608576\" alt=\"Paw in grass with pollen\" class=\"pf-img\">\n        <h3 class=\"pf-card-title\">Pollen &rarr; Cleared</h3>\n        <p class=\"pf-card-text\">Removed before it sits against skin.</p>\n      </div>\n\n      <div class=\"pf-card\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0735/4833/3323/files/hf_20260807_070514_3aef9acd-27ac-4f69-a5d3-56fd04a673df.png?v=1786086440\" alt=\"Owner cleaning golden retriever's paw at entryway\" class=\"pf-img\">\n        <h3 class=\"pf-card-title\">Daily &rarr; Under Control</h3>\n        <p class=\"pf-card-text\">A 30-second post-walk habit.</p>\n      </div>\n\n    </div>\n\n    <button class=\"pf-arrow pf-arrow-next\" aria-label=\"Next\">&#8250;</button>\n  </div>\n\n  <div class=\"pf-dots\" id=\"pf-dots-06\"></div>\n</div>\n\n<style>\n.pf-grid-section {\n  background: #fffff;\n  padding: 48px 24px;\n  text-align: center;\n}\n.pf-grid-title {\n  font-size: 32px;\n  font-weight: 700;\n  color: #16323B;\n  margin: 0 0 32px;\n  font-family: inherit;\n}\n.pf-carousel-wrap {\n  position: relative;\n  max-width: 1100px;\n  margin: 0 auto;\n}\n.pf-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px;\n}\n.pf-card {\n  text-align: center;\n  background: #fffff;\n  border: 1px solid #47B5E9 ;\n  border-radius: 12px;\n  padding: 14px;\n}\n.pf-img {\n  width: 100%;\n  aspect-ratio: 1 / 1;\n  height: auto;\n  object-fit: cover;\n  border-radius: 8px;\n  display: block;\n  margin-bottom: 12px;\n}\n.pf-card-title {\n  font-size: 16px;\n  font-weight: 700;\n  color: #16323B;\n  margin: 0 0 6px;\n}\n.pf-card-text {\n  font-size: 13px;\n  color: #3C4D52;\n  margin: 0;\n  line-height: 1.5;\n}\n\n/* Arrows + dots: hidden on desktop, shown only in the mobile carousel */\n.pf-arrow {\n  display: none;\n}\n.pf-dots {\n  display: none;\n}\n\n@media (max-width: 749px) {\n  /* Convert the grid into a horizontal, one-card-at-a-time snap carousel */\n  .pf-grid {\n    display: flex;\n    grid-template-columns: none;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    gap: 14px;\n    padding-bottom: 4px;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n  }\n  .pf-grid::-webkit-scrollbar {\n    display: none;\n  }\n  .pf-card {\n    flex: 0 0 100%;\n    scroll-snap-align: center;\n    padding: 10px;\n  }\n\n  .pf-arrow {\n    display: flex;\n    position: absolute;\n    top: 45%;\n    transform: translateY(-50%);\n    width: 32px;\n    height: 32px;\n    border-radius: 50%;\n    background: #ffffff;\n    border: 1px solid #C9D3D6;\n    align-items: center;\n    justify-content: center;\n    font-size: 20px;\n    line-height: 1;\n    color: #16323B;\n    z-index: 2;\n    cursor: pointer;\n    padding: 0;\n  }\n  .pf-arrow-prev { left: -2px; }\n  .pf-arrow-next { right: -2px; }\n\n  .pf-dots {\n    display: flex;\n    justify-content: center;\n    gap: 8px;\n    margin-top: 16px;\n  }\n}\n\n.pf-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: #C9D3D6;\n  transition: background 0.2s, width 0.2s;\n  cursor: pointer;\n}\n.pf-dot.active {\n  background: #11111;\n  width: 18px;\n  border-radius: 4px;\n}\n</style>\n\n<script>\n(function () {\n  var grid = document.getElementById('pf-grid-06');\n  var dotsWrap = document.getElementById('pf-dots-06');\n  if (!grid || !dotsWrap) return;\n\n  var wrap = grid.closest('.pf-carousel-wrap');\n  var prevBtn = wrap.querySelector('.pf-arrow-prev');\n  var nextBtn = wrap.querySelector('.pf-arrow-next');\n  var cards = Array.prototype.slice.call(grid.querySelectorAll('.pf-card'));\n\n  cards.forEach(function (card, i) {\n    var dot = document.createElement('span');\n    dot.className = 'pf-dot' + (i === 0 ? ' active' : '');\n    dot.addEventListener('click', function () {\n      card.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });\n    });\n    dotsWrap.appendChild(dot);\n  });\n  var dots = dotsWrap.querySelectorAll('.pf-dot');\n\n  function updateActive() {\n    var gridRect = grid.getBoundingClientRect();\n    var closestIndex = 0;\n    var closestDist = Infinity;\n    cards.forEach(function (card, i) {\n      var r = card.getBoundingClientRect();\n      var dist = Math.abs(r.left - gridRect.left);\n      if (dist < closestDist) {\n        closestDist = dist;\n        closestIndex = i;\n      }\n    });\n    dots.forEach(function (d, i) {\n      d.classList.toggle('active', i === closestIndex);\n    });\n  }\n\n  var ticking = false;\n  grid.addEventListener('scroll', function () {\n    if (!ticking) {\n      window.requestAnimationFrame(function () {\n        updateActive();\n        ticking = false;\n      });\n      ticking = true;\n    }\n  }, { passive: true });\n\n  if (prevBtn) {\n    prevBtn.addEventListener('click', function () {\n      grid.scrollBy({ left: -grid.clientWidth, behavior: 'smooth' });\n    });\n  }\n  if (nextBtn) {\n    nextBtn.addEventListener('click', function () {\n      grid.scrollBy({ left: grid.clientWidth, behavior: 'smooth' });\n    });\n  }\n})();\n</script>",
        "color_scheme": "background-1",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
