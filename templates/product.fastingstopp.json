en kjemikalier.<\/strong><\/p>","text_style":"body"}}},"block_order":["heading_cqqTnT","text_MK8LKH"],"settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/giphy_430x_c09b63af-e370-4f69-a513-c3ad2165cdeb.webp","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"accent-1","section_color_scheme":"accent-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":16,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"section_divider_VfcCGy":{"type":"section-divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":true,"shape_color":"accent-1","custom_shape_color":"#dd1d1d","background_color":"background-1","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"image_with_text_kgnYwz":{"type":"image-with-text","blocks":{"heading_wNWMk7":{"type":"heading","settings":{"title":"Er du bekymret for flått - men også for deg selv?","title_highlight_color":"#6d388b","heading_size":"h2"}},"text_JwiaAw":{"type":"text","settings":{"text":"<p><strong>Vi vet hvordan det er.<\/strong><br\/><br\/>Når hunden din drar med seg flått opp i sofaen, på gulvet, i sengen...<br\/><br\/>Plutselig er det ikke bare hunden din som risikerer å bli bitt - men hele familien.<br\/><br\/>Men med vår flåttbeskyttelse holder du flåtten unna helt fra begynnelsen.<br\/><br\/>Tenk deg at du slipper å inspisere hundens pels hver kveld.<br\/><br\/><strong>Tenk deg å kunne nyte sommeren igjen, uten bekymringer, bare glede.<\/strong><\/p>","text_style":"body"}}},"block_order":["heading_wNWMk7","text_JwiaAw"],"settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/FastingStopp.png","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"background-1","section_color_scheme":"background-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":16,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"horizontal_ticker_LYncFL":{"type":"horizontal-ticker","blocks":{"text_BbRhnL":{"type":"text","settings":{"title":"Naturliga ingredienser"}},"text_FNHwBi":{"type":"text","settings":{"title":"starkt skydd mot fästingar"}},"text_Nt4aYp":{"type":"text","settings":{"title":"40% rea idag"}}},"block_order":["text_BbRhnL","text_FNHwBi","text_Nt4aYp"],"settings":{"display_id":false,"visibility":"always-display","speed":1,"direction":"normal","stop_on_hover":false,"mobile_spacing":60,"desktop_spacing":100,"color_scheme":"accent-1","mobile_text_size":16,"desktop_text_size":18,"italic_text":false,"uppercase_text":true,"bold_text":true,"mobile_image_height":26,"desktop_image_height":40,"mobile_reviews_width":300,"desktop_reviews_width":400,"hidden_products":"","enable_specific_display":false,"displayed_products