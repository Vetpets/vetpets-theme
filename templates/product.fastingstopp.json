5,"margin_bottom":15}},"buy_buttons":{"type":"buy_buttons","settings":{"show_dynamic_checkout":false,"skip_cart":false,"uppercase_text":true,"icon_scale":120,"icon_spacing":10,"atc_custom_label":"","display_price":false,"enable_custom_color":false,"custom_color":"#dd1d1d","enable_secondary_btn":false,"secondary_btn_label":"Buy It Now","secondary_btn_enable_custom_color":false,"secondary_btn_custom_color":"#dd1d1d","margin_top":24,"margin_bottom":24}},"d505cdfe-d5cf-4aff-8e9e-abca6dae66eb":{"type":"sticky_atc","settings":{"function":"add_to_cart","display_when":"after_scroll","button_label":"LÄGG I VARUKORGEN","enable_custom_btn_color":false,"custom_btn_color":"#dd1d1d","color_scheme":"background-1","star_color":"#ffcc00","stars_label":"(xxxx Reviews)","picker_type":"combined","desktop_show_image":false,"desktop_show_title":true,"desktop_rating_stars":false,"desktop_show_price":true,"desktop_show_sale_badge":true,"desktop_variant_picker":false,"desktop_full_button_width":false,"desktop_show_price_in_button":false,"desktop_transparent_bg":false,"mobile_show_image":false,"mobile_show_title":true,"mobile_rating_stars":false,"mobile_show_price":true,"mobile_show_sale_badge":true,"mobile_variant_picker":false,"mobile_full_button_width":false,"mobile_show_price_in_button":false,"mobile_transparent_bg":false}},"98db29ee-a7dc-429e-8129-bf71131627da":{"type":"payment_badges","settings":{"enabled_payment_types":"","margin_top":15,"margin_bottom":15}},"collapsible_tab_kKWAtK":{"type":"collapsible_tab","settings":{"heading":"Innholdsfortegnelse","heading_size":"medium","icon":"","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<p>Ingredienser:<br\/><br\/>Lavendelolje, sitron eukalyptus, kanelolje, eukalyptusolje, linalool <br\/><br\/>Alle ingrediensene er 100 % naturlige og nøye utvalgt for å avvise flått og andre parasitter uten å skade hundens hud eller helse.<\/p>","page":"","margin_top":24,"margin_bottom":0}},"collapsible_tab_gk4a3W":{"type":"collapsible_tab","settings":{"heading":"Hva gjør FästingStopp?","heading_size":"medium","icon":"","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<p>TickStop er et naturlig halsbånd som effektivt holder flått og andre parasitter borte fra hunden din. <br\/><br\/>Det fungerer ved å avgi duftstoffer fra plantebaserte oljer som flått ikke tåler - men som er helt trygge for hunder. <br\/><br\/>En enkel måte å beskytte hunden din hver dag, uten giftstoffer eller søl.<\/p>","page":"","margin_top":24,"margin_bottom":0}},"collapsible_tab_CNhHPx":{"type":"collapsible_tab","settings":{"heading":"Helsegaranti for hund","heading_size":"medium","icon":"","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<p>Vi ønsker at både du og hunden din skal føle dere helt trygge med FästingStopp.<br\/><br\/>Derfor tilbyr vi 60 dagers åpent kjøp.<br\/><br\/>Hvis du ikke er fornøyd, kan du returnere produktet og få pengene tilbake.<br\/><br\/>Du kan også velge å betale senere med Klarna, slik at du får tid til å teste i fred og ro.<br\/><br\/>Å beskytte hunden din skal føles godt - både i hjertet og i lommeboken.<\/p>","page":"","margin_top":24,"margin_bottom":0}},"149aabfb-9fd8-4472-a633-6032dbe01ed0":{"type":"reviews","settings":{"color_scheme":"background-1","show_custom_bg":false,"custom_bg_color":"#f2f2f2","corner_radius":12,"border_width":0,"border_color":"#b7b7b7","avatar_alignment":"top","avatar_corner_radius":40,"star_color":"#ffcc00","stars_translate":0,"checkmark_color":"#6d388b","checkmark_icon_color":"#ffffff","slider_type":"slide","autoplay":false,"autoplay_speed":5,"display_arrows":false,"display_dots":true,"author_1":"Lena, 42 år, Kalmar","image_1":"shopify:\/\/shop_images\/Profilbild3.webp","text_1":"<p>Vi har prøvd flere forskjellige beskyttelser tidligere, men TickStop er den eneste som faktisk har fungert for labradoren vår. To hele somre uten en eneste flått - vi er imponert.<\/p>","author_2":"Johan, 35 år, Sundsvall","text_2":"<p>Jack russellen min får alltid med seg flått inn fra skogen, men etter at vi begynte å bruke TickStop har vi nesten ikke sett noen i det hele tatt. Det lukter mildt, og det ser ikke engang ut til at han merker at han har det på seg.<\/p>","author_3":"Malin, 50 år, Malmö","image_3":"shopify:\/\/shop_images\/Profilbild_3.webp","text_3":"<p>TickStop fungerte veldig bra for våre to hunder gjennom hele fjorårets sommer. Vi bor på landet, så vi merket raskt forskjellen - og i år gjør vi det igjen.<\/p>","margin_top":24,"margin_bottom":24}}},"block_order":["title","rating_stars_HEpJGB","price","text_QENAJH","text_BR7PYd","44f9cdc2-f4bf-466e-87d5-fb765ad4864a","074f248d-8d73-4c8f-a97e-d8e82c5be5fc","inventory_QVMf4e","buy_buttons","d505cdfe-d5cf-4aff-8e9e-abca6dae66eb","98db29ee-a7dc-429e-8129-bf71131627da","collapsible_tab_kKWAtK","collapsible_tab_gk4a3W","collapsible_tab_CNhHPx","149aabfb-9fd8-4472-a633-6032dbe01ed0"],"settings":{"display_id":false,"enable_sticky_info":true,"display_variant_image_first":false,"disable_prepend":false,"hide_variants":false,"variant_image_filtering":"none","image_zoom":"none","thumbnails_ratio":"square","arrows_color_scheme":"inverse","transparent_arrows":false,"dots_color_scheme":"inverse","video_player":"play_btn","enable_video_looping":false,"autoplay_videos_pause_btn":false,"video_sound_btn":false,"video_timeline":false,"play_btn_color_scheme":"accent-1","sound_btn_color_scheme":"inverse","timeline_color":"accent-1","media_size":"medium","media_position":"left","gallery_layout":"thumbnail_slider","desktop_thumbnails_position":"bottom","desktop_thumbnails_count":5,"desktop_vertical_thumbnails_width":16,"desktop_vertical_thumbnails_hide_arrows":false,"constrain_to_viewport":true,"media_fit":"contain","desktop_arrows_position":"hidden","mobile_media_corner_radius":12,"mobile_spacing_pixels":0,"mobile_arrows_position":"hidden","mobile_pagination":"dots_overlay","mobile_thumbnail