ktop_full_button_width":false,"desktop_show_price_in_button":false,"desktop_transparent_bg":false,"mobile_show_image":false,"mobile_show_title":true,"mobile_rating_stars":false,"mobile_show_price":true,"mobile_show_sale_badge":false,"mobile_variant_picker":false,"mobile_full_button_width":false,"mobile_show_price_in_button":false,"mobile_transparent_bg":false}},"description":{"type":"description","settings":{"margin_top":24,"margin_bottom":24}},"de158e68-5d0d-4819-a625-e2dabdff87d1":{"type":"collapsible_tab","settings":{"heading":"Description","heading_size":"medium","icon":"","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<p><strong>ClearSwipe – Streak-Free Surfaces Without the Mess<\/strong><br\/><br\/>Quickly and effectively wipe windows, mirrors, and shower walls – no drips, no smudges, and no need to wipe afterward.<br\/><br\/>ClearSwipe gives you sparkling clean surfaces in a single swipe – every time.<\/p><p><strong>Fits All Smooth Surfaces<\/strong><br\/><br\/>Works on glass, tile, plastic, and metal.<\/p><p><strong>Made From Durable Silicone<\/strong><br\/><br\/>Flexible blade that follows the surface and collects water instantly.<\/p><p><strong>Comfortable and Easy to Use<\/strong><br\/><br\/>Soft to hold and simple to clean.<\/p>","page":"","margin_top":24,"margin_bottom":0}},"collapsible_tab_EGhYxC":{"type":"collapsible_tab","settings":{"heading":"FREE E-BOOK – The Secret to a Sparkling Home in Just 15 Minutes a Day","heading_size":"medium","icon":"","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"","page":"free-e-book-the-secret-to-a-sparkling-home-in-just-15-minutes-a-day","margin_top":24,"margin_bottom":0}},"collapsible_tab_aFAiwA":{"type":"collapsible_tab","settings":{"heading":"Specifications","heading_size":"medium","icon":"","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<p><strong>Included in your order:<\/strong><br\/><br\/>1x ClearSwipe Silicone Blade<br\/><br\/>1x ClearSwipe Window Cleaner<br\/><br\/>1x Free E-book – <em>The Secret to a Sparkling Home in 15 Minutes a Day<\/em><br\/><br\/>2x Microfiber Covers for ClearSwipe<br\/><br\/>1x Detachable Handle<\/p><p><strong>Material:<\/strong> Soft and durable silicone<br\/><br\/><strong>Blade Width:<\/strong> 30 cm<br\/><br\/><strong>Total Length:<\/strong> 21 cm<br\/><br\/><strong>Surfaces:<\/strong> Glass, mirrors, tiles, shower walls, car windows<br\/><br\/><strong>Cleaning:<\/strong> Rinse with water after use<br\/><br\/><strong>Storage:<\/strong> Small hanging hole in the handle<\/p>","page":"","margin_top":24,"margin_bottom":0}},"collapsible_tab_9JTNPN":{"type":"collapsible_tab","settings":{"heading":"2-Year Guarantee","heading_size":"medium","icon":"","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<p>We stand by the quality of ClearSwipe and want you to feel completely confident in your purchase.<br\/><br\/>That’s why we offer a 2-year warranty covering material and manufacturing defects.<\/p><p>If anything breaks or stops working properly – without being caused by misuse – we’ll send you a replacement product completely free of charge.<br\/><br\/>Whether it’s a cracked blade, abnormal wear or anything else that affects performance – we’ll take care of it.<\/p><p>All you need to do is contact our customer support with a brief description and a photo – and we’ll handle the rest, quickly and smoothly.<br\/><br\/>📄 Want to read more about how the warranty works and your rights? <a href=\"\/pages\/2-year-warranty\" title=\"2 Year Warranty\"><strong>Click here.<\/strong><\/a><\/p>","page":"","margin_top":24,"margin_bottom":0}},"reviews_8UgFbe":{"type":"reviews","settings":{"color_scheme":"background-1","show_custom_bg":false,"custom_bg_color":"#f2f2f2","corner_radius":12,"border_width":0,"border_color":"#b7b7b7","avatar_alignment":"top","avatar_corner_radius":40,"star_color":"#ffcc00","stars_translate":0,"checkmark_color":"#6d388b","checkmark_icon_color":"#ffffff","slider_type":"slide","autoplay":false,"autoplay_speed":5,"display_arrows":false,"display_dots":true,"author_1":"Anna Müller, Germany [stars]","image_1":"shopify:\/\/shop_images\/Profilbild_21_6774d488-3bc3-405d-b134-5d5f0598af50.webp","text_1":"<p>ClearSwipe has transformed my cleaning routine. With just one swipe, my windows are spotless and streak-free. It's incredibly easy to use and saves me so much time.<\/p>","author_2":"Luca Rossi, Italy [stars]","image_2":"shopify:\/\/shop_images\/Profilbild_32.webp","text_2":"<p>I was skeptical at first, but ClearSwipe exceeded my expectations. It's durable, eco-friendly, and leaves my mirrors and glass surfaces gleaming. Highly recommended!<\/p>","author_3":"Sophie Dubois, France [stars]","image_3":"shopify:\/\/shop_images\/Profilbild111.webp","text_3":"<p>I've tried various window cleaners, but ClearSwipe stands out. It cleans efficiently without leaving any streaks or drips. Plus, it's made from recycled materials, which I appreciate.<\/p>","margin_top":24,"margin_bottom":24}}},"block_order":["title","a6eb81db-40e4-43e0-972f-32db010a4a56","price","text_cn7XQg","text_kEd4Nj","5fcc0428-e768-4cb7-bea3-eb0274198dd1","04ba004e-2f54-4936-8b1c-8bcadf6573f6","inventory_TFawNK","buy_buttons","payment_badges_XtWzKz","text_rerK7N","e7a28cbe-03cb-4c9d-a2c4-0e3e76ffb3e5","description","de158e68-5d0d-4819-a625-e2dabdff87d1","collapsible_tab_EGhYxC","collapsible_tab_aFAiwA","collapsible_tab_9JTNPN","reviews_8UgFbe"],"custom_css":[],"settings":{"display_id":false,"enable_sticky_info":true,"display_variant_image_first":false,"disable_prepend":true,"hide_variants":false,"variant_image_filtering":"none","image_zoom":"none","thumbnails_ratio":"square","arrows_color_scheme":"inverse","transparent_arrows":false,"dots_color_scheme":"inverse","video_player":"play_btn","enable_video_looping":false,"autoplay_videos_pause_btn":false,"video_sound_btn"