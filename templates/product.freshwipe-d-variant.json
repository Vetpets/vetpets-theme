ms: center;\n    justify-content: space-between;\n    padding: 14px 20px;\n    border-bottom: 0.5px solid rgba(0,0,0,0.1);\n    flex-shrink: 0;\n  }\n\n  .vp-modal-header p {\n    margin: 0;\n    font-size: 14px;\n    font-weight: 500;\n    color: #111;\n  }\n\n  .vp-modal-close {\n    background: none;\n    border: none;\n    cursor: pointer;\n    padding: 4px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 4px;\n    transition: background 0.15s;\n    -webkit-appearance: none;\n    appearance: none;\n  }\n\n  .vp-modal-close:hover {\n    background: rgba(0,0,0,0.06);\n  }\n\n  .vp-modal-close svg {\n    width: 18px;\n    height: 18px;\n    opacity: 0.5;\n  }\n\n  .vp-tabs {\n    display: flex;\n    border-bottom: 0.5px solid rgba(0,0,0,0.1);\n    flex-shrink: 0;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n  }\n\n  .vp-tabs::-webkit-scrollbar {\n    display: none;\n  }\n\n  .vp-tab-btn {\n    flex-shrink: 0;\n    padding: 11px 18px;\n    font-size: 13px;\n    color: rgba(0,0,0,0.45);\n    cursor: pointer;\n    border: none;\n    border-bottom: 2px solid transparent;\n    background: none;\n    font-family: var(--font-body-family, var(--font-heading-family, inherit));\n    white-space: nowrap;\n    transition: color 0.15s, border-color 0.15s;\n    -webkit-appearance: none;\n    appearance: none;\n  }\n\n  .vp-tab-btn.is-active {\n    color: #111;\n    border-bottom-color: #111;\n    font-weight: 500;\n  }\n\n  .vp-panels {\n    overflow-y: auto;\n    flex: 1;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  .vp-panel {\n    display: none;\n  }\n\n  .vp-panel.is-active {\n    display: grid;\n    grid-template-columns: 180px 1fr;\n  }\n\n  .vp-panel-image {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 24px 20px;\n    border-right: 0.5px solid rgba(0,0,0,0.1);\n    background: #f5f8fa;\n  }\n\n  .vp-panel-image img {\n    width: 