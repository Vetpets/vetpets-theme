    "collapsible_content_carHra": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_ne9KWb": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Hur länge håller kyleffekten?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>Mellan 2–4 timmar beroende på temperatur och användning. Mattan återaktiveras automatiskt efter vila.</p>",
            "page": ""
          }
        },
        "collapsible_row_LypmYW": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Behöver jag kyla ner mattan i förväg?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>Nej, den fungerar helt utan kylning eller el.</p>",
            "page": ""
          }
        },
        "collapsible_row_6aBdr3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Är materialet giftfritt?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>Ja, helt fritt från skadliga ämnen och säkert även om din hund biter lite i den.</p>",
            "page": ""
          }
        },
        "collapsible_row_B8FakY": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Fungerar den för stora hundar?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>Ja, vi har flera storlekar som passar både små och stora raser.</p>",
            "page": ""
          }
        },
        "collapsible_row_hY3wLq": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Kan jag använda den utomhus?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>Absolut – så länge det inte är direkt stekande sol, fungerar den perfekt på altan, gräsmatta eller i bilen.</p>",
            "page": ""
          }
        }
      },
