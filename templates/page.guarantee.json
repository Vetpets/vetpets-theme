        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<style>\n  .hero-section {\n    padding: 0px 0px;\n    text-align: center;\n    background: #ffffff;\n    font-family: 'Poppins', sans-serif;\n  }\n  \n  .hero-heading {\n    font-size: 45px;\n    font-weight: 900;\n    line-height: 1.2;\n    margin: 0;\n    color: #000000;\n    font-family: 'Poppins', sans-serif;\n    display: inline;\n    margin-right: 8px;\n  }\n  \n  .hero-subheading {\n    font-size: 45px;\n    font-weight: 900;\n    line-height: 1.2;\n    margin: 0;\n    background: linear-gradient(90deg, #47B5E9 0%, #19B6B5 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    font-family: 'Poppins', sans-serif;\n    display: inline;\n  }\n  \n  @media (max-width: 768px) {\n    .hero-section {\n      padding: 0px 0px;\n    }\n    \n    .hero-heading,\n    .hero-subheading {\n      font-size: 32px;\n    }\n  }\n</style>\n\n<div class=\"hero-section\">\n  <h1 class=\"hero-heading\">100-Day</h1>\n  <h2 class=\"hero-subheading\">Money-Back Guarantee</h2>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_PfGnRG": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<style> \n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;700;900&display=swap'); \n\n.mission-section { \n  padding: 60px 20px; \n  background: linear-gradient(136deg, #D5F7FF 11%, #FFFFFF 100%); \n  font-family: 'Poppins', sans-serif; \n} \n\n.mission-container { \n  max-width: 1100px; \n  margin: 0 auto; \n  display: grid; \n  grid-template-columns: 1fr 1fr; \n  gap: 40px; \n  align-items: center; \n} \n\n.mission-image img { \n  width: 100%; \n  height: auto; \n  border-radius: 10px; \n} \n\n.mission-content { \n  padding-left: 10px; \n} \n\n/* MATCH HERO TITLE */\n.mission-title { \n  font-size: 32px; \n  font-weight: 900; \n  line-height: 1.2; \n  margin: 0; \n  color: #000000; \n} \n\n/* MATCH HERO GRADIENT STYLE */\n.mission-subtitle { \n  font-size: 38px; \n  font-weight: 900; \n  line-height: 1.2; \n  margin: 0 0 20px 0; \n  background: linear-gradient(90deg, #47B5E9 0%, #19B6B5 100%); \n  -webkit-background-clip: text; \n  -webkit-text-fill-color: transparent; \n  background-clip: text; \n} \n\n/* MATCH HERO BODY TEXT */\n.mission-description { \n  font-size: 20px; \n  font-weight: 400; \n  line-height: 1.6; \n  color: #000000; \n  margin: 0; \n  max-width: 520px;\n} \n\n@media (max-width: 768px) { \n  .mission-section { \n    padding: 40px 20px; \n  } \n\n  .mission-container { \n    grid-template-columns: 1fr; \n    gap: 30px; \n  } \n\n  .mission-content { \n    padding-left: 0; \n    text-align: center;\n  } \n\n  .mission-title, \n  .mission-subtitle { \n    font-size: 32px; \n  } \n\n  .mission-description { \n    font-size: 18px; \n    margin: 0 auto;\n  } \n}\n</style>\n\n<div class=\"mission-section\"> \n  <div class=\"mission-container\"> \n\n    <div class=\"mission-image\"> \n      <img src=\"https://cdn.shopify.com/s/files/1/0735/4833/3323/files/Product_image.jpg?v=1749107778?v=1768026248\" alt=\"VetPets Products\"> \n    </div> \n\n    <div class=\"mission-content\"> \n      <h2 class=\"mission-title\">Try it at home – stress-free</h2> \n      <h3 class=\"mission-subtitle\">for up to 100 days</h3> \n\n      <p class=\"mission-description\"> \n        We understand how important it is to feel confident when trying something new for your pet.\n        That’s why we give you a full 100 days to test our products — at your own pace, in your daily routine, right at home. \n      </p> \n    </div> \n\n  </div> \n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
