    "gp_section_631635195543487333": {
      "settings": {
        "checksum": "5f68e9d2777b5d084174452d217754acad04cab916532e985ea0e744b0fc5b6d_1_1_1_0__1",
        "gg-LONt97m2_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/5_reasons_why_page_1.webp",
        "gg4s-F8YUhM_text": "<p>FreshWipes feel like <i>your own finger</i>, not a tool.</p><p>No pulling away.<br>No biting.<br>No hiding at the sight of a toothbrush.</p><p>Just a quick wipe most dogs accept from day one.</p>",
        "ggDECHodCh__srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/5_reasons_why_page_3.jpg",
        "ggDiKBnMjaM_text": "<p><i>Simple routine you’ll actually stick to.</i></p><p>No mixing.<br>No measuring.<br>No daily prep.</p><p>Just one wipe per day — <strong>even busy dog owners can keep up with it.</strong></p>",
        "ggEiftUzoAq_text": "<strong>Try it risk-free </strong><span style=\"color:#47B5E9;\"><i><strong>for 100 days</strong></i></span>",
        "ggFulkAIWTn_text": "<strong>30 Seconds a day </strong><span style=\"color:#47B5E9;\"><i><strong>is all it takes</strong></i></span>",
        "ggOxq8cGZxD_text": "<p><i>Simple routine you’ll actually stick to.</i></p><p>No mixing.<br>No measuring.<br>No daily prep.</p><p>Just one wipe per day — <strong>even busy dog owners can keep up with it.</strong></p>",
        "ggPTQ4b2Oyp_text": "<strong>You can actually </strong><span style=\"color:#47B5E9;\"><i><strong>SEE the plaque</strong></i></span><strong> being removed</strong>",
        "ggQd5XkBjkE_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/5_reasons_why_page.jpg",
        "ggUD4YdXUjF_text": "<p>Unlike powders or water additives that work “over time”, FreshWipes physically remove plaque on contact.</p><p>Just one wipe along the gumline — and you can actually see what’s been removed. <strong>No guessing. No waiting. No brushing battles.</strong></p>",
        "ggWIdRpk5_R_text": "<strong>No brushing battles — dogs </strong><span style=\"color:#47B5E9;\"><i><strong>actually accept it</strong></i></span>",
        "ggarFIzks-h_text": "<strong>30 Seconds a day </strong><span style=\"color:#47B5E9;\"><i><strong>is all it takes</strong></i></span>",
        "ggb7bTLZf4__srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/5_reasons_why_page_3.webp",
        "ggboSehJLGA_text": "<span style=\"color:#47B5E9;\"><i><strong>Direct contact</strong></i></span><strong> &nbsp;where plaque actually builds up</strong>",
        "ggc7HGH2dVJ_text": "<p>FreshWipes feel like <i>your own finger</i>, not a tool.</p><p>No pulling away.<br>No biting.<br>No hiding at the sight of a toothbrush.</p><p>Just a quick wipe most dogs accept from day one.</p>",
        "ggm83XOQS5G_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/5_reasons_why_page_1.jpg",
        "ggp68ht1jgk_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/5_reasons_why_page_2.webp",
        "ggppN7qvuDK_text": "<p><i>Not diluted. Not indirect. Right on the gumline.</i></p><p>Powders and water additives rely on saliva — and time.<br>FreshWipes work because they touch the teeth and gumline directly,<br>right where plaque actually starts.</p><p>That’s why you can see results immediately.</p>",
        "ggx4XAjUy5b_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0735/4833/3323/files/5_reasons_why_page_4.webp",
        "ggxF3G0g9bZ_text": "<p><i><strong>No more plaque buildup</strong> — or your money back.</i> <i>Choose the Dental Care Habit Plan — if you don't see plaque being removed with consistent use, we'll refund you. No improvement, no payment. No questions asked.</i></p>",
        "ggxo_GzGKhp_text": "<strong>No brushing battles — dogs </strong><span style=\"color:#47B5E9;\"><i><strong>actually accept it</strong></i></span>"
      },
      "type": "gp-section-631635195543487333"
    },
