    "ss_feature_54_9tLJcd": {
      "type": "ss-feature-54",
      "blocks": {
        "heading_BACNCk": {
          "type": "heading",
          "settings": {
            "heading": "<p>30 Seconds a Day Keeps the Vet Bills Away</p>",
            "heading_custom": false,
            "heading_font": "geist_n6",
            "heading_accent_font": "playfair_n4",
            "heading_size": 36,
            "heading_size_mobile": 24,
            "heading_advanced": false,
            "heading_height": 130,
            "heading_mt": 0,
            "heading_mt_mobile": 0,
            "heading_color": "#000000"
          }
        },
        "text_JmAzkk": {
          "type": "text",
          "settings": {
            "text": "<p>A professional dental cleaning for dogs can cost a lot of money and usually requires anesthesia. Most of it is preventable with a consistent daily routine that <strong>takes less time than making coffee.</strong></p>",
            "text_custom": false,
            "text_font": "josefin_sans_n4",
            "text_size": 14,
            "text_size_mobile": 14,
            "text_advanced": false,
            "text_height": 150,
            "text_mt": 12,
            "text_mt_mobile": 12,
            "text_color": "#2e2a39"
          }
        },
        "feature_XxTRyG": {
          "type": "feature",
          "settings": {
            "icon": "shield_check",
            "custom_icon": "shopify://shop_images/VETPETS_1.png",
            "title": "30 seconds covers the teeth and gumline",
            "text": "<p>One wipe along the teeth and gumline is all it takes before your dog is ready to move on</p>",
            "hide_mobile": false
          }
        },
        "feature_qPJagm": {
          "type": "feature",
          "settings": {
            "icon": "star_sparkle",
            "custom_icon": "shopify://shop_images/VETPETS_2.png",
            "title": "Stops plaque before it hardens into tartar",
            "text": "<p>Plaque that sits long enough hardens into tartar, which can only be removed by a vet under anesthesia</p>",
            "hide_mobile": false
          }
        },
        "feature_cnPtGa": {
          "type": "feature",
          "settings": {
            "icon": "feather",
            "title": "Works for dogs that won't tolerate a toothbrush",
            "text": "<p>No bristles, no paste, no forcing their mouth open, just a soft wipe on your finger</p>",
            "hide_mobile": false
          }
        },
        "feature_XtNY9j": {
          "type": "feature",
          "settings": {
            "icon": "heart_hand",
            "title": "Consistent use = fewer vet checkup",
            "text": "<p>Most dental issues vets flag during checkups are preventable with a simple daily habit</p>",
            "hide_mobile": false
          }
        }
      },
