 {\n    document.getElementById('vp-overlay').classList.add('is-open');\n    document.body.style.overflow = 'hidden';\n  }\n\n  function vpClose() {\n    document.getElementById('vp-overlay').classList.remove('is-open');\n    document.body.style.overflow = '';\n  }\n\n  function vpOverlayClick(e) {\n    if (e.target === document.getElementById('vp-overlay')) vpClose();\n  }\n\n  function vpTab(index) {\n    document.querySelectorAll('.vp-tab-btn').forEach(function(t, i) {\n      t.classList.toggle('is-active', i === index);\n    });\n    document.querySelectorAll('.vp-panel').forEach(function(p, i) {\n      p.classList.toggle('is-active', i === index);\n    });\n  }\n\n  document.addEventListener('keydown', function(e) {\n    if (e.key === 'Escape') vpClose();\n  });\n</script>"
