    "image_banner_Jkg3ye": {
      "type": "image-banner",
      "blocks": {
        "heading_hbj7Ji": {
          "type": "heading",
          "settings": {
            "title": "<strong>En risikofri investering </strong>i hundens helse",
            "title_highlight_color": "#118fcb",
            "heading_size": "h1"
          }
        },
        "text_WEzjkg": {
          "type": "text",
          "settings": {
            "text": "FreshWipes er en enkel og trygg løsning for hundens munnhelse. Vi ønsker at både du og hunden din skal være fornøyde – derfor tilbyr vi 100 dagers pengene-tilbake-garanti. Våre våtservietter er utviklet for å være både effektive og skånsomme, og de passer perfekt på fingeren for enkel bruk. Gi hunden din en smertefri fremtid med et produkt du kan stole på – helt risikofritt!",
            "text_style": "body"
          }
        },
