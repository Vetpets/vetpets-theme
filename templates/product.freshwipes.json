    "multicolumn_r3Fa8U": {
      "type": "multicolumn",
      "blocks": {
        "column_bKkKHH": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Namnlos_design_14.svg",
            "muted_autoplay": true,
            "title": "Te-polyfenoler",
            "text": "<p>Te-polyfenoler er naturlige antioksidanter som bidrar til å redusere bakterier i munnen, frisker opp ånden og beskytter mot betennelse i tannkjøttet.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_yXWzdC": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Namnlos_design_12.svg",
            "muted_autoplay": true,
            "title": "Glyserin",
            "text": "<p>Glyserin fukter munnens slimhinner og tannkjøtt – noe som reduserer risikoen for irritasjon og gir en mykere rengjøring.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_c9FKpR": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Namnlos_design_13.svg",
            "muted_autoplay": true,
            "title": "Sitronsyre",
            "text": "<p>Sitronsyre bidrar til å balansere pH-nivået i munnen – noe som beskytter vevet og forebygger dårlig ånde.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_QCjHRw": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Namnlos_design_15.svg",
            "muted_autoplay": true,
            "title": "Allantoin",
            "text": "<p>Allantoin beskytter og beroliger sensitivt tannkjøtt. Hjelper med å redusere irritasjon og fremmer heling.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_zLHyXq": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/assets_task_01jwzy13s9efnbfcxbccj3f6tg_1749123413_img_0.webp",
            "muted_autoplay": true,
            "title": "Cetylpyridiniumklorid",
            "text": "<p>En velkjent antibakteriell ingrediens brukt i munnpleie. Bidrar til å redusere plakk, bakterier og dårlig ånde.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_deznN8": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/540f0b38-c0db-4b70-a19d-8781871e78f7.png",
            "muted_autoplay": true,
            "title": "Natriumbenzoat",
            "text": "<p>Et skånsomt og trygt konserveringsmiddel som forlenger holdbarheten uten å påvirke munnens sensitive miljø.</p>",
