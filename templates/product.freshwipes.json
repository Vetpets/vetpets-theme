    "image_with_text_kiAL7m": {
      "type": "image-with-text",
      "blocks": {
        "heading_bXGAFf": {
          "type": "heading",
          "settings": {
            "title": "Få <strong>veterinærresultater</strong> hjemme",
            "title_highlight_color": "#118fcb",
            "heading_size": "h2"
          }
        },
        "text_GjNNAg": {
          "type": "text",
          "settings": {
            "text": "<p>FreshWipes rengjør skånsomt hundens tenner og tannkjøtt på bare noen sekunder.<br/><br/><strong>Fjerner plakk, frisker opp pusten og forebygger betennelse.</strong></p><p>Alt i en liten, enkel serviett du trer på fingeren.<br/><br/><strong>Ingen tannbørste, ingen søl, ingen stress.</strong></p>",
            "text_style": "body"
          }
        }
      },
