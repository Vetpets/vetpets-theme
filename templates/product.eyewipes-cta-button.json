ret","display_top_border":true,"open":false,"content":"<p><strong>EDI-purified water <\/strong>– base solution<br\/><br\/><strong>Aloe Vera (Aloe Barbadensis)<\/strong> – soothes and moisturizes the skin around the eyes<br\/><br\/><strong>Chamomile (Chamomilla Recutita)<\/strong> – known for its mild, anti-inflammatory properties<br\/><br\/><strong>Glycerin <\/strong>– binds moisture and protects the skin<br\/><br\/><strong>Ethylhexylglycerin<\/strong> – gentle preservation and antibacterial effect<br\/><br\/><strong>Decyl Glucoside<\/strong> – mild cleansing surfactant from plants<br\/><br\/><strong>Polyhexamethylene Biguanide Hydrochloride<\/strong> – antibacterial, counteracts irritation<br\/><br\/><strong>Vitamin E<\/strong> – strengthens and protects sensitive skin<br\/><br\/>✔️ pH-balanced & fragrance-free<br\/><br\/>✔️ Not tested on animals (cruelty-free)<br\/><br\/>✔️ Free from alcohol, parabens & sulfates<\/p>","page":"","margin_top":24,"margin_bottom":0}},"collapsible_tab_VQzpeP":{"type":"collapsible_tab","settings":{"heading":"Payment & Delivery","heading_size":"small","icon":"","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<h4><strong>Payment<\/strong><\/h4><p>You can safely pay with Klarna, credit card, or bank transfer – choose what works best for you.<br\/><\/p><h4><strong>Shipping<\/strong><\/h4><p><br\/>We offer different rates for the UK and the Rest of the World:<\/p><ul><li><strong>United Kingdom (UK): <\/strong>Standard Shipping: <strong>£2.00<\/strong> (Free on orders £37 and over)Priority Shipping: <strong>£4.50<\/strong><\/li><li><strong>Rest of the World: <\/strong>Standard Shipping: <strong>$2.95<\/strong> (Free on orders $49 and over)Priority Shipping: <strong>$6.00<\/strong><\/li><\/ul><p><strong>Delivery Time<\/strong><br\/><br\/>As our UK warehouse is temporarily out of stock, your order will be shipped from our international warehouse.<br\/>We offer two shipping options at checkout:<\/p><ul><li><strong>Standard Shipping:<\/strong> 1–2 days handling + 5–10 days shipping time<\/li><li><strong>Priority Shipping:<\/strong> 1–2 days handling + 4–7 days shipping time<\/li><\/ul><p>A tracking number will be sent by email as soon as your order leaves the warehouse.<\/p><p><strong>Questions?<\/strong><br\/>Email us at <strong>info@shopvetpets.com<\/strong> – we always reply within 24 hours on weekdays.<\/p>","page":"","margin_top":24,"margin_bottom":0}},"e7a28cbe-03cb-4c9d-a2c4-0e3e76ffb3e5":{"type":"sticky_atc","settings":{"function":"add_to_cart","display_when":"after_scroll","button_label":"ADD TO CART","enable_custom_btn_color":false,"custom_btn_color":"#dd1d1d","color_scheme":"background-1","star_color":"#ffcc00","stars_label":"(xxxx Reviews)","picker_type":"combined","desktop_show_image":true,"desktop_show_title":true,"desktop_rating_stars":false,"desktop_show_price":true,"desktop_show_sale_badge":true,"desktop_variant_picker":true,"desktop_full_button_width":false,"desktop_show_price_in_button":false,"desktop_transparent_bg":false,"mobile_show_image":false,"mobile_show_title":false,"mobile_rating_stars":false,"mobile_show_price":false,"mobile_show_sale_badge":false,"mobile_variant_picker":false,"mobile_full_button_width":true,"mobile_show_price_in_button":false,"mobile_transparent_bg":false}},"description":{"type":"description","disabled":true,"settings":{"margin_top":24,"margin_bottom":24}},"reviews_8UgFbe":{"type":"reviews","disabled":true,"settings":{"color_scheme":"background-1","show_custom_bg":false,"custom_bg_color":"#f2f2f2","corner_radius":12,"border_width":0,"border_color":"#b7b7b7","avatar_alignment":"top","avatar_corner_radius":40,"star_color":"#ffcc00","stars_translate":0,"checkmark_color":"#6d388b","checkmark_icon_color":"#ffffff","slider_type":"slide","autoplay":false,"autoplay_speed":5,"display_arrows":false,"display_dots":true,"author_1":"Anna Müller, Germany [stars]","image_1":"shopify:\/\/shop_images\/Profilbild_21_6774d488-3bc3-40