new_releases","filled_icon_1":true,"icon_2":"check_circle","filled_icon_2":false,"icon_3":"check_circle","filled_icon_3":false,"width":"100%","direction":"vertical","column_gap":3,"enable_bg":false,"bg_color":"#f3f3f3","corner_radius":40,"padding":3,"border_size":0,"border_color":"#b7b7b7"}}},"block_order":["caption_eyQd6B","heading_ddrPwT","text_7qAqC8","atc_button_pzEQzT","text_with_icon_QNKT3B"],"name":"t:sections.image-with-text.presets.name","settings":{"display_id":false,"visibility":"always-display","video":"shopify:\/\/files\/videos\/3175976ee8b841e99041bf8dacaf1f39.mp4","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"background-1","section_color_scheme":"background-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":16,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"testimonials_6ncqrm":{"type":"testimonials","blocks":{"column_iG9w8C":{"type":"column","settings":{"star_rating":5,"title":"No more crusty mornings","text":"<p>My Bichon used to wake up with those brown stains every single day. I tried everything - baby wipes, damp cloths, nothing worked properly. These actually remove the gunk and it doesn't come back as quickly. Takes about a week to see real improvement but now her eyes look so much cleaner. Finally something that works.<\/p>","author":"Sophie H., 43 | Bichon Frise - 2025-10-28"}},"column_pDtzVn":{"type":"column","settings":{"star_rating":5,"title":"Safe for sensitive eyes","text":"<p>We have a 3-year-old at home and the dog is constantly around him. I wanted something gentle that wouldn't irritate if it got in his eyes. These are natural and work really well. Takes 2 minutes in the evening. His eye area looks so much cleaner now and no more redness. Great not to have to worry.<\/p>","author":"Sarah E., 39 | Golden Retriever - 2025-10-03"}},"column_zAqp9B":{"type":"column","settings":{"star_rating":5,"title":"Getting better each time","text":"<p>My dog wasn't fond of it at first. But now it's going better. Works. I can actually get the tear stains cleaned properly now 😊 Worth every penny.<\/p>","author":"Christina B. | Maltese - 2025-09-21"}},"column_pFJKgM":{"type":"column","settings":{"star_rating":5,"title":"Finally something that actually works","text":"<p>Really good. I've tried different eye wipes, homemade solutions, everything possible. Nothing worked until the stains were really bad. These wipes actually remove the buildup, you see it directly on the wipe. Takes max 2 minutes and I can do it while watching TV. Should've bought these ages ago<\/p>","author":"Emily K., 41 | Cocker Spaniel - 2025-09-15"}},"column_9XrHtL":{"type":"column","settings":{"star_rating":5,"title":"Cleaner eyes, no more comments","text":"<p>People used to point out the tear stains on my dog. Now they compliment how clean she looks. I finally don't feel embarrassed at the park anymore<\/p>","author":"Laura M., 52 | Maltese - 2025-08-19"}},"column_fNxHWR":{"type":"column","settings":{"star_rating":5,"title":"I can sleep well now","text":"<p>I always felt guilty seeing the crusty buildup around his eyes but didn't know what to do. Vet said it wasn't urgent but I knew it wasn't right. These wipes are so simple - 30 seconds a day and his eyes are clear. I finally feel like I'm doing something that actually helps him.<\/p>","author":"Anna T., 56 | Bichon Frise - 2025-07-22"}}},"block_order":["column_iG9w8C","column_pDtzVn","column_zAqp9B","column_pFJKgM","column_9XrHtL","column_fNxHWR"],"name":"Testimonials","settings":{"display_id":false,"visibility":"always-display","title":"Verified Reviews","title_highlight_color":"#6d388b","heading_size":"h1","text":"<p><strong>10,000+ dog owners<\/strong> are keeping eyes clean without the struggle<\/p>","color_scheme":"background-1","image_width":"full","image_ratio":"square","column_alignment":"center","show_stars":true,"inactive_stars_style":"solid","star_color":"#ffcc00","bg_star_color":"#ececec","show_quotes":true,"quotes_color_scheme":"accent-1","cards_color_scheme":"bg-overlay","type":"loop","autoplay":true,"autoplay_speed":12.5,"arrows_color_scheme":"inverse","transparent_arrows":false,"dots_color_scheme":"inverse","desktop_full_page":true,"columns_desktop":4,"slider_desktop":true,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":false,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":false,"mobile_dots_position":"under","mobile_arrows_position":"under","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_cards_colors_background":"#f3f3f3","custom_cards_gradient_background":"","custom_cards_colors_text":"#2e2a39"}},"section_divider_WTNfTG":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":false,"shape_color":"background-2","custom_shape_color":"#dd1d1d","background_color":"background-1","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"image_with_text_JdMRPV":{"type":"image-with-text","blocks":{"heading_DWdACi":{"type":"heading","settings":{"title":"Gentle care <strong>for sensitive eyes<\/strong>","title_highlight_color":"#47b5e9","heading_size":"h1"}},"text_pJKKnm":{"type":"text","settings":{"text":"<p>Eyewipes are designed with the sensitive eyes of dogs and cats in mind.<br\/><br\/>Our formula is <strong>free from harsh chemicals <\/strong>and developed to be safe for everyday use.<br\/><br\/>Each wipe is pH-balanced and gentle, while <strong>effectively removing dirt, tear stains, and bacteria.<\/strong><br\/><br\/><strong>Naturally nourishing ingredients:<br\/><\/strong><br\/><strong>Aloe vera <\/strong>– soothes and moisturizes the skin around the eyes.<br\/><br\/><strong>Chamomile<\/strong> – known for its mild, anti-inflammatory properties.<br\/><br\/><strong>Vitamin E<\/strong> – strengthens and protects sensitive skin.<br\/><br\/>Together, they provide cleansing that both cares for and prevents problems – so your dog can keep its healthy, clear eyes.<\/p>","text_style":"body"}},"atc_button_pEEWVx":{"type":"atc_button","settings":{"button_label":"ADD TO CART","atc_product":"eyewipes-prevention-that-keeps-eyes-clear","atc_skip_cart":false}},"text_with_icon_xa7KTK":{"type":"text_with_icon","settings":{"mobile_text_size":14,"desktop_text_size":16,"alignment":"left","mobile_alignment":"left","text_color":"#121212","text_1":"100-Day Money-Back Guarantee","text_2":"","text_3":"","icon_scale":120,"icon_color":"#47b5e9","icon_1":"new_releases","filled_icon_1":true,"icon_2":"check_circle","filled_icon_2":false,"icon_3":"check_circle","filled_icon_3":false,"width":"100%","direction":"vertical","column_gap":3,"enable_bg":false,"bg_color":"#f3f3f3","corner_radius":40,"padding":3,"border_size":0,"border_color":"#b7b7b7"}}},"block_order":["heading_DWdACi","text_pJKKnm","atc_button_pEEWVx","text_with_icon_xa7KTK"],"name":"t:sections.image-with-text.presets.name","settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/Engelska_39.jpg","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"custom","section_color_scheme":"custom","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#d5f7ff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_colors_solid_button_background":"#47b5e9","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#47b5e9","custom_section_colors_background":"#d5f7ff","custom_section_gradient_background":""}},"section_divider_MckDnr":{"type":"section-divider","name":"Section divider","settings":{"visibility":"always-display","shape":"waves_1","flip_horizontal":false,"flip_vertical":false,"shape_color":"background-1","custom_shape_color":"#dd1d1d","background_color":"background-2","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"collapsible_content_3qj3hn":{"type":"collapsible-content","blocks":{"collapsible_row_qGe3Vx":{"type":"collapsible_row","settings":{"heading":"How soon will I see results?","icon":"","filled_icon":false,"row_content":"<p>Most dog parents notice brighter, cleaner eyes within <strong>7–10 days<\/strong> of daily use. For deeper, long-standing stains, expect <strong>2–3 weeks<\/strong> for full improvement. Consistency is key - the routine works best when done daily.<\/p>","page":""}},"collapsible_row_nFVraE":{"type":"collapsible_row","settings":{"heading":"Is it safe for my dog's eyes?","icon":"","filled_icon":false,"row_content":"<p>Yes, absolutely. VetPets EyeWipes are <strong>ophthalmologist-tested<\/strong> and formulated specifically for the delicate eye area. The pH-balanced, hypoallergenic formula contains soothing ingredients like Aloe Vera and Chamomile. They're gentle enough for daily use, even on puppies and dogs with sensitive eyes.<\/p>","page":""}},"collapsible_row_x8Gbyi":{"type":"collapsible_row","settings":{"heading":"Will this help old, stubborn tear stains?","icon":"","filled_icon":false,"row_content":"<p>Yes. While fresh stains respond quickly (7–10 days), stubborn tear stains that have built up over months may take <strong>2–3 weeks<\/strong> of consistent daily use to fade significantly. The key is removing the bacteria causing new staining while the old discoloration gradually lightens. Patience and daily use make the difference.<\/p>","page":""}},"collapsible_row_rmaE7E":{"type":"collapsible_row","settings":{"heading":"How often should I use it?","icon":"","filled_icon":false,"row_content":"<p><strong>Once daily<\/strong> is ideal for most dogs. Use one wipe per eye, gently cleaning from the inner corner outward. For dogs prone to heavy discharge or during allergy season, you can use them twice daily (morning and evening). Consistency matters more than frequency.<\/p>","page":""}},"collapsible_row_traqqd":{"type":"collapsible_row","settings":{"heading":"How long does one container last?","icon":"","filled_icon":false,"row_content":"<p>Each container has <strong>100 wipes<\/strong>. For daily use (one wipe per eye), one container lasts approximately <strong>6–7 weeks<\/strong> for one dog. If you have multiple dogs or use twice daily, plan accordingly. Most customers find the 2-pack or 3-pack offers the best value.<\/p>","page":""}},"collapsible_row_imM4tj":{"type":"collapsible_row","settings":{"heading":"Will the stains come back?","icon":"","filled_icon":false,"row_content":"<p>Tear staining is caused by bacteria and moisture buildup, which is ongoing for many dogs. The stains won't return <em>as long as you maintain the daily routine<\/em>. If you stop using the wipes, bacteria can accumulate again and stains may gradually reappear. Think of it like brushing teeth - consistency prevents problems from coming back.<\/p>","page":""}},"collapsible_row_f67TaQ":{"type":"collapsible_row","settings":{"heading":"What's the difference between these and baby wipes?","icon":"","filled_icon":false,"row_content":"<p>Baby wipes often contain fragrances, lotions, and harsh preservatives that can irritate the sensitive eye area. VetPets EyeWipes are specifically formulated for dogs' eyes - <strong>hypoallergenic, fragrance-free, pH-balanced<\/strong>, and contain antibacterial ingredients that actually prevent regrowth. They don't just wipe the surface; they address the root cause.<\/p>","page":""}},"collapsible_row_Yr4DNV":{"type":"collapsible_row","settings":{"heading":"Can I use these on cats too?","icon":"","filled_icon":false,"row_content":"<p>Yes! VetPets EyeWipes are safe for both dogs and cats. Cats can also develop tear staining and eye discharge, especially flat-faced breeds like Persians. Use the same technique - one wipe per eye, gently cleaning from inner corner outward.<\/p>","page":""}},"collapsible_row_pGRcRX":{"type":"collapsible_row","settings":{"heading":"My dog hates having their eyes touched. Will this work?","icon":"","filled_icon":false,"row_content":"<p>Many dogs are initially hesitant. Start slowly - let them sniff the wipe first, offer treats, and keep sessions short (30 seconds max). Most dogs adjust within a few days once they realize it's quick and gentle. Some customers find it easier right after walks when dogs are calmer, or during cuddle time on the couch.<\/p>","page":""}},"collapsible_row_cnB8mR":{"type":"collapsible_row","settings":{"heading":"Do I need to rinse after using?","icon":"","filled_icon":false,"row_content":"<p>No rinsing needed. The wipes are designed to be used and discarded. Just gently wipe the eye area, discard the wipe, and you're done. The formula is safe to leave on and will continue working to prevent bacterial regrowth.<\/p>","page":""}}},"block_order":["collapsible_row_qGe3Vx","collapsible_row_nFVraE","collapsible_row_x8Gbyi","collapsible_row_rmaE7E","collapsible_row_traqqd","collapsible_row_imM4tj","collapsible_row_f67TaQ","collapsible_row_Yr4DNV","collapsible_row_pGRcRX","collapsible_row_cnB8mR"],"name":"t:sections.collapsible_content.presets.name","settings":{"display_id":false,"visibility":"always-display","caption":"","title":"Frequently Asked Questions","title_highlight_color":"#6d388b","heading_size":"h1","heading_alignment":"center","layout":"row","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"video_muted_autoplay":true,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"medium","collapse_icon":"carret","display_top_border":true,"padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_contaner_colors_background":"#ffffff","custom_container_gradient_background":"","custom_contaner_colors_text":"#2e2a39"}},"related-products":{"type":"related-products","disabled":true,"settings":{"display_id":false,"title":"You may also like","title_highlight_color":"#6d388b","heading_size":"h2","products_to_show":4,"stretch_cards":false,"columns_desktop":4,"color_scheme":"background-1","image_ratio":"adapt","show_secondary_image":false,"show_vendor":false,"show_rating":false,"enable_quick_add":false,"columns_mobile":"2","padding_top":36,"padding_bottom":24}},"featured_collection_MRf9GU":{"type":"featured-collection","disabled":true,"settings":{"display_id":false,"visibility":"always-display","title":"You may also like:","title_highlight_color":"#6d388b","heading_size":"h1","description":"","show_description":false,"description_style":"body","color_scheme":"background-1","collection":"frontpage","products_to_show":4,"stretch_cards":false,"show_view_all":true,"view_all_style":"solid","cards_color_scheme":"background-1","image_ratio":"adapt","show_secondary_image":false,"badges":"regular","show_vendor":false,"show_rating":false,"enable_quick_add":false,"swatches_option_name":"","swatches_position":"to